.custom-tabbar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 200;
}

.tabbar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
}

.tabbar-icon {
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 6rpx;
}

.tabbar-icon .icon {
  width: 100%;
  height: 100%;
}

.tabbar-icon-add {
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 中间添加按钮保持静态展示，点击后不再旋转。 */
.tabbar-icon-add .add-icon {
  transform: rotate(0deg) scale(1);
}

/* 激活态也保持和默认态一致，避免点击后出现旋转动画。 */
.tabbar-icon-add.is-active .add-icon {
  transform: rotate(0deg) scale(1);
}

.tabbar-text {
  font-size: 22rpx;
}
