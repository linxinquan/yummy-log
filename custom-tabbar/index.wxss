.custom-tabbar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 200;
}

.tabbar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
}

.tabbar-icon {
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 6rpx;
}

.tabbar-icon .icon {
  width: 100%;
  height: 100%;
}

.tabbar-icon-add {
  display: flex;
  align-items: center;
  justify-content: center;
}

.tabbar-icon-add .add-icon {
  transform: rotate(0deg) scale(1);
  transform-origin: center;
  transition: transform 320ms cubic-bezier(0.22, 1, 0.36, 1);
  will-change: transform;
}

.tabbar-icon-add.is-active .add-icon {
  transform: rotate(45deg) scale(1.04);
}

.tabbar-text {
  font-size: 22rpx;
}
