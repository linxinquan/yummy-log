page {
  background: #FFFFFF;
}

/* 页面整体容器 */
.container {
  min-height: 100vh;
  background: #FFFFFF;
  padding-bottom: env(safe-area-inset-bottom);
}

/* 顶部标题区 */
.header {
  padding: 48rpx;
  background: #FFFFFF;
}

.district-title {
  font-family: 'PingFang SC';
  font-style: normal;
  font-weight: 500;
  font-size: 48rpx;
  line-height: 100%;
  color: #1A2739;
}

/* 攻略列表区域 */
.guide-list {
  display: flex;
  flex-direction: column;
  gap: 48rpx;
  padding: 0 48rpx;
}

/* 空状态：当当前区没有攻略数据时，给用户一个明确反馈。 */
.empty-wrap {
  min-height: calc(100vh - 160rpx);
  padding: 64rpx 48rpx 96rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.empty-illustration {
  width: 320rpx;
  height: 320rpx;
  margin-bottom: 48rpx;
}

.empty-image {
  width: 100%;
  height: 100%;
  display: block;
}

.empty-title {
  font-family: 'PingFang SC';
  font-weight: 500;
  font-size: 36rpx;
  line-height: 44rpx;
  color: #1A2739;
}

.empty-desc {
  margin-top: 20rpx;
  font-family: 'PingFang SC';
  font-weight: 400;
  font-size: 26rpx;
  line-height: 38rpx;
  color: #9DA4AD;
}

/* 单张攻略卡片 */
.guide-card {
  width: 100%;
  min-height: 368rpx;
  border-radius: 32rpx;
  padding: 32rpx;
  box-sizing: border-box;
  position: relative;
  background: linear-gradient(180deg, #F6F8FA 0%, #FFFFFF 100%);
}

.guide-cover-wrap {
  position: absolute;
  width: 192rpx;
  height: 192rpx;
  left: 32rpx;
  top: 32rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.guide-cover {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.guide-info {
  position: absolute;
  top: 32rpx;
  left: 256rpx;
  right: 32rpx;
  width: auto;
  height: 192rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  min-width: 0;
}

.guide-title {
  width: 100%;
  max-width: 100%;
  height: 96rpx;
  display: -webkit-box;
  overflow: hidden;
  font-family: 'PingFang SC';
  font-weight: 500;
  font-size: 32rpx;
  line-height: 48rpx;
  color: #1A2739;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  word-break: break-all;
}

.guide-city {
  margin-top: 24rpx;
  font-family: 'PingFang SC';
  font-weight: 400;
  font-size: 24rpx;
  line-height: 100%;
  color: #9DA4AD;
}

.guide-stats {
  margin-top: 16rpx;
  font-family: 'PingFang SC';
  font-weight: 400;
  font-size: 24rpx;
  line-height: 100%;
  color: #9DA4AD;
}

.guide-divider {
  position: absolute;
  width: calc(100% - 64rpx);
  height: 0;
  left: 32rpx;
  top: 272rpx;
  border-top: 2rpx dashed #F6F8FA;
}

.guide-footer {
  position: absolute;
  width: calc(100% - 64rpx);
  left: 32rpx;
  top: 304rpx;
}

.guide-meta {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}

.guide-author-wrap {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
}

.guide-author-avatar {
  width: 32rpx;
  height: 32rpx;
  border-radius: 24rpx;
  object-fit: cover;
}

.guide-author {
  font-family: 'PingFang SC';
  font-weight: 400;
  font-size: 24rpx;
  line-height: 100%;
  color: #9DA4AD;
}

.guide-likes {
  font-family: 'PingFang SC';
  font-weight: 400;
  font-size: 24rpx;
  line-height: 100%;
  color: #9DA4AD;
}



