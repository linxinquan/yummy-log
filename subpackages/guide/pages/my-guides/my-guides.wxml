<!-- 觅食图 - 我的攻略页面 -->
<view class="container">
  <view class="header">
    <view class="district-title">我的发布</view>
  </view>

  <scroll-view class="guide-list" scroll-y wx:if="{{myGuides.length > 0}}">
    <block wx:for="{{myGuides}}" wx:key="id">
      <view
        class="guide-card"
        bindtap="onGuideTap"
        bindlongpress="onGuideLongPress"
        data-guide="{{item}}"
        data-index="{{index}}"
      >
        <view class="guide-cover-wrap">
          <image
            class="guide-cover"
            src="{{item.coverImage}}"
            mode="aspectFill"
            binderror="onImageError"
            data-index="{{index}}"
          />
        </view>
        <view class="guide-info">
          <text class="guide-title">{{item.title}}</text>
          <text class="guide-city">{{item.cityText}}</text>
          <text class="guide-stats">{{item.duration}} · {{item.shopCount}} 个地点</text>
        </view>
        <view class="guide-divider"></view>
        <view class="guide-footer">
          <view class="guide-meta">
            <view class="guide-author-wrap">
              <view class="guide-time-icon">
                <i class="mgc_time_line"></i>
              </view>
              <text class="guide-author">{{item.publishedAtText}}</text>
            </view>
            <text class="guide-likes">{{item.useRouteCount}} 人使用路线</text>
          </view>
        </view>
      </view>
    </block>

    <view class="safe-area-bottom"></view>
  </scroll-view>


  <view class="empty-state" wx:else>
    <view class="empty-illustration">
      <image class="empty-image" webp="{{true}}" src="/images/empty/暂无攻略.webp" mode="aspectFit" />
    </view>
    <text class="empty-title">我的发布</text>
    <text class="empty-hint">去我的路线发布攻略吧</text>
    <view class="empty-btn" bindtap="onGoGuidePage">去我的路线</view>
  </view>

  <bottom-action-sheet
    visible="{{routeActionSheetVisible}}"
    title="发布路线编辑"
    bind:close="onCloseRouteActionSheet"
  >
    <view class="route-action-grid">
      <view
        wx:for="{{routeActionOptions}}"
        wx:key="key"
        class="route-action-card {{item.danger ? 'danger' : ''}}"
        bindtap="onSelectRouteAction"
        data-action="{{item.key}}"
      >
        <i class="route-action-icon {{item.icon}}"></i>
        <text class="route-action-label">{{item.label}}</text>
      </view>
    </view>
  </bottom-action-sheet>

  <bottom-action-sheet
    visible="{{deleteRouteConfirmVisible}}"
    title="删除路线"
    custom-panel-class="route-delete-confirm-sheet"
    custom-body-class="route-delete-confirm-body"
    bind:close="onCloseDeleteRouteConfirm"
  >
    <text class="route-delete-confirm-desc">删除后无法恢复，确认删除这条路线吗？</text>
    <view class="route-delete-confirm-actions">
      <view class="route-delete-confirm-btn cancel" bindtap="onCloseDeleteRouteConfirm">取消</view>
      <view class="route-delete-confirm-btn danger" bindtap="onConfirmDeleteRoute">确认删除</view>
    </view>
  </bottom-action-sheet>
</view>
