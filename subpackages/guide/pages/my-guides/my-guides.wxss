/* 觅食图 - 我的攻略页面样式 */

.page {
  background: #FFFFFF;
}

.container {
  width: 100%;
  min-height: 100vh;
  background: #FFFFFF;
  padding-bottom: env(safe-area-inset-bottom);
  display: flex;
  flex-direction: column;
}

/* ── 大标题（与 district-guide 一致） ── */
.header {
  padding: 48rpx;
  background: #FFFFFF;
}

.district-title {
  font-family: 'PingFang SC';
  font-style: normal;
  font-weight: 500;
  font-size: 48rpx;
  line-height: 100%;
  color: #1A2739;
}

.guide-list {
  flex: 1;
  background: #FFFFFF;
  padding: 0 48rpx calc(64rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.guide-card {
  width: 100%;
  min-height: 368rpx;
  margin-bottom: 48rpx;
  border-radius: 32rpx;
  padding: 32rpx;
  box-sizing: border-box;
  position: relative;
  z-index: 1;
  border: 2rpx solid #F6F7F7;
  background: linear-gradient(180deg, #F6F8FA 0%, #FFFFFF 100%);
}

.guide-cover-wrap {
  position: absolute;
  width: 192rpx;
  height: 192rpx;
  left: 32rpx;
  top: 32rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.guide-cover {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.guide-info {
  position: absolute;
  top: 32rpx;
  left: 256rpx;
  right: 32rpx;
  width: auto;
  height: 192rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  min-width: 0;
}

.guide-title {
  width: 100%;
  max-width: 100%;
  height: 96rpx;
  display: -webkit-box;
  overflow: hidden;
  font-family: 'PingFang SC';
  font-weight: 500;
  font-size: 32rpx;
  line-height: 48rpx;
  color: #1A2739;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  word-break: break-all;
}

.guide-city {
  margin-top: 24rpx;
  font-family: 'PingFang SC';
  font-weight: 400;
  font-size: 24rpx;
  color: #9DA4AD;
  line-height: 100%;
}

.guide-stats {
  font-family: 'PingFang SC';
  font-weight: 400;
  font-size: 24rpx;
  color: #9DA4AD;
  line-height: 100%;
  margin-top: 16rpx;
}

.guide-divider {
  position: absolute;
  width: calc(100% - 64rpx);
  left: 32rpx;
  top: 272rpx;
  height: 2rpx;
  background: linear-gradient(to right, #F6F8FA 50%, transparent 50%);
  background-size: 16rpx 2rpx;
}

.guide-footer {
  position: absolute;
  width: calc(100% - 64rpx);
  left: 32rpx;
  top: 304rpx;
}

.guide-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
}

.guide-author-wrap {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
}

.guide-time-icon {
  width: 32rpx;
  height: 32rpx;
  border-radius: 16rpx;
  color: #9DA4AD;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.guide-author {
  font-family: 'PingFang SC';
  font-weight: 400;
  font-size: 24rpx;
  line-height: 100%;
  color: #9DA4AD;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.guide-likes {
  font-family: 'PingFang SC';
  font-weight: 400;
  font-size: 24rpx;
  line-height: 100%;
  color: #9DA4AD;
  white-space: nowrap;
}

/* ── 空状态 ── */
.empty-state {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 0 48rpx calc(120rpx + env(safe-area-inset-bottom));
}

.empty-illustration {
  width: 320rpx;
  height: 320rpx;
  margin-bottom: 32rpx;
}

.empty-image {
  width: 100%;
  height: 100%;
  display: block;
}

.empty-title {
  color: #1A2739;
  font-size: 32rpx;
  line-height: 32rpx;
  margin-bottom: 24rpx;
  font-weight: 500;
}

.empty-hint {
  font-size: 28rpx;
  color: #808B9A;
  line-height: 28rpx;
  text-align: center;
  margin-bottom: 32rpx;
}

.empty-btn {
  min-width: 176rpx;
  height: 80rpx;
  padding: 0 32rpx;
  border-radius: 999rpx;
  background: #25BBE7;
  color: #FFFFFF;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ── 底部安全区 ── */
.safe-area-bottom {
  height: env(safe-area-inset-bottom);
}

/* 长按路线后的底部操作弹窗，直接对齐“想去”页的路线编辑样式。 */
.route-action-grid {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.route-action-card {
  width: 100%;
  min-height: 104rpx;
  border-radius: 24rpx;
  border: 2rpx solid #F6F8FA;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 0 32rpx;
  box-sizing: border-box;
}

.route-action-icon {
  color: #1A2739;
  font-size: 40rpx;
  line-height: 40rpx;
  flex-shrink: 0;
}

.route-action-label {
  color: #1A2739;
  font-size: 32rpx;
  line-height: 32rpx;
  font-weight: 400;
  flex: 1;
  text-align: left;
}

.route-action-card.danger .route-action-icon,
.route-action-card.danger .route-action-label {
  color: #FF5A5F;
}

.route-delete-confirm-body {
  padding-top: 0;
}

.route-delete-confirm-desc {
  display: block;
  color: #808B9A;
  font-size: 28rpx;
  line-height: 44rpx;
}

.route-delete-confirm-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 48rpx;
}

.route-delete-confirm-btn {
  height: 96rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 32rpx;
}

.route-delete-confirm-btn.cancel {
  width: 160rpx;
  background: #F2F4F7;
  color: #1A2739;
  flex-shrink: 0;
}

.route-delete-confirm-btn.danger {
  flex: 1;
  background: #FF5A5F;
  color: #FFFFFF;
}
