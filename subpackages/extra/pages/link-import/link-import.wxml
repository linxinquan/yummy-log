<view class="link-import-page">
  <!-- 顶部标题和关闭按钮 -->
  <view class="link-import-header">
    <text class="link-import-title">解析路线</text>
    <view class="link-import-close" bindtap="onBack">
      <i class="mgc_close_line"></i>
    </view>
  </view>

  <!-- 内容输入区和说明文案 -->
  <view class="link-import-body">
    <view class="link-input-wrap">
      <textarea
        class="link-textarea"
        value="{{guideLink}}"
        placeholder="粘贴纯链接、攻略正文或分享文案"
        placeholder-class="link-placeholder"
        maxlength="-1"
        auto-height
        cursor-spacing="24"
        bindinput="onLinkInput"
      ></textarea>
    </view>

    <view class="link-hint-list">
      <text class="link-hint">支持识别微信公众号、小红书笔记的文本内容或者链接</text>
    </view>
  </view>

  <!-- 底部操作按钮 -->
  <view class="link-import-footer">
    <view class="link-secondary-btn" bindtap="onPasteLink">粘贴内容</view>
    <view class="link-primary-btn" bindtap="onConfirmLink">确认</view>
  </view>
</view>
