/* 页面整体容器 */
.link-import-page {
  min-height: 100vh;
  background: #FFFFFF;
  padding: 134rpx 48rpx calc(146rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* 顶部标题区 */
.link-import-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 128rpx;
}

.link-import-title {
  color: #1A2739;
  font-size: 48rpx;
  font-weight: 500;
  line-height: 48rpx;
}

.link-import-close {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #1A2739;
}

.link-import-close i {
  font-size: 40rpx;
}

.link-import-body {
  margin-top: 24rpx;
}

/* 输入框外层容器 */
.link-input-wrap {
  box-sizing: border-box;
  min-height: 320rpx;
  padding: 32rpx;
  background: #F6F8FA;
  border: 2rpx solid #F6F8FA;
  border-radius: 24rpx;
}

.link-textarea {
  width: 100%;
  min-height: 240rpx;
  color: #1A2739;
  font-size: 28rpx;
  line-height: 44rpx;
}

.link-placeholder {
  /* 占位文字补齐字号和行高，和输入内容保持同样的视觉基线。 */
  color: #9DA4AD;
  font-size: 28rpx;
  line-height: 44rpx;
}

.link-hint-list {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.link-hint {
  color: #808B9A;
  font-size: 24rpx;
  line-height: 24rpx;
}

/* 底部固定按钮区 */
.link-import-footer {
  position: fixed;
  left: 48rpx;
  right: 48rpx;
  bottom: calc(48rpx + env(safe-area-inset-bottom));
  display: flex;
  gap: 20rpx;
}

.link-secondary-btn,
.link-primary-btn {
  height: 96rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  line-height: 32rpx;
  font-weight: 500;
}

.link-secondary-btn {
  width: 220rpx;
  flex: 0 0 220rpx;
  background: #F2F4F7;
  color: #1A2739;
}

.link-primary-btn {
  flex: 1;
  background: #25BBE7;
  color: #FFFFFF;
}
