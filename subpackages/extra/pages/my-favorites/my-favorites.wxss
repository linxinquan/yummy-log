/* pages/my-favorites/my-favorites.wxss */

.page {
  background: #FFFFFF;
}

.container {
  min-height: 100vh;
  background: #FFFFFF;
  padding-bottom: env(safe-area-inset-bottom);
  display: flex;
  flex-direction: column;
}

/* ── 大标题（与 district-guide 一致） ── */
.header {
  padding: 48rpx; 
  background: #FFFFFF;
}

.district-title {
  font-family: 'PingFang SC';
  font-style: normal;
  font-weight: 500;
  font-size: 48rpx;
  line-height: 100%;
  color: #1A2739;
}

/* ── 空状态 ── */
.empty-state {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 0 48rpx calc(120rpx + env(safe-area-inset-bottom));
}

.empty-illustration {
  width: 320rpx;
  height: 320rpx;
  margin-bottom: 32rpx;
}

.empty-image {
  width: 100%;
  height: 100%;
  display: block;
}

.empty-title {
  color: #1A2739;
  font-size: 32rpx;
  line-height: 32rpx;
  margin-bottom: 24rpx;
  font-weight: 500;
}

.empty-hint {
  font-size: 28rpx;
  color: #808B9A;
  text-align: center;
  line-height: 28rpx;
  white-space: pre-line;
  margin-bottom: 32rpx;
}

.empty-btn {
  min-width: 176rpx;
  height: 80rpx;
  padding: 0 32rpx;
  border-radius: 999rpx;
  background: #25BBE7;
  font-size: 28rpx;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ── 列表容器 ── */
.list-container {
  flex: 1;
  background: #FFFFFF;
  /* 收藏列表的横向留白改成和“想去”页一致。 */
  padding: 0 48rpx calc(42rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* 左滑删除单元：结构和“想去”页保持一致。 */
.place-swipe-item {
  position: relative;
  margin-bottom: 48rpx;
  overflow: hidden;
}

/* 左滑露出的删除按钮：和“想去”页一样，放在卡片右侧。 */
.place-delete-action {
  position: absolute;
  top: 0;
  right: 0;
  width: 120rpx;
  height: 160rpx;
  border-radius: 24rpx;
  background: #FF5A5F;
  display: flex;
  align-items: center;
  justify-content: center;
  /* 默认完全隐藏，只有开始左滑后再显示，避免未滑开时透出来。 */
  opacity: 0;
  transition: opacity 0.2s ease;
}

.place-delete-action.show {
  opacity: 1;
}

.place-delete-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
}

.place-delete-icon {
  color: #FFFFFF;
  font-size: 40rpx;
  line-height: 40rpx;
}

.place-delete-text {
  color: #FFFFFF;
  font-size: 24rpx;
  line-height: 24rpx;
  font-weight: 500;
}

/* 地点卡片：直接对齐“想去”页同名类。 */
.place-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  width: 100%;
  min-height: 160rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  transition: transform 0.2s ease;
  box-sizing: border-box;
  z-index: 1;
}

.place-card-main {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 32rpx;
  min-width: 0;
}

.place-cover-wrap {
  width: 160rpx;
  height: 160rpx;
  border-radius: 24rpx;
  flex-shrink: 0;
  overflow: hidden;
  position: relative;
  background: #F2F4F7;
}

.place-cover {
  width: 100%;
  height: 100%;
  display: block;
}

/* 封面角标：和“想去”页保持同一种样式。 */
.card-cat-badge {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  background: rgba(0, 0, 0, 0.1);
  border-radius: 8rpx;
  padding: 6rpx 8rpx;
  font-size: 20rpx;
  color: #FFFFFF;
  line-height: 20rpx;
  backdrop-filter: blur(4px);
}

/* 中间信息和右侧操作区的布局完全对齐“想去”页。 */
.place-info-row {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.place-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-height: 160rpx;
  box-sizing: border-box;
}

.place-name {
  width: 100%;
  font-size: 32rpx;
  color: #1A2739;
  line-height: 32rpx;
  font-weight: 400;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  margin-bottom: 16rpx;
}

.place-tags {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-wrap: nowrap;
  overflow: hidden;
  width: 100%;
  margin-bottom: 32rpx;
}

.place-rating {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FFF7E8;
  border-radius: 12rpx;
  padding: 8rpx 16rpx;
  font-size: 24rpx;
  color: #FF7D00;
  line-height: 24rpx;
  flex-shrink: 0;
}

.place-tag-chip {
  background: #F6F8FA;
  border-radius: 12rpx;
  padding: 8rpx 16rpx;
  font-size: 24rpx;
  color: #9DA4AD;
  line-height: 24rpx;
  flex-shrink: 0;
  white-space: nowrap;
}

.place-footer {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
}

.place-footer-text,
.place-footer-separator {
  font-size: 24rpx;
  color: #9DA4AD;
  line-height: 28rpx;
  flex-shrink: 0;
}

/* 右侧操作位沿用“想去”页箭头槽位尺寸，只是里面放心形按钮。 */
.place-arrow {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.want-icon {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.icon-btn-text {
  font-size: 40rpx;
  line-height: 40rpx;
  color: #BAC4CC;
}

.icon-btn-text.active {
  color: #FF5A5F;
}

/* ── 底部安全区 ── */
.safe-area-bottom {
  height: env(safe-area-inset-bottom);
}
