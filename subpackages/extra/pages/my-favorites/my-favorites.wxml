<view class="container">
  <!-- 大标题（与 district-guide 一致） -->
  <view class="header">
    <view class="district-title">我的收藏</view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{showEmpty}}">
    <view class="empty-illustration">
      <image class="empty-image" src="/images/empty/暂无收藏.png" mode="aspectFit" />
    </view>
    <text class="empty-title">我的收藏</text>
    <text class="empty-hint">{{emptyText}}</text>
    <view class="empty-btn" bindtap="onGoExplore">去探索</view>
  </view>

  <!-- 收藏列表 -->
  <scroll-view 
    class="list-container" 
    scroll-y 
    wx:if="{{!showEmpty}}"
  >
    <block wx:for="{{allList}}" wx:key="id">
      <view class="place-swipe-item">
        <!-- 左滑后露出的删除操作：这里只删除收藏，不影响想去。 -->
        <view class="place-delete-action {{(item.swipeOffset || 0) < 0 ? 'show' : ''}}" catchtap="onRemoveCollect" data-id="{{item.id}}">
          <view class="place-delete-inner">
            <i class="mgc_delete_2_line place-delete-icon"></i>
            <text class="place-delete-text">删除</text>
          </view>
        </view>

        <view 
          class="place-row" 
          bindtap="onItemTap"
          bindtouchstart="onCardTouchStart"
          bindtouchmove="onCardTouchMove"
          bindtouchend="onCardTouchEnd"
          bindtouchcancel="onCardTouchEnd"
          data-item="{{item}}"
          data-index="{{index}}"
          style="transform: translateX({{item.swipeOffset || 0}}px);"
        >
          <!-- 卡片结构直接对齐“想去”页：左封面，中间信息，右操作。 -->
          <view class="place-card-main">
            <view class="place-cover-wrap">
              <image 
                class="place-cover" 
                src="{{item.coverImage}}" 
                mode="aspectFill"
                binderror="onImageError"
                data-index="{{index}}"
              />
              <view class="card-cat-badge">{{item.displayCategory}}</view>
            </view>

            <!-- 中间信息和右侧操作区的布局也保持和“想去”页一致。 -->
            <view class="place-info-row">
              <view class="place-main">
                <text class="place-name">{{item.name}}</text>
                <view class="place-tags">
                  <view class="place-rating" wx:if="{{item.rating}}">
                    <!-- 评分标签沿用“想去”页同一套展示。 -->
                  <text>{{item.rating}}</text>
                </view>
                  <text class="place-tag-chip" wx:for="{{item.tags}}" wx:key="*this" wx:for-item="tag">{{tag}}</text>
                </view>
                <view class="place-footer">
                  <text class="place-footer-text">{{item.displayWantCount}} 人想去</text>
                  <text class="place-footer-separator">·</text>
                  <text class="place-footer-text">{{item.distanceText}}</text>
                </view>
              </view>

              <!-- 按用户前一条要求，右侧继续保留心形加入想去功能。 -->
              <view class="place-arrow">
                <view
                  class="want-icon"
                  catchtap="onAddWant"
                  data-item="{{item}}"
                >
                  <i class="{{item.isWanted ? 'mgc_heart_fill' : 'mgc_heart_line'}} icon-btn-text {{item.isWanted ? 'active' : ''}}"></i>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>
    </block>

    <!-- 底部安全区 -->
    <view class="safe-area-bottom"></view>
  </scroll-view>
</view>
