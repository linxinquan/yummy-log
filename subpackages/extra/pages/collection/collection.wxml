<!-- 我的采集：按当前产品的二级页风格整理 -->
<view class="container">
  <view class="header">
    <!-- 顶部标题区：按设计稿保留左标题、右侧采集打卡按钮 -->
    <view class="header-row">
      <view class="district-title">我的采集</view>
      <view class="hero-action-btn" bindtap="onGoCheckin">
        <i class="mgc_camera_2_ai_line"></i>
        <text>采集打卡</text>
      </view>
    </view>
  </view>

  <view class="page-content">
    <!-- 统计卡：三列小卡，与设计稿的轻量信息块一致 -->
    <view class="stats-row">
      <view class="stat-card">
        <text class="stat-label">采集</text>
        <text class="stat-value">{{stats.totalCount}}</text>
      </view>
      <view class="stat-card">
        <text class="stat-label">城市</text>
        <text class="stat-value">{{stats.cityCount}}</text>
      </view>
      <view class="stat-card">
        <text class="stat-label">足迹</text>
        <text class="stat-value">{{stats.footprintCount}}</text>
      </view>
    </view>

    <!-- 列表/地图：改成纯文字切换，不再使用胶囊 segmented 样式 -->
    <view class="view-tabs">
      <view class="vt-item {{viewMode === 'list' ? 'active' : ''}}" bindtap="onSwitchView" data-view="list">
        <text>列表</text>
      </view>
      <view class="vt-item {{viewMode === 'map' ? 'active' : ''}}" bindtap="onSwitchView" data-view="map">
        <text>地图</text>
      </view>
    </view>

    <block wx:if="{{viewMode === 'list'}}">
      <view class="empty-state" wx:if="{{checkins.length === 0}}">
        <view class="empty-illustration">
          <i class="mgc_flower_4_line empty-icon"></i>
        </view>
        <text class="empty-title">我的采集</text>
        <text class="empty-hint">去记录你的第一张采集卡吧</text>
        <view class="empty-actions">
          <!-- 空状态按钮改成 view，避免被原生 button 默认宽度 184px 干扰 -->
          <view class="empty-btn empty-btn-primary" bindtap="onGoCheckin">
            <text>采集打卡</text>
          </view>
        </view>
      </view>

      <view class="stamp-grid" wx:else>
        <!-- 邮票卡：列表里只保留图片和标题，不展示分类与时间 -->
        <view
          class="stamp-item {{index % 2 === 0 ? 'stamp-item-left' : 'stamp-item-right'}}"
          wx:for="{{checkins}}"
          wx:key="id"
          bindtap="onCheckinTap"
          bindlongpress="onCheckinLongPress"
          data-id="{{item.id}}"
          data-name="{{item.spotName || item.shortAddr || '未知地点'}}"
        >
          <view class="stamp-ticket">
            <!-- 底部单独椭圆阴影：只给邮票底部一点悬浮感，避免左右卡片阴影互相打架 -->
            <view class="stamp-bottom-shadow"></view>
            <!-- 邮票壳：使用 PNG 切图 -->
            <image class="stamp-shell" src="/images/collection/stamp-ticket.png" mode="scaleToFill"></image>
            <image class="stamp-photo" src="{{item.displayPath}}" mode="aspectFill" />
          </view>
          <text class="stamp-title">{{item.spotName || item.shortAddr || '未知地点'}}</text>
        </view>
      </view>
    </block>

    <block wx:if="{{viewMode === 'map'}}">
      <view class="map-wrap">
        <map
          class="collection-map"
          latitude="{{mapCenter.lat}}"
          longitude="{{mapCenter.lng}}"
          scale="{{mapScale}}"
          markers="{{mapMarkers}}"
          bindmarkertap="onMarkerTap"
          bindtap="onMapTapBackground"
          show-location
          enable-zoom
          enable-scroll
        ></map>
      </view>
    </block>
  </view>

  <canvas
    canvas-id="mapMarkerCanvas"
    class="map-marker-canvas"
    disable-scroll
  ></canvas>

  <!-- 长按邮票操作弹窗：复用路线编辑同款底部弹窗样式 -->
  <view class="route-action-mask {{actionSheetVisible ? 'show' : ''}}" bindtap="onCloseActionSheet">
    <view class="route-action-sheet" catchtap="preventBubble">
      <view class="route-action-header">
        <text class="route-action-title">采集编辑</text>
        <i class="mgc_close_line route-action-close" bindtap="onCloseActionSheet"></i>
      </view>
      <view class="route-action-body">
        <view class="route-action-grid">
          <view
            class="route-action-card"
            bindtap="onEditCheckin"
          >
            <i class="route-action-icon mgc_pencil_3_line"></i>
            <text class="route-action-label">编辑名称</text>
          </view>
          <view
            class="route-action-card danger"
            bindtap="onDeleteCheckin"
          >
            <i class="route-action-icon mgc_delete_2_line"></i>
            <text class="route-action-label">删除采集</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 编辑名称弹窗：也复用统一的底部弹窗头部与关闭图标 -->
  <view class="route-action-mask {{editNameSheetVisible ? 'show' : ''}}" bindtap="onCloseEditNameSheet">
    <view class="route-action-sheet route-edit-name-sheet" catchtap="preventBubble">
      <view class="route-action-header">
        <text class="route-action-title">编辑名称</text>
        <i class="mgc_close_line route-action-close" bindtap="onCloseEditNameSheet"></i>
      </view>
      <view class="route-action-body">
        <input
          class="route-edit-name-input"
          value="{{editNameValue}}"
          bindinput="onEditNameInput"
          placeholder="请输入邮票名称"
          maxlength="20"
        />
        <view class="route-action-confirm" bindtap="onConfirmEditName">确认</view>
      </view>
    </view>
  </view>
</view>
