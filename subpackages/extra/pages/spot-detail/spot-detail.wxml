<view class="container" wx:if="{{spot}}">
  <!-- ── 顶部图片区 ── -->
  <view class="hero-wrap">
    <image class="hero-img" src="{{spot.coverImage}}" mode="aspectFill" />
    
    <!-- 自定义导航栏按钮 -->
    <view class="top-bar" style="top: {{menuTop}}px; height: {{menuHeight}}px;">
      <view class="icon-btn back-btn" bindtap="onBack">
        <i class="mgc_left_line back-icon"></i>
      </view>
      <!-- 视觉层继续复用圆形图标按钮，透明 button 只负责承接微信原生分享能力。 -->
      <view class="icon-btn share-btn-wrap">
        <i class="mgc_share_forward_line share-icon"></i>
        <button class="share-hit-btn" open-type="share"></button>
      </view>
    </view>

    <!-- 底部统计 & 头像 -->
    <view class="hero-stats">
      <text class="stats-text">{{wantStatText}}</text>
      <view class="avatar-group">
        <image class="avatar" wx:for="{{displayAvatars}}" wx:key="*this" src="{{item}}" mode="aspectFill" />
      </view>
    </view>
    
    <!-- 底部圆角遮罩 -->
    <view class="hero-overlay"></view>
  </view>

  <!-- ── 内容区 ── -->
  <view class="content-wrap">
    
    <!-- 基本信息 -->
    <view class="main-info">
      <view class="info-header">
        <view class="info-left">
          <view class="tags-row">
            <view class="rating-badge"><text class="rating-val">{{spot.rating || '4.6'}}</text></view>
            <view class="tag-badge"><text>{{spot.category || '历史文化'}}</text></view>
            <view class="tag-badge"><text>{{secondaryTag}}</text></view>
          </view>
          <text class="spot-title">{{spot.name}}</text>
        </view>
      </view>
      
      <text class="open-time">{{openTimeText}}</text>
      
      <view class="address-box" bindtap="onOpenNavMapSheet">
        <view class="address-content">
          <text class="address-label">地址</text>
          <!-- 页面里的地址文案改成统一兜底字段，避免部分景点没有 address 时这里只剩“地址”标题。 -->
          <text class="address-text">{{addressText || (spot.city + spot.district + spot.name)}}</text>
        </view>
        <i class="mgc_right_line arrow-icon"></i>
      </view>

      <view class="phone-row" wx:if="{{phoneText}}" bindtap="onCall">
        <text class="phone-label">联系电话</text>
        <text class="phone-text">{{phoneText}}</text>
      </view>
      
      <text class="spot-desc" wx:if="{{showDesc !== false}}">{{spot.desc}}</text>
    </view>
    
    <!-- 分割线 -->
    <view class="divider" wx:if="{{showDivider !== false}}"></view>
    
    <!-- 位置卡片 -->
    <view class="map-section">
      <text class="section-title">位置</text>
      <view class="map-card" bindtap="onNavigate">
        <map
          class="mini-map"
          latitude="{{spot.lat}}"
          longitude="{{spot.lng}}"
          scale="15"
          markers="{{mapMarkers}}"
          enable-zoom="{{false}}"
          enable-scroll="{{false}}"
          enable-rotate="{{false}}"
          enable-overlooking="{{false}}"
          bindtap="onNavigate"
        ></map>
      </view>
    </view>
    
    <!-- 附近美食 -->
    <view class="nearby-section" wx:if="{{(isFoodDetail && relatedItems.length > 0) || (!isFoodDetail && nearbyShops.length > 0)}}">
      <view class="section-header">
        <text class="section-title">{{relatedSectionTitle || '附近美食'}}</text>
        <text class="more-btn" wx:if="{{showRelatedMore !== false}}" bindtap="onFindFood">更多</text>
      </view>
      <!-- 横向列表：这里已经改成和“精选攻略”同一类滚动逻辑 -->
      <view class="nearby-scroll">
        <block wx:if="{{isFoodDetail}}">
          <!-- 美食详情页：这里显示的是推荐菜 -->
          <view
            class="dish-card"
            wx:for="{{relatedItems}}"
            wx:key="name"
          >
            <image class="nearby-img" src="{{item.coverImage}}" mode="aspectFill" />
            <view class="nearby-info">
              <text class="nearby-name">{{item.name}}</text>
            </view>
          </view>
        </block>
        <block wx:else>
          <!-- 景点详情页：这里显示的是附近美食 -->
          <view
            class="nearby-card"
            wx:for="{{nearbyShops}}"
            wx:key="id"
            bindtap="onGoShop"
            data-id="{{item.id}}"
          >
            <image class="nearby-img" src="{{item.coverImage}}" mode="aspectFill" />
            <view class="nearby-info">
              <text class="nearby-name">{{item.name}}</text>
              <text class="nearby-meta">{{item.wantCount || 4232}} 人想去 · {{item.distText}}</text>
            </view>
          </view>
        </block>
      </view>
    </view>
    
  </view>

  <!-- ── 底部操作栏 ── -->
  <view class="bottom-action-bar">
    <view class="action-bg"></view>
    <view class="action-content">
      <view class="collect-action-btn" bindtap="onCollect">
        <i class="{{isCollected ? 'mgc_star_fill collected' : 'mgc_star_line'}} collect-action-icon"></i>
      </view>
      <view class="want-btn" bindtap="onWant">
        <i class="{{isLiked ? 'mgc_heart_fill wanted' : 'mgc_heart_line'}} want-action-icon"></i>
        <text>{{isLiked ? '已添加到想去' : '添加到想去'}}</text>
      </view>
    </view>
  </view>

  <!-- 导航地图选择弹窗（公共组件） -->
  <nav-map-sheet
    visible="{{navMapSheetVisible}}"
    target="{{navMapTarget}}"
    bind:close="onCloseNavMapSheet"
  />
</view>
