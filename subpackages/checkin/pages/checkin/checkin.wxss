page {
  background: #FFFFFF;
  min-height: 100vh;
}

.page {
  min-height: 100vh;
  background: #FFFFFF;
  box-sizing: border-box;
}

.section {
  padding: 40rpx 48rpx 48rpx;
}

.guide-tip {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 32rpx;
  padding: 28rpx 32rpx;
  background: #F6F8FA;
  border-radius: 24rpx;
}

.gt-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 999rpx;
  background: #1A2739;
}

.gt-title {
  color: #1A2739;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 44rpx;
}

.gt-sub {
  color: #9DA4AD;
  font-size: 26rpx;
  line-height: 38rpx;
}

.photo-card {
  min-height: 420rpx;
  border-radius: 32rpx;
  background: #F6F8FA;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pc-empty {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 64rpx 48rpx;
  box-sizing: border-box;
}

.pce-camera {
  width: 120rpx;
  height: 120rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: inset 0 0 0 2rpx #ECEEF1;
}

.pce-camera i {
  font-size: 52rpx;
  line-height: 52rpx;
  color: #1A2739;
}

.pce-title {
  color: #1A2739;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 32rpx;
}

.pce-sub {
  color: #9DA4AD;
  font-size: 26rpx;
  line-height: 38rpx;
  text-align: center;
}

.photo-extra-row {
  display: flex;
  gap: 24rpx;
  margin-top: 32rpx;
}

.photo-extra-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 999rpx;
  background: #F2F4F7;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.photo-extra-btn.secondary {
  background: #F6F8FA;
}

.photo-extra-btn i {
  font-size: 32rpx;
  line-height: 32rpx;
  color: #1A2739;
}

.photo-extra-btn text {
  color: #1A2739;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 28rpx;
}

.confirm-section {
  padding-bottom: calc(220rpx + env(safe-area-inset-bottom));
}

.detail-stamp-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 56rpx;
}

.detail-stamp {
  position: relative;
  width: 255px;
  height: 324px;
}

.detail-stamp-shell {
  position: absolute;
  left: 0;
  top: 0;
  width: 255px;
  height: 324px;
  filter: drop-shadow(0 64px 48px rgba(0, 0, 0, 0.15));
}

.detail-stamp-photo {
  position: absolute;
  left: 24px;
  top: 24px;
  width: 207px;
  height: 276px;
  background: #FFFFFF;
}

.detail-stamp-title-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  width: 100%;
}

.detail-stamp-title {
  color: #1A2739;
  font-size: 48rpx;
  font-weight: 500;
  line-height: 64rpx;
  flex: 1;
  min-width: 0;
  text-align: center;
  word-break: break-all;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.detail-info-list {
  margin-top: 40rpx;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.info-section {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.info-section-desc {
  gap: 16rpx;
}

.info-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.info-title {
  flex-shrink: 0;
}

.info-ai-icon {
  font-size: 28rpx;
  line-height: 28rpx;
  color: #1A2739;
  flex-shrink: 0;
}

@keyframes aiPulse {
  0% {
    transform: scale(1);
    opacity: 0.65;
  }
  50% {
    transform: scale(1.12);
    opacity: 1;
  }
  100% {
    transform: scale(1);
    opacity: 0.65;
  }
}

.info-ai-icon.running {
  animation: aiPulse 1.2s ease-in-out infinite;
}

.info-title {
  color: #1A2739;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 28rpx;
}

.info-regenerate {
  margin-left: auto;
  color: #25BBE7;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 28rpx;
}

.info-refresh-address {
  margin-left: auto;
  color: #25BBE7;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 28rpx;
}

.info-regenerate.disabled {
  opacity: 0.45;
}

.info-value {
  width: 100%;
  color: #9DA4AD;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 44rpx;
}

.info-value-desc {
  white-space: pre-wrap;
}

.bottom-action-mask {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 0;
  background: transparent;
  pointer-events: none;
}

.bottom-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 30;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 16rpx;
  padding: 16rpx 48rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  box-sizing: border-box;
}

.action-btn {
  height: 96rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  display: flex;
  flex-wrap: nowrap;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  box-sizing: border-box;
}

.action-btn::after {
  border: none;
}

.action-btn text {
  font-size: 32rpx;
  font-weight: 500;
  line-height: 32rpx;
  white-space: nowrap;
}

.action-btn-light {
  width: auto;
  flex-shrink: 0;
  padding: 0 16rpx;
  background: #F2F4F7;
}

.action-btn-light text {
  color: #1A2739;
}

.action-btn-text-secondary {
  width: 188rpx !important;
  flex: 0 0 188rpx !important;
  padding: 0 16rpx;
}

.action-btn-icon {
  flex: 0 0 96rpx;
  width: 96rpx;
  padding: 0;
}

.action-btn-icon i {
  color: #1A2739;
  font-size: 40rpx;
  line-height: 40rpx;
}

/* 文字按钮内的小图标：和文案横向排布 */
.action-btn-inline-icon {
  font-size: 40rpx;
  line-height: 40rpx;
  flex-shrink: 0;
}

.action-btn-dark {
  flex: 1 1 0;
  min-width: 0;
  background: #25BBE7;
}

.action-btn-main {
  gap: 10rpx;
}

.action-btn-dark text {
  color: #FFFFFF;
}

.action-btn-light .action-btn-inline-icon {
  color: #1A2739;
}

.action-btn-dark .action-btn-inline-icon {
  color: #FFFFFF;
}

.action-btn-dark.disabled {
  opacity: 0.6;
}

