page {
  background: #FFFFFF;
}

.container {
  min-height: 100vh;
  background: #FFFFFF;
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
}

.page-content {
  padding-top: 40rpx;
  padding-left: 48rpx;
  padding-right: 48rpx;
}

.detail-stamp-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 56rpx;
}

.detail-stamp {
  position: relative;
  width: 255px;
  height: 324px;
}

.detail-stamp-shell {
  position: absolute;
  left: 0;
  top: 0;
  width: 255px;
  height: 324px;
  filter: drop-shadow(0 64px 48px rgba(0, 0, 0, 0.15));
}

.detail-stamp-photo {
  position: absolute;
  left: 24px;
  top: 24px;
  width: 207px;
  height: 276px;
  background: #FFFFFF;
}

.detail-stamp-title {
  width: 100%;
  color: #1A2739;
  font-size: 48rpx;
  font-weight: 500;
  line-height: 64rpx;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.detail-info-list {
  margin-top: 40rpx;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.info-section {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 16rpx;
}

.info-section-desc {
  gap: 16rpx;
}

.info-head {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.info-title {
  color: #1A2739;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 28rpx;
}

.info-value {
  width: 100%;
  color: #9DA4AD;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 44rpx;
}

.info-value-desc {
  line-height: 44rpx;
}

.bottom-action-mask {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 0;
  background: transparent;
  pointer-events: none;
}

.bottom-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 30;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 16rpx;
  padding: 16rpx 48rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  box-sizing: border-box;
}

.action-btn {
  height: 96rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  display: flex;
  flex-wrap: nowrap;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  box-sizing: border-box;
  border: none;
}

.action-btn::after {
  border: none;
}

.action-btn text {
  font-size: 32rpx;
  font-weight: 500;
  line-height: 32rpx;
  white-space: nowrap;
}

.action-btn-light {
  width: auto;
  flex-shrink: 0;
  background: #F2F4F7;
}

.action-btn-light text {
  color: #1A2739;
}

.action-btn-text-secondary {
  width: 188rpx;
  flex: none;
  padding: 0 16rpx;
}

.action-btn-share {
  width: 188rpx !important;
  flex: 0 0 188rpx !important;
  padding: 0 16rpx;
  gap: 8rpx;
}

.action-btn-icon {
  flex: 0 0 96rpx;
  width: 96rpx;
  padding: 0;
}

.action-btn-icon i {
  color: #1A2739;
  font-size: 40rpx;
  line-height: 40rpx;
}

/* 文字按钮内的小图标：和文案横向排布 */
.action-btn-inline-icon {
  font-size: 40rpx;
  line-height: 40rpx;
  flex-shrink: 0;
}

.action-btn-dark {
  flex: 1 1 0;
  min-width: 0;
  background: #25BBE7;
}

.action-btn-main {
  gap: 10rpx;
}

.action-btn-edit {
  flex: 1 1 0 !important;
  min-width: 0;
}

.action-btn-dark text {
  color: #FFFFFF;
}

.action-btn-light .action-btn-inline-icon {
  color: #1A2739;
}

.action-btn-dark .action-btn-inline-icon {
  color: #FFFFFF;
}

.edit-sheet-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.28);
  z-index: 49;
}

.edit-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
}

.edit-sheet-panel {
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  padding: 0;
  box-sizing: border-box;
  max-height: min(84vh, 1080rpx);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.sheet-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 128rpx;
  padding: 0 48rpx;
  box-sizing: border-box;
  flex-shrink: 0;
}

.sheet-title {
  color: #1A2739;
  font-size: 40rpx;
  font-weight: 500;
  line-height: 100%;
}

.sheet-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #1A2739;
  font-size: 48rpx;
}

.edit-sheet-content {
  padding: 0 48rpx;
  box-sizing: border-box;
  flex: 1;
  min-height: 0;
}

.edit-field {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.edit-field-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.edit-sheet-content .edit-field + .edit-field {
  margin-top: 48rpx;
}

.edit-field-label {
  color: #1A2739;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 28rpx;
}

.edit-field-action {
  color: #25BBE7;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 28rpx;
  flex-shrink: 0;
}

.edit-field-input,
.edit-field-textarea {
  width: 100%;
  padding: 0 32rpx 0;
  border-radius: 24rpx;
  border: 2rpx solid #F6F8FA;
  background: #FFFFFF;
  box-sizing: border-box;
  color: #1A2739;
  font-size: 32rpx;
  font-weight: 400;
}

.edit-field-input {
  height: 104rpx;
  padding-right: 32rpx;
}

.edit-field-textarea-desc {
  height: 240rpx;
  padding: 24rpx 32rpx 24rpx;
  line-height: 40rpx;
  display: block;
}

.edit-field-action.disabled {
  opacity: 0.45;
}


.edit-sheet-actions {
  display: flex;
  gap: 24rpx;
  padding: 40rpx 48rpx calc(40rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  box-sizing: border-box;
  flex-shrink: 0;
}

.edit-sheet-btn {
  height: 96rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.edit-sheet-btn text {
  font-size: 32rpx;
  font-weight: 500;
  line-height: 32rpx;
}

.edit-sheet-btn-light {
  width: 160rpx;
  background: #F2F4F7;
}

.edit-sheet-btn-light text {
  color: #1A2739;
}

.edit-sheet-btn-dark {
  flex: 1;
  background: #25BBE7;
}

.edit-sheet-btn-dark text {
  color: #FFFFFF;
}

.route-action-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0);
  z-index: 1004;
  pointer-events: none;
  transition: background 0.3s;
}

.route-action-mask.show {
  background: rgba(0, 0, 0, 0.4);
  pointer-events: auto;
}

.route-action-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.32, 0.72, 0, 1);
}

.route-action-mask.show .route-action-sheet {
  transform: translateY(0);
}

.route-action-header {
  height: 128rpx;
  padding: 0 48rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
}

.route-action-title {
  color: #1A2739;
  font-size: 40rpx;
  line-height: 40rpx;
  font-weight: 500;
}

.route-action-close {
  color: #1A2739;
  font-size: 40rpx;
  line-height: 40rpx;
}

.route-action-body {
  padding: 0 48rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.route-action-grid {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.route-action-card {
  width: 100%;
  min-height: 104rpx;
  border-radius: 24rpx;
  border: 2rpx solid #F6F8FA;
  background: #FFFFFF;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 0 32rpx;
  box-sizing: border-box;
}

.route-action-card.active {
  border-color: #1A2739;
}

.route-action-card.danger .route-action-icon,
.route-action-card.danger .route-action-label {
  color: #FF5A5F;
}

.route-action-card.active.danger {
  border-color: #FF5A5F;
  background: #FFF7F7;
}

.route-action-icon {
  color: #1A2739;
  font-size: 40rpx;
  line-height: 40rpx;
  flex-shrink: 0;
}

.route-action-label {
  color: #1A2739;
  font-size: 32rpx;
  line-height: 32rpx;
  font-weight: 400;
  flex: 1;
  text-align: left;
}

.route-action-confirm {
  margin-top: 48rpx;
  width: 100%;
  height: 96rpx;
  border-radius: 999rpx;
  background: #25BBE7;
  color: #FFFFFF;
  font-size: 32rpx;
  line-height: 32rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
}

.route-edit-name-sheet .route-action-body {
  padding-top: 0rpx;
}

.route-edit-name-input {
  width: 100%;
  height: 104rpx;
  padding: 0 32rpx;
  border-radius: 24rpx;
  border: 2rpx solid #F6F8FA;
  background: #FFFFFF;
  box-sizing: border-box;
  color: #1A2739;
  font-size: 32rpx;
  font-weight: 400;
}

.route-delete-confirm-sheet .route-action-body {
  padding-top: 0;
}

.route-delete-confirm-desc {
  display: block;
  color: #808B9A;
  font-size: 28rpx;
  line-height: 44rpx;
}

.route-delete-confirm-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 48rpx;
}

.route-delete-confirm-btn {
  height: 96rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 32rpx;
}

.route-delete-confirm-btn.cancel {
  width: 160rpx;
  background: #F2F4F7;
  color: #1A2739;
  flex-shrink: 0;
}

.route-delete-confirm-btn.danger {
  flex: 1;
  background: #FF5A5F;
  color: #FFFFFF;
}
