page {
  background: #FFFFFF;
}

.container {
  min-height: 100vh;
  background: #FFFFFF;
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
}

.page-content {
  padding-top: 64rpx;
  padding-left: 48rpx;
  padding-right: 48rpx;
}

.detail-stamp-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 56rpx;
}

.detail-stamp {
  position: relative;
  width: 255px;
  height: 324px;
}

.detail-stamp-shell {
  position: absolute;
  left: 0;
  top: 0;
  width: 255px;
  height: 324px;
  filter: drop-shadow(0 80px 64px rgba(0, 0, 0, 0.15));
}

.detail-stamp-photo {
  position: absolute;
  left: 24px;
  top: 24px;
  width: 207px;
  height: 276px;
  background: #FFFFFF;
}

.detail-stamp-title {
  width: 100%;
  color: #1A2739;
  font-size: 48rpx;
  font-weight: 500;
  line-height: 64rpx;
  text-align: center;
  word-break: break-all;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.detail-info-list {
  margin-top: 40rpx;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.info-section {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 16rpx;
}

.info-section-desc {
  gap: 16rpx;
}

.info-head {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.info-title {
  color: #1A2739;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 28rpx;
}

.info-value {
  width: 100%;
  color: #9DA4AD;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 44rpx;
}

.info-value-desc {
  line-height: 44rpx;
}

.bottom-action-mask {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 0;
  background: transparent;
  pointer-events: none;
}

.bottom-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 30;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 16rpx;
  padding: 16rpx 48rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  box-sizing: border-box;
}

.action-btn {
  height: 96rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  display: flex;
  flex-wrap: nowrap;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  box-sizing: border-box;
  border: none;
}

.action-btn::after {
  border: none;
}

.action-btn text {
  font-size: 32rpx;
  font-weight: 500;
  line-height: 32rpx;
  white-space: nowrap;
}

.action-btn-light {
  width: auto;
  flex-shrink: 0;
  background: #F2F4F7;
}

.action-btn-light text {
  color: #1A2739;
}

.action-btn-text-secondary {
  width: 188rpx;
  flex: none;
  padding: 0 16rpx;
}

.action-btn-share {
  width: 188rpx !important;
  flex: 0 0 188rpx !important;
  padding: 0 16rpx;
  gap: 8rpx;
}

.action-btn-icon {
  flex: 0 0 96rpx;
  width: 96rpx;
  padding: 0;
}

.action-btn-icon i {
  color: #1A2739;
  font-size: 40rpx;
  line-height: 40rpx;
}

/* 文字按钮内的小图标：和文案横向排布 */
.action-btn-inline-icon {
  font-size: 40rpx;
  line-height: 40rpx;
  flex-shrink: 0;
}

.action-btn-dark {
  flex: 1 1 0;
  min-width: 0;
  background: #25BBE7;
}

.action-btn-main {
  gap: 10rpx;
}

.action-btn-edit {
  flex: 1 1 0 !important;
  min-width: 0;
}

.action-btn-dark text {
  color: #FFFFFF;
}

.action-btn-light .action-btn-inline-icon {
  color: #1A2739;
}

.action-btn-dark .action-btn-inline-icon {
  color: #FFFFFF;
}

.route-action-grid {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.route-action-card {
  width: 100%;
  min-height: 104rpx;
  border-radius: 24rpx;
  border: 2rpx solid #F6F8FA;
  background: #FFFFFF;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 0 32rpx;
  box-sizing: border-box;
}

.route-action-card.active {
  border-color: #1A2739;
}

.route-action-card.danger .route-action-icon,
.route-action-card.danger .route-action-label {
  color: #FF5A5F;
}

.route-action-card.active.danger {
  border-color: #FF5A5F;
  background: #FFF7F7;
}

.route-action-icon {
  color: #1A2739;
  font-size: 40rpx;
  line-height: 40rpx;
  flex-shrink: 0;
}

.route-action-label {
  color: #1A2739;
  font-size: 32rpx;
  line-height: 32rpx;
  font-weight: 400;
  flex: 1;
  text-align: left;
}

.route-action-confirm {
  margin-top: 48rpx;
  width: 100%;
  height: 96rpx;
  border-radius: 999rpx;
  background: #25BBE7;
  color: #FFFFFF;
  font-size: 32rpx;
  line-height: 32rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
}

.route-edit-name-input {
  width: 100%;
  height: 104rpx;
  padding: 0 32rpx;
  border-radius: 24rpx;
  border: 2rpx solid #F6F8FA;
  background: #FFFFFF;
  box-sizing: border-box;
  color: #1A2739;
  font-size: 32rpx;
  font-weight: 400;
}

.route-delete-confirm-body {
  padding-top: 0;
}

.route-delete-confirm-desc {
  display: block;
  color: #808B9A;
  font-size: 28rpx;
  line-height: 44rpx;
}

.route-delete-confirm-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 48rpx;
}

.route-delete-confirm-btn {
  height: 96rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 32rpx;
}

.route-delete-confirm-btn.cancel {
  width: 160rpx;
  background: #F2F4F7;
  color: #1A2739;
  flex-shrink: 0;
}

.route-delete-confirm-btn.danger {
  flex: 1;
  background: #FF5A5F;
  color: #FFFFFF;
}
