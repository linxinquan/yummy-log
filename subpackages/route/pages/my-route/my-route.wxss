@import "/styles/shared-detail.wxss";

/* 隐藏模式切换时，强制不占位 */
.mode-switch[hidden] {
  display: none;
}

/* 页面头部：和正常的路线规划详情保持同一套留白与层级 */
.detail-header {
  margin: 0 48rpx 0;
}

/* 通用底部弹窗遮罩：控制背景蒙层和点击关闭区域 */
.sheet-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0);
  pointer-events: none;
  transition: background 0.3s;
  z-index: 1001;
}

.sheet-mask.show {
  background: rgba(0, 0, 0, 0.4);
  pointer-events: auto;
}

/* 导航地图弹窗要盖在地点简介上面，避免点击地址后看不到选择面板 */
.nav-map-sheet-mask {
  z-index: 1003;
}

/* 通用底部弹窗面板：默认在底部隐藏，显示时上滑出现 */
.sheet-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.32, 0.72, 0, 1);
  overflow: hidden;
  z-index: 1002;
}

.sheet-mask.show .sheet-panel {
  transform: translateY(0);
}

.nav-map-sheet-panel {
  z-index: 1004;
}

/* 弹窗头部：单独使用自己的类名，避免影响页面顶部标题区 */
.sheet-modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 128rpx;
  padding: 0 48rpx;
  box-sizing: border-box;
}

.sheet-modal-title {
  color: #242529;
  font-size: 40rpx;
  font-weight: 500;
  line-height: 100%;
}

.sheet-modal-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #242529;
  font-size: 48rpx;
}

/* 左滑删除的外层单元 */
.place-swipe-cell {
  position: relative;
  overflow: hidden;
  min-height: 160rpx;
  margin-bottom: 48rpx;
}

.place-swipe-cell.drag-active-cell {
  overflow: visible;
  z-index: 30;
}

.place-swipe-cell.drag-active-cell .place-delete-btn {
  display: none;
}

/* 地点列表区域 */
.place-list {
  margin: 0 48rpx;
}

.day-anchor {
  position: relative;
  top: -132rpx;
  height: 0;
}

/* 左滑出现的删除按钮 */
.place-delete-btn {
  position: absolute;
  top: 0;
  bottom: 0;
  right: 0;
  width: 120rpx;
  border-radius: 24rpx;
  background: #FF5A5F;
  display: flex;
  align-items: center;
  justify-content: center;
}

.place-delete-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
}

.place-delete-icon {
  font-size: 40rpx;
  line-height: 40rpx;
  color: #FFFFFF;
}

.place-delete-text {
  color: #FFFFFF;
  font-size: 24rpx;
  line-height: 24rpx;
  font-weight: 500;
}

/* 单个地点卡片 */
.place-row {
  position: relative;
  display: flex;
  align-items: center;
  gap: 24rpx; /* 12px：中间信息到右侧箭头 */
  margin: 0;
  min-height: 160rpx;
  transition: transform 0.18s ease;
  background: #FFFFFF;
  border-radius: 24rpx;
}

/* 卡片主体：左侧封面和中间信息保持 16px 间距 */
.route-place-main {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 32rpx; /* 16px：封面到中间信息 */
  min-width: 0;
}

/* 左侧封面容器：封面角标要贴在图片上 */
.route-place-cover-wrap {
  position: relative;
  width: 160rpx; /* 80px */
  height: 160rpx; /* 80px */
  flex-shrink: 0;
  border-radius: 20rpx; /* 10px */
  overflow: hidden;
  background: #F2F4F7;
}

.place-cover {
  width: 100%;
  height: 100%;
  display: block;
  border-radius: 20rpx; /* 10px */
}

/* 封面角标：和探索列表保持同一套视觉 */
.card-cat-badge {
  position: absolute;
  top: 12rpx; /* 6px */
  left: 12rpx; /* 6px */
  background: rgba(0, 0, 0, 0.1);
  border-radius: 8rpx; /* 4px */
  padding: 6rpx 8rpx; /* 3px 4px */
  color: #FFFFFF;
  font-size: 20rpx; /* 10px */
  line-height: 20rpx;
  backdrop-filter: blur(4px);
}

.place-info-row {
  flex: 1;
  min-width: 0;
  height: 160rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.place-main.route-place-content {
  flex: 1;
  min-width: 0;
  height: 144rpx; /* 72px */
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 24rpx; /* 12px：评分标签到底部交通行 */
}

.route-place-top {
  display: flex;
  flex-direction: column;
  gap: 16rpx; /* 8px：标题到评分标签 */
  min-width: 0;
}

.route-place-name {
  width: 100%;
  color: #242529;
  font-size: 32rpx; /* 16px */
  line-height: 32rpx;
  font-weight: 400;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 评分和普通标签：直接复用探索列表的结构风格 */
.route-place-tags {
  display: flex;
  align-items: center;
  gap: 16rpx; /* 8px */
  flex-wrap: nowrap;
  overflow: hidden;
  width: 100%;
}

.rating-star {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 16rpx; /* 4px 8px */
  border-radius: 12rpx; /* 6px */
  background: #FDF8E3;
  color: #EE8733;
  font-size: 24rpx; /* 12px */
  line-height: 24rpx;
  flex-shrink: 0;
}

.spot-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 16rpx; /* 4px 8px */
  border-radius: 12rpx; /* 6px */
  background: #F6F6F6;
  color: #BABABA;
  font-size: 24rpx; /* 12px */
  line-height: 24rpx;
  flex-shrink: 0;
  white-space: nowrap;
}

/* 底部交通信息：出行方式 + 中文距离时间 */
.route-place-travel-row {
  display: flex;
  align-items: center;
  gap: 24rpx; /* 12px */
  min-width: 0;
}

.route-place-travel-mode,
.route-place-travel-summary {
  display: inline-flex;
  align-items: center;
  gap: 4rpx; /* 2px */
  min-width: 0;
}

.route-place-travel-mode i,
.route-place-travel-summary i {
  flex-shrink: 0;
  font-size: 32rpx; /* 16px */
  line-height: 32rpx;
}

.route-place-travel-mode i {
  color: #A0A4AE;
}

.route-place-travel-summary i {
  color: #C7CAD1;
}

.route-place-travel-mode text {
  color: #A0A4AE;
  font-size: 24rpx; /* 12px */
  line-height: 24rpx;
  white-space: nowrap;
}

.route-place-travel-summary text {
  color: #A0A4AE;
  font-size: 24rpx; /* 12px */
  line-height: 24rpx;
  white-space: nowrap;
}

.place-handle i {
  color: #C7CAD1;
  font-size: 36rpx;
}

.place-row.dragging {
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.12);
  transition: none;
}

.place-arrow {
  width: 40rpx; /* 20px */
  height: 40rpx; /* 20px */
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.place-arrow i {
  color: #C7CAD1;
  font-size: 40rpx; /* 20px */
  line-height: 40rpx;
}

.add-place-entry {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 88rpx;
  margin-bottom: 48rpx;
  border-radius: 24rpx;
  background: #ffffff;
  color: #242529;
  font-size: 28rpx;
  border: 2rpx solid #F7F8FA;
}

.add-place-entry i {
  font-size: 32rpx;
  color: #6E727A;
}

.add-place-entry text {
  color: #6E727A;
}

.add-place-entry-empty {
  margin: 0;
}

.empty-day {
  margin: 0 48rpx 48rpx;
  padding: 0;
  background: transparent;
  border-radius: 0;
  display: block;
}

/* 空路线时的提示卡片 */
.route-empty-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  min-height: 360rpx;
  padding: 32rpx 32rpx;
  border-radius: 32rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.route-empty-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #F7F8FA;
  display: flex;
  align-items: center;
  justify-content: center;
}

.route-empty-icon i {
  color: #A0A4AE;
  font-size: 48rpx;
  line-height: 48rpx;
}

.route-empty-title {
  color: #242529;
  font-size: 32rpx;
  line-height: 32rpx;
  font-weight: 500;
}

.route-empty-hint {
  color: #6E727A;
  font-size: 26rpx;
  line-height: 38rpx;
  text-align: center;
}

.overview-empty {
  padding: 24rpx 0 8rpx;
  color: #A0A4AE;
  font-size: 26rpx;
  line-height: 38rpx;
}

.bottom-btn i {
  font-size: 40rpx;
}

/* 底部按钮区域 */
.route-bottom-bar {
  gap: 16rpx;
}

.route-icon-btn {
  width: 96rpx !important;
  flex: none !important;
  padding: 0;
}

.route-adjust-btn {
  width: 188rpx !important;
  flex: none !important;
  gap: 8rpx;
}

.route-nav-btn {
  flex: 1;
  min-width: 0;
  gap: 10rpx;
}

.top-actions-editing {
  left: 48rpx;
  right: 48rpx;
  display: flex;
  align-items: center;
}

.edit-header-title {
  display: flex;
  align-items: center;
  height: 100%;
}

.edit-header-title text {
  color: #242529;
  font-size: 40rpx;
  line-height: 40rpx;
  font-weight: 500;
}

/* 编辑路线规划底部弹窗：路线详情和规划路线详情统一 */
.reorder-sheet-mask {
  position: fixed;
  inset: 0;
  z-index: 90;
  background: rgba(0, 0, 0, 0.26);
}

.reorder-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 91;
  border-radius: 32rpx 32rpx 0 0;
  background: #FFFFFF;
  padding: 0 0 calc(24rpx + env(safe-area-inset-bottom));
}

.reorder-sheet-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 128rpx;
  padding: 0 48rpx;
  box-sizing: border-box;
}

.reorder-sheet-title {
  color: #242529;
  font-size: 40rpx;
  font-weight: 500;
  line-height: 100%;
}

.reorder-sheet-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #242529;
}

.reorder-sheet-close i {
  font-size: 48rpx;
}

.reorder-sheet-option-list {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  padding: 0 48rpx;
  box-sizing: border-box;
}

.reorder-sheet-option {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 148rpx;
  padding: 30rpx;
  background: #FFFFFF;
  border: 2rpx solid #E5E7EB;
  border-radius: 24rpx;
}

.reorder-sheet-option.active {
  border-color: #242529;
}

.reorder-option-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
  gap: 24rpx;
}

.reorder-option-icon {
  flex-shrink: 0;
  color: #242529;
  font-size: 40rpx;
  line-height: 40rpx;
}

.reorder-option-title {
  display: block;
  color: #242529;
  font-size: 32rpx;
  line-height: 32rpx;
}

.reorder-option-desc {
  display: block;
  color: #6E727A;
  font-size: 28rpx;
  line-height: 28rpx;
}


/* 返回确认弹窗：
路线详情编辑态也统一改成自定义弹窗。 */
.exit-confirm-sheet {
  border-radius: 32rpx 32rpx 0 0;
  background: #FFFFFF;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.exit-confirm-body {
  padding: 8rpx 48rpx 0;
}

.exit-confirm-desc {
  display: block;
  color: #6E727A;
  font-size: 28rpx;
  line-height: 44rpx;
}

.exit-confirm-footer {
  display: flex;
  gap: 24rpx;
  padding: 40rpx 48rpx 0;
}

.exit-confirm-btn {
  flex: 1;
  height: 96rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.exit-confirm-btn text {
  font-size: 32rpx;
  font-weight: 500;
  line-height: 32rpx;
}

.exit-confirm-btn.secondary {
  border: 2rpx solid #E5E7EB;
  background: #FFFFFF;
}

.exit-confirm-btn.secondary text {
  color: #242529;
}

.exit-confirm-btn.primary {
  background: #242529;
}

.exit-confirm-btn.primary text {
  color: #FFFFFF;
}

/* 添加地点底部弹窗 */
.place-picker-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0);
  z-index: 90;
  pointer-events: none;
  transition: background 0.3s;
}

/* 路线详情里的操作弹窗：用于选择导航地图 */
.route-action-sheet {
  z-index: 1002;
}

.route-sheet-option-list {
  padding: 0 48rpx calc(48rpx + env(safe-area-inset-bottom));
}

.route-sheet-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 104rpx;
  padding: 0 32rpx;
  border-radius: 24rpx;
  border: 2rpx solid #E5E7EB;
  background: #FFFFFF;
}

.route-sheet-option + .route-sheet-option {
  margin-top: 24rpx;
}

.route-sheet-option-main {
  display: flex;
  align-items: center;
  gap: 16rpx;
  color: #242529;
}

.route-sheet-option-main i {
  font-size: 40rpx;
  color: #242529;
}

/* 地图品牌图片：统一控制尺寸，保证两张 png 显示一致 */
.route-sheet-option-logo {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
  display: block;
}

.route-sheet-option-main text {
  font-size: 32rpx;
  line-height: 32rpx;
  color: #242529;
}

.route-sheet-option-arrow {
  font-size: 36rpx;
  color: #C7CAD1;
}

/* 地点简介底部弹窗：只保留封面和探索详情里的核心信息 */
.place-intro-sheet {
  z-index: 1002;
  max-height: 78vh;
}

.place-intro-scroll {
  max-height: calc(78vh - 128rpx);
}

.place-intro-body {
  padding: 0 48rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.place-intro-cover {
  width: 240rpx;
  height: 240rpx;
  border-radius: 24rpx;
  display: block;
}

.place-intro-tags {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 32rpx;
  flex-wrap: nowrap;
  overflow: hidden;
}

.tag-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  background: #F7F8FA;
}

.tag-badge text {
  color: #A0A4AE;
  font-size: 24rpx;
  line-height: 24rpx;
}

.place-intro-title {
  display: block;
  margin-top: 24rpx;
  color: #242529;
  font-size: 48rpx;
  line-height: 64rpx;
  font-weight: 500;
}

.place-intro-open-time {
  display: block;
  margin-top: 24rpx;
  color: #A0A4AE;
  font-size: 24rpx;
  line-height: 24rpx;
}

.place-intro-address-box {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx 32rpx;
  margin-top: 48rpx;
  border: 2rpx solid #E5E7EB;
  border-radius: 24rpx;
  box-sizing: border-box;
}

.place-intro-address-content {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.place-intro-address-label {
  color: #A0A4AE;
  font-size: 24rpx;
  line-height: 24rpx;
}

.place-intro-address-text {
  color: #242529;
  font-size: 28rpx;
  line-height: 40rpx;
  font-weight: 500;
}

.place-intro-address-icon {
  font-size: 40rpx;
  color: #C7CAD1;
}

.place-intro-desc {
  display: block;
  margin-top: 32rpx;
  color: #242529;
  font-size: 32rpx;
  line-height: 48rpx;
}

.place-picker-mask.show {
  background: rgba(0, 0, 0, 0.4);
  pointer-events: auto;
}

.place-picker-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 78vh;
  background: #FFFFFF;
  border-radius: 48rpx 48rpx 0 0;
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.32, 0.72, 0, 1);
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.place-picker-mask.show .place-picker-panel {
  transform: translateY(0);
}

.picker-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 128rpx;
  padding: 0 48rpx;
  box-sizing: border-box;
}

.picker-title {
  color: #242529;
  font-size: 40rpx;
  font-weight: 500;
  line-height: 40rpx;
}

.picker-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #242529;
  font-size: 48rpx;
}

.picker-body {
  padding: 0;
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
}

.picker-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 0 48rpx 48rpx;
}

.picker-tabs {
  display: flex;
  align-items: center;
  gap: 24rpx;
  flex: 1;
  min-width: 0;
}

.picker-tab {
  min-width: 104rpx;        /* 标签最小宽度 */
  height: 60rpx;            /* 标签固定高度 */
  padding: 0 24rpx;         /* 左右内边距，上下无内边距 */
  border-radius: 999rpx;    /* 超大圆角，做成胶囊样式 */
  background: #F7F8FA;      /* 浅灰色背景色 */
  color: #A0A4AE;           /* 默认文字浅灰色 */
  font-size: 24rpx;         /* 文字字号大小 */
  line-height: 60rpx;       /* 行高等同高度，文字垂直居中 */
  text-align: center;       /* 文字水平居中 */
  font-weight: 400;         /* 常规字体粗细，不加粗 */
  box-sizing: border-box;   /* 内边距圆角不撑开元素尺寸 */
  flex-shrink: 0;           /* 弹性布局禁止标签被压缩缩小 */
}

.picker-tab.active {
  background: #242529;
  color: #FFFFFF;
  font-weight: 400;
}

.picker-map-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  height: 64rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: #242529;
  color: #FFFFFF;
  flex-shrink: 0;
}

.picker-map-btn i {
  font-size: 32rpx;
  color: #FFFFFF;
}

.picker-map-btn text {
  color: #FFFFFF;
  font-size: 28rpx;
  line-height: 28rpx;
  font-weight: 400;
}

.place-picker-scroll {
  flex: 1;
  min-height: 0;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.picker-place-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 0 48rpx;
  margin-bottom: 48rpx;
  min-height: 160rpx;
  box-sizing: border-box;
  background: #FFFFFF;
}

/* 添加地点卡片主体：和详情页地点列表保持同样的封面 + 内容结构 */
.picker-route-place-main {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 32rpx;
  min-width: 0;
}

.picker-route-place-cover-wrap {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background: #F2F4F7;
  flex-shrink: 0;
}

.picker-place-tag {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  padding: 6rpx 8rpx;
  border-radius: 8rpx;
  background: rgba(0, 0, 0, 0.1);
  color: #FFFFFF;
  font-size: 20rpx;
  line-height: 20rpx;
  backdrop-filter: blur(4px);
}

.picker-place-image {
  width: 100%;
  height: 100%;
  display: block;
}

.picker-route-place-info-row {
  flex: 1;
  min-width: 0;
  height: 160rpx;
  display: flex;
  align-items: center;
}

.picker-route-place-content {
  flex: 1;
  min-width: 0;
  height: 144rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 24rpx;
}

.picker-route-place-top {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  min-width: 0;
}

.picker-place-name {
  color: #242529;
  font-size: 32rpx;
  line-height: 32rpx;
  font-weight: 400;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  width: 100%;
}

.picker-place-rating {
  display: flex;
  align-items: center;
  gap: 16rpx;
  width: 100%;
  overflow: hidden;
  flex-wrap: nowrap;
}

.picker-rating-star {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: #FDF8E3;
  border-radius: 12rpx;
  padding: 8rpx 16rpx;
  font-size: 24rpx;
  color: #EE8733;
  line-height: 24rpx;
  flex-shrink: 0;
}

.picker-place-chip {
  background: #F7F8FA;
  border-radius: 12rpx;
  padding: 8rpx 16rpx;
  font-size: 24rpx;
  color: #A0A4AE;
  line-height: 24rpx;
  flex-shrink: 0;
  white-space: nowrap;
}

.picker-place-footer {
  display: flex;
  align-items: center;
  width: 100%;
}

.picker-place-meta {
  color: #A0A4AE;
  font-size: 24rpx;
  line-height: 24rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  width: 100%;
}

.picker-place-add-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.picker-place-add-btn i {
  font-size: 40rpx;
  color: #242529;
}

.picker-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 240rpx;
  color: #6E727A;
  font-size: 26rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.map-panel {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  bottom: 48rpx;
  z-index: 20;
}

.map-card {
  border-radius: 32rpx;
  background: #FFFFFF;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.05);
}

/* 地图空状态卡片：
和正常地图悬浮卡片保持同一块白色容器，只是内容改成空状态提示。 */
.map-empty-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  padding: 40rpx 32rpx;
  min-height: 320rpx;
  box-sizing: border-box;
}

.map-empty-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #F7F8FA;
  display: flex;
  align-items: center;
  justify-content: center;
}

.map-empty-icon i {
  color: #A0A4AE;
  font-size: 48rpx;
  line-height: 48rpx;
}

.map-empty-title {
  color: #242529;
  font-size: 32rpx;
  line-height: 32rpx;
  font-weight: 500;
}

.map-empty-hint {
  color: #6E727A;
  font-size: 26rpx;
  line-height: 38rpx;
  text-align: center;
}

.route-map-preview-card {
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  padding: 32rpx;
  min-height: 520rpx;
}

.preview-tabs-panel {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  width: 100%;
}

.preview-tab-scroll {
  width: 100%;
}

.preview-tab-row {
  display: inline-flex;
  align-items: center;
  gap: 32rpx;
  min-width: 100%;
  white-space: nowrap;
}

.preview-tab-item {
  flex-shrink: 0;
  color: #A0A4AE;
  font-size: 28rpx;
  line-height: 28rpx;
  font-weight: 500;
}

.preview-tab-item.active {
  color: #242529;
}

.preview-tab-divider {
  width: 100%;
  height: 2rpx;
  background: #F2F4F7;
}

.preview-card-stage {
  width: 100%;
}

.preview-detail-card {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  width: 100%;
}

.preview-side-inner {
  display: flex;
  flex-direction: column;
  gap: 40rpx;
  width: 100%;
}

.preview-card-head {
  display: flex;
  align-items: center;
  gap: 32rpx;
  width: 100%;
  min-width: 0;
}

.preview-cover-image {
  width: 128rpx;
  height: 128rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}

.preview-head-main {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 24rpx;
}

.preview-name {
  display: block;
  width: 100%;
  min-width: 0;
  max-width: 100%;
  color: #242529;
  font-size: 36rpx;
  line-height: 36rpx;
  font-weight: 400;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.preview-meta-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  width: 100%;
  min-width: 0;
  overflow: hidden;
}

.preview-chip {
  flex-shrink: 0;
  max-width: 160rpx;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  background: #F7F8FA;
  color: #A0A4AE;
  font-size: 22rpx;
  line-height: 22rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.preview-chip.score {
  background: #FDF8E3;
  color: #ee8733;
}

.preview-desc-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  width: 100%;
}

.preview-desc-left,
.preview-desc-right {
  min-width: 0;
  color: #6E727A;
  font-size: 24rpx;
  line-height: 24rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.preview-desc-left {
  flex: 1;
}

.preview-desc-right {
  flex-shrink: 0;
  max-width: 180rpx;
  text-align: right;
}

.preview-footer {
  display: grid;
  grid-template-columns: minmax(72rpx, auto) minmax(0, 1fr) minmax(72rpx, auto);
  align-items: center;
  column-gap: 16rpx;
  width: 100%;
  height: 32rpx;
  min-height: 32rpx;
}

.preview-footer-side {
  min-width: 72rpx;
  height: 32rpx;
  color: #6E727A;
  font-size: 24rpx;
  line-height: 24rpx;
  display: flex;
  align-items: center;
  justify-self: start;
  text-align: left;
}

.preview-footer travel-meta-line {
  height: 32rpx;
  display: flex;
  align-items: center;
  justify-self: center;
  min-width: 0;
  max-width: 100%;
}

.preview-footer-side.right {
  justify-content: flex-end;
  justify-self: end;
  text-align: right;
}
