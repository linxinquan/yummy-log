/* 页面整体容器 */
.page {
  min-height: 100vh;
  background: #FFFFFF;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* 顶部标题区域 */
.header {
  padding: 48rpx;
  background: #FFFFFF;
}

.district-title {
  font-family: 'PingFang SC';
  font-style: normal;
  font-weight: 500;
  font-size: 48rpx;
  line-height: 100%;
  color: #1A2739;
}

/* 基础信息表单区域 */
.settings-panel {
  display: flex;
  flex-direction: column;
  gap: 64rpx;
  padding: 0 48rpx;
}

.setting-block {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.field-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.setting-label {
  color: #808B9A;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 28rpx;
}

.field-count {
  color: #808B9A;
  font-size: 24rpx;
  line-height: 24rpx;
}

/* 通用输入框 / 选择框 */
.setting-field {
  height: 96rpx;
border-radius: 24rpx;
background: #ffffff;
padding: 0 32rpx;
display: flex;
align-items: center;
justify-content: space-between;
box-sizing: border-box;
border: 2rpx solid #F6F8FA;
}

.input-field {
  display: block;
  width: 100%;
}

.setting-value,
.input-field {
  color: #1A2739;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 32rpx;
}

.setting-value.placeholder {
  color: #9DA4AD;
}

.picker-field i {
  font-size: 40rpx;
  color: #808B9A;
}

.cover-row {
  display: flex;
  align-items: center;
  gap: 32rpx;
}

.cover-preview,
.cover-upload {
  width: 128rpx;
  height: 128rpx;
  border-radius: 16rpx;
}

.cover-preview {
  background: #f2f2f2;
}

.cover-upload {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F6F8FA;
}

.cover-upload i {
  font-size: 48rpx;
  color: #808B9A;
}

/* 底部固定按钮区 */
.bottom-bar {
  position: fixed;
  left: 48rpx;
  right: 48rpx;
  bottom: 0;
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 16rpx 0 calc(24rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  box-sizing: border-box;
}

.icon-btn,
.bottom-btn {
  height: 96rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 500;
}

.icon-btn {
  width: 96rpx;
  flex-shrink: 0;
}

.delete-btn {
  background: rgba(255, 90, 95, 0.08);
  color: #FF5A5F;
}

.delete-btn i {
  font-size: 40rpx;
}

.bottom-btn.secondary {
  flex: 1;
  background: #F2F4F7;
  color: #1A2739;
}

.bottom-btn.primary {
  flex: 1;
  background: #25BBE7;
  color: #FFFFFF;
}

/* 城市选择和底部弹窗的遮罩层 */
.location-picker-mask,
.sheet-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0);
  pointer-events: none;
  transition: background 0.3s;
}

.location-picker-mask {
  z-index: 1000;
}

.sheet-mask {
  z-index: 1001;
}

.location-picker-mask.show,
.sheet-mask.show {
  background: rgba(0, 0, 0, 0.4);
  pointer-events: auto;
}

/* 城市选择面板 / 通用底部弹窗面板 */
.location-picker-panel,
.sheet-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.32, 0.72, 0, 1);
  overflow: hidden;
}

.location-picker-panel {
  max-height: 78vh;
}

.sheet-panel {
  z-index: 1002;
}

.location-picker-mask.show .location-picker-panel,
.sheet-mask.show .sheet-panel {
  transform: translateY(0);
}

.picker-header,
.sheet-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 128rpx;
  padding: 0 48rpx;
  box-sizing: border-box;
}

.picker-title,
.sheet-title {
  color: #1A2739;
  font-size: 40rpx;
  font-weight: 500;
  line-height: 100%;
}

.picker-close,
.sheet-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #1A2739;
  font-size: 48rpx;
}

.picker-content {
  padding: 0 48rpx calc(48rpx + env(safe-area-inset-bottom));
  height: 960rpx;
  box-sizing: border-box;
}

.city-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 24rpx;
}

.city-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 24rpx;
  width: 100%;
  min-width: 0;
  min-height: 160rpx;
  padding: 32rpx;
  border-radius: 32rpx;
  background: #F6F8FA;
  box-sizing: border-box;
}

.city-cover-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  overflow: hidden;
  flex-shrink: 0;
}

.city-cover {
  width: 100%;
  height: 100%;
  display: block;
}

.city-card-content {
  /* 右侧文案区域允许自适应收缩，避免不同城市名把卡片撑坏 */
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: flex-start;
  gap: 24rpx;
}

.city-card-name {
  color: #1A2739;
  font-size: 32rpx;
  font-weight: 400;
  line-height: 32rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.city-card-meta {
  color: #808B9A;
  font-size: 24rpx;
  line-height: 24rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.sheet-body {
  padding: 0 48rpx calc(48rpx + env(safe-area-inset-bottom));
}

/* 旅行天数滚轮 */
.day-picker-view {
  width: 100%;
  height: 360rpx;
}

.day-picker-item {
  height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #1A2739;
  font-size: 48rpx;
  line-height: 48rpx;
}

.sheet-confirm {
  height: 96rpx;
  border-radius: 999rpx;
  margin-top: 32rpx;
  background: #25BBE7;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 32rpx;
  line-height: 32rpx;
  font-weight: 500;
}

.delete-confirm-sheet .sheet-body {
  padding-top: 0;
}

.delete-confirm-desc {
  display: block;
  color: #808B9A;
  font-size: 28rpx;
  line-height: 44rpx;
}

.delete-confirm-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 48rpx;
}

.delete-confirm-btn {
  height: 96rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 32rpx;
}

.delete-confirm-btn.cancel {
  width: 160rpx;
  background: #F2F4F7;
  color: #1A2739;
  flex-shrink: 0;
}

.delete-confirm-btn.danger {
  flex: 1;
  background: #FF5A5F;
  color: #FFFFFF;
}

/* 交通偏好卡片宫格 */
.transport-option-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx;
}

.transport-group {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.transport-group + .transport-group {
  margin-top: 48rpx;
}

.transport-group-title {
  color: #808B9A;
  font-size: 28rpx;
  line-height: 28rpx;
  margin-top: 24rpx;
}

.transport-option-card {
  box-sizing: border-box;
  height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  background: #FFFFFF;
  border: 2rpx solid #F6F8FA;
  border-radius: 24rpx;
}

.transport-option-card.active {
  border-color: #1A2739;
}

.transport-option-icon {
  flex-shrink: 0;
  color: #1A2739;
  font-size: 40rpx;
  line-height: 40rpx;
}

.transport-option-label {
  color: #1A2739;
  font-size: 32rpx;
  line-height: 32rpx;
}
