@import "/styles/shared-detail.wxss";

/* 路线规划页根容器 */
page {
  background: #FFFFFF;
}

/* 调整每天标题区域布局：标题和起点按钮分两行 */
.day-header {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  margin: 0 48rpx 48rpx;
}

.day-header-main {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.day-start-container {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 8rpx;
}

.day-start-label {
  font-size: 24rpx;
  color: #6E727A;
  line-height: 24rpx;
}

.day-start-point {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  background: #F7F8FA;
  font-size: 24rpx;
  color: #6E727A;
  line-height: 24rpx;
}

.day-start-point i {
  font-size: 28rpx;
  color: #A0A4AE;
}

.day-start-current {
  background: #E8F5E9;
  color: #2E7D32;
}

.day-start-current i {
  color: #2E7D32;
}

/* 页面整体容器 */
.page {
  position: relative;
  height: 100vh;
  background: #FFFFFF;
  overflow: hidden;
}

/* 顶部地图 / 头图区域 */
.hero-wrap {
  position: relative;
  width: 100%;
  height: 780rpx;
  overflow: hidden;
}

.hero-wrap-map {
  height: 100vh;
}

.hero-map {
  width: 100%;
  height: 100%;
}

.hero-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 220rpx;
  background: linear-gradient(180deg, rgba(255,255,255,0) 0%, rgba(255,255,255,0.9) 62%, #FFFFFF 100%);
  pointer-events: none;
}

/* 返回确认弹窗：
使用自定义底部弹窗，保留完整按钮文案。 */
.exit-confirm-sheet {
  border-radius: 32rpx 32rpx 0 0;
  background: #FFFFFF;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.exit-confirm-body {
  padding: 8rpx 48rpx 0;
}

.exit-confirm-desc {
  display: block;
  color: #6E727A;
  font-size: 28rpx;
  line-height: 44rpx;
}

.exit-confirm-footer {
  display: flex;
  gap: 24rpx;
  padding: 40rpx 48rpx 0;
}

.exit-confirm-btn {
  flex: 1;
  height: 96rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.exit-confirm-btn text {
  font-size: 32rpx;
  font-weight: 500;
  line-height: 32rpx;
}

.exit-confirm-btn.secondary {
  border: 2rpx solid #E5E7EB;
  background: #FFFFFF;
}

.exit-confirm-btn.secondary text {
  color: #242529;
}

.exit-confirm-btn.primary {
  background: #242529;
}

.exit-confirm-btn.primary text {
  color: #FFFFFF;
}

/* 列表模式的白色内容面板 */
.detail-sheet {
  position: fixed;
  left: 0;
  right: 0;
  top: 248rpx;
  bottom: 0;
  z-index: 15;
  border-radius: 48rpx 48rpx 0 0;
  background: #FFFFFF;
  overflow: hidden;
}

.detail-scroll {
  height: 100%;
}

.sheet-header,
.section-card,
.empty-card {
  margin: 0 48rpx 0;
}

.plain-section {
  margin: 0 48rpx 32rpx;
}

.section-card,
.empty-card,
.nav-card {
  background: #FFFFFF;
  border: 1rpx solid #E5E7EB;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.05);
}

.section-card {
  padding: 28rpx;
}

.empty-day {
  margin: 0 48rpx;
  padding-bottom: 48rpx;
  color: #A0A4AE;
  font-size: 24rpx;
  line-height: 24rpx;
}

.section-head {
  margin-bottom: 24rpx;
}

.section-title {
  display: block;
  color: #242529;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 32rpx;
}

.section-sub,
.candidate-sub {
  display: block;
  margin-top: 12rpx;
  color: #6E727A;
  font-size: 22rpx;
  line-height: 22rpx;
}

/* 候选地点卡片：自定义规划时使用 */
.candidate-card {
  padding-bottom: 8rpx;
}

.edit-bottom-bar {
  gap: 24rpx;
}

.candidate-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.select-all-pill {
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: #EAF7FF;
  color: #47BFFE;
  font-size: 22rpx;
  line-height: 22rpx;
}

.candidate-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 0;
}

.candidate-item + .candidate-item {
  border-top: 1rpx solid #EEF0F3;
}

.candidate-item.selected {
  background: transparent;
}

.candidate-check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid #E5E7EB;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  color: transparent;
}

.candidate-check.on {
  background: #47BFFE;
  border-color: #47BFFE;
  color: #FFFFFF;
}

.candidate-check i {
  font-size: 24rpx;
}

.candidate-cover {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}

.candidate-main {
  flex: 1;
  min-width: 0;
}

.candidate-name {
  display: block;
  color: #242529;
  font-size: 28rpx;
  line-height: 28rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.candidate-meta {
  display: block;
  margin-top: 10rpx;
  color: #6E727A;
  font-size: 22rpx;
  line-height: 22rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.candidate-order {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #F2F4F7;
  color: #A0A4AE;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  flex-shrink: 0;
  opacity: 0;
}

.candidate-order.show {
  opacity: 1;
  background: #47BFFE;
  color: #FFFFFF;
}

.route-list-header {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  margin-bottom: 24rpx;
}

.edit-pill {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: #EAF7FF;
  color: #47BFFE;
  font-size: 22rpx;
  line-height: 22rpx;
}

.edit-pill i {
  font-size: 24rpx;
}

.route-place-row {
  display: block;
}

.route-place-row.editing .route-place-card {
  opacity: 0.96;
}

.route-place-card {
  display: flex;
  align-items: center;
  gap: 32rpx;
  padding-bottom: 64rpx;
  border-bottom: 1rpx solid #EEF0F3;
}

.route-cover-wrap {
  position: relative;
  width: 128rpx;
  height: 128rpx;
  flex-shrink: 0;
}

.route-cover-shadow {
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  width: 112rpx;
  height: 112rpx;
  border-radius: 20rpx;
  background: rgba(0, 0, 0, 0.04);
  transform: rotate(-8deg);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
}

.route-cover {
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  width: 112rpx;
  height: 112rpx;
  border-radius: 20rpx;
  border: 2rpx solid #FFFFFF;
  transform: rotate(-8deg);
}

/* 路线规划页会覆盖 guide-detail 的同名类，所以这里同步成新版卡片样式 */
.route-place-main {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 32rpx; /* 16px：封面到中间信息 */
  min-width: 0;
}

.route-place-cover-wrap {
  position: relative;
  width: 160rpx; /* 80px */
  height: 160rpx; /* 80px */
  flex-shrink: 0;
  border-radius: 20rpx; /* 10px */
  overflow: hidden;
  background: #F2F4F7;
}

.card-cat-badge {
  position: absolute;
  top: 12rpx; /* 6px */
  left: 12rpx; /* 6px */
  background: rgba(0, 0, 0, 0.1);
  border-radius: 8rpx; /* 4px */
  padding: 6rpx 8rpx; /* 3px 4px */
  color: #FFFFFF;
  font-size: 20rpx; /* 10px */
  line-height: 20rpx;
  backdrop-filter: blur(4px);
}

.place-main.route-place-content {
  flex: 1;
  min-width: 0;
  height: 144rpx; /* 72px */
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 24rpx; /* 12px：评分标签到底部交通行 */
}

.route-place-top {
  display: flex;
  flex-direction: column;
  gap: 16rpx; /* 8px：标题到评分标签 */
  min-width: 0;
}

.route-place-name,
.nav-destination-name {
  width: 100%;
  color: #242529;
  font-size: 32rpx;
  line-height: 32rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.route-place-tags {
  display: flex;
  align-items: center;
  gap: 16rpx; /* 8px */
  flex-wrap: nowrap;
  overflow: hidden;
  width: 100%;
}

.rating-star {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  background: #FDF8E3;
  color: #EE8733;
  font-size: 24rpx;
  line-height: 24rpx;
  flex-shrink: 0;
}

.spot-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  background: #F6F6F6;
  color: #BABABA;
  font-size: 24rpx;
  line-height: 24rpx;
  flex-shrink: 0;
  white-space: nowrap;
}

.route-place-travel-row {
  display: flex;
  align-items: center;
  gap: 24rpx; /* 12px */
  min-width: 0;
}

.route-place-travel-mode,
.route-place-travel-summary {
  display: inline-flex;
  align-items: center;
  gap: 4rpx; /* 2px */
  min-width: 0;
}

.route-place-travel-mode i,
.route-place-travel-summary i {
  flex-shrink: 0;
  font-size: 32rpx; /* 16px */
  line-height: 32rpx;
}

.route-place-travel-mode i {
  color: #A0A4AE;
}

.route-place-travel-summary i {
  color: #C7CAD1;
}

.route-place-travel-mode text,
.route-place-travel-summary text,
.nav-destination-meta {
  color: #A0A4AE;
  font-size: 24rpx;
  line-height: 24rpx;
  white-space: nowrap;
}

.route-place-actions,
.route-sort-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  flex-shrink: 0;
}

.route-action-btn,
.sort-action {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.route-action-btn i,
.sort-action i {
  font-size: 28rpx;
}

.route-action-btn.nav {
  background: #EAF7FF;
  color: #47BFFE;
}

.route-action-btn.del {
  background: #FFFFFF1f0;
  color: #ff4d4f;
}

.sort-action {
  background: #F7F8FA;
  color: #6E727A;
}

.sort-action.off {
  opacity: 0.3;
  pointer-events: none;
}

.reorder-sheet-mask {
  position: fixed;
  inset: 0;
  z-index: 70;
  background: rgba(0, 0, 0, 0.26);
}

.reorder-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 71;
  border-radius: 32rpx 32rpx 0 0;
  background: #FFFFFF;
  padding: 0 0 calc(24rpx + env(safe-area-inset-bottom));
}

.reorder-sheet-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 128rpx;
  padding: 0 48rpx;
  box-sizing: border-box;
}

.reorder-sheet-title {
  color: #242529;
  font-size: 40rpx;
  font-weight: 500;
  line-height: 100%;
}

.reorder-sheet-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #242529;
}

.reorder-sheet-close i {
  font-size: 48rpx;
}

.reorder-sheet-option-list {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  padding: 0 48rpx;
  box-sizing: border-box;
}

.reorder-sheet-option {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 148rpx;
  padding: 30rpx;
  background: #FFFFFF;
  border: 2rpx solid #E5E7EB;
  border-radius: 24rpx;
}

.reorder-sheet-option.active {
  border-color: #242529;
}

.reorder-option-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
  gap: 24rpx;
}

.reorder-option-icon {
  flex-shrink: 0;
  color: #242529;
  font-size: 40rpx;
  line-height: 40rpx;
}

.reorder-option-title {
  display: block;
  color: #242529;
  font-size: 32rpx;
  line-height: 32rpx;
}

.reorder-option-desc {
  display: block;
  color: #6E727A;
  font-size: 28rpx;
  line-height: 28rpx;
}

.reorder-sheet-footer {
  padding: 48rpx 48rpx 0;
}

.reorder-confirm-btn {
  height: 96rpx;
  border-radius: 999rpx;
  background: #242529;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
}

.reorder-confirm-btn text {
  font-size: 32rpx;
  font-weight: 500;
  line-height: 32rpx;
}

.empty-card {
  padding: 56rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.empty-card i {
  color: #A0A4AE;
  font-size: 72rpx;
}

.empty-title {
  margin-top: 20rpx;
  color: #242529;
  font-size: 30rpx;
  line-height: 42rpx;
}

.empty-sub {
  margin-top: 12rpx;
  color: #6E727A;
  font-size: 24rpx;
  line-height: 36rpx;
}

.empty-action {
  margin-top: 28rpx;
  min-width: 200rpx;
  height: 80rpx;
  padding: 0 32rpx;
  border-radius: 999rpx;
  background: #47BFFE;
  color: #FFFFFF;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  z-index: 40;
  gap: 16rpx;
  padding: 16rpx 48rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  box-sizing: border-box;
}

.bottom-btn {
  min-width: 0;
  height: 96rpx;
  border-radius: 999rpx;
  display: flex;
  flex-wrap: nowrap;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 0 16rpx;
  box-sizing: border-box;
}

.bottom-btn.secondary {
  width: auto;
  flex-shrink: 0;
  background: #F2F4F7;
  color: #242529;
}

.bottom-btn.primary {
  flex: 1;
  min-width: 0;
  background: #242529;
  color: #FFFFFF;
}

.view-btn {
  min-width: 0;
}

.route-preview-bar {
  justify-content: flex-start;
  gap: 12rpx;
}

.route-preview-bar .route-edit-meta-btn {
  width: 96rpx;
  flex: 0 0 96rpx;
  padding: 0;
}

.route-preview-bar .reorder-btn {
  flex: 1 1 0;
  padding: 0 16rpx;
}

.route-preview-bar .route-view-btn {
  flex: 1 1 0;
  padding: 0 16rpx;
}

.route-preview-bar .route-save-btn {
  flex: 1 1 0;
  background: #242529;
}

.route-preview-bar .bottom-btn text {
  font-size: 28rpx;
}

.bottom-btn i {
  font-size: 40rpx;
  flex-shrink: 0;
}

.bottom-btn text {
  font-size: 32rpx;
  font-weight: 500;
  white-space: nowrap;
  flex-shrink: 0;
}

.nav-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 40;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: calc(16rpx + env(safe-area-inset-top)) 48rpx 0;
}

.nav-progress {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.progress-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.35);
}

.progress-dot.done {
  background: #47BFFE;
}

.progress-dot.active {
  background: #FFFFFF;
  transform: scale(1.5);
}

.remaining-text {
  margin-left: 12rpx;
  color: #FFFFFF;
  font-size: 24rpx;
}

.nav-close-btn {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.4);
  color: #FFFFFF;
  font-size: 24rpx;
}

.nav-complete {
  position: fixed;
  inset: 0;
  z-index: 80;
  background: #FFFFFF;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.complete-icon {
  font-size: 140rpx;
  color: #47BFFE;
}

.complete-title {
  margin-top: 24rpx;
  color: #242529;
  font-size: 40rpx;
  font-weight: 500;
}

.complete-sub {
  margin-top: 16rpx;
  color: #6E727A;
  font-size: 26rpx;
}

.complete-btn {
  margin-top: 40rpx;
  min-width: 240rpx;
  height: 88rpx;
  padding: 0 32rpx;
  border-radius: 999rpx;
  background: #f5fbff;
  color: #47BFFE;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  border: 2rpx solid rgba(71, 191, 254, 0.18);
}

/* 导览模式下方的主信息卡片 */
.nav-card {
  position: fixed;
  left: 48rpx;
  right: 48rpx;
  bottom: calc(32rpx + env(safe-area-inset-bottom));
  z-index: 60;
  padding: 28rpx;
}

.nav-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.nav-card-title {
  display: block;
  color: #242529;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 32rpx;
}

.nav-card-sub,
.nav-card-remain {
  color: #6E727A;
  font-size: 22rpx;
  line-height: 22rpx;
}

.nav-card-sub {
  display: block;
  margin-top: 10rpx;
}

.nav-destination {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.nav-cover-wrap {
  position: relative;
  width: 128rpx;
  height: 128rpx;
  flex-shrink: 0;
}

.nav-cover-shadow {
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  width: 112rpx;
  height: 112rpx;
  border-radius: 20rpx;
  background: rgba(0, 0, 0, 0.04);
  transform: rotate(-8deg);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
}

.nav-cover {
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  width: 112rpx;
  height: 112rpx;
  border-radius: 20rpx;
  border: 2rpx solid #FFFFFF;
  transform: rotate(-8deg);
}

.nav-destination-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.nav-btns-row {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.nav-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  font-size: 28rpx;
}

.nav-btn.secondary {
  background: #F7F8FA;
  color: #242529;
}

.nav-btn.primary {
  background: #47BFFE;
  color: #FFFFFF;
}

.nav-btn i {
  font-size: 32rpx;
}

.map-panel {
  position: fixed;
  left: 48rpx;
  right: 48rpx;
  bottom: 48rpx;
  z-index: 20;
}

.map-card {
  border-radius: 32rpx;
  background: #FFFFFF;
}

.route-map-preview-card {
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  padding: 32rpx;
  min-height: 520rpx;
}

.preview-tabs-panel {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  width: 100%;
}

.preview-tab-scroll {
  width: 100%;
}

.preview-tab-row {
  display: inline-flex;
  align-items: center;
  gap: 32rpx;
  min-width: 100%;
  white-space: nowrap;
}

.preview-tab-item {
  flex-shrink: 0;
  color: #A0A4AE;
  font-size: 28rpx;
  line-height: 28rpx;
  font-weight: 500;
}

.preview-tab-item.active {
  color: #242529;
}

.preview-tab-divider {
  width: 100%;
  height: 2rpx;
  background: #F2F4F7;
}

.preview-card-stage {
  width: 100%;
}

.preview-detail-card {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  width: 100%;
}

.preview-side-inner {
  display: flex;
  flex-direction: column;
  gap: 40rpx;
  width: 100%;
}

.preview-card-head {
  display: flex;
  align-items: center;
  gap: 32rpx;
  width: 100%;
  min-width: 0;
}

.preview-cover-image {
  width: 128rpx;
  height: 128rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}

.preview-head-main {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 24rpx;
}

.preview-name {
  display: block;
  width: 100%;
  min-width: 0;
  max-width: 100%;
  color: #242529;
  font-size: 36rpx;
  line-height: 36rpx;
  font-weight: 400;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.preview-meta-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  width: 100%;
  min-width: 0;
  overflow: hidden;
}

.preview-chip {
  flex-shrink: 0;
  max-width: 160rpx;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  background: #F7F8FA;
  color: #A0A4AE;
  font-size: 22rpx;
  line-height: 22rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.preview-chip.score {
  background: #FDF8E3;
  color: #ee8733;
}

.preview-desc-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  width: 100%;
}

.preview-desc-left,
.preview-desc-right {
  min-width: 0;
  color: #6E727A;
  font-size: 24rpx;
  line-height: 24rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.preview-desc-left {
  flex: 1;
}

.preview-desc-right {
  flex-shrink: 0;
  max-width: 180rpx;
  text-align: right;
}

.preview-footer {
  display: grid;
  grid-template-columns: minmax(72rpx, auto) minmax(0, 1fr) minmax(72rpx, auto);
  align-items: center;
  column-gap: 16rpx;
  width: 100%;
  height: 32rpx;
  min-height: 32rpx;
}

.preview-footer-side {
  min-width: 72rpx;
  height: 32rpx;
  color: #6E727A;
  font-size: 24rpx;
  line-height: 24rpx;
  display: flex;
  align-items: center;
  justify-self: start;
  text-align: left;
}

.preview-footer travel-meta-line {
  height: 32rpx;
  display: flex;
  align-items: center;
  justify-self: center;
  min-width: 0;
  max-width: 100%;
}

.preview-footer-side.right {
  justify-content: flex-end;
  justify-self: end;
  text-align: right;
}
