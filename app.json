{
  "pages": [
    "pages/index/index",
    "pages/wantgo/wantgo",
    "pages/discover/discover",
    "pages/route-entry/route-entry",
    "pages/my/my"
  ],
  "subpackages": [
    {
      "root": "subpackages/guide",
      "name": "guide",
      "pages": [
        "pages/district-guide/district-guide",
        "pages/guide-detail/guide-detail",
        "pages/my-guides/my-guides"
      ]
    },
    {
      "root": "subpackages/checkin",
      "name": "checkin",
      "pages": [
        "pages/checkin/checkin",
        "pages/checkin-camera/checkin-camera",
        "pages/checkin-detail/checkin-detail"
      ]
    },
    {
      "root": "subpackages/route",
      "name": "route",
      "pages": [
        "pages/route/route",
        "pages/route-basic-edit/route-basic-edit",
        "pages/my-route/my-route"
      ]
    },
    {
      "root": "subpackages/extra",
      "name": "extra",
      "pages": [
        "pages/shop-detail/shop-detail",
        "pages/spot-detail/spot-detail",
        "pages/collection/collection",
        "pages/link-import/link-import",
        "pages/webview/webview",
        "pages/my-favorites/my-favorites"
      ]
    }
  ],
  "preloadRule": {
    "pages/my/my": {
      "packages": ["checkin"],
      "network": "all"
    },
    "pages/route-entry/route-entry": {
      "packages": ["checkin"],
      "network": "all"
    },
    "pages/discover/discover": {
      "packages": ["guide"],
      "network": "all"
    },
    "pages/wantgo/wantgo": {
      "packages": ["route"],
      "network": "all"
    }
  },
  "lazyCodeLoading": "requiredComponents",
  "window": {
    "backgroundTextStyle": "light",
    "navigationBarBackgroundColor": "#ffffff",
    "navigationBarTitleText": "觅食图",
    "navigationBarTextStyle": "black"
  },
  "tabBar": {
    "custom": true,
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "探索"
      },
      {
        "pagePath": "pages/wantgo/wantgo",
        "text": "想去"
      },
      {
        "pagePath": "pages/route-entry/route-entry",
        "text": ""
      },
      {
        "pagePath": "pages/discover/discover",
        "text": "攻略"
      },
      {
        "pagePath": "pages/my/my",
        "text": "我的"
      }
    ]
  },
  "networkTimeout": {
    "request": 10000,
    "downloadFile": 10000
  },
  "sitemapLocation": "sitemap.json",
  "style": "v2",
  "permission": {
    "scope.userLocation": {
      "desc": "你的位置信息将用于展示附近美食"
    }
  },
  "requiredPrivateInfos": [
    "getLocation",
    "chooseLocation"
  ]
}
