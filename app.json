{
  "pages": [
    "pages/index/index",
    "pages/wantgo/wantgo",
    "pages/discover/discover",
    "pages/route-entry/route-entry",
    "pages/my/my"
  ],
  "subpackages": [
    {
      "root": "subpackages/guide",
      "name": "guide",
      "pages": [
        "pages/district-guide/district-guide",
        "pages/guide-detail/guide-detail",
        "pages/my-guides/my-guides"
      ]
    },
    {
      "root": "subpackages/checkin",
      "name": "checkin",
      "pages": [
        "pages/checkin/checkin",
        "pages/checkin-camera/checkin-camera",
        "pages/checkin-detail/checkin-detail"
      ]
    },
    {
      "root": "subpackages/route",
      "name": "route",
      "pages": [
        "pages/route-basic-edit/route-basic-edit",
        "pages/my-route/my-route"
      ]
    },
    {
      "root": "subpackages/extra",
      "name": "extra",
      "pages": [
        "pages/spot-detail/spot-detail",
        "pages/collection/collection",
        "pages/link-import/link-import",
        "pages/webview/webview",
        "pages/my-favorites/my-favorites"
      ]
    }
  ],
  "preloadRule": {
    "pages/my/my": {
      "packages": ["checkin"],
      "network": "all"
    },
    "pages/route-entry/route-entry": {
      "packages": ["checkin"],
      "network": "all"
    },
    "pages/discover/discover": {
      "packages": ["guide"],
      "network": "all"
    },
    "pages/wantgo/wantgo": {
      "packages": ["route"],
      "network": "all"
    }
  },
  "lazyCodeLoading": "requiredComponents",
  "usingComponents": {
    "bottom-action-sheet": "/components/bottom-action-sheet/index",
    "nav-map-sheet": "/components/nav-map-sheet/nav-map-sheet",
    "place-intro": "/components/place-intro/place-intro",
    "travel-meta-line": "/components/travel-meta-line/index",
    "transport-info-sheet": "/components/transport-info-sheet/index",
    "route-map-preview-card": "/components/route-map-preview-card/index"
  },
  "window": {
    "backgroundTextStyle": "light",
    "navigationBarBackgroundColor": "#ffffff",
    "navigationBarTitleText": "觅食图",
    "navigationBarTextStyle": "black"
  },
  "tabBar": {
    "color": "#BAC4CC",
    "selectedColor": "#1A2739",
    "backgroundColor": "#ffffff",
    "borderStyle": "white",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "探索",
        "iconPath": "assets/icons/tabbar-home.png",
        "selectedIconPath": "assets/icons/tabbar-home-active.png"
      },
      {
        "pagePath": "pages/wantgo/wantgo",
        "text": "想去",
        "iconPath": "assets/icons/tabbar-spots.png",
        "selectedIconPath": "assets/icons/tabbar-spots-active.png"
      },
      {
        "pagePath": "pages/discover/discover",
        "text": "攻略",
        "iconPath": "assets/icons/tabbar-discover.png",
        "selectedIconPath": "assets/icons/tabbar-discover-active.png"
      },
      {
        "pagePath": "pages/my/my",
        "text": "我的",
        "iconPath": "assets/icons/tabbar-my.png",
        "selectedIconPath": "assets/icons/tabbar-my-active.png"
      }
    ]
  },
  "networkTimeout": {
    "request": 10000,
    "downloadFile": 10000
  },
  "sitemapLocation": "sitemap.json",
  "style": "v2",
  "permission": {
    "scope.userLocation": {
      "desc": "你的位置信息将用于展示附近美食"
    }
  },
  "requiredPrivateInfos": [
    "getLocation",
    "chooseLocation"
  ]
}
