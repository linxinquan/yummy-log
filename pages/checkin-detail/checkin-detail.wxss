page {
  background: #FFFFFF;
}

.container {
  min-height: 100vh;
  background: #FFFFFF;
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
}

.page-content {
  padding-top: 40rpx;
  padding-left: 48rpx;
  padding-right: 48rpx;
}

.detail-stamp-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 56rpx;
}

.detail-stamp {
  position: relative;
  width: 255px;
  height: 324px;
}

.detail-stamp-shell {
  position: absolute;
  left: 0;
  top: 0;
  width: 255px;
  height: 324px;
  filter: drop-shadow(0 64px 48px rgba(0, 0, 0, 0.15));
}

.detail-stamp-photo {
  position: absolute;
  left: 24px;
  top: 24px;
  width: 207px;
  height: 276px;
  background: #FFFFFF;
}

.detail-stamp-title {
  width: 100%;
  color: #242529;
  font-size: 48rpx;
  font-weight: 500;
  line-height: 64rpx;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.detail-info-list {
  margin-top: 40rpx;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.info-section {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 16rpx;
}

.info-section-desc {
  gap: 16rpx;
}

.info-head {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.info-title {
  color: #242529;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 28rpx;
}

.info-value {
  width: 100%;
  color: #A0A4AE;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 44rpx;
}

.info-value-desc {
  line-height: 44rpx;
}

.bottom-action-mask {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 0;
  background: transparent;
  pointer-events: none;
}

.bottom-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 30;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 16rpx 48rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  box-sizing: border-box;
}

.action-btn {
  height: 96rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: none;
}

.action-btn::after {
  border: none;
}

.action-btn text {
  font-size: 32rpx;
  font-weight: 500;
  line-height: 32rpx;
  white-space: nowrap;
}

.action-btn-light {
  width: auto;
  flex-shrink: 0;
  background: #F2F4F7;
}

.action-btn-light text {
  color: #060606;
}

.action-btn-dark {
  flex: 1;
  min-width: 0;
  background: #242529;
}

.action-btn-dark text {
  color: #FFFFFF;
}

.edit-sheet-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.28);
  z-index: 49;
}

.edit-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
}

.edit-sheet-panel {
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  padding: 0;
  box-sizing: border-box;
  max-height: min(84vh, 1080rpx);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.sheet-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 128rpx;
  padding: 0 48rpx;
  box-sizing: border-box;
  flex-shrink: 0;
}

.sheet-title {
  color: #242529;
  font-size: 40rpx;
  font-weight: 500;
  line-height: 100%;
}

.sheet-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #242529;
  font-size: 48rpx;
}

.edit-sheet-content {
  padding: 0 48rpx;
  box-sizing: border-box;
  flex: 1;
  min-height: 0;
}

.edit-field {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.edit-field-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.edit-sheet-content .edit-field + .edit-field {
  margin-top: 48rpx;
}

.edit-field-label {
  color: #242529;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 28rpx;
}

.edit-field-action {
  color: #47BFFE;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 28rpx;
  flex-shrink: 0;
}

.edit-field-input,
.edit-field-textarea {
  width: 100%;
  min-height: 96rpx;
  padding: 0 32rpx;
  background: #F7F8FA;
  border-radius: 24rpx;
  box-sizing: border-box;
  color: #242529;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 40rpx;
  display: flex;
  align-items: center;
}

.edit-field-input {
  height: 96rpx;
  padding-right: 40rpx;
}

.edit-field-textarea-desc {
  height: 240rpx;
  padding: 24rpx 32rpx 32rpx;
  line-height: 40rpx;
  display: block;
  margin-bottom: 8rpx;
}

.edit-field-action.disabled {
  opacity: 0.45;
}


.edit-sheet-actions {
  display: flex;
  gap: 24rpx;
  padding: 40rpx 48rpx calc(40rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  box-sizing: border-box;
  flex-shrink: 0;
}

.edit-sheet-btn {
  height: 96rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.edit-sheet-btn text {
  font-size: 28rpx;
  font-weight: 500;
  line-height: 28rpx;
}

.edit-sheet-btn-light {
  width: 160rpx;
  background: #F2F4F7;
}

.edit-sheet-btn-light text {
  color: #242529;
}

.edit-sheet-btn-dark {
  flex: 1;
  background: #242529;
}

.edit-sheet-btn-dark text {
  color: #FFFFFF;
}
