<view class="container">
  <view class="page-content" wx:if="{{detail}}">
    <!-- 顶部放大版邮票：沿用列表同款样式，尺寸放大 1.5 倍 -->
    <view class="detail-stamp-wrap" bindtap="onPreviewPhoto">
      <view class="detail-stamp">
        <image class="detail-stamp-shell" src="/images/collection/stamp-ticket.png" mode="scaleToFill"></image>
        <image class="detail-stamp-photo" src="{{detail.photoPath}}" mode="aspectFill"></image>
      </view>
      <!-- 邮票标题：补回详情页底部标题 -->
      <text class="detail-stamp-title">{{detail.spotName || '未知地点'}}</text>
    </view>

    <!-- 基础信息：只保留记录时间、地址、打卡内容 -->
    <view class="detail-info-list">
      <view class="info-section">
        <view class="info-head">
          <text class="info-title">记录时间</text>
        </view>
        <text class="info-value">{{detail.recordTimeLabel}}</text>
      </view>

      <view class="info-section">
        <view class="info-head">
          <text class="info-title">地址</text>
        </view>
        <text class="info-value">{{detail.address || '暂未补充地址'}}</text>
      </view>

      <view class="info-section info-section-desc">
        <view class="info-head">
          <text class="info-title">打卡内容</text>
        </view>
        <text class="info-value info-value-desc">{{detail.description || '暂未生成打卡内容'}}</text>
      </view>
    </view>
  </view>

  <!-- 底部操作区：编辑改为底部弹窗编辑 -->
  <view class="bottom-action-mask"></view>
  <view class="bottom-actions" wx:if="{{detail}}">
    <button class="action-btn action-btn-light" open-type="share">
      <text>分享</text>
    </button>
    <button class="action-btn action-btn-dark" bindtap="onOpenEditSheet">
      <text>编辑</text>
    </button>
  </view>

  <!-- 详情编辑底部弹窗：在弹窗内修改时间、地址、打卡内容 -->
  <view class="edit-sheet-mask" wx:if="{{editSheetVisible}}" bindtap="onCloseEditSheet"></view>
  <view class="edit-sheet" wx:if="{{editSheetVisible}}">
    <view class="edit-sheet-panel" catchtap="preventBubble">
      <view class="sheet-header">
        <text class="sheet-title">编辑采集内容</text>
        <i class="mgc_close_line sheet-close" bindtap="onCloseEditSheet"></i>
      </view>
      <scroll-view class="edit-sheet-content" scroll-y>
        <view class="edit-field">
          <view class="edit-field-head">
            <text class="edit-field-label">地址</text>
            <text class="edit-field-action" bindtap="onPickEditLocation">地址选点</text>
          </view>
          <input
            class="edit-field-input"
            value="{{editAddress}}"
            bindinput="onEditAddressInput"
            placeholder="请输入地址"
            maxlength="20"
          />
        </view>

        <view class="edit-field">
          <view class="edit-field-head">
            <text class="edit-field-label">打卡内容</text>
            <text
              class="edit-field-action {{editGeneratingDescription ? 'disabled' : ''}}"
              bindtap="onGenerateEditDescription"
            >{{editGeneratingDescription ? '生成中...' : 'AI生成'}}</text>
          </view>
          <textarea
            class="edit-field-textarea edit-field-textarea-desc"
            value="{{editDescription}}"
            bindinput="onEditDescriptionInput"
            placeholder="请输入打卡内容"
            maxlength="200"
            disable-default-padding
            show-confirm-bar="{{false}}"
            cursor-spacing="180"
          />
        </view>
      </scroll-view>

      <view class="edit-sheet-actions">
        <view class="edit-sheet-btn edit-sheet-btn-light" bindtap="onCloseEditSheet">
          <text>取消</text>
        </view>
        <view class="edit-sheet-btn edit-sheet-btn-dark" bindtap="onConfirmEditSheet">
          <text>保存编辑</text>
        </view>
      </view>
    </view>
  </view>
</view>
