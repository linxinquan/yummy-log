page {
  background: #FFFFFF;
}

.container {
  position: relative;
  min-height: 100vh;
  background: #FFFFFF;
  padding-bottom: calc(146rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.tab-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-left: 48rpx;
  background: #FFFFFF;
  box-sizing: content-box;
}

.tab-left {
  display: flex;
  align-items: center;
}

.tab-item text {
  color: #A0A4AE;
  font-size: 48rpx;
  line-height: 48rpx;
  font-weight: 500;
}

.tab-item.active text {
  color: #242529;
}

.tab-right {
  width: 48rpx;
  height: 48rpx;
}

.create-content {
  padding: 0 48rpx;
}

.weekday-row {
  display: inline-flex;
  align-items: center;
  gap: 32rpx;
}

.weekday-item {
  color: #A0A4AE;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 28rpx;
}

.weekday-item.active {
  color: #242529;
}

.action-section {
  position: absolute;
  left: 48rpx;
  right: 48rpx;
  bottom: calc(320rpx + env(safe-area-inset-bottom));
}

.action-row {
  display: flex;
  justify-content: flex-start;
  align-items: flex-end;
  gap: 32rpx;
}

.action-col {
  position: relative;
  width: calc((100% - 36rpx) / 2);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.action-col-left {
  padding-top: 72rpx;
}

.action-card {
  position: relative;
  width: 100%;
  height: 240rpx;
  border-radius: 32rpx;
  background: #FFFFFF;
  border: 2rpx solid #F7F8FA;
  box-shadow: inset 0 0 24rpx #FFFFFF, 0 12rpx 48rpx rgba(0, 0, 0, 0.04);
  overflow: hidden;
}

.action-card-icon {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  z-index: 2;
  color: #242529;
  font-size: 80rpx;
  line-height: 80rpx;
}

.action-label {
  display: block;
  margin-top: 34rpx;
  color: #242529;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 32rpx;
  text-align: center;
}

.parse-source-stack {
  position: absolute;
  left: 50%;
  top: 12rpx;
  width: 160rpx;
  height: 64rpx;
  overflow: hidden;
  transform: translateX(-50%);
}

.source-card-image {
  position: absolute;
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
}

.wechat-card {
  left: 8rpx;
  top: 8rpx;
  transform: rotate(-15deg);
  border: 2rpx solid #F7F8FA;
  border-radius: 24rpx;
}

.xhs-card {
  left: 64rpx;
  top: 16rpx;
  transform: rotate(15deg);
  border: 2rpx solid #F7F8FA;
    border-radius: 24rpx;
}

.parse-glow,
.create-glow {
  position: absolute;
  border-radius: 999rpx;
  pointer-events: none;
}

.parse-glow-red {
  left: 66rpx;
  top: 148rpx;
  width: 120rpx;
  height: 120rpx;
  background: linear-gradient(180deg, #FFEBEB 0%, #FFB3B3 100%);
  filter: blur(25rpx);
}

.parse-glow-yellow {
  left: 158rpx;
  top: 188rpx;
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(180deg, #FFFEF2 0%, #FFF9B3 100%);
  filter: blur(25rpx);
}

.create-glow-purple {
  left: 46rpx;
  top: 218rpx;
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(180deg, #EDE4FF 0%, #C4A4FF 100%);
  filter: blur(40rpx);
}

.create-glow-blue {
  left: 92rpx;
  top: 178rpx;
  width: 120rpx;
  height: 120rpx;
  background: linear-gradient(180deg, #DCEBF2 0%, #B8E7FF 100%);
  filter: blur(40rpx);
}

.import-sheet-mask {
  position: fixed;
  inset: 0;
  z-index: 210;
  background: rgba(0, 0, 0, 0);
  pointer-events: none;
  transition: background 0.28s ease;
}

.import-sheet-mask.show {
  background: rgba(0, 0, 0, 0.4);
  pointer-events: auto;
}

.import-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 211;
  padding: 0 0 calc(24rpx + env(safe-area-inset-bottom));
  border-radius: 32rpx 32rpx 0 0;
  background: #FFFFFF;
  transform: translateY(100%);
  transition: transform 0.28s cubic-bezier(0.32, 0.72, 0, 1);
}

.import-sheet.show {
  transform: translateY(0);
}

.import-sheet-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 128rpx;
  padding: 0 48rpx;
  box-sizing: border-box;
}

.import-sheet-title {
  color: #242529;
  font-size: 40rpx;
  font-weight: 500;
  line-height: 100%;
}

.import-sheet-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #242529;
}

.import-sheet-close i {
  font-size: 48rpx;
}

.import-sheet-body {
  padding: 0 48rpx;
  box-sizing: border-box;
}

.import-input-wrap {
  box-sizing: border-box;
  min-height: 320rpx;
  padding: 32rpx;
  background: #F7F8FA;
  border: 2rpx solid #E5E7EB;
  border-radius: 24rpx;
}

.import-textarea {
  width: 100%;
  min-height: 240rpx;
  color: #242529;
  font-size: 32rpx;
  line-height: 48rpx;
}

.import-placeholder {
  color: #A0A4AE;
}

.import-hint-list {
  margin-top: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.import-hint {
  color: #6E727A;
  font-size: 24rpx;
  line-height: 24rpx;
}

.import-sheet-footer {
  display: flex;
  gap: 24rpx;
  padding: 48rpx 48rpx 0;
}

.import-secondary-btn,
.import-primary-btn {
  height: 96rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  line-height: 32rpx;
  font-weight: 500;
}

.import-secondary-btn {
  width: 220rpx;
  flex: 0 0 220rpx;
  background: #F2F4F7;
  color: #242529;
}

.import-primary-btn {
  flex: 1;
  background: #242529;
  color: #FFFFFF;
}
