/* 觅食图 V2 - 景点详情页样式 (基于新版 UI) */

.container {
  background: #FFFFFF;
  min-height: 100vh;
  padding-bottom: calc(176rpx + env(safe-area-inset-bottom));
}

/* ── Hero 图片区 ── */
.hero-wrap {
  position: relative;
  width: 100%;
  height: 780rpx; /* 390px */
}

.hero-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.top-bar {
  position: fixed;
  left: 48rpx; /* 24px */
  display: flex;
  align-items: center;
  gap: 32rpx; /* 16px 间距 */
  z-index: 200;
}

.icon-btn {
  width: 64rpx; /* 32px */
  height: 64rpx; /* 32px */
  background: rgba(0, 0, 0, 0.24);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-btn i {
  font-size: 40rpx; /* 20px */
  color: #FFFFFF;
}

.hero-stats {
  position: absolute;
  bottom: 80rpx;
  left: 48rpx;
  right: 48rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  z-index: 10;
}

.stats-text {
  font-family: 'PingFang SC', sans-serif;
  font-size: 28rpx; /* 14px */
  color: #FFFFFF;
}

.avatar-group {
  display: flex;
  align-items: center;
}

.avatar {
  width: 48rpx; /* 24px */
  height: 48rpx; /* 24px */
  border-radius: 50%;
  border: 2rpx solid #FFFFFF;
  margin-left: -16rpx; /* -8px overlap */
  background: #FFFFFF;
}
.avatar:first-child {
  margin-left: 0;
}

.hero-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 48rpx; /* 24px */
  background: #FFFFFF;
  border-radius: 48rpx 48rpx 0 0;
  z-index: 10;
}

/* ── 内容区 ── */
.content-wrap {
  position: relative;
  background: #FFFFFF;
  z-index: 20;
  margin-top: -8rpx;
  padding-bottom: 40rpx;
}

/* 基本信息 */
.main-info {
  display: flex;
  flex-direction: column;
  padding: 0 48rpx 0; 

}



.info-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 24rpx;
}

.info-left {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 32rpx; /* 16px */
}

.tags-row {
  display: flex;
  align-items: center;
  gap: 16rpx; /* 8px */
}

.rating-badge {
  background: #FDF8E3;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.rating-val {
  color: #EE8733;
  font-size: 24rpx; /* 12px */
  font-weight: 400;
}

.tag-badge {
  background: #F7F8FA;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tag-badge text {
  color: #A0A4AE;
  font-size: 24rpx; /* 12px */
}

.spot-title {
  font-size: 48rpx; /* 24px */
  font-weight: 500;
  color: #242529;
  line-height: 48rpx;
}

.open-time {
  font-size: 24rpx; /* 12px */
  color: #A0A4AE;
  line-height: 24rpx; /* 12px */
  margin-top: 24rpx; /* 12px 距离上方标题 */
}

.address-box {
  display: flex;
  padding: 24rpx 32rpx; /* 12px 16px */
  align-items: center;
  gap: 24rpx; /* 12px */
  align-self: stretch;
  border: 2rpx solid #E5E7EB;
  border-radius: 24rpx; /* 12px */
  box-sizing: border-box;
  margin-top: 48rpx; /* 24px 距离上面的营业时间 */
}

.phone-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-top: 24rpx;
}

.phone-label {
  font-size: 24rpx;
  color: #A0A4AE;
  line-height: 24rpx;
}

.phone-text {
  font-size: 28rpx;
  font-weight: 500;
  color: #242529;
  line-height: 28rpx;
}

.address-content {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 24rpx; /* 12px */
  align-self: stretch;
}

.address-label {
  font-family: "PingFang SC";
  font-size: 24rpx; /* 12px */
  font-weight: 400;
  color: #A0A4AE;
  line-height: 100%; /* 12px */
}

.address-text {
  font-family: "PingFang SC";
  font-size: 28rpx; /* 14px */
  font-weight: 500;
  color: #242529;
  line-height: 28rpx; /* 14px */
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  overflow: hidden;
  align-self: stretch;
}

.arrow-icon {
  font-size: 40rpx; /* 20px */
  color: #C0C0C0;
}

.spot-desc {
  font-size: 32rpx; /* 16px */
  color: #6E727A;
  line-height: 48rpx; /* 24px */
  margin-top: 40rpx; /* 20px 距离上面的地址卡片 */
}

/* 分割线 */
.divider {
  height: 2rpx; /* 1px */
  background: #F2F4F7;
  margin: 64rpx 48rpx 0;
}

/* 位置卡片 */
.map-section {
  padding: 64rpx 48rpx 0;
  display: flex;
  flex-direction: column;
  gap: 32rpx; /* 16px */
}

.section-title {
  font-size: 34rpx; /* 17px */
  font-weight: 500;
  color: #242529;
}

.map-card {
  width: 100%;
  height: 240rpx; /* 120px */
  border-radius: 24rpx; /* 12px */
  overflow: hidden;
  background: #F7F8FA;
}

.mini-map {
  width: 100%;
  height: 100%;
}

/* 附近美食 */
.nearby-section {
  padding: 64rpx 0 0 48rpx; /* margin-top 32px */
  display: flex;
  flex-direction: column;
  gap: 32rpx; /* 16px */
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-right: 48rpx;
}

.more-btn {
  font-size: 28rpx; /* 14px */
  color: #FF5A5F;
}

.nearby-scroll {
  width: 100%;
  white-space: nowrap;
}

.nearby-list {
  display: flex;
  gap: 24rpx; /* 12px */
  padding-right: 48rpx;
}

.nearby-card {
  width: 280rpx; /* 140px */
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  gap: 24rpx; /* 12px */
}

.dish-card {
  width: 280rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}


.nearby-img {
  width: 280rpx; /* 140px */
  height: 280rpx; /* 140px */
  border-radius: 24rpx; /* 12px */
  background: #F7F8FA;
}

.nearby-info {
  display: flex;
  flex-direction: column;
  gap: 16rpx; /* 8px */
}

.nearby-name {
  font-size: 32rpx; /* 16px */
  color: #242529;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.nearby-meta {
  font-size: 24rpx; /* 12px */
  color: #A0A4AE;
}

/* ── 底部操作栏 ── */
.bottom-action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 16rpx 48rpx calc(16rpx + env(safe-area-inset-bottom));
  z-index: 100;
}

.action-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FFFFFF;
}

.action-content {
  position: relative;
  display: flex;
  align-items: center;
  gap: 24rpx; /* 12px */
}

.collect-action-btn {
  width: 96rpx; /* 48px */
  height: 96rpx; /* 48px */
  flex-shrink: 0;
  border-radius: 999rpx;
  background: #F2F4F7;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.collect-action-icon {
  font-size: 48rpx; /* 24px */
  color: #242529;
  line-height: 1;
}

.collect-action-icon.collected {
  color: #FF5A5F;
}

.want-btn {
  flex: 1;
  height: 96rpx; /* 48px */
  background: #242529;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.want-btn text {
  font-size: 32rpx; /* 16px */
  font-weight: 500;
  color: #FFFFFF;
  line-height: 1;
}

.title-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-top: 32rpx; /* 16px 距离上方标签 */
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
