/* 觅食图 V2 - 景点详情页样式 (基于新版 UI) */

.container {
  background: #FFFFFF;
  min-height: 100vh;
  padding-bottom: calc(176rpx + env(safe-area-inset-bottom));
}

/* ── Hero 图片区 ── */
.hero-wrap {
  position: relative;
  width: 100%;
  height: 780rpx; /* 390px */
}

.hero-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.top-bar {
  position: fixed;
  left: 48rpx; /* 24px */
  display: flex;
  align-items: center;
  gap: 32rpx; /* 16px 间距 */
  z-index: 200;
}

.icon-btn {
  width: 64rpx; /* 32px */
  height: 64rpx; /* 32px */
  background: rgba(0, 0, 0, 0.24);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-btn i {
  font-size: 40rpx; /* 20px */
  color: #FFFFFF;
}

.hero-stats {
  position: absolute;
  bottom: 80rpx;
  left: 48rpx;
  right: 48rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  z-index: 10;
}

.stats-text {
  font-family: 'PingFang SC', sans-serif;
  font-size: 28rpx; /* 14px */
  color: #FFFFFF;
}

.avatar-group {
  display: flex;
  align-items: center;
}

.avatar {
  width: 48rpx; /* 24px */
  height: 48rpx; /* 24px */
  border-radius: 50%;
  border: 2rpx solid #FFFFFF;
  margin-left: -16rpx; /* -8px overlap */
  background: #FFFFFF;
}
.avatar:first-child {
  margin-left: 0;
}

.hero-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 48rpx; /* 24px */
  background: #FFFFFF;
  border-radius: 48rpx 48rpx 0 0;
  z-index: 10;
}

/* ── 内容区 ── */
.content-wrap {
  position: relative;
  background: #FFFFFF;
  z-index: 20;
  margin-top: -8rpx;
  padding-bottom: 40rpx;
}

/* 基本信息 */
.main-info {
  display: flex;
  flex-direction: column;
  padding: 0 48rpx 0; 

}



.info-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 24rpx;
}

.info-left {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 32rpx; /* 16px */
}

.tags-row {
  display: flex;
  align-items: center;
  gap: 16rpx; /* 8px */
}

.rating-badge {
  background: #FDF8E3;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.rating-val {
  color: #EE8733;
  font-size: 24rpx; /* 12px */
  font-weight: 400;
}

.tag-badge {
  background: #F7F8FA;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tag-badge text {
  color: #A0A4AE;
  font-size: 24rpx; /* 12px */
}

.spot-title {
  font-size: 48rpx; /* 24px */
  font-weight: 500;
  color: #242529;
  line-height: 48rpx;
}

.open-time {
  font-size: 24rpx; /* 12px */
  color: #A0A4AE;
  line-height: 24rpx; /* 12px */
  margin-top: 24rpx; /* 12px 距离上方标题 */
}

.address-box {
  display: flex;
  padding: 24rpx 32rpx; /* 12px 16px */
  align-items: center;
  gap: 24rpx; /* 12px */
  align-self: stretch;
  border: 2rpx solid #E5E7EB;
  border-radius: 24rpx; /* 12px */
  box-sizing: border-box;
  margin-top: 48rpx; /* 24px 距离上面的营业时间 */
}

.phone-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-top: 24rpx;
}

.phone-label {
  font-size: 24rpx;
  color: #A0A4AE;
  line-height: 24rpx;
}

.phone-text {
  font-size: 28rpx;
  font-weight: 500;
  color: #242529;
  line-height: 28rpx;
}

.address-content {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 24rpx; /* 12px */
  align-self: stretch;
}

.address-label {
  font-family: "PingFang SC";
  font-size: 24rpx; /* 12px */
  font-weight: 400;
  color: #A0A4AE;
  line-height: 100%; /* 12px */
}

.address-text {
  font-family: "PingFang SC";
  font-size: 28rpx; /* 14px */
  font-weight: 500;
  color: #242529;
  line-height: 28rpx; /* 14px */
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  overflow: hidden;
  align-self: stretch;
}

.arrow-icon {
  font-size: 40rpx; /* 20px */
  color: #C7CAD1;
}

.spot-desc {
  font-size: 32rpx; /* 16px */
  color: #242529;
  line-height: 48rpx; /* 24px */
  margin-top: 32rpx; /* 16px 距离上面的地址卡片 */
}

/* 分割线 */
.divider {
  height: 2rpx; /* 1px */
  background: #F2F4F7;
  margin: 48rpx 48rpx 0;
}

/* 位置卡片 */
.map-section {
  padding: 48rpx 48rpx 0;
  display: flex;
  flex-direction: column;
  gap: 32rpx; /* 16px */
}

.section-title {
  font-size: 32rpx; /* 17px */
  font-weight: 500;
  color: #242529;
  line-height: 32rpx;
}

.map-card {
  width: 100%;
  height: 240rpx; /* 120px */
  border-radius: 24rpx; /* 12px */
  overflow: hidden;
  background: #F7F8FA;
}

.mini-map {
  width: 100%;
  height: 100%;
}

/* 附近美食模块：外层只负责上下间距，不再负责左右留白 */
.nearby-section {
  padding-top: 48rpx; /* margin-top 32px */
  display: flex;
  flex-direction: column;
  gap: 24rpx; /* 12px */
}

/* 标题行：左右和下面列表保持同样的边距 */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 48rpx;
}

.more-btn {
  font-size: 28rpx; /* 14px */
  color: #A0A4AE;
}

/* 横向滚动区：这里负责真正的左右滚动和两侧留白 */
.nearby-scroll {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 24rpx; /* 12px */
  padding: 0 48rpx;
  box-sizing: border-box;
  overflow-x: auto;
  white-space: nowrap;
}

/* 隐藏横向滚动条，保留更干净的视觉 */
.nearby-scroll::-webkit-scrollbar {
  display: none;
}

/* 景点详情页里的附近美食卡片 */
.nearby-card {
  width: 240rpx; /* 120px */
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  gap: 24rpx; /* 12px */
}

/* 美食详情页里的推荐菜卡片 */
.dish-card {
  width: 240rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}


.nearby-img {
  width: 240rpx; /* 120px */
  height: 240rpx; /* 140px */
  border-radius: 24rpx; /* 12px */
  background: #F7F8FA;
}

.nearby-info {
  display: flex;
  flex-direction: column;
  gap: 16rpx; /* 8px */
}

.nearby-name {
  font-size: 32rpx; /* 16px */
  color: #242529;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  line-height: 32rpx;
}

.nearby-meta {
  font-size: 24rpx; /* 12px */
  color: #A0A4AE;
  line-height: 32rpx;
}

/* ── 底部操作栏 ── */
.bottom-action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 16rpx 48rpx calc(16rpx + env(safe-area-inset-bottom));
  z-index: 100;
}

.action-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FFFFFF;
}

.action-content {
  position: relative;
  display: flex;
  align-items: center;
  gap: 24rpx; /* 12px */
}

.collect-action-btn {
  width: 96rpx; /* 48px */
  height: 96rpx; /* 48px */
  flex-shrink: 0;
  border-radius: 999rpx;
  background: #F2F4F7;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.collect-action-icon {
  font-size: 48rpx; /* 24px */
  color: #242529;
  line-height: 1;
}

.collect-action-icon.collected {
  color: #EEB237;
}

.want-btn {
  flex: 1;
  height: 96rpx; /* 48px */
  background: #242529;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  gap: 12rpx;
}

.want-action-icon {
  font-size: 40rpx;
  color: #FFFFFF;
  line-height: 1;
}

.want-action-icon.wanted {
  color: #FF5A5F;
}

.want-btn text {
  font-size: 32rpx; /* 16px */
  font-weight: 500;
  color: #FFFFFF;
  line-height: 1;
}

.title-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-top: 32rpx; /* 16px 距离上方标签 */
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

/* 地址导航底部弹窗：探索详情地址和位置卡片都复用这一套 */
.sheet-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0);
  pointer-events: none;
  transition: background 0.3s;
  z-index: 1001;
}

.sheet-mask.show {
  background: rgba(0, 0, 0, 0.4);
  pointer-events: auto;
}

.sheet-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.32, 0.72, 0, 1);
  overflow: hidden;
  z-index: 1002;
}

.sheet-mask.show .sheet-panel {
  transform: translateY(0);
}

.sheet-modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 128rpx;
  padding: 0 48rpx;
  box-sizing: border-box;
}

.sheet-modal-title {
  color: #242529;
  font-size: 40rpx;
  font-weight: 500;
  line-height: 40rpx;
}

.sheet-modal-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #242529;
  font-size: 48rpx;
}

.route-action-sheet {
  z-index: 1002;
}

.route-sheet-option-list {
  padding: 0 48rpx calc(48rpx + env(safe-area-inset-bottom));
}

.route-sheet-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 104rpx;
  padding: 0 32rpx;
  border-radius: 24rpx;
  border: 2rpx solid #E5E7EB;
  background: #FFFFFF;
}

.route-sheet-option + .route-sheet-option {
  margin-top: 24rpx;
}

.route-sheet-option-main {
  display: flex;
  align-items: center;
  gap: 16rpx;
  color: #242529;
}

.route-sheet-option-main i {
  font-size: 40rpx;
  color: #242529;
}

.route-sheet-option-main text {
  font-size: 32rpx;
  line-height: 32rpx;
  color: #242529;
}

.route-sheet-option-arrow {
  font-size: 36rpx;
  color: #C7CAD1;
}
