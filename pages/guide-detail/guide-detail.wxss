/* 觅食图 V2 - 攻略详情页样式 (路线规划版) */

.container {
  background: #FFFFFF;
  min-height: 100vh;
  padding-bottom: calc(176rpx + env(safe-area-inset-bottom));
}

/* ── Hero 图片区 ── */
.hero-wrap {
  position: relative;
  width: 100%;
  height: 780rpx; /* 390px */
}

.hero-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.top-bar {
  position: fixed;
  left: 48rpx; /* 24px */
  display: flex;
  align-items: center;
  gap: 32rpx; /* 16px 间距 */
  z-index: 200;
}

.icon-btn {
  width: 64rpx; /* 32px */
  height: 64rpx; /* 32px */
  background: rgba(0, 0, 0, 0.24);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-btn i {
  font-size: 40rpx; /* 20px */
  color: #FFFFFF;
}

.hero-stats {
  position: absolute;
  bottom: 80rpx;
  left: 48rpx;
  right: 48rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  z-index: 10;
}

.stats-text {
  font-family: 'PingFang SC', sans-serif;
  font-size: 28rpx; /* 14px */
  color: #FFFFFF;
}

.hero-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 48rpx; /* 24px */
  background: #FFFFFF;
  border-radius: 48rpx 48rpx 0 0;
  z-index: 10;
}

/* ── 内容区 ── */
.content-wrap {
  position: relative;
  background: #FFFFFF;
  z-index: 20;
  margin-top: -8rpx;
  padding-bottom: 40rpx;
}

/* 基本信息 */
.main-info {
  display: flex;
  flex-direction: column;
  padding: 0 48rpx 0; 
}

.info-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 24rpx;
}

.info-left {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 32rpx; /* 16px */
}

.tags-row {
  display: flex;
  align-items: center;
  gap: 16rpx; /* 8px */
  flex-wrap: wrap;
}

.tag-badge {
  background: #F6F6F6;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tag-badge text {
  color: #BABABA;
  font-size: 24rpx; /* 12px */
}

.spot-title {
  font-size: 48rpx; /* 24px */
  font-weight: 500;
  color: #000000;
  line-height: 48rpx;
}

.collect-btn {
  flex-shrink: 0;
  width: 96rpx; /* 48px */
  height: 96rpx; /* 48px */
  background: #FFFFFF;
  border: 2rpx solid #E8E8E8;
  border-radius: 24rpx; /* 12px */
  display: flex;
  align-items: center;
  justify-content: center;
}

.collect-icon {
  font-size: 48rpx; /* 24px */
  color: #000000;
}

.open-time {
  font-size: 24rpx; /* 12px */
  color: #C2C2C2;
  line-height: 24rpx; /* 12px */
  margin-top: 24rpx; /* 12px 距离上方标题 */
}

.spot-desc {
  font-size: 32rpx; /* 16px */
  color: #868686;
  line-height: 48rpx; /* 24px */
  margin-top: 40rpx; /* 20px 距离上面的地址卡片 */
}

/* 分割线 */
.divider {
  height: 2rpx; /* 1px */
  background: #E8E8E8;
  margin: 64rpx 48rpx 0;
}

/* 路线地图 */
.map-section {
  padding: 64rpx 48rpx 0;
  display: flex;
  flex-direction: column;
  gap: 32rpx; /* 16px */
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.section-title {
  font-size: 34rpx; /* 17px */
  font-weight: 500;
  color: #000000;
}

.more-btn {
  font-size: 28rpx; /* 14px */
  color: #DC6962;
}

.map-card {
  width: 100%;
  height: 320rpx; /* 160px */
  border-radius: 24rpx; /* 12px */
  overflow: hidden;
  background: #F6F6F6;
  position: relative;
}

.mini-map {
  width: 100%;
  height: 100%;
}

.map-legend {
  position: absolute;
  bottom: 16rpx;
  left: 16rpx;
  display: flex;
  gap: 32rpx;
  background: rgba(255, 255, 255, 0.9);
  padding: 12rpx 20rpx;
  border-radius: 16rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.legend-dot.start {
  background: #4CAF50;
}

.legend-dot.end {
  background: #FF5722;
}

.legend-line {
  width: 24rpx;
  height: 6rpx;
  background: #00D9C0;
  border-radius: 3rpx;
}

.legend-item text {
  font-size: 22rpx;
  color: #666666;
}

/* 行程安排 */
.route-section {
  padding: 64rpx 48rpx 0;
}

.route-list {
  margin-top: 32rpx;
}

.route-item {
  display: flex;
  align-items: center;
  padding: 32rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}

.route-item:last-child {
  border-bottom: none;
}

.route-num {
  width: 56rpx;
  height: 56rpx;
  background: linear-gradient(135deg, #47BFFE 0%, #00D9C0 100%);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
  flex-shrink: 0;
}

.route-info {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.route-name {
  font-size: 32rpx;
  font-weight: 500;
  color: #000000;
}

.route-desc {
  font-size: 26rpx;
  color: #999999;
}

.route-meta {
  display: flex;
  gap: 24rpx;
}

.route-time {
  font-size: 24rpx;
  color: #C2C2C2;
}

.route-dist {
  font-size: 24rpx;
  color: #C2C2C2;
}

.route-arrow {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.route-arrow i {
  font-size: 36rpx;
  color: #C0C0C0;
}

/* 路线统计 */
.stats-section {
  margin: 64rpx 48rpx 0;
  background: linear-gradient(135deg, #47BFFE 0%, #00D9C0 100%);
  border-radius: 24rpx;
  padding: 48rpx;
  display: flex;
  justify-content: space-around;
  align-items: center;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.stat-value {
  font-size: 48rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.stat-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

.stat-divider {
  width: 2rpx;
  height: 60rpx;
  background: rgba(255, 255, 255, 0.3);
}

/* ── 底部操作栏 ── */
.bottom-action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 16rpx 48rpx calc(16rpx + env(safe-area-inset-bottom));
  z-index: 100;
}

.action-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FFFFFF;
}

.action-content {
  position: relative;
  display: flex;
  align-items: center;
  gap: 24rpx; /* 12px */
}

.nav-btn {
  width: 192rpx; /* 96px */
  height: 96rpx; /* 48px */
  border: 2rpx solid #E7E7E7;
  border-radius: 24rpx; /* 12px */
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.nav-btn text {
  font-size: 32rpx; /* 16px */
  font-weight: 500;
  color: #060606;
  line-height: 1;
}

.want-btn {
  flex: 1;
  height: 96rpx; /* 48px */
  background: linear-gradient(135deg, #47BFFE 0%, #00D9C0 100%);
  border-radius: 24rpx; /* 12px */
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.want-btn text {
  font-size: 32rpx; /* 16px */
  font-weight: 500;
  color: #FFFFFF;
  line-height: 1;
}