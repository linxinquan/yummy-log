page {
  background: #ffffff;
}

.page {
  position: relative;
  height: 100vh;
  background: #ffffff;
  overflow: hidden;
}

.hero-wrap {
  position: relative;
  width: 100%;
  height: 780rpx;
  overflow: hidden;
}

.hero-wrap-map {
  height: 100vh;
}

.hero-map {
  width: 100%;
  height: 100%;
}

.hero-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 220rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0.92) 60%, #ffffff 100%);
  pointer-events: none;
}

.top-actions {
  position: fixed;
  left: 48rpx;
  display: flex;
  align-items: center;
  gap: 32rpx;
  z-index: 30;
}

.top-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
}

.top-icon i {
  font-size: 40rpx;
  color: #ffffff;
}

.mode-switch {
  position: fixed;
  left: 50%;
  transform: translateX(-50%);
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  padding: 4rpx;
  border-radius: 999rpx;
  background: #f6f6f6;
  z-index: 30;
}

.mode-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  min-width: 120rpx;
  height: 56rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  color: #c2c2c2;
  font-size: 28rpx;
  font-weight: 500;
}

.mode-chip i {
  font-size: 32rpx;
}

.mode-chip.active {
  background: #fefefe;
  color: #47bffe;
}

.detail-sheet {
  position: fixed;
  left: 0;
  right: 0;
  top: 248rpx;
  bottom: 0;
  z-index: 15;
  border-radius: 48rpx 48rpx 0 0;
  background: #ffffff;
  overflow: hidden;
}

.detail-scroll {
  height: 100%;
}

.detail-scroll-inner {
  min-height: 100%;
  padding-top: 32rpx;
  padding-bottom: calc(168rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.sheet-header {
  margin: 0 48rpx;
}

.guide-title {
  display: block;
  color: #000000;
  font-size: 40rpx;
  font-weight: 500;
  line-height: 56rpx;
}

.guide-meta-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-top: 32rpx;
}

.guide-meta,
.guide-city,
.map-meta,
.map-city {
  color: #868686;
  font-size: 24rpx;
  line-height: 24rpx;
}

.tab-sticky-wrap {
  position: sticky;
  top: 0;
  z-index: 22;
  padding-top: 40rpx;
  background: #ffffff;
}

.sheet-content {
  background: #ffffff;
}

.tab-scroll {
  white-space: nowrap;
}

.tab-row {
  display: inline-flex;
  align-items: flex-start;
  gap: 48rpx;
  padding: 0 48rpx;
}

.tab-item {
  display: inline-flex;
  align-items: center;
  color: #c2c2c2;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 32rpx;
  flex-shrink: 0;
}

.tab-item.active {
  color: #000000;
}

.tab-item i {
  font-size: 32rpx;
}

.add-item {
  gap: 8rpx;
  color: #47bffe;
}

.add-item i,
.add-item text {
  color: #47bffe;
}

.section-divider {
  margin: 32rpx 0 0;
  height: 1rpx;
  background: #e8e8e8;
}

.sort-tip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin: 24rpx 48rpx 0;
  color: #868686;
  font-size: 24rpx;
}

.sort-tip i {
  font-size: 28rpx;
}

.day-section {
  margin-top: 48rpx;
}

.day-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 48rpx 48rpx;
}

.day-title {
  color: #000000;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 32rpx;
}

.day-count {
  color: #868686;
  font-size: 24rpx;
  line-height: 24rpx;
}

.place-list {
  margin: 0 48rpx;
}

.day-anchor {
  position: relative;
  top: -132rpx;
  height: 0;
}

.place-row {
  display: flex;
  align-items: center;
  gap: 32rpx;
  padding-bottom: 64rpx;
}

.place-row.dragging {
  transform: scale(1.02);
  opacity: 0.92;
}

.place-cover-wrap {
  position: relative;
  width: 128rpx;
  height: 128rpx;
  flex-shrink: 0;
  overflow: visible;
}

.place-cover-shadow {
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  width: 112rpx;
  height: 112rpx;
  border-radius: 20rpx;
  background: rgba(0, 0, 0, 0.04);
  transform: rotate(-8deg);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
}

.place-cover {
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  width: 112rpx;
  height: 112rpx;
  border: 2rpx solid #ffffff;
  border-radius: 20rpx;
  transform: rotate(-8deg);
}

.place-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  min-width: 0;
}

.place-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  align-self: flex-start;
  min-width: 56rpx;
  height: 32rpx;
  padding: 0 8rpx;
  border-radius: 8rpx;
  background: #fdf8e3;
  color: #ee8733;
  font-size: 20rpx;
  line-height: 20rpx;
}

.place-name {
  color: #000000;
  font-size: 32rpx;
  line-height: 32rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.place-travel {
  color: #868686;
  font-size: 24rpx;
  line-height: 24rpx;
}

.place-arrow,
.place-handle {
  width: 48rpx; 
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex-shrink: 0;
}

.place-arrow i {
  color: #7cc5df;
  font-size: 48rpx;
}

.place-handle i {
  color: #b7b7b7;
  font-size: 32rpx;
}

.empty-day {
  margin: 0 48rpx;
  padding: 40rpx 32rpx;
  border-radius: 24rpx;
  background: #f7f7f7;
  color: #999999;
  font-size: 26rpx;
  text-align: center;
}

.day-separator {
  width: 100%;
  height: 16rpx;
  background: #f2f6f7;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  padding: 16rpx 48rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #ffffff 0.1;
  z-index: 40;
}

.bottom-btn {
  height: 96rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.bottom-btn i {
  font-size: 36rpx;
}

.bottom-btn text {
  font-size: 32rpx;
  font-weight: 500;
}

.bottom-btn.secondary {
  width: 192rpx;
  border: 2rpx solid #e7e7e7;
  color: #060606;
  background: #ffffff;
}

.bottom-btn.primary {
  flex: 1;
  min-width: 0;
  background: #47bffe;
  color: #ffffff;
}

.map-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 0 24rpx calc(24rpx + env(safe-area-inset-bottom));
  z-index: 20;
}

.map-card {
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.96);
  backdrop-filter: blur(20rpx);
  padding: 32rpx;
  box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.06);
}

.map-title {
  display: block;
  color: #000000;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 44rpx;
}

.map-meta-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-top: 16rpx;
}

.map-chip-scroll {
  margin-top: 28rpx;
  white-space: nowrap;
}

.map-chip-row {
  display: inline-flex;
  align-items: center;
  gap: 16rpx;
}

.map-chip {
  min-width: 128rpx;
  height: 56rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: #f4f6f8;
  color: #868686;
  font-size: 24rpx;
  line-height: 56rpx;
  text-align: center;
  box-sizing: border-box;
}

.map-chip.active {
  background: #47bffe;
  color: #ffffff;
}
