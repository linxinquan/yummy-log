/* 觅食图 V2 - 攻略详情页样式 (路线规划版) */

.container {
  background: #FFFFFF;
  min-height: 100vh;
}

/* ── 顶部导航栏 ── */
.nav-bar {
  position: fixed;
  left: 0;
  right: 0;
  z-index: 200;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10px);
}

.nav-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  height: 88rpx;
}

.nav-left {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  font-size: 40rpx;
  color: #000000;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 500;
  color: #000000;
}

.nav-right {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.nav-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-btn i {
  font-size: 36rpx;
  color: #666666;
}

.collect-icon {
  font-size: 36rpx;
}

/* ── 地图模式 ── */
.map-mode {
  padding-top: calc(env(safe-area-inset-top) + 88rpx);
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

.map-container {
  position: fixed;
  top: calc(env(safe-area-inset-top) + 88rpx);
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1;
}

.main-map {
  width: 100%;
  height: 100%;
}

.date-tabs-bottom {
  position: fixed;
  bottom: 480rpx;
  left: 32rpx;
  right: 32rpx;
  display: flex;
  gap: 16rpx;
  z-index: 10;
  background: rgba(255, 255, 255, 0.95);
  padding: 16rpx 24rpx;
  border-radius: 16rpx;
  backdrop-filter: blur(10px);
}

.date-tab {
  flex: 1;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #666666;
  background: #F6F6F6;
}

.day-itinerary {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  z-index: 20;
  max-height: 60vh;
  overflow-y: auto;
}

.day-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.day-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #000000;
}

.edit-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  background: #FF6B35;
  border-radius: 20rpx;
}

.edit-btn i {
  font-size: 28rpx;
  color: #FFFFFF;
}

.edit-btn text {
  font-size: 26rpx;
  color: #FFFFFF;
}

.route-detail {
  margin-bottom: 32rpx;
}

.route-text {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.6;
}

.spot-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.spot-card {
  display: flex;
  gap: 24rpx;
  padding: 24rpx;
  background: #F9F9F9;
  border-radius: 20rpx;
}

.spot-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}

.spot-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 12rpx;
}

.spot-name {
  font-size: 32rpx;
  font-weight: 500;
  color: #000000;
}

.spot-desc {
  font-size: 26rpx;
  color: #999999;
}

.spot-tag {
  align-self: flex-start;
  padding: 8rpx 16rpx;
  background: #FFE4D8;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #FF6B35;
}

/* ── 列表模式 ── */
.list-mode {
  padding-top: calc(env(safe-area-inset-top) + 88rpx);
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

.date-tabs-scroll {
  white-space: nowrap;
  background: #FFFFFF;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.date-tabs {
  display: inline-flex;
  gap: 24rpx;
}

.section {
  padding: 32rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #000000;
}

.day-cards {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.day-card {
  padding: 24rpx;
  background: #F9F9F9;
  border-radius: 20rpx;
  position: relative;
  overflow: hidden;
}

.day-header {
  display: flex;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.day-num {
  font-size: 28rpx;
  font-weight: 600;
  color: #000000;
}

.day-location {
  font-size: 26rpx;
  color: #999999;
}

.day-route {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.day-img {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
}

/* 日期详情页面 */
.day-detail-page {
  padding: 32rpx;
}

.day-header-large {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.route-timeline {
  padding-left: 24rpx;
}

.timeline-item {
  display: flex;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.timeline-node {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 24rpx;
}

.node-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #FF6B35;
  border: 4rpx solid #FFFFFF;
  box-shadow: 0 0 0 4rpx #FFE4D8;
}

.node-line {
  flex: 1;
  width: 4rpx;
  background: #E8E8E8;
  margin-top: 12rpx;
}

.timeline-content {
  flex: 1;
}

.timeline-card {
  display: flex;
  gap: 24rpx;
  padding: 24rpx;
  background: #FFF8F5;
  border-radius: 20rpx;
  margin-bottom: 16rpx;
}

.timeline-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}

.timeline-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 12rpx;
}

.timeline-name {
  font-size: 32rpx;
  font-weight: 500;
  color: #000000;
}

.timeline-desc {
  font-size: 26rpx;
  color: #999999;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.timeline-tag {
  align-self: flex-start;
  padding: 8rpx 16rpx;
  background: #FFFFFF;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #FF6B35;
}

.timeline-meta {
  display: flex;
  justify-content: space-between;
  padding-right: 24rpx;
}

.timeline-meta text {
  font-size: 24rpx;
  color: #999999;
}

.time-text {
  color: #FF6B35 !important;
}

/* ── 底部浮动按钮 ── */
.float-btn {
  position: fixed;
  bottom: calc(32rpx + env(safe-area-inset-bottom));
  right: 48rpx;
  width: 120rpx;
  height: 120rpx;
  background: linear-gradient(135deg, #FF6B35 0%, #FF8C42 100%);
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  box-shadow: 0 8rpx 32rpx rgba(255, 107, 53, 0.4);
  z-index: 300;
}

.float-btn i {
  font-size: 40rpx;
  color: #FFFFFF;
}

.float-btn text {
  font-size: 20rpx;
  color: #FFFFFF;
}