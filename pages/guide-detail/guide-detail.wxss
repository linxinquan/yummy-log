page {
  background: #ffffff;
}

.page {
  position: relative;
  height: 100vh;
  background: #ffffff;
  overflow: hidden;
}

.hero-wrap {
  position: relative;
  width: 100%;
  height: 780rpx;
  overflow: hidden;
}

.hero-wrap-map {
  height: 100vh;
}

.hero-map {
  width: 100%;
  height: 100%;
}

.hero-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 220rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0.92) 60%, #ffffff 100%);
  pointer-events: none;
}

.top-actions {
  position: fixed;
  left: 48rpx;
  display: flex;
  align-items: center;
  gap: 32rpx;
  z-index: 30;
}

.top-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
}

.top-icon i {
  font-size: 40rpx;
  color: #ffffff;
}

.mode-switch {
  position: fixed;
  left: 50%;
  transform: translateX(-50%);
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  padding: 4rpx;
  border-radius: 999rpx;
  background: #f6f6f6;
  z-index: 30;
}

.mode-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  min-width: 120rpx;
  height: 56rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  color: #c2c2c2;
  font-size: 28rpx;
  font-weight: 500;
}

.mode-chip i {
  font-size: 32rpx;
}

.mode-chip.active {
  background: #fefefe;
  color: #000000;
}

.detail-sheet {
  position: fixed;
  left: 0;
  right: 0;
  top: 248rpx;
  bottom: 0;
  z-index: 15;
  border-radius: 48rpx 48rpx 0 0;
  background: #ffffff;
  overflow: hidden;
}

.detail-scroll {
  height: 100%;
}

.detail-scroll-inner {
  min-height: 100%;
  padding-top: 40rpx;
  padding-bottom: calc(168rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.sheet-header {
  margin: 0 48rpx;
}

.guide-title {
  display: block;
  color: #000000;
  font-size: 48rpx;
  font-weight: 400;
  line-height: 64rpx;
}

.guide-meta-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-top: 24rpx;
}

.guide-meta,
.guide-city,
.map-meta,
.map-city {
  color: #999999;
  font-size: 28rpx;
  line-height: 28rpx;
}

.tab-sticky-wrap {
  position: sticky;
  top: 0;
  z-index: 22;
  padding-top: 48rpx;
  background: #ffffff;
}

.sheet-content {
  background: #ffffff;
}

.overview-section {
  margin: 64rpx 48rpx 0;
}

.overview-anchor {
  position: relative;
  top: -132rpx;
  height: 0;
}

.overview-title {
  display: block;
  color: #000000;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 32rpx;
}

.overview-list {
  display: flex;
  flex-direction: column;
  gap: 48rpx;
  margin-top: 32rpx;
}

.overview-card {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  padding: 32rpx 32rpx;
  border: 1rpx solid #e8e8e8;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
}

.overview-card-day {
  color: #868686;
  font-size: 28rpx;
  line-height: 100%;
}

.overview-place-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 34rpx;
}

.overview-place-main {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.overview-place-index {
  flex-shrink: 0;
  color: #000000;
  font-size: 28rpx;
  line-height: 28rpx;
}

.overview-place-name {
  flex: 1;
  min-width: 0;
  color: #000000;
  font-size: 28rpx;
  line-height: 28rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.overview-place-tag {
  flex-shrink: 0;
  padding: 6rpx 8rpx;
  border-radius: 8rpx;
  background: #fdf8e3;
  color: #ee8733;
  font-size: 20rpx;
  line-height: 20rpx;
}

.tab-scroll {
  white-space: nowrap;
}

.tab-row {
  display: inline-flex;
  align-items: flex-start;
  gap: 48rpx;
  padding: 0 48rpx;
}

.tab-item {
  display: inline-flex;
  align-items: center;
  color: #c2c2c2;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 32rpx;
  flex-shrink: 0;
}

.tab-item.active {
  color: #000000;
}

.tab-item i {
  font-size: 40rpx;
}

.add-item {
  gap: 8rpx;
  color: #47bffe;
}

.add-item i,
.add-item text {
  color: #000000;
}

.section-divider {
  margin: 32rpx 0 0;
  height: 1rpx;
  background: #e8e8e8;
}

.sort-tip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin: 24rpx 48rpx 0;
  color: #868686;
  font-size: 24rpx;
}

.sort-tip i {
  font-size: 28rpx;
}

.day-section {
  margin-top: 48rpx;
}

.day-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 48rpx 48rpx;
}

.day-title {
  color: #000000;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 32rpx;
}

.day-count {
  color: #868686;
  font-size: 24rpx;
  line-height: 24rpx;
}

.place-list {
  margin: 0 48rpx;
}

.day-anchor {
  position: relative;
  top: -132rpx;
  height: 0;
}

.place-row {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 32rpx;
  height: 160rpx;
  margin-bottom: 48rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.place-row.dragging {
  transform: scale(1.02);
  opacity: 0.92;
}

.place-cover {
  width: 160rpx;
  height: 160rpx;
  border-radius: 24rpx;
  flex-shrink: 0;
  display: block;
}

.place-main {
  flex: 1;
  height: 144rpx;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  min-width: 0;
  justify-content: center;
}

.place-info-row {
  flex: 1;
  min-width: 0;
  height: 144rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.place-head {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 16rpx;
}

.place-tag {
  min-width: 48rpx;
  max-width: 100%;
  height: 32rpx;
  padding: 6rpx 8rpx;
  border-radius: 8rpx;
  background: #fdf8e3;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.place-tag-text {
  color: #ee8733;
  font-size: 20rpx;
  line-height: 20rpx;
  font-weight: 400;
  text-align: center;
  white-space: nowrap;
}

.place-name {
  width: 100%;
  color: #000000;
  font-size: 32rpx;
  line-height: 32rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.place-meta-line {
  display: inline-flex;
  max-width: 100%;
}

.place-arrow,
.place-handle {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.place-arrow i {
  color: #cccccc;
  font-size: 40rpx;
  line-height: 40rpx;
}

.place-handle i {
  color: #b7b7b7;
  font-size: 32rpx;
}

.empty-day {
  margin: 0 48rpx;
  padding: 40rpx 32rpx;
  border-radius: 24rpx;
  background: #f7f7f7;
  color: #999999;
  font-size: 26rpx;
  text-align: center;
}

.day-separator {
  width: 100%;
  height: 16rpx;
  background: #f2f6f7;
}

.overview-separator {
  margin-top: 48rpx;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  padding: 16rpx 48rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #ffffff 0.1;
  z-index: 40;
}

.bottom-btn {
  flex: 1;
  min-width: 0;
  height: 96rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.bottom-btn i {
  font-size: 40rpx;
}

.bottom-btn text {
  font-size: 32rpx;
  font-weight: 500;
}

.bottom-btn.secondary {
  border: 2rpx solid #e7e7e7;
  color: #060606;
  background: #ffffff;
}

.bottom-btn.primary {
  background: #47bffe;
  color: #ffffff;
}

.map-panel {
  position: fixed;
  left: 48rpx;
  right: 48rpx;
  bottom: 48rpx;
  z-index: 20;
}

.map-panel-actions {
  position: absolute;
  left: 0;
  right: 0;
  bottom: calc(100% + 32rpx);
  display: flex;
  align-items: center;
  justify-content: space-between;
  pointer-events: none;
}

.map-floating-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  pointer-events: auto;
}

.map-floating-icon i {
  font-size: 48rpx;
  color: #09244b;
  line-height: 1;
}

.map-card {
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.05);
}

.route-map-preview-card {
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  padding: 32rpx;
  min-height: 520rpx;
}

.preview-tabs-panel {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  width: 100%;
}

.preview-tab-row {
  display: flex;
  align-items: center;
  gap: 32rpx;
  width: 100%;
  min-width: 0;
}

.preview-tab-item {
  flex-shrink: 0;
  color: #c2c2c2;
  font-size: 32rpx;
  line-height: 32rpx;
  font-weight: 500;
}

.preview-tab-item.active {
  color: #000000;
}

.preview-tab-divider {
  width: 100%;
  height: 2rpx;
  background: #e8e8e8;
}

.preview-card-stage {
  width: 100%;
}

.preview-detail-card {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  width: 100%;
}

.preview-side-inner {
  display: flex;
  flex-direction: column;
  gap: 40rpx;
  width: 100%;
}

.preview-card-head {
  display: flex;
  align-items: center;
  gap: 32rpx;
  width: 100%;
  min-width: 0;
}

.preview-cover-image {
  width: 128rpx;
  height: 128rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}

.preview-head-main {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 24rpx;
}

.preview-name {
  display: block;
  width: 100%;
  min-width: 0;
  max-width: 100%;
  color: #000000;
  font-size: 36rpx;
  line-height: 36rpx;
  font-weight: 400;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.preview-meta-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  width: 100%;
  min-width: 0;
  overflow: hidden;
}

.preview-chip {
  flex-shrink: 0;
  max-width: 160rpx;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  background: #f6f6f6;
  color: #bababa;
  font-size: 22rpx;
  line-height: 22rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.preview-chip.score {
  background: #fdf8e3;
  color: #ee8733;
}

.preview-desc-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  width: 100%;
}

.preview-desc-left,
.preview-desc-right {
  min-width: 0;
  color: #999999;
  font-size: 28rpx;
  line-height: 28rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.preview-desc-left {
  flex: 1;
}

.preview-desc-right {
  flex-shrink: 0;
  max-width: 180rpx;
  text-align: right;
}

.preview-btn-row {
  display: flex;
  gap: 20rpx;
  width: 100%;
}

.preview-btn {
  flex: 1;
  min-width: 0;
  height: 88rpx;
  border-radius: 16rpx;
  background: #f7f7f7;
  display: flex;
  align-items: center;
  justify-content: center;
}

.preview-btn text {
  color: #000000;
  font-size: 28rpx;
  line-height: 28rpx;
}

.preview-btn.disabled {
  opacity: 0.35;
}

.preview-footer {
  display: grid;
  grid-template-columns: minmax(72rpx, auto) minmax(0, 1fr) minmax(72rpx, auto);
  align-items: center;
  column-gap: 16rpx;
  width: 100%;
  height: 32rpx;
  min-height: 32rpx;
}

.preview-footer-side {
  min-width: 72rpx;
  height: 32rpx;
  color: #999999;
  font-size: 24rpx;
  line-height: 24rpx;
  display: flex;
  align-items: center;
  justify-self: start;
  text-align: left;
}

.preview-footer travel-meta-line {
  height: 32rpx;
  display: flex;
  align-items: center;
  justify-self: center;
  min-width: 0;
  max-width: 100%;
}

.preview-footer-side.right {
  justify-content: flex-end;
  justify-self: end;
  text-align: right;
}
