<view class="container" wx:if="{{guide}}">
  <!-- ── 顶部图片区 ── -->
  <view class="hero-wrap">
    <image class="hero-img" src="{{guide.coverImage || '/images/app-logo.jpg'}}" mode="aspectFill" />
    
    <!-- 自定义导航栏按钮 -->
    <view class="top-bar" style="top: {{menuTop}}px; height: {{menuHeight}}px;">
      <view class="icon-btn back-btn" bindtap="onBack">
        <i class="mgc_left_line back-icon"></i>
      </view>
      <view class="icon-btn share-btn" bindtap="onShareTap">
        <i class="mgc_share_forward_line share-icon"></i>
      </view>
    </view>

    <!-- 底部统计 -->
    <view class="hero-stats">
      <text class="stats-text">{{routeStats}}</text>
    </view>
    
    <!-- 底部圆角遮罩 -->
    <view class="hero-overlay"></view>
  </view>

  <!-- ── 内容区 ── -->
  <view class="content-wrap">
    
    <!-- 基本信息 -->
    <view class="main-info">
      <view class="info-header">
        <view class="info-left">
          <view class="tags-row">
            <view class="tag-badge"><text>{{guide.duration}}</text></view>
            <view class="tag-badge"><text>{{guide.shopCount || guide.shops.length || 0}} 个地点</text></view>
            <view class="tag-badge" wx:for="{{guide.tags}}" wx:key="*this"><text>{{item}}</text></view>
          </view>
          <text class="spot-title">{{guide.title}}</text>
        </view>
        <!-- 收藏图标 -->
        <view class="collect-btn" bindtap="onCollect">
          <i class="{{isCollected ? 'mgc_heart_fill' : 'mgc_heart_line'}} collect-icon" style="{{isCollected ? 'color: #DC6962;' : ''}}"></i>
        </view>
      </view>
      
      <text class="open-time">作者：{{guide.author || '匿名作者'}} · {{guide.likes || 0}} 人喜欢</text>
      
      <text class="spot-desc" wx:if="{{guide.desc}}">{{guide.desc}}</text>
    </view>
    
    <!-- 分割线 -->
    <view class="divider"></view>
    
    <!-- 路线地图 -->
    <view class="map-section">
      <view class="section-header">
        <text class="section-title">路线地图</text>
        <text class="more-btn" bindtap="onViewRoute">查看路线</text>
      </view>
      <view class="map-card" bindtap="onViewRoute">
        <map
          class="mini-map"
          latitude="{{mapCenter.lat}}"
          longitude="{{mapCenter.lng}}"
          scale="14"
          markers="{{mapMarkers}}"
          polyline="{{polyline}}"
          enable-zoom="{{false}}"
          enable-scroll="{{false}}"
          enable-rotate="{{false}}"
          enable-overlooking="{{false}}"
        ></map>
        <view class="map-legend">
          <view class="legend-item">
            <view class="legend-dot start"></view>
            <text>起点</text>
          </view>
          <view class="legend-item">
            <view class="legend-dot end"></view>
            <text>终点</text>
          </view>
          <view class="legend-item">
            <view class="legend-line"></view>
            <text>路线</text>
          </view>
        </view>
      </view>
    </view>
    
    <!-- 行程安排 -->
    <view class="route-section">
      <view class="section-header">
        <text class="section-title">行程安排</text>
        <text class="more-btn" bindtap="onAddRoute">加入想去</text>
      </view>
      
      <view class="route-list">
        <view 
          class="route-item" 
          wx:for="{{routeItems}}" 
          wx:key="index"
          bindtap="onItemTap"
          data-item="{{item}}"
        >
          <view class="route-num">{{index + 1}}</view>
          <view class="route-info">
            <text class="route-name">{{item.name}}</text>
            <text class="route-desc">{{item.desc || item.category}}</text>
            <view class="route-meta">
              <text class="route-time">{{item.time || '约1小时'}}</text>
              <text class="route-dist" wx:if="{{item.distance}}">{{item.distance}}</text>
            </view>
          </view>
          <view class="route-arrow">
            <i class="mgc_right_line"></i>
          </view>
        </view>
      </view>
    </view>
    
    <!-- 路线统计 -->
    <view class="stats-section">
      <view class="stat-item">
        <text class="stat-value">{{totalDistance}}</text>
        <text class="stat-label">总距离</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-value">{{totalTime}}</text>
        <text class="stat-label">预计时间</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-value">{{guide.shopCount || guide.shops.length || 0}}</text>
        <text class="stat-label">途经地点</text>
      </view>
    </view>
    
  </view>

  <!-- ── 底部操作栏 ── -->
  <view class="bottom-action-bar">
    <view class="action-bg"></view>
    <view class="action-content">
      <view class="nav-btn" bindtap="onShareTap">
        <text>分享</text>
      </view>
      <view class="want-btn" bindtap="onAddRoute">
        <text>开始导航</text>
      </view>
    </view>
  </view>
</view>