<view class="container" wx:if="{{guide}}">
  <!-- ── 顶部导航栏 ── -->
  <view class="nav-bar" style="top: {{menuTop}}px; height: {{menuHeight + 16}}px;">
    <view class="nav-content">
      <view class="nav-left" bindtap="onBack">
        <i class="mgc_left_line back-icon"></i>
      </view>
      <view class="nav-title">{{guide.title}}</view>
      <view class="nav-right">
        <view class="nav-btn" bindtap="onTip">
          <i class="mgc_lightbulb_line tip-icon"></i>
        </view>
        <view class="nav-btn" bindtap="onToggleMode">
          <i class="mgc_list_line list-icon" wx:if="{{mode === 'map'}}"></i>
          <i class="mgc_map_pin_line map-icon" wx:else></i>
        </view>
        <view class="nav-btn" bindtap="onCollect">
          <i class="{{isCollected ? 'mgc_heart_fill' : 'mgc_heart_line'}} collect-icon" style="{{isCollected ? 'color: #DC6962;' : ''}}"></i>
        </view>
      </view>
    </view>
  </view>

  <!-- ── 地图模式 ── -->
  <view class="map-mode" wx:if="{{mode === 'map'}}">
    <view class="map-container">
      <map
        class="main-map"
        latitude="{{mapCenter.lat}}"
        longitude="{{mapCenter.lng}}"
        scale="14"
        markers="{{mapMarkers}}"
        polyline="{{polyline}}"
        enable-zoom="{{true}}"
        enable-scroll="{{true}}"
        enable-rotate="{{false}}"
        enable-overlooking="{{false}}"
      ></map>
    </view>
    
    <!-- 底部日期标签 -->
    <view class="date-tabs-bottom">
      <view 
        class="date-tab" 
        wx:for="{{dateTabs}}" 
        wx:key="index"
        bindtap="onDateTab"
        data-index="{{index}}"
        style="{{currentDay === index ? 'background: #FF6B35; color: #FFFFFF;' : ''}}"
      >
        {{item}}
      </view>
    </view>
    
    <!-- 当天行程列表 -->
    <view class="day-itinerary">
      <view class="day-header">
        <text class="day-title">{{currentDayName}}</text>
        <view class="edit-btn" bindtap="onEditRoute">
          <i class="mgc_edit_2_line"></i>
          <text>编辑路线</text>
        </view>
      </view>
      <view class="route-detail">
        <text class="route-text">{{currentRouteText}}</text>
      </view>
      <view class="spot-list">
        <view 
          class="spot-card" 
          wx:for="{{currentDaySpots}}" 
          wx:key="index"
          bindtap="onSpotTap"
          data-spot="{{item}}"
        >
          <image class="spot-img" src="{{item.image}}" mode="aspectFill" />
          <view class="spot-info">
            <text class="spot-name">{{item.name}}</text>
            <text class="spot-desc">{{item.desc}}</text>
          </view>
          <view class="spot-tag">{{item.tag}}</view>
        </view>
      </view>
    </view>
  </view>

  <!-- ── 列表模式 ── -->
  <view class="list-mode" wx:else>
    <!-- 日期标签 -->
    <scroll-view class="date-tabs-scroll" scroll-x>
      <view class="date-tabs">
        <view 
          class="date-tab" 
          wx:for="{{dateTabs}}" 
          wx:key="index"
          bindtap="onDateTab"
          data-index="{{index}}"
          style="{{currentDay === index ? 'background: #FF6B35; color: #FFFFFF;' : ''}}"
        >
          {{item}}
        </view>
      </view>
    </scroll-view>
    
    <!-- 总览页面 -->
    <view class="overview-page" wx:if="{{currentDay === 0}}">
      <!-- 行程总览 -->
      <view class="section">
        <text class="section-title">行程总览</text>
        <view class="day-cards">
          <view 
            class="day-card" 
            wx:for="{{daySummaries}}" 
            wx:key="index"
            bindtap="onDayCard"
            data-day="{{index + 1}}"
          >
            <view class="day-header">
              <text class="day-num">第{{index + 1}}天</text>
              <text class="day-location" wx:if="{{item.location}}">{{item.location}}</text>
            </view>
            <text class="day-route">{{item.route}}</text>
            <image class="day-img" src="{{item.image}}" mode="aspectFill" />
          </view>
        </view>
      </view>
      
      <!-- 今日行程 -->
      <view class="section">
        <view class="section-header">
          <text class="section-title">第1天</text>
          <view class="edit-btn" bindtap="onEditRoute">
            <i class="mgc_edit_2_line"></i>
            <text>编辑路线</text>
          </view>
        </view>
        <text class="route-text">{{daySummaries[0].route}}</text>
        <view class="spot-list">
          <view 
            class="spot-card" 
            wx:for="{{currentDaySpots}}" 
            wx:key="index"
            bindtap="onSpotTap"
            data-spot="{{item}}"
          >
            <image class="spot-img" src="{{item.image}}" mode="aspectFill" />
            <view class="spot-info">
              <text class="spot-name">{{item.name}}</text>
              <text class="spot-desc">{{item.desc}}</text>
            </view>
            <view class="spot-tag">{{item.tag}}</view>
          </view>
        </view>
      </view>
    </view>
    
    <!-- 日期详情页面 -->
    <view class="day-detail-page" wx:else>
      <view class="day-header-large">
        <text class="day-title">{{currentDayName}}</text>
        <view class="edit-btn" bindtap="onEditRoute">
          <i class="mgc_edit_2_line"></i>
          <text>编辑路线</text>
        </view>
      </view>
      <text class="route-text">{{currentRouteText}}</text>
      
      <view class="route-timeline">
        <view 
          class="timeline-item" 
          wx:for="{{currentDaySpots}}" 
          wx:key="index"
          bindtap="onSpotTap"
          data-spot="{{item}}"
        >
          <view class="timeline-node">
            <view class="node-dot"></view>
            <view class="node-line" wx:if="{{index < currentDaySpots.length - 1}}"></view>
          </view>
          <view class="timeline-content">
            <view class="timeline-card">
              <image class="timeline-img" src="{{item.image}}" mode="aspectFill" />
              <view class="timeline-info">
                <text class="timeline-name">{{item.name}}</text>
                <text class="timeline-desc">{{item.desc}}</text>
              </view>
              <view class="timeline-tag">{{item.tag}}</view>
            </view>
            <view class="timeline-meta" wx:if="{{item.distance}}">
              <text>{{item.distance}}</text>
              <text class="time-text">{{item.time}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- ── 底部浮动按钮 ── -->
  <view class="float-btn" bindtap="onStartNav">
    <i class="mgc_navigation_line"></i>
    <text>开始导航</text>
  </view>
</view>