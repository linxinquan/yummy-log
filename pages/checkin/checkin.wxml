<!-- pages/checkin/checkin.wxml - 采集 v6 · 美食/景点采集卡片 · 基于 Design System v1.0 -->

<!-- WXS -->
<wxs module="utils">
module.exports = { len: function(v) { return v == null ? 0 : typeof v === 'string' ? v.length : typeof v === 'number' ? String(v).length : 0; } };
</wxs>

<view class="page {{type === 'spot' ? 'type-spot' : 'type-food'}}">
  <!-- 大标题：对齐我的收藏这类二级页 -->
  <view class="header">
    <view class="header-row">
      <view class="district-title">{{navTitle || '采集打卡'}}</view>
      <view class="header-action-btn" bindtap="onGoCollection">
        <i class="mgc_flower_4_line"></i>
        <text>采集本</text>
      </view>
    </view>
  </view>

  <!-- ══════════════════════════════════════════════════ -->
  <!-- STEP 1：拍照 -->
  <!-- ══════════════════════════════════════════════════ -->
  <view class="section" wx:if="{{step === 1}}">

    <!-- 引导语 -->
    <view class="guide-tip">
      <view class="gt-dot"></view>
      <text class="gt-title heading-2">{{type === 'spot' ? '定格城市足迹' : '记录舌尖美味'}}</text>
      <text class="gt-sub body-sm">{{type === 'spot' ? '拍下这一刻的城市风景' : '一张照片，留住探店的味道'}}</text>
    </view>

    <!-- 拍照卡片 -->
    <view class="photo-card" bindtap="onChoosePhoto">
      <view wx:if="{{photoPath}}" class="pc-preview">
        <image class="pc-photo" src="{{photoPath}}" mode="aspectFill" />
        <view class="pc-retake-btn" catchtap="onChoosePhoto">
          <text class="caption">重新拍摄</text>
        </view>
      </view>
      <view wx:else class="pc-empty">
        <view class="pce-camera">
          <text class="pce-icon">📷</text>
        </view>
        <text class="pce-title heading-3">点击拍照</text>
        <text class="pce-sub caption">或从相册选择</text>
      </view>
    </view>

    <!-- 辅助入口：自动拉起相机后，用户仍然可以改走相册上传或查看采集本 -->
    <view class="photo-extra-row">
      <view class="photo-extra-btn" bindtap="onChooseAlbum">
        <i class="mgc_pic_2_line"></i>
        <text>相册上传</text>
      </view>
      <view class="photo-extra-btn secondary" bindtap="onGoCollection">
        <i class="mgc_album_line"></i>
        <text>查看采集</text>
      </view>
    </view>

    <!-- 下一步 -->
    <view class="btn-primary {{photoPath ? 'ready' : ''}}" bindtap="onNextStep">
      <text class="btn-primary-text body">{{photoPath ? '下一步 · AI 识别位置' : '请先拍照'}}</text>
      <text class="btn-primary-arrow body" wx:if="{{photoPath}}">→</text>
    </view>
  </view>

  <!-- ══════════════════════════════════════════════════ -->
  <!-- STEP 2：定位 + AI 内容 -->
  <!-- ══════════════════════════════════════════════════ -->
  <view class="section step-two-section" wx:if="{{step === 2}}">
    <!-- 主卡片：重新整理图片区、位置信息区、AI 文案区的层级 -->
    <view class="main-card checkin-detail-card">
      <view class="detail-hero">
        <view class="mct-photo-wrap detail-photo" wx:if="{{photoPath}}">
          <image class="mct-photo" src="{{photoPath}}" mode="aspectFill" />
        </view>
        <view class="detail-hero-main">
          <view class="mct-type-badge {{type}}">
            <text class="mct-type-dot"></text>
            <text class="mct-type-label caption">{{type === 'spot' ? '景点' : '美食'}}</text>
          </view>
          <text class="detail-date caption">{{dateInfo.mm}}.{{dateInfo.dd}} · {{dateInfo.yyyy}}</text>
          <text class="detail-title">刚刚记录的这一刻</text>
          <text class="detail-subtitle">确认地点后即可生成更完整的打卡文案</text>
        </view>
      </view>

      <!-- 位置区：保留一层内容容器，不再套内层描边卡片 -->
      <view class="detail-panel location-panel">
        <view class="detail-panel-head">
          <view class="lb-icon-wrap {{type}}">
            <i class="mgc_location_line lb-icon caption"></i>
          </view>
          <view class="detail-panel-copy">
            <text class="detail-panel-title">识别到的位置</text>
            <text class="detail-panel-desc">支持补充地点名称和详细地址</text>
          </view>
          <view class="lb-refresh {{type}}" bindtap="onGetLocation">
            <text class="caption">⟳</text>
          </view>
        </view>

        <view class="lb-info">
          <view class="lb-loading" wx:if="{{locationLoading}}">
            <text class="lb-loading-text caption">正在定位...</text>
            <view class="lb-spinner"></view>
          </view>
          <view class="lb-result" wx:else>
            <view class="lb-name-row">
              <text class="lb-name heading-1 {{spotName ? '' : 'placeholder'}}"
                    wx:if="{{!editingName}}"
                    bindtap="onToggleNameEdit">{{spotName || '点击设置地点名称'}}</text>
              <input class="lb-name-input heading-1"
                     wx:else
                     value="{{spotName}}"
                     bindinput="onNameInput"
                     bindblur="onToggleNameEdit"
                     focus
                     placeholder="输入地点名称"
                     maxlength="30" />
              <view class="lb-edit-btn caption" bindtap="onToggleNameEdit" wx:if="{{!editingName}}">
                <i class="mgc_pencil_3_line"></i>
              </view>
            </view>
            <view class="lb-addr-row">
              <text class="lb-addr caption {{address ? '' : 'dim'}}"
                    wx:if="{{!editingAddr}}"
                    bindtap="onToggleAddrEdit">{{address || '详细地址（点击补充）'}}</text>
              <input class="lb-addr-input caption"
                     wx:else
                     value="{{address}}"
                     bindinput="onAddrInput"
                     bindblur="onToggleAddrEdit"
                     focus
                     placeholder="输入详细地址"
                     maxlength="50" />
            </view>
          </view>
        </view>
      </view>

      <!-- AI 区：只保留分区，不再和外层形成双重描边 -->
      <view class="detail-panel ai-panel">
        <view class="detail-panel-head ai-panel-head">
          <view class="aibe-icon {{type}} caption">✦</view>
          <view class="detail-panel-copy">
            <text class="detail-panel-title">生成打卡内容</text>
            <text class="detail-panel-desc">根据图片和地点整理一句更自然的文案</text>
          </view>
        </view>

        <view class="ai-block">
          <view class="aib-empty {{generatingTitle || generatingDesc ? 'hidden' : ''}}" bindtap="onGenerate">
            <view class="aibe-texts">
              <text class="aibe-title body">生成打卡内容</text>
              <text class="aibe-hint caption">AI 将根据位置和图片内容生成描述文案</text>
            </view>
            <view class="aibe-arrow {{type}} caption">→</view>
          </view>

          <view class="aib-generating {{(!generatingTitle && !generatingDesc) ? 'hidden' : ''}}">
            <view class="aibg-header">
              <view class="aibg-badge {{type}}">
                <text class="aibg-badge-text caption">AI 生成中</text>
              </view>
            </view>
            <text class="aibg-title heading-2">{{generatingTitle}}<text class="cursor {{type}}">|</text></text>
            <text class="aibg-desc body-sm" wx:if="{{generatingDesc}}">{{generatingDesc}}<text class="cursor {{type}}">|</text></text>
          </view>

          <view class="aib-result {{(title && !generatingTitle && !generatingDesc) ? '' : 'hidden'}}" wx:if="{{title}}">
            <view class="aibr-header">
              <view class="aibr-badge {{type}}">
                <text class="aibr-badge-text caption">AI 打卡文案</text>
              </view>
              <view class="aibr-retry {{type}} caption" bindtap="onGenerate">
                <text>重新生成</text>
              </view>
            </view>
            <text class="aibr-title heading-2">{{title}}</text>
            <text class="aibr-desc body-sm">{{description}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 底部按钮：对齐项目其他页面的 bottom-btn 结构 -->
    <view class="bottom-bar checkin-bottom-bar">
      <view class="bottom-btn secondary checkin-bottom-secondary" bindtap="onPrevStep">
        <i class="mgc_camera_2_ai_line"></i>
        <text>重新拍照</text>
      </view>
      <view class="bottom-btn primary checkin-bottom-primary" bindtap="onGenerate">
        <i class="mgc_pic_ai_line"></i>
        <text>{{generatingTitle || generatingDesc ? '生成中...' : '生成打卡内容'}}</text>
      </view>
    </view>

    <!-- 继续提示 -->
    <view class="continue-tip" wx:if="{{title && !generatingTitle && !generatingDesc}}">
      <text class="ct-text caption">文案已生成，可直接点击「确认采集」保存这一刻</text>
    </view>

  </view>

  <!-- ══════════════════════════════════════════════════ -->
  <!-- STEP 3：最终预览 -->
  <!-- ══════════════════════════════════════════════════ -->
  <view class="section" wx:if="{{step === 3}}">

    <!-- 预览卡片 -->
    <view class="preview-card card">

      <!-- 照片区：顶上大图 + 叠加层 -->
      <view class="pvc-photo-wrap" wx:if="{{photoPath}}">
        <image class="pvc-photo" src="{{photoPath}}" mode="aspectFill" />
        <!-- 类型标签：左上 -->
        <view class="pvc-type-tag {{type}} caption">
          <text class="pvc-type-dot"></text>
          {{type === 'spot' ? '景点' : '美食'}}
        </view>
        <!-- 附近美食：右下半透明条 -->
        <view class="pvc-nearby caption" wx:if="{{nearbyFood}}">
          <text>{{nearbyFood}}</text>
        </view>
      </view>

      <!-- 信息区 -->
      <view class="pvc-info">
        <!-- AI 标题：emoji + 主标题｜POI副标题 -->
        <view class="pvci-title-row" wx:if="{{title}}">
          <i class="{{type === 'spot' ? 'mgc_scenery_line' : 'mgc_fork_spoon_line'}} pvci-emoji {{type}}"></i>
          <text class="pvci-title-main heading-2">{{title}}</text>
        </view>
        <view class="pvci-subtitle-row">
          <text class="pvci-title-sub body-sm">{{spotName || '未知地点'}}</text>
        </view>

        <!-- AI 描述：单独一行 + badge左上 -->
        <view class="pvci-ai" wx:if="{{description}}">
          <view class="pvia-badge {{type}}">
            <text class="pvia-badge-text caption">AI</text>
          </view>
          <text class="pvia-text body-sm">{{description}}</text>
        </view>

        <!-- 日期：右下角竖排 -->
        <view class="pvci-date">
          <text class="pvic-month body-sm">{{dateInfo.mm}}/{{dateInfo.dd}}</text>
          <text class="pvic-year caption">{{dateInfo.yyyy}}</text>
        </view>
      </view>

    </view>

    <!-- 分隔线 + 按钮 -->
    <view class="step3-divider"></view>
    <!-- 确认按钮 -->
    <view class="btn-primary main {{saving ? 'loading' : ''}}" bindtap="onSaveCheckin">
      <view wx:if="{{!saving}}" class="bpm-inner">
        <text class="bpm-icon heading-3">✦</text>
        <text class="bpm-text body">确认采集</text>
      </view>
      <text wx:else class="bpm-loading body">保存中...</text>
    </view>
    <view class="btn-ghost body" bindtap="onPrevStep">← 重新编辑</view>

  </view>

  <!-- ══════════════════════════════════════════════════ -->
  <!-- STEP 4：采集成功 -->
  <!-- ══════════════════════════════════════════════════ -->
  <view class="section success-section" wx:if="{{step === 4}}">

    <!-- 成功动画 -->
    <view class="success-hero">
      <view class="sh-ring"></view>
      <view class="sh-icon {{type}} heading-2">✦</view>
      <text class="sh-title display">采集成功</text>
      <text class="sh-sub caption">已收入你的旅行足迹</text>
    </view>

    <!-- 打卡卡片 -->
    <view class="preview-card card">
      <view class="pvc-photo-wrap" wx:if="{{photoPath}}">
        <image class="pvc-photo" src="{{photoPath}}" mode="aspectFill" />
        <view class="pvc-type-tag {{type}} caption">
          <text class="pvc-type-dot"></text>
          {{type === 'spot' ? '景点' : '美食'}}
        </view>
        <view class="pvc-nearby caption" wx:if="{{nearbyFood}}">
          <text>{{nearbyFood}}</text>
        </view>
      </view>
      <view class="pvc-info">
        <!-- AI 标题：emoji + 主标题｜POI副标题 -->
        <view class="pvci-title-row" wx:if="{{title}}">
          <i class="{{type === 'spot' ? 'mgc_scenery_line' : 'mgc_fork_spoon_line'}} pvci-emoji {{type}}"></i>
          <text class="pvci-title-main heading-2">{{title}}</text>
        </view>
        <view class="pvci-subtitle-row">
          <text class="pvci-title-sub body-sm">{{spotName || '未知地点'}}</text>
        </view>
        <!-- AI 描述：单独一行 + badge左上 -->
        <view class="pvci-ai" wx:if="{{description}}">
          <view class="pvia-badge {{type}}">
            <text class="pvia-badge-text caption">AI</text>
          </view>
          <text class="pvia-text body-sm">{{description}}</text>
        </view>
        <!-- 日期：右下角竖排 -->
        <view class="pvci-date">
          <text class="pvic-month body-sm">{{dateInfo.mm}}/{{dateInfo.dd}}</text>
          <text class="pvic-year caption">{{dateInfo.yyyy}}</text>
        </view>
      </view>
    </view>

    <!-- 足迹地图 -->
    <view class="map-section card">
      <view class="ms-header">
        <text class="ms-title body">足迹地图</text>
        <view class="ms-toggle">
          <view class="mst-btn caption {{mapView === 'map' ? 'active' : ''}}" data-view="map" bindtap="onSwitchView">地图</view>
          <view class="mst-btn caption {{mapView === 'list' ? 'active' : ''}}" data-view="list" bindtap="onSwitchView">列表</view>
        </view>
      </view>

      <!-- 地图视图 -->
      <view class="ms-map-wrap" wx:if="{{mapView === 'map'}}">
        <map class="ms-map" latitude="{{mapCenter.latitude}}" longitude="{{mapCenter.longitude}}"
             scale="{{mapScale}}" markers="{{allMarkers}}" show-location enable-zoom />
        <view class="ms-stat-badge">
          <text class="mssb-num heading-2">{{allMarkers.length}}</text>
          <text class="mssb-label caption">个足迹</text>
        </view>
      </view>

      <!-- 列表视图 -->
      <view class="ms-list" wx:if="{{mapView === 'list'}}">
        <view class="msl-empty caption" wx:if="{{recentCheckins.length === 0}}">暂无记录</view>
        <view class="msl-item" wx:for="{{recentCheckins}}" wx:key="id">
          <view class="msli-dot {{item.type === 'spot' ? 'spot' : 'food'}}"></view>
          <view class="msli-info">
            <text class="msli-name body">{{item.spotName || '未知地点'}}</text>
            <text class="msli-meta caption">{{item.type === 'spot' ? '景点' : '美食'}} · {{item.dateStr || ''}}</text>
          </view>
          <view class="msli-icon {{item.type}} caption">{{item.type === 'spot' ? '🏛' : '🍽'}}</view>
        </view>
      </view>
    </view>

    <!-- 操作按钮 -->
    <view class="btn-row success-actions">
      <view class="btn-ghost body" bindtap="onReset">继续采集</view>
      <view class="btn-primary body" bindtap="onGoCollection">
        <text class="btn-primary-text">查看采集本 →</text>
      </view>
    </view>
  </view>

</view>
