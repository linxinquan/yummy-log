/* pages/checkin/checkin.wxss - 采集 v6 · 基于 Design System v1.0 */

page {
  background: var(--background);
  min-height: 100vh;
}

.page {
  min-height: 100vh;
  background: var(--background);
  padding-bottom: calc(env(safe-area-inset-bottom) + var(--space-lg));
}

/* ══ 导航栏 ════════════════════════════════════════════════ */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-sm) var(--space-lg);
  background: var(--surface);
  padding-top: calc(env(safe-area-inset-top) + var(--space-sm));
  border-bottom: 2rpx solid var(--divider);
}

.nav-back {
  font-size: 52rpx;
  color: var(--primary);
  line-height: 1;
  
  padding: 0 var(--space-xs);
}

.nav-title {
  color: var(--text-primary);
  flex: 1;
  text-align: center;
}

.nav-album-btn {
  display: flex;
  align-items: center;
  gap: var(--space-xs);
  background: var(--primary-light);
  border: 2rpx solid var(--primary-light);
  border-radius: var(--radius-full);
  padding: var(--space-xs) var(--space-md);
}

.nav-album-icon,
.nav-album-text { 
  color: var(--primary-dark); 
   
}

/* ══ 通用 ════════════════════════════════════════════════ */
.section {
  padding: var(--space-lg);
}

/* ══ 引导语 ════════════════════════════════════════════════ */
.guide-tip {
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
  margin-bottom: var(--space-lg);
  padding: var(--space-md) var(--space-lg);
  background: var(--surface);
  border-radius: var(--radius-md);
  border-left: 8rpx solid var(--primary);
  box-shadow: var(--shadow-sm);
}

.gt-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: var(--radius-full);
  background: var(--primary);
  margin-bottom: var(--space-xs);
}

.gt-title {
  color: var(--text-primary);
}

.gt-sub {
  color: var(--text-secondary);
}

/* ══ 拍照卡片 ════════════════════════════════════════════════ */
.photo-card {
  background: var(--surface);
  border-radius: var(--radius-xl);
  overflow: hidden;
  margin-bottom: var(--space-lg);
  box-shadow: var(--shadow-sm);
  border: 2rpx solid var(--divider);
  min-height: 320rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pc-preview {
  width: 100%;
  height: 400rpx; /* ~4:3 */
  position: relative;
}

.pc-photo { width: 100%; height: 100%; object-fit: cover;}

.pc-retake-btn {
  position: absolute;
  bottom: var(--space-md);
  right: var(--space-md);
  background: rgba(255, 255, 255, 0.9);
  border-radius: var(--radius-sm);
  padding: var(--space-xs) var(--space-md);
  backdrop-filter: blur(8px);
  border: 2rpx solid var(--divider);
}

.pc-retake-btn text {
  color: var(--primary);
  
}

.pc-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--space-3xl) var(--space-2xl);
  gap: var(--space-sm);
  width: 100%;
}

.pce-camera {
  width: 120rpx;
  height: 120rpx;
  border-radius: var(--radius-full);
  background: var(--primary-light);
  border: 4rpx dashed var(--primary);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: var(--space-sm);
}

.pce-icon { font-size: 48rpx; }

.pce-title {
  color: var(--text-primary);
}

.pce-sub { color: var(--text-disabled); }

/* ══ 按钮：主按钮 ════════════════════════════════════════════════ */
.btn-primary {
  width: 100%;
  background: var(--surface-muted);
  border: none;
  border-radius: var(--radius-full);
  padding: 0 var(--space-lg);
  height: 96rpx; /* lg size */
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-sm);
  transition: all 0.2s;
  margin-bottom: var(--space-sm);
}

.btn-primary.ready {
  background: var(--dark-button);
  box-shadow: var(--shadow-md);
}

.btn-primary:active { transform: scale(0.98); }

.btn-primary.main {
  background: var(--dark-button);
  box-shadow: var(--shadow-lg);
}

.btn-primary.generating { opacity: 0.7; }
.btn-primary.loading { opacity: 0.7; }

.btn-primary-text {
  color: var(--text-disabled);
  
}

.btn-primary.ready .btn-primary-text,
.btn-primary.main .btn-primary-text { color: var(--surface); }

.btn-primary-arrow {
  color: var(--surface);
  opacity: 0.85;
}

.bpm-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.bpm-icon { line-height: 1; }
.bpm-text { color: var(--surface);  letter-spacing: 2rpx; }
.bpm-loading { color: var(--surface);  }

/* ══ 按钮：幽灵按钮 ════════════════════════════════════════════════ */
.btn-ghost {
  width: 100%;
  background: var(--surface);
  border: 2rpx solid var(--border);
  border-radius: var(--radius-full);
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  
  color: var(--text-secondary);
  transition: all 0.2s;
}

.btn-ghost:active { background: var(--background); }

/* ══ 主卡片 ════════════════════════════════════════════════ */
.main-card {
  margin-bottom: var(--space-lg);
  padding: 0; /* Override default card padding for internal structure */
}

/* 照片 + 日期顶栏 */
.mc-top {
  display: flex;
  gap: var(--space-md);
  padding: var(--space-md);
  border-bottom: 2rpx solid var(--divider);
}

.mct-photo-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: var(--radius-sm);
  overflow: hidden;
  flex-shrink: 0;
  border: 4rpx solid var(--primary);
}

.mct-photo { width: 100%; height: 100%; object-fit: cover;}

.mct-meta {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: var(--space-sm);
}

.mct-type-badge {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  align-self: flex-start;
  padding: 8rpx 16rpx;
  border-radius: var(--radius-full);
  
}

.mct-type-badge.spot {
  color: var(--primary-dark);
  background: var(--primary-light);
}

.mct-type-badge.food {
  color: var(--warning);
  background: rgba(230, 168, 23, 0.1);
}

.mct-type-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: var(--radius-full);
}

.mct-type-badge.spot .mct-type-dot { background: var(--primary); }
.mct-type-badge.food .mct-type-dot { background: var(--warning); }

.mct-date {
  color: var(--text-secondary);
  
}

/* ══ 位置区 ════════════════════════════════════════════════ */
.location-block {
  display: flex;
  align-items: flex-start;
  gap: var(--space-md);
  padding: var(--space-md);
  border-bottom: 2rpx solid var(--divider);
}

.lb-icon-wrap {
  width: 56rpx;
  height: 56rpx;
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.lb-icon-wrap.spot { background: var(--primary-light); }
.lb-icon-wrap.food { background: rgba(230, 168, 23, 0.1); }

.lb-icon { font-size: 32rpx; }

.lb-info { flex: 1; min-width: 0; }

.lb-loading {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  padding: var(--space-sm) 0;
}

.lb-loading-text { color: var(--text-disabled); }

@keyframes spinSlow {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.lb-spinner {
  width: 32rpx;
  height: 32rpx;
  border-radius: var(--radius-full);
  border: 4rpx solid var(--divider);
  border-top-color: var(--primary);
  animation: spinSlow 1s linear infinite;
}

.lb-result { display: flex; flex-direction: column; gap: var(--space-sm); }

.lb-name-row {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
}

.lb-name {
  color: var(--text-primary);
  flex: 1;
  letter-spacing: 0.5rpx;
}

.lb-name.placeholder {
  color: var(--text-disabled);
}

.lb-name-input {
  color: var(--text-primary);
  border: none;
  background: transparent;
  padding: 0;
  flex: 1;
  border-bottom: 4rpx solid var(--primary);
}

.lb-edit-btn {
  color: var(--text-disabled);
  padding: var(--space-xs) var(--space-sm);
  flex-shrink: 0;
}

.lb-addr-row { display: flex; align-items: center; gap: var(--space-sm); }

.lb-addr {
  color: var(--text-secondary);
  flex: 1;
}

.lb-addr.dim { color: var(--text-disabled); }

.lb-addr-input {
  color: var(--text-secondary);
  flex: 1;
  border: none;
  background: transparent;
  padding: 0;
  border-bottom: 2rpx dashed var(--primary-light);
}

.lb-refresh {
  width: 56rpx;
  height: 56rpx;
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border: 2rpx solid;
}

.lb-refresh.spot {
  color: var(--primary-dark);
  background: var(--primary-light);
  border-color: var(--primary-light);
}

.lb-refresh.food {
  color: var(--warning);
  background: rgba(230, 168, 23, 0.1);
  border-color: rgba(230, 168, 23, 0.2);
}

/* ══ AI 内容区 ════════════════════════════════════════════════ */
.ai-block { padding: 0 0 var(--space-xs) 0; }

.aib-divider {
  height: 2rpx;
  background: var(--divider);
  margin: 0 var(--space-md);
}

/* 未生成 */
.aib-empty {
  display: flex;
  align-items: center;
  gap: var(--space-md);
  padding: var(--space-md);
  cursor: pointer;
}

.aib-empty.hidden { display: none; }

.aibe-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.aibe-icon.spot {
  background: var(--primary-light);
  color: var(--primary);
}

.aibe-icon.food {
  background: rgba(230, 168, 23, 0.1);
  color: var(--warning);
}

.aibe-texts { flex: 1; display: flex; flex-direction: column; gap: var(--space-xs); }

.aibe-title {
  color: var(--text-primary);
  
}

.aibe-hint { color: var(--text-disabled); }

.aibe-arrow.spot { color: var(--primary); }
.aibe-arrow.food { color: var(--warning); }

/* 生成中 */
.aib-generating {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
  padding: var(--space-md);
}

.aib-generating.hidden { display: none; }

.aibg-header { margin-bottom: var(--space-xs); }

.aibg-badge {
  display: inline-flex;
  align-items: center;
  padding: var(--space-xs) var(--space-sm);
  border-radius: var(--radius-sm);
  
}

.aibg-badge.spot {
  color: var(--primary-dark);
  background: var(--primary-light);
}

.aibg-badge.food {
  color: var(--warning);
  background: rgba(230, 168, 23, 0.1);
}

.aibg-title {
  color: var(--text-primary);
}

.aibg-desc {
  color: var(--text-secondary);
}

@keyframes blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0; }
}

.cursor.spot { animation: blink 1s ease-in-out infinite; color: var(--primary); }
.cursor.food { animation: blink 1s ease-in-out infinite; color: var(--warning); }

/* 已生成 */
.aib-result {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
  padding: var(--space-md);
}

.aib-result.hidden { display: none; }

.aibr-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--space-xs);
}

.aibr-badge {
  display: inline-flex;
  align-items: center;
  padding: var(--space-xs) var(--space-sm);
  border-radius: var(--radius-sm);
}

.aibr-badge.spot {
  color: var(--primary-dark);
  background: var(--primary-light);
}

.aibr-badge.food {
  color: var(--warning);
  background: rgba(230, 168, 23, 0.1);
}

.aibr-badge-text {  }

.aibr-retry {
  padding: var(--space-xs) var(--space-sm);
  border-radius: var(--radius-sm);
  
}

.aibr-retry.spot {
  color: var(--primary-dark);
  background: var(--primary-light);
}

.aibr-retry.food {
  color: var(--warning);
  background: rgba(230, 168, 23, 0.1);
}

.aibr-title {
  color: var(--text-primary);
}

.aibr-desc {
  color: var(--text-secondary);
}

/* ══ 按钮行 ════════════════════════════════════════════════ */
.btn-row {
  display: flex;
  gap: var(--space-md);
  margin-top: var(--space-sm);
}

.btn-row .btn-ghost,
.btn-row .btn-primary {
  flex: 1;
}

/* 继续提示 */
.continue-tip {
  margin-top: var(--space-md);
  text-align: center;
}

.ct-text {
  color: var(--text-disabled);
}

/* ══ 预览卡片（Step 3 & Step 4）═══════════════════════════════════════ */
.preview-card {
  margin-bottom: 0;
  padding: 0; /* Override default card padding */
}

/* 照片区 */
.pvc-photo-wrap {
  width: 100%;
  height: 400rpx; /* ~4:3 */
  position: relative;
  overflow: hidden;
}

.pvc-photo { width: 100%; height: 100%; object-fit: cover;}

/* 类型标签：左上 */
.pvc-type-tag {
  position: absolute;
  top: var(--space-md);
  left: var(--space-md);
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  padding: var(--space-xs) var(--space-md);
  border-radius: var(--radius-sm);
  
  backdrop-filter: blur(8px);
}

.pvc-type-tag.spot {
  color: var(--surface);
  background: rgba(71, 191, 254, 0.88); /* primary */
}

.pvc-type-tag.food {
  color: var(--surface);
  background: rgba(230, 168, 23, 0.88); /* warning */
}

.pvc-type-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: var(--radius-full);
  background: rgba(255, 255, 255, 0.8);
}

/* 附近美食叠加：右下半透明白条 */
.pvc-nearby {
  position: absolute;
  bottom: 0;
  right: 0;
  background: rgba(255, 255, 255, 0.82);
  backdrop-filter: blur(8px);
  padding: var(--space-xs) var(--space-md);
  border-top-left-radius: var(--radius-md);
}

.pvc-nearby text {
  color: var(--text-primary);
  
}

/* 信息区 */
.pvc-info {
  padding: var(--space-lg) var(--space-lg) var(--space-xl);
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
  position: relative;
}

/* 标题行：emoji + 主标题 */
.pvci-title-row {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
}

.pvci-emoji {
  font-size: 36rpx;
  flex-shrink: 0;
  line-height: 1;
}

.pvci-title-main {
  color: var(--primary);
}

.type-food .pvci-title-main { color: var(--warning); }

/* 副标题：POI名 */
.pvci-subtitle-row {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  margin-top: -8rpx;
}

.pvci-title-sub {
  color: var(--text-secondary);
}

/* AI 描述：独立一行 + badge左上 */
.pvci-ai {
  display: flex;
  align-items: flex-start;
  gap: var(--space-md);
  padding: var(--space-md);
  background: var(--background);
  border-radius: var(--radius-md);
}

.type-food .pvci-ai {
  background: rgba(230, 168, 23, 0.05);
}

.pvia-badge {
  padding: 4rpx 12rpx;
  border-radius: var(--radius-sm);
  
  flex-shrink: 0;
}

.pvia-badge.spot {
  color: var(--primary);
  background: var(--primary-light);
}

.pvia-badge.food {
  color: var(--warning);
  background: rgba(230, 168, 23, 0.1);
}

.pvia-text {
  color: var(--text-secondary);
  flex: 1;
  text-align: justify;
}

/* 日期：右下角竖排轻量 */
.pvci-date {
  position: absolute;
  bottom: var(--space-lg);
  right: var(--space-lg);
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 0;
}

.pvic-month {
  
  color: var(--text-disabled);
  letter-spacing: 1rpx;
}

.pvic-year {
  color: var(--border);
  
}

/* 分隔线：按钮区上方 */
.step3-divider {
  height: 2rpx;
  background: var(--divider);
  margin: var(--space-lg) 0;
}

/* ══ 成功页 ════════════════════════════════════════════════ */
.success-section {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.success-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--space-lg) 0 var(--space-md);
  position: relative;
}

.sh-ring {
  position: absolute;
  top: 16rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 120rpx;
  height: 120rpx;
  border-radius: var(--radius-full);
  border: 4rpx solid var(--primary);
  animation: ringExpand 2.5s ease-out infinite;
}

.type-food .sh-ring { border-color: var(--warning); }

@keyframes ringExpand {
  0% { transform: translateX(-50%) scale(0.8); opacity: 0.6; }
  100% { transform: translateX(-50%) scale(2.2); opacity: 0; }
}

.sh-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 2;
  box-shadow: var(--shadow-md);
  background: var(--primary);
  color: var(--surface);
}

.type-food .sh-icon {
  background: var(--warning);
}

.sh-title {
  color: var(--text-primary);
  margin-top: var(--space-md);
}

.sh-sub {
  color: var(--text-secondary);
  margin-top: var(--space-xs);
}

/* ══ 足迹地图 ════════════════════════════════════════════════ */
.map-section {
  width: 100%;
  margin-top: var(--space-lg);
  margin-bottom: var(--space-lg);
  padding: 0; /* Override */
}

.ms-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-md) var(--space-lg);
  border-bottom: 2rpx solid var(--divider);
}

.ms-title { color: var(--text-primary);  }

.ms-toggle {
  display: flex;
  background: var(--background);
  border-radius: var(--radius-sm);
  padding: 4rpx;
  gap: 4rpx;
}

.mst-btn {
  
  padding: var(--space-xs) var(--space-md);
  border-radius: var(--radius-sm);
  color: var(--text-secondary);
  transition: all 0.2s;
}

.mst-btn.active {
  background: var(--surface);
  color: var(--text-primary);
  box-shadow: var(--shadow-xs);
}

.ms-map-wrap {
  position: relative;
  width: 100%;
  height: 400rpx;
}

.ms-map { width: 100%; height: 100%; }

.ms-stat-badge {
  position: absolute;
  bottom: var(--space-md);
  left: var(--space-md);
  background: rgba(255, 255, 255, 0.92);
  border-radius: var(--radius-sm);
  padding: var(--space-sm) var(--space-md);
  backdrop-filter: blur(12px);
  box-shadow: var(--shadow-sm);
  z-index: 10;
  display: flex;
  align-items: baseline;
  gap: var(--space-sm);
}

.mssb-num { color: var(--primary); }
.mssb-label { color: var(--text-secondary); }

.ms-list { padding: var(--space-xs) 0; min-height: 160rpx; }

.msl-empty {
  text-align: center;
  padding: var(--space-2xl);
  color: var(--text-disabled);
}

.msl-item {
  display: flex;
  align-items: center;
  gap: var(--space-md);
  padding: var(--space-md) var(--space-lg);
  border-bottom: 2rpx solid var(--divider);
}

.msl-item:last-child { border-bottom: none; }

.msli-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: var(--radius-full);
  flex-shrink: 0;
}

.msli-dot.spot { background: var(--primary); }
.msli-dot.food { background: var(--warning); }

.msli-info { flex: 1; display: flex; flex-direction: column; gap: var(--space-xs); }

.msli-name { color: var(--text-primary);  }
.msli-meta { color: var(--text-secondary); }

.msli-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
}

.msli-icon.spot { background: var(--primary-light); color: var(--primary-dark); }
