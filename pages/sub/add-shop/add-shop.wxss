/* ================================================
  觅食图 · 添加店铺页  (Refactored to Design System)
  ================================================ */

.container {
  min-height: 100vh;
  background: var(--background);
  padding: var(--space-lg) var(--space-md);
  padding-bottom: 160rpx;
}

/* ─── Section ─────────────────────────────── */
.form-section {
  background: var(--surface);
  border-radius: var(--radius-md);
  padding: var(--space-lg) var(--space-lg) var(--space-md);
  margin-bottom: var(--space-md);
  box-shadow: var(--shadow-sm);
}

.form-label {
  font-size: 28rpx;
  
  color: var(--text-primary);
  margin-bottom: var(--space-sm);
  display: block;
}

.form-input {
  width: 100%;
  height: 88rpx; /* 44px */
  background: var(--background);
  border-radius: var(--radius-sm);
  padding: 0 var(--space-md);
  font-size: 28rpx;
  box-sizing: border-box;
  color: var(--text-primary);
  border: 1.5rpx solid var(--divider);
  transition: border-color 0.18s;
}

.form-input:focus {
  border-color: var(--primary);
  background: var(--surface);
}

/* ─── Category Pills ─────────────────────── */
.category-select {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-sm);
}

.cat-pill {
  padding: 12rpx 26rpx;
  background: var(--background);
  border-radius: var(--radius-full);
  font-size: 26rpx;
  
  color: var(--text-secondary);
  transition: all 0.18s;
  border: 1rpx solid var(--divider);
}

.cat-pill.active {
  background: var(--primary);
  color: #FFFFFF;
  
  box-shadow: var(--shadow-xs);
  border-color: var(--primary);
}

.cat-pill.active .cat-icon {
  color: #FFFFFF;
}

/* ─── Emoji Select ─────────────────────────── */
.emoji-select {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-sm);
}

.emoji-item {
  font-size: 50rpx;
  padding: 10rpx;
  background: var(--background);
  border-radius: var(--radius-sm);
  transition: all 0.18s;
  border: 2rpx solid transparent;
}

.emoji-item.active {
  background: var(--primary-light);
  box-shadow: 0 0 0 3rpx var(--primary);
  border-color: var(--primary);
}

/* ─── 🗺️ Map Choose Button ─────────────── */
.choose-location-btn {
  display: flex;
  align-items: center;
  background: var(--primary-light);
  border: 2rpx solid var(--primary);
  border-radius: var(--radius-md);
  padding: var(--space-lg) var(--space-lg);
  margin-bottom: var(--space-md);
  gap: var(--space-md);
}

.choose-loc-icon {
  font-size: 44rpx;
  flex-shrink: 0;
}

.choose-loc-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.choose-loc-title {
  font-size: 30rpx;
  
  color: var(--primary-dark);
}

.choose-loc-sub {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.choose-loc-arrow {
  font-size: 40rpx;
  color: var(--primary);
  
}

/* ─── Coord Input ─────────────────────────── */
.coord-hint {
  font-size: 24rpx;
  color: var(--text-disabled);
  margin-bottom: var(--space-sm);
  
}

.coord-row {
  display: flex;
  gap: var(--space-md);
}

.coord-input {
  flex: 1;
}

.quick-coord {
  margin-top: var(--space-sm);
  font-size: 26rpx;
  color: var(--primary);
  
}

/* ─── Map Picker ──────────────────────────── */
.map-picker {
  position: relative;
  height: 380rpx;
  background: var(--surface);
  border-radius: var(--radius-md);
  overflow: hidden;
  margin-bottom: var(--space-md);
  box-shadow: var(--shadow-sm);
}

.map {
  width: 100%;
  height: 100%;
}

.map-center-icon {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 50rpx;
  z-index: 10;
  pointer-events: none;
}

/* ─── Submit Button ──────────────────────── */
.submit-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: var(--space-md) var(--space-md);
  padding-bottom: calc(var(--space-md) + env(safe-area-inset-bottom));
  background: var(--surface);
  box-shadow: var(--shadow-md);
  z-index: 100;
}

.btn-submit {
  width: 100%;
  height: 96rpx; /* lg size 48px */
  background: var(--primary);
  color: #FFFFFF;
  border-radius: var(--radius-full);
  font-size: 32rpx;
  
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  box-shadow: var(--shadow-sm);
  letter-spacing: 0.5rpx;
}

.btn-submit::after {
  border: none;
}

.btn-submit:active {
  background: var(--primary-dark);
  transform: scale(0.98);
}

/* Batch Mode */
.batch-header {
  margin-bottom: var(--space-lg);
}

.batch-title {
  font-size: 40rpx;
  
  color: var(--text-primary);
  display: block;
  margin-bottom: var(--space-xs);
}

.batch-hint {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.batch-item {
  background: var(--surface);
  border-radius: var(--radius-md);
  padding: var(--space-lg);
  margin-bottom: var(--space-md);
  box-shadow: var(--shadow-sm);
}

.batch-item-header {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  margin-bottom: var(--space-sm);
}

.batch-emoji {
  font-size: 40rpx;
}

.batch-name {
  font-size: 32rpx;
  
  color: var(--text-primary);
}

.batch-detail {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-bottom: var(--space-xs);
}
