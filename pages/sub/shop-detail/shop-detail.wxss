/* ================================================
  觅食图 · 店铺详情页  (Refactored to Design System)
  ================================================ */

.container {
  min-height: 100vh;
  background: var(--background);
  padding-bottom: 160rpx;
}

/* ─── Cover Image ────────────────────────── */
.cover {
  width: 100%;
  height: 480rpx;
  background: var(--primary-light);
  position: relative;
}

.cover-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.cover-fallback {
  width: 100%;
  height: 100%;
  background: var(--primary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 120rpx;
}

.cover-emoji {
  font-size: 120rpx;
}

.cover-back {
  position: absolute;
  top: env(safe-area-inset-top);
  left: var(--space-md);
  width: 72rpx;
  height: 72rpx;
  background: rgba(0,0,0,0.35);
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  backdrop-filter: blur(8rpx);
}

/* ─── Content ─────────────────────────────── */
.content {
  padding: 0 var(--space-md);
}

/* 店铺基本信息卡片 */
.shop-card {
  background: var(--surface);
  border-radius: var(--radius-lg);
  padding: var(--space-lg);
  margin-top: -40rpx;
  margin-bottom: var(--space-md);
  box-shadow: var(--shadow-sm);
  position: relative;
  z-index: 2;
  border: 1rpx solid var(--border);
}

.shop-emoji {
  font-size: 80rpx;
  margin-bottom: var(--space-sm);
}

.shop-name {
  font-size: 40rpx;
  
  color: var(--text-primary);
  margin-bottom: var(--space-sm);
  letter-spacing: -1rpx;
}

.shop-meta {
  display: flex;
  align-items: center;
  gap: var(--space-md);
  margin-bottom: var(--space-lg);
}

.shop-rating {
  font-size: 32rpx;
  color: var(--warning);
  
}

.shop-price {
  font-size: 28rpx;
  color: var(--text-secondary);
  
}

.shop-category {
  font-size: 24rpx;
  background: var(--background);
  color: var(--primary-dark);
  padding: 4rpx var(--space-md);
  border-radius: var(--radius-full);
  
}

/* 标签 */
.shop-tags {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-sm);
  margin-bottom: var(--space-lg);
}

.tag {
  padding: 6rpx 18rpx;
  border-radius: var(--radius-full);
  font-size: 24rpx;
  
  background: rgba(224,82,82,0.1);
  color: var(--danger);
}

/* 地址和营业时间 */
.info-row {
  display: flex;
  align-items: flex-start;
  padding: var(--space-md) 0;
  border-top: 1rpx solid var(--divider);
}

.info-icon {
  font-size: 28rpx;
  margin-right: 14rpx;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.info-text {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.5;
}

.info-arrow {
  font-size: 28rpx;
  color: var(--text-disabled);
  flex-shrink: 0;
}

/* ─── Section ─────────────────────────────── */
.section {
  background: var(--surface);
  border-radius: var(--radius-lg);
  padding: var(--space-lg);
  margin-bottom: var(--space-md);
  box-shadow: var(--shadow-xs);
  border: 1rpx solid var(--border);
}

.section-title {
  font-size: 32rpx;
  
  color: var(--text-primary);
  margin-bottom: var(--space-lg);
  display: flex;
  align-items: center;
  gap: var(--space-sm);
}

.section-icon {
  font-size: 32rpx;
}

.recommend-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.recommend-item {
  display: flex;
  align-items: center;
  gap: var(--space-md);
  padding: var(--space-md);
  background: var(--background);
  border-radius: var(--radius-md);
}

.recommend-rank {
  font-size: 28rpx;
  
  color: var(--primary-dark);
  width: 40rpx;
  text-align: center;
  flex-shrink: 0;
}

.recommend-name {
  flex: 1;
  font-size: 28rpx;
  
  color: var(--text-primary);
}

.recommend-price {
  font-size: 26rpx;
  color: var(--danger);
  
}

/* ─── Record Card (觅食记录) ──────────────────────── */
.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--space-lg);
}

.edit-record-btn {
  font-size: 26rpx;
  color: var(--danger);
  
}

.record-card {
  background: var(--surface);
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
  border: 1rpx solid var(--border);
}

/* 记录内容区 */
.record-body {
  padding: var(--space-lg);
}

.record-rating {
  display: flex;
  align-items: center;
  gap: var(--space-md);
  margin-bottom: var(--space-md);
}

.stars-row {
  display: flex;
  gap: 6rpx;
}

.star-item {
  font-size: 36rpx;
  color: var(--divider);
  transition: all 0.2s;
}

.star-item.active {
  color: var(--warning);
}

.rating-text {
  font-size: 28rpx;
  color: var(--danger);
  
}

.record-content {
  margin-bottom: var(--space-md);
}

.comment-text {
  font-size: 28rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

.record-meta {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
}

.meta-dot {
  width: 8rpx;
  height: 8rpx;
  background: var(--primary);
  border-radius: 50%;
}

.meta-date {
  font-size: 24rpx;
  color: var(--text-disabled);
}

/* 记录卡片中的定位信息 */
.record-location {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  margin-bottom: 12rpx;
  padding: 10rpx var(--space-md);
  background: var(--background);
  border-radius: var(--space-sm);
  width: fit-content;
}

.location-icon-small {
  font-size: 24rpx;
}

.location-text-small {
  font-size: 24rpx;
  color: var(--primary-dark);
}

/* 未记录状态 */
.empty-record {
  display: flex;
  align-items: center;
  gap: var(--space-lg);
  background: var(--surface);
  border-radius: var(--radius-lg);
  padding: var(--space-xl);
  box-shadow: var(--shadow-sm);
  border: 2rpx dashed var(--border);
}

.empty-record-icon {
  width: 100rpx;
  height: 100rpx;
  background: var(--primary);
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.icon-fork {
  font-size: 48rpx;
}

.empty-record-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.empty-title {
  font-size: 30rpx;
  
  color: var(--text-primary);
}

.empty-desc {
  font-size: 26rpx;
  color: var(--text-disabled);
}

.empty-record-btn {
  background: var(--primary);
  color: #ffffff;
  font-size: 28rpx;
  
  padding: var(--space-md) var(--space-xl);
  border-radius: var(--radius-full);
  box-shadow: var(--shadow-xs);
}

/* ─── Bottom Bar ─────────────────────────── */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: var(--space-lg) var(--space-xl);
  padding-bottom: calc(var(--space-lg) + env(safe-area-inset-bottom));
  background: var(--surface);
  box-shadow: var(--shadow-lg);
  display: flex;
  gap: var(--space-md);
  z-index: 100;
}

.bottom-btn {
  flex: 1;
  height: 88rpx; /* lg size 48px is 96rpx, maybe 88rpx is okay */
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  
  transition: all 0.18s;
}

.bottom-btn::after {
  border: none;
}

.bottom-btn:active {
  opacity: 0.85;
  transform: scale(0.98);
}

.bottom-btn.want {
  background: var(--background);
  color: var(--primary-dark);
}

.bottom-btn.want.active {
  background: var(--primary);
  color: #ffffff;
  box-shadow: var(--shadow-xs);
}

.bottom-btn.nav {
  background: var(--primary);
  color: #ffffff;
  box-shadow: var(--shadow-sm);
}

.bottom-btn.checkin {
  background: var(--background);
  color: var(--primary-dark);
  border: 1.5rpx solid var(--border);
}

.bottom-btn.checkin.active {
  background: var(--primary);
  color: #ffffff;
  border-color: transparent;
  box-shadow: var(--shadow-xs);
}

/* ─── Modal ──────────────────────────────── */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.45);
  z-index: 999;
  backdrop-filter: blur(4rpx);
}

.modal-content {
  position: fixed;
  bottom: 0; left: 0; right: 0;
  background: var(--surface);
  border-radius: var(--radius-xl) var(--radius-xl) 0 0;
  max-height: 80vh;
  overflow-y: auto;
  z-index: 1000;
  padding-bottom: env(safe-area-inset-bottom);
}

.modal-handle {
  width: 72rpx;
  height: 6rpx;
  background: var(--border);
  border-radius: var(--radius-full);
  margin: 18rpx auto 0;
}

.modal-title {
  font-size: 32rpx;
  
  color: var(--text-primary);
  text-align: center;
  padding: var(--space-lg) var(--space-xl) var(--space-md);
}

.star-row {
  display: flex;
  justify-content: center;
  gap: var(--space-md);
  padding: var(--space-lg);
}

.star-btn {
  font-size: 60rpx;
  transition: transform 0.15s;
}

.star-btn.active {
  transform: scale(1.2);
}

.modal-textarea {
  width: calc(100% - 48rpx);
  min-height: 160rpx;
  background: var(--background);
  border-radius: var(--radius-md);
  padding: 20rpx var(--space-lg);
  font-size: 28rpx;
  color: var(--text-primary);
  margin: 0 var(--space-lg) var(--space-lg);
  box-sizing: border-box;
  border: 1.5rpx solid var(--divider);
}

.modal-submit {
  width: calc(100% - 48rpx);
  height: 88rpx;
  background: var(--primary);
  color: #ffffff;
  border-radius: var(--radius-full);
  font-size: 30rpx;
  
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 var(--space-lg) var(--space-lg);
  box-shadow: var(--shadow-sm);
}

.modal-cancel {
  text-align: center;
  font-size: 28rpx;
  color: var(--text-disabled);
  padding: 0 var(--space-lg) var(--space-lg);
}

/* ─── 底部操作栏（详情页）─────────────────────────────── */
.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: var(--surface);
  padding: var(--space-md) var(--space-lg);
  padding-bottom: calc(var(--space-md) + env(safe-area-inset-bottom));
  box-shadow: var(--shadow-lg);
  z-index: 100;
}

.action-main {
  display: flex;
  gap: var(--space-md);
}

.action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-sm);
  padding: 20rpx var(--space-md);
  border-radius: var(--radius-full);
  font-size: 28rpx;
  
  transition: all 0.18s;
  background: var(--background);
  color: var(--primary-dark);
  border: 1.5rpx solid var(--border);
}

.action-btn.liked {
  background: var(--danger);
  color: #ffffff;
  border-color: transparent;
  box-shadow: var(--shadow-xs);
}

.action-btn.checked {
  background: var(--success);
  color: #ffffff;
  border-color: transparent;
  box-shadow: var(--shadow-xs);
}

.action-btn.primary {
  background: var(--primary);
  color: #ffffff;
  border-color: transparent;
  box-shadow: var(--shadow-xs);
  flex: 1.2;
}

.action-icon {
  font-size: 32rpx;
  line-height: 1;
}

.action-text {
  font-size: 26rpx;
  
}
