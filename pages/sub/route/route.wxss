/* ================================================
   觅食图 · 路线规划页  v6.0 (Refactored to Design System)
   ================================================ */

.container {
  min-height: 100vh;
  background: var(--background);
  padding-bottom: 160rpx;
}

/* ═══════════════════════════════════════════════
   地图区
   ═══════════════════════════════════════════════ */
.map-wrap {
  position: relative;
  height: 40vh;
  min-height: 380rpx;
  background: var(--primary-light);
  transition: height 0.3s;
}

.map-wrap.nav-mode {
  height: 60vh;
  min-height: 560rpx;
}

.map {
  width: 100%;
  height: 100%;
}

/* 返回按钮 */
.map-back-btn {
  position: absolute;
  top: var(--space-lg);
  left: var(--space-md);
  width: 72rpx;
  height: 72rpx;
  background: rgba(255,255,255,0.92);
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-sm);
  z-index: 10;
}

.map-back-icon {
  font-size: 44rpx;
  
  color: var(--text-primary);
  line-height: 1;
  margin-top: -4rpx;
}

/* 适配全部标记按钮 */
.map-fit-btn {
  position: absolute;
  top: var(--space-lg);
  right: var(--space-md);
  width: 64rpx;
  height: 64rpx;
  background: rgba(255,255,255,0.92);
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-sm);
  z-index: 10;
}

.map-fit-icon {
  font-size: 30rpx;
  color: var(--primary-dark);
}

/* 地图信息浮层（底部） */
.map-info-bar {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-around;
  background: rgba(255,255,255,0.92);
  backdrop-filter: blur(8px);
  padding: var(--space-md) var(--space-lg);
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
}

.map-info-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
}

.map-info-val {
  font-size: 30rpx;
  
  color: var(--primary-dark);
}

.map-info-lbl {
  font-size: 20rpx;
  color: var(--text-disabled);
}

.map-info-divider {
  width: 1rpx;
  height: 36rpx;
  background: var(--divider);
}

/* 导览进度条 */
.nav-header {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--space-md) var(--space-lg);
  padding-top: calc(var(--space-md) + env(safe-area-inset-top));
  background: linear-gradient(to bottom, rgba(0,0,0,0.55) 0%, transparent 100%);
  z-index: 20;
}

.nav-progress {
  display: flex;
  gap: var(--space-sm);
  align-items: center;
}

.progress-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: var(--radius-full);
  background: rgba(255,255,255,0.35);
  transition: all 0.3s;
}

.progress-dot.done  { background: var(--success); }
.progress-dot.active {
  background: #FFFFFF;
  transform: scale(1.4);
  box-shadow: 0 0 8rpx rgba(255,255,255,0.9);
}

.remaining-text {
  font-size: 22rpx;
  color: rgba(255,255,255,0.9);
  
  margin-left: var(--space-xs);
}

.nav-close-btn {
  padding: var(--space-sm) 20rpx;
  background: rgba(0,0,0,0.4);
  border-radius: var(--radius-full);
  font-size: 22rpx;
  color: #FFFFFF;
}

/* ═══════════════════════════════════════════════
   导览完成
   ═══════════════════════════════════════════════ */
.nav-complete {
  position: fixed;
  inset: 0;
  background: var(--primary);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 300;
}

.complete-icon  { font-size: 120rpx; margin-bottom: var(--space-xl); }
.complete-title { font-size: 44rpx;  color: #FFF; margin-bottom: var(--space-md); }
.complete-sub   { font-size: 28rpx; color: rgba(255,255,255,.8); margin-bottom: 60rpx; }

.complete-btn {
  padding: 20rpx 64rpx;
  background: #FFFFFF;
  color: var(--primary-dark);
  border-radius: var(--radius-full);
  font-size: 30rpx;
  
  border: none;
  box-shadow: var(--shadow-md);
}
.complete-btn::after { border: none; }

/* ═══════════════════════════════════════════════
   导览模式卡片（底部 fixed）
   ═══════════════════════════════════════════════ */
.nav-card {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: var(--surface);
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  padding: var(--space-lg) var(--space-lg) calc(var(--space-lg) + env(safe-area-inset-bottom));
  box-shadow: var(--shadow-lg);
  z-index: 100;
}

.nav-card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--space-md);
}

.nav-header-left {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
}

.nav-label {
  font-size: 26rpx;
  
  color: var(--primary);
}

.nav-badge {
  padding: 4rpx 14rpx;
  background: var(--primary);
  color: #FFF;
  border-radius: var(--radius-full);
  font-size: 20rpx;
  
}

.nav-remain {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.nav-shop-row {
  display: flex;
  align-items: center;
  gap: var(--space-md);
  background: var(--background);
  border-radius: var(--radius-md);
  padding: var(--space-md);
  margin-bottom: var(--space-md);
}

.nav-shop-num {
  width: 48rpx;
  height: 48rpx;
  background: var(--primary);
  color: #FFF;
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  
  flex-shrink: 0;
  box-shadow: var(--shadow-xs);
}

.nav-shop-thumb {
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--radius-sm);
  flex-shrink: 0;
  object-fit: cover;
}

.nav-shop-info { flex: 1; min-width: 0; }

.nav-shop-name {
  display: block;
  font-size: 28rpx;
  
  color: var(--text-primary);
  margin-bottom: 4rpx;
}

.nav-shop-meta {
  display: block;
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-bottom: 2rpx;
}

.nav-shop-addr {
  display: block;
  font-size: 20rpx;
  color: var(--text-disabled);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.nav-stats-row {
  display: flex;
  justify-content: space-around;
  padding: 12rpx 0;
  background: var(--background);
  border-radius: var(--radius-md);
  margin-bottom: var(--space-md);
}

.nav-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.ns-val { font-size: 26rpx;  color: var(--text-primary); }
.ns-lbl { font-size: 18rpx; color: var(--text-disabled); }

.nav-btns-row {
  display: flex;
  gap: var(--space-sm);
}

.nav-go-btn,
.nav-next-btn {
  flex: 1;
  height: 80rpx;
  border-radius: var(--radius-full);
  font-size: 26rpx;
  
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.nav-go-btn {
  background: var(--primary-light);
  color: var(--primary-dark);
}

.nav-next-btn {
  background: var(--primary);
  color: #FFF;
  box-shadow: var(--shadow-sm);
}

.nav-go-btn::after,
.nav-next-btn::after { border: none; }

/* ═══════════════════════════════════════════════
   常规路线规划内容区
   ═══════════════════════════════════════════════ */
.route-body {
  padding: var(--space-md) 20rpx;
}

/* ─── 起点行 ─── */
.start-row {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  background: var(--surface);
  border-radius: var(--radius-md);
  padding: 20rpx var(--space-lg);
  margin-bottom: var(--space-sm);
  box-shadow: var(--shadow-xs);
}

.start-dot {
  font-size: 16rpx;
  color: var(--success);
  flex-shrink: 0;
}

.start-name {
  flex: 1;
  font-size: 26rpx;
  
  color: var(--text-primary);
}

.start-chevron {
  font-size: 22rpx;
  color: var(--text-disabled);
}

.start-expand {
  margin-bottom: var(--space-sm);
}

.start-chips {
  display: flex;
  gap: var(--space-sm);
  padding: 4rpx 0 var(--space-sm);
}

.start-chip {
  padding: var(--space-smp) var(--space-lg);
  background: var(--surface);
  border-radius: var(--radius-full);
  font-size: 24rpx;
  color: var(--text-secondary);
  white-space: nowrap;
  border: 2rpx solid var(--border);
  flex-shrink: 0;
  transition: all 0.2s;
}

.start-chip.active {
  background: var(--primary);
  color: #FFF;
  border-color: var(--primary);
  
  box-shadow: var(--shadow-xs);
}

.start-chip.map-chip {
  background: #FFF8E1;
  border-color: #FFD54F;
  color: #E65100;
}

/* ─── 出行方式行 ─── */
.mode-row {
  display: flex;
  gap: var(--space-sm);
  margin-bottom: var(--space-md);
}

.mode-chip {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--space-md) var(--space-sm);
  background: var(--surface);
  border-radius: var(--radius-md);
  font-size: 24rpx;
  
  color: var(--text-secondary);
  border: 2rpx solid var(--border);
  transition: all 0.2s;
}

.mode-chip.active {
  background: var(--primary);
  color: #FFF;
  border-color: var(--primary);
  box-shadow: var(--shadow-xs);
}

.mode-chip.optimize {
  flex: 0.7;
  background: #FFF3E0;
  border-color: #FFD54F;
  color: #E65100;
}

/* ═══════════════════════════════════════════════
   ★ 双模式切换卡片
   ═══════════════════════════════════════════════ */
.mode-switch-bar {
  display: flex;
  background: var(--surface);
  border-radius: var(--radius-lg);
  padding: var(--space-smp);
  gap: 0;
  margin-bottom: var(--space-md);
  box-shadow: var(--shadow-xs);
}

.mode-switch-item {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 18rpx var(--space-md);
  border-radius: var(--radius-md);
  transition: all 0.2s;
  position: relative;
}

.mode-switch-item.active {
  background: var(--background);
  border: 2rpx solid rgba(71, 191, 254, 0.3);
}

.ms-icon {
  font-size: 34rpx;
  flex-shrink: 0;
}

.ms-text-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.ms-title {
  font-size: 26rpx;
  
  color: var(--text-primary);
}

.mode-switch-item.active .ms-title {
  color: var(--primary-dark);
}

.ms-sub {
  font-size: 20rpx;
  color: var(--text-disabled);
}

.ms-check {
  width: 36rpx;
  height: 36rpx;
  background: var(--primary);
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18rpx;
  color: #FFF;
  
  flex-shrink: 0;
}

.mode-switch-sep {
  width: 1rpx;
  background: var(--divider);
  margin: var(--space-sm) 0;
}

/* ═══════════════════════════════════════════════
   ★ 候选勾选面板
   ═══════════════════════════════════════════════ */
.candidate-panel {
  background: var(--surface);
  border-radius: var(--radius-lg);
  margin-bottom: var(--space-md);
  overflow: hidden;
  box-shadow: var(--shadow-xs);
  border: 1rpx solid var(--border);
}

.candidate-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx var(--space-lg) var(--space-md);
  border-bottom: 1rpx solid var(--divider);
}

.candidate-title {
  font-size: 26rpx;
  
  color: var(--text-primary);
}

.select-all-pill {
  padding: 6rpx 20rpx;
  background: var(--background);
  border-radius: var(--radius-full);
  font-size: 24rpx;
  color: var(--primary-dark);
  
}

.cand-item {
  display: flex;
  align-items: center;
  gap: var(--space-md);
  padding: var(--space-md) var(--space-lg);
  border-bottom: 1rpx solid var(--divider);
  transition: background 0.15s;
}

.cand-item:last-child { border-bottom: none; }
.cand-item.selected  { background: var(--background); }

.cand-check {
  width: 40rpx;
  height: 40rpx;
  border-radius: var(--radius-full);
  border: 2rpx solid var(--text-disabled);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: transparent;
  flex-shrink: 0;
  transition: all 0.2s;
}

.cand-check.on {
  background: var(--primary);
  border-color: var(--primary);
  color: #FFF;
}

.cand-logo {
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--radius-sm);
  flex-shrink: 0;
  object-fit: cover;
}

.cand-info { flex: 1; min-width: 0; }

.cand-name {
  display: block;
  font-size: 28rpx;
  
  color: var(--text-primary);
  margin-bottom: 6rpx;
}

.cand-meta {
  font-size: 22rpx;
  color: var(--text-disabled);
}

.cand-badge {
  width: 44rpx;
  height: 44rpx;
  border-radius: var(--radius-full);
  background: var(--border);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: var(--text-disabled);
  
  flex-shrink: 0;
  opacity: 0;
  transition: all 0.2s;
}

.cand-badge.show {
  opacity: 1;
  background: var(--primary);
  color: #FFF;
}

/* ═══════════════════════════════════════════════
   ★ 路线 Timeline
   ═══════════════════════════════════════════════ */
.timeline-card {
  background: var(--surface);
  border-radius: var(--radius-lg);
  padding: 20rpx 20rpx var(--space-lg);
  box-shadow: var(--shadow-xs);
}

.timeline-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.timeline-title {
  font-size: 28rpx;
  
  color: var(--text-primary);
}

.edit-pill {
  padding: 8rpx 22rpx;
  background: var(--background);
  border-radius: var(--radius-full);
  font-size: 24rpx;
  
  color: var(--primary-dark);
}

/* timeline 行 */
.tl-item {
  display: flex;
  gap: 0;
  min-height: 72rpx;
}

.tl-item.editing .tl-shop-row {
  background: #FFF9E6;
  border: 2rpx dashed var(--warning);
  border-radius: var(--radius-md);
}

/* 节点轨道 */
.tl-node-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 52rpx;
  flex-shrink: 0;
  padding-top: 4rpx;
}

/* 数字节点 */
.tl-num {
  width: 44rpx;
  height: 44rpx;
  background: var(--primary);
  color: #FFF;
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  
  flex-shrink: 0;
  box-shadow: var(--shadow-xs);
  z-index: 1;
}

.tl-num.first {
  background: var(--warning);
  box-shadow: var(--shadow-xs);
}

/* 起终点圆点 */
.tl-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: var(--radius-full);
  flex-shrink: 0;
  margin: 10rpx 0 0 10rpx;
}

.start-dot-node {
  background: var(--success);
  box-shadow: 0 0 0 6rpx rgba(58,155,111,0.2);
}

.end-dot-node {
  background: var(--danger);
  box-shadow: 0 0 0 6rpx rgba(224,82,82,0.2);
}

/* 竖线 */
.tl-line {
  flex: 1;
  width: 2rpx;
  background: var(--divider);
  border-radius: 2rpx;
  margin: 6rpx 0;
  min-height: 32rpx;
}

/* 内容区 */
.tl-content {
  flex: 1;
  padding: 0 0 20rpx var(--space-md);
  min-width: 0;
}

.tl-item.tl-start .tl-content,
.tl-item.tl-end .tl-content {
  padding-bottom: var(--space-smp);
}

.tl-tag-start,
.tl-tag-end {
  display: inline-block;
  padding: 3rpx var(--space-smp);
  border-radius: var(--radius-full);
  font-size: 18rpx;
  
  margin-bottom: 4rpx;
}

.tl-tag-start {
  background: rgba(58,155,111,0.12);
  color: var(--success);
}

.tl-tag-end {
  background: rgba(224,82,82,0.12);
  color: var(--danger);
}

.tl-name {
  display: block;
  font-size: 26rpx;
  
  color: var(--text-primary);
}

/* 店铺行 */
.tl-shop-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 14rpx var(--space-md) 14rpx 14rpx;
  background: var(--background);
  border-radius: var(--radius-md);
  transition: background 0.15s;
}

.tl-thumb {
  width: 88rpx;
  height: 88rpx;
  border-radius: var(--radius-sm);
  flex-shrink: 0;
  object-fit: cover;
}

.tl-shop-info {
  flex: 1;
  min-width: 0;
}

.tl-name {
  font-size: 28rpx;
  
  color: var(--text-primary);
  display: block;
  margin-bottom: 4rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.tl-meta {
  font-size: 22rpx;
  color: var(--text-secondary);
  display: block;
  margin-bottom: 4rpx;
}

.tl-dist {
  font-size: 20rpx;
  color: var(--primary-dark);
  
}

/* 操作按钮 */
.tl-actions {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
  flex-shrink: 0;
}

.tl-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  transition: all 0.15s;
}

.tl-btn.nav { background: var(--primary-light); color: var(--primary-dark); }
.tl-btn.del { background: rgba(224, 82, 82, 0.1); color: var(--danger); }

/* 排序箭头 */
.tl-sort {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  flex-shrink: 0;
}

.sort-arrow {
  width: 48rpx;
  height: 48rpx;
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  
  transition: all 0.15s;
}

.sort-arrow.up  {
  background: var(--primary-light);
  color: var(--primary-dark);
}

.sort-arrow.down {
  background: #FFF3E0;
  color: #E65100;
}

.sort-arrow.off {
  opacity: 0.25;
  pointer-events: none;
}

/* ═══════════════════════════════════════════════
   空状态
   ═══════════════════════════════════════════════ */
.empty-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0 60rpx;
  text-align: center;
}

.empty-icon  { font-size: 96rpx; margin-bottom: var(--space-lg); opacity: 0.45; }
.empty-text  { font-size: 30rpx;  color: var(--text-primary); margin-bottom: var(--space-sm); }
.empty-hint  { font-size: 26rpx; color: var(--text-disabled); margin-bottom: 36rpx; line-height: 1.5; }

.empty-btn {
  padding: 18rpx 56rpx;
  background: var(--primary);
  color: #FFF;
  border-radius: var(--radius-full);
  font-size: 28rpx;
  
  border: none;
  box-shadow: var(--shadow-sm);
}

.empty-btn::after { border: none; }

/* ═══════════════════════════════════════════════
   底部操作栏
   ═══════════════════════════════════════════════ */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: var(--space-md);
  padding: var(--space-md) var(--space-lg);
  padding-bottom: calc(var(--space-md) + env(safe-area-inset-bottom));
  background: rgba(255,255,255,0.96);
  backdrop-filter: blur(12px);
  box-shadow: var(--shadow-lg);
  z-index: 100;
}

.bb-clear {
  width: 140rpx;
  height: 88rpx;
  background: var(--background);
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  
  color: var(--text-secondary);
  flex-shrink: 0;
}

.bb-start {
  flex: 1;
  height: 88rpx;
  background: var(--primary);
  color: #FFF;
  border-radius: var(--radius-full);
  font-size: 30rpx;
  
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  box-shadow: var(--shadow-sm);
}

.bb-start::after { border: none; }

.bb-clear:active,
.bb-start:active { opacity: 0.85; transform: scale(0.98); }
