/* my.wxss - 我的页面样式 (Figma Design 1044_132) */

.container {
  min-height: 100vh;
  background: #F7F8FA;
  padding-bottom: env(safe-area-inset-bottom);
  position: relative;
}

/* ── 顶部背景 ── */
.top-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 400rpx;
  background: linear-gradient(180deg, #B3C4DC 0%, #F7F8FA 100%);
  z-index: 0;
}

/* 保证内容层级在背景之上 */
.user-section, .shortcut-section, .record-section, .list-section {
  position: relative;
  z-index: 1;
}

/* ── 用户信息栏 ── */
.user-section {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 256rpx 48rpx 0; /* 128px */
  height: 416rpx; /* 256 + 160 */
  box-sizing: border-box;
}

.user-info {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 36rpx; /* 18px */
}

.user-nickname {
  font-family: 'mue', 'PingFang SC', sans-serif;
  font-weight: normal;
  font-size: 64rpx; /* 32px */
  color: #242529;
  line-height: 64rpx;
}

.user-desc {
  font-family: 'PingFang SC';
  font-weight: 400; /* Regular */
  font-size: 28rpx; /* 14px */
  color: #7C7C79;
  line-height: 28rpx;
}

.user-avatar {
  width: 160rpx; /* 80px */
  height: 160rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.user-avatar-default {
  width: 160rpx; /* 80px */
  height: 160rpx;
  border-radius: 50%;
  background: linear-gradient(180deg, #C5D3E3 0%, #D8E1EC 100%);
  display: flex;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
}

.user-avatar-default i {
  font-size: 80rpx; /* 40px */
  color: #FFFFFF;
}

/* ── 快捷功能 ── */
.shortcut-section {
  display: flex;
  justify-content: space-between;
  padding: 64rpx 32rpx 0;
  gap: 32rpx;
}

.shortcut-card {
  width: 342rpx; /* 171px * 2 */
  height: 144rpx; /* 72px * 2 */
  background: #FFFFFF;
  border-radius: 32rpx; /* 16px * 2 */
  display: flex;
  align-items: center;
  padding-left: 32rpx; /* 16px * 2 */
  gap: 16rpx; /* 8px * 2 */
  box-sizing: border-box;
}

.shortcut-card text {
  font-family: 'PingFang SC';
  font-weight: 500;
  font-size: 30rpx; /* 15px * 2 */
  line-height: 40rpx; /* 20px * 2 */
  color: #242529;
}

/* 图标渐变色 */
.icon-gradient {
  background: linear-gradient(180deg, #C5D3E3 0%, #D8E1EC 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  font-size: 40rpx; /* 20px * 2 */
}

/* ── 记录卡片 ── */
.record-section {
  margin: 32rpx 32rpx 0; /* 16px */
  background: #FFFFFF;
  border-radius: 32rpx; /* 16px */
  padding: 32rpx; /* 16px */
}

.record-header {
  display: flex;
  align-items: center;
  gap: 16rpx; /* 8px */
  margin-bottom: 32rpx; /* 16px */
}

.record-header text {
  font-family: 'PingFang SC';
  font-weight: 500;
  font-size: 30rpx; /* 15px */
  color: #242529;
}

.record-cards {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
}

.record-item {
  width: 206rpx; /* 103px / 104px */
  height: 136rpx; /* 68px */
  border-radius: 16rpx; /* 8px */
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: flex-start;
  padding-left: 24rpx; /* 12px */
  gap: 20rpx; /* 10px */
}

.item-collect { background: #E8F5FC; }
.item-city { background: #F1F1FC; }
.item-footprint { background: #FDF1F0; }

.record-label {
  font-family: 'PingFang SC';
  font-weight: 600;
  font-size: 24rpx; /* 12px */
  line-height: 24rpx; /* 12px */
  color: #6E727A;
}

.record-value {
  font-family: 'DIN Alternate', sans-serif;
  font-weight: 700;
  font-size: 44rpx; /* 22px */
  line-height: 44rpx; /* 22px */
  color: #242529;
}

/* ── 列表菜单 ── */
.list-section {
  margin: 32rpx 32rpx 0; /* 16px */
  background: #FFFFFF;
  border-radius: 32rpx; /* 16px */
  padding: 16rpx 32rpx; /* 8px 16px */
}

.list-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 112rpx; /* 56px */
}

.list-item-left {
  display: flex;
  align-items: center;
  gap: 16rpx; /* 8px */
}

.list-item-left text {
  font-family: 'PingFang SC';
  font-weight: 500;
  font-size: 30rpx; /* 15px */
  color: #242529;
}

.arrow-icon {
  color: #C0C0C0;
  font-size: 40rpx; /* 20px */
}