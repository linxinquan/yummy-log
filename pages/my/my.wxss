/* 我的页：按新版设计重排 */

.container {
  min-height: 100vh;
  background: #FFFFFF;
  padding-bottom: env(safe-area-inset-bottom);
}

/* 顶部灰底信息区 */
.profile-hero {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding: 256rpx 48rpx 64rpx;
  gap: 64rpx;
  background: #F7F8FA;
  box-sizing: border-box;
}

/* 资料头部：左文案右头像 */
.user-section {
  width: 100%;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 32rpx;
  box-sizing: border-box;
}

.user-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.user-nickname {
  color: #242529;
  font-size: 64rpx;
  font-weight: 500;
  line-height: 64rpx;
}

/* 未登录时的昵称输入框 */
.user-nickname-input {
  color: #242529;
  font-size: 36rpx;
  font-weight: 500;
  line-height: 48rpx;
  height: 64rpx;
  background: transparent;
  padding: 0;
  margin: 0;
  width: 100%;
}

.user-desc {
  color: #A0A4AE;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 28rpx;
}

.user-avatar,
.user-avatar-default {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.user-avatar-default {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, #C5D3E3 0%, #D8E1EC 100%);
}

.user-avatar-default i {
  font-size: 80rpx;
  line-height: 80rpx;
  color: #FFFFFF;
}

/* 未登录时的头像选择按钮 */
.user-avatar-btn {
  width: 160rpx !important;
  height: 160rpx !important;
  border-radius: 50% !important;
  padding: 0 !important;
  margin: 0 !important;
  background: none !important;
  border: none !important;
  line-height: normal !important;
  overflow: hidden;
  flex-shrink: 0;
}

.user-avatar-btn::after {
  display: none;
}

.user-avatar-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  display: block;
}

.user-avatar-placeholder {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, #C5D3E3 0%, #D8E1EC 100%);
  gap: 8rpx;
}

.user-avatar-placeholder i {
  font-size: 64rpx;
  line-height: 64rpx;
  color: #FFFFFF;
}

.avatar-btn-text {
  font-size: 24rpx;
  color: #FFFFFF;
  line-height: 24rpx;
}



/* 统计一行：整行可点击进入采集页 */
.stats-row {
  display: flex;
  align-items: center;
  gap: 32rpx;
}

.stat-item {
  width: 160rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 16rpx;
}

.stat-label {
  width: 100%;
  color: #A0A4AE;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 24rpx;
}

.stat-value {
  width: 100%;
  color: #242529;
  font-family: 'DIN Alternate', 'PingFang SC', sans-serif;
  font-size: 48rpx;
  font-weight: 700;
  line-height: 48rpx;
}

/* 快捷入口：收藏 / 采集 */
.shortcut-section {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.shortcut-card {
  flex: 1;
  height: 128rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 0 32rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  box-sizing: border-box;
}

.shortcut-icon {
  font-size: 48rpx;
  line-height: 48rpx;
  flex-shrink: 0;
}

/* 快捷入口图标：沿用设计里的浅蓝灰渐变 */
.icon-gradient {
  background: linear-gradient(180deg, #C5D3E3 0%, #D8E1EC 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.shortcut-card text {
  color: #242529;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 40rpx;
}

/* 下方菜单：改成纯文字列表，不再使用图标 */
.list-section {
  margin: 32rpx 48rpx 0;
}

.list-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 0;
}

.list-item-text {
  color: #242529;
  font-size: 32rpx;
  font-weight: 400;
  line-height: 32rpx;
}

.arrow-icon {
  color: #C7CAD1;
  font-size: 40rpx;
  line-height: 40rpx;
}


