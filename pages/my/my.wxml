<!-- 我的页：按新版设计改为顶部信息区 + 快捷入口 + 简洁菜单 -->
<view class="container">
  <!-- 顶部灰底信息区 -->
  <view class="profile-hero">
    <!-- 头像和昵称区域：已登录展示信息，未登录展示设置控件 -->
    <view class="user-section">
      <view class="user-info">
        <block wx:if="{{isLoggedIn}}">
          <!-- 已登录：点击昵称可修改；点击资料区（头像或描述文字）可编辑资料或退出登录 -->
          <input class="user-nickname-input" type="nickname" placeholder="点击设置昵称" value="{{userInfo.nickName}}" bindblur="onUpdateNickname" />
          <text class="user-desc">与你相遇的第 {{userInfo.days || 1}} 天</text>
        </block>
        <block wx:else>
          <!-- 未登录：显示请登录按钮 -->
          <view class="login-prompt" bindtap="showLoginModal">
            <text class="login-prompt-text">点击登录</text>
            <text class="user-desc">登录后记录你的美食足迹</text>
          </view>
        </block>
      </view>

      <!-- 头像区域 -->
      <block wx:if="{{isLoggedIn}}">
        <!-- 已登录：点击头像可修改 -->
        <button class="user-avatar-btn" open-type="chooseAvatar" bindchooseavatar="onUpdateAvatar">
          <image class="user-avatar-img" src="{{avatarUrl}}" mode="aspectFill" />
        </button>
      </block>
      <block wx:else>
        <!-- 未登录：显示默认头像，点击弹出登录弹窗 -->
        <view class="user-avatar-default" bindtap="showLoginModal">
          <i class="mgc_user_3_fill avatar-icon"></i>
        </view>
      </block>
    </view>

    <!-- 统计一行：点击整行进入我的采集 -->
    <view class="stats-row" bindtap="onGoCollection">
      <view class="stat-item">
        <text class="stat-label">采集</text>
        <text class="stat-value">{{checkinStats.totalCount || 0}}</text>
      </view>
      <view class="stat-item">
        <text class="stat-label">城市</text>
        <text class="stat-value">{{checkinStats.cityCount || 0}}</text>
      </view>
      <view class="stat-item">
        <text class="stat-label">足迹</text>
        <text class="stat-value">{{stats.visitedCount || 0}}</text>
      </view>
    </view>

    <!-- 快捷入口：收藏保留，采集替换掉原来的我的发布 -->
    <view class="shortcut-section">
      <view class="shortcut-card" bindtap="onMenuTap" data-type="favorites">
        <i class="mgc_star_line shortcut-icon icon-gradient"></i>
        <text>收藏</text>
      </view>
      <view class="shortcut-card" bindtap="onGoCollection">
        <i class="mgc_flower_4_line shortcut-icon icon-gradient"></i>
        <text>采集</text>
      </view>
    </view>
  </view>

  <!-- 下方菜单：去掉我的想去和采集本，只保留这三项 -->
  <view class="list-section">
    <view class="list-item" bindtap="onMenuTap" data-type="guides">
      <text class="list-item-text">我的发布</text>
      <i class="mgc_right_line arrow-icon"></i>
    </view>
    <view class="list-item" bindtap="showSettingsModal">
      <text class="list-item-text">设置</text>
      <i class="mgc_right_line arrow-icon"></i>
    </view>
    <view class="list-item" bindtap="onMenuTap" data-type="share">
      <text class="list-item-text">分享我们</text>
      <i class="mgc_right_line arrow-icon"></i>
    </view>

  </view>

  <!-- 自定义 TabBar -->
  <custom-tabbar></custom-tabbar>

  <!-- 登录弹窗 -->
  <view class="login-modal {{showLoginModal ? 'show' : ''}}" bindtap="onModalMaskTap">
    <view class="login-modal-content" catchtap="onModalContentTap">
      <!-- 关闭按钮 -->
      <view class="modal-close" bindtap="hideLoginModal">
        <i class="mgc_close_line"></i>
      </view>
      
      <!-- 标题 -->
      <view class="modal-header">
        <text class="modal-title">欢迎登录觅食迹</text>
        <text class="modal-subtitle">授权微信账号，记录你的美食足迹</text>
      </view>
      
      <!-- 用户信息预览 -->
      <view class="modal-user-preview">
        <view class="preview-avatar">
          <open-data type="userAvatarUrl"></open-data>
        </view>
        <view class="preview-name">
          <open-data type="userNickName"></open-data>
        </view>
      </view>
      
      <!-- 隐私协议 -->
      <view class="privacy-agreement">
        <checkbox class="agreement-checkbox" checked="{{isAgreePrivacy}}" bindtap="togglePrivacyAgreement"/>
        <view class="agreement-text">
          <text>我已阅读并同意</text>
          <text class="agreement-link" bindtap="onTapPrivacyPolicy">《隐私协议》</text>
          <text>和</text>
          <text class="agreement-link" bindtap="onTapUserAgreement">《用户协议》</text>
        </view>
      </view>
      
      <!-- 登录按钮 -->
      <button 
        class="login-btn {{isAgreePrivacy ? '' : 'disabled'}}" 
        bindtap="onWechatLogin"
        disabled="{{!isAgreePrivacy}}"
      >
        <i class="mgc_wechat_fill wechat-icon"></i>
        <text>授权微信登录</text>
      </button>
      
      <!-- 暂不登录 -->
      <view class="cancel-login" bindtap="hideLoginModal">
        <text>暂不登录</text>
      </view>
    </view>
  </view>

  <!-- 设置弹窗 -->
  <view class="settings-modal {{showSettingsModal ? 'show' : ''}}" bindtap="onSettingsModalMaskTap">
    <view class="settings-modal-content" catchtap="onSettingsModalContentTap">
      <!-- 关闭按钮 -->
      <view class="modal-close" bindtap="hideSettingsModal">
        <i class="mgc_close_line"></i>
      </view>

      <!-- 标题 -->
      <view class="modal-header">
        <text class="modal-title">设置</text>
      </view>

      <!-- 设置项 -->
      <view class="settings-items">
        <view class="settings-item" bindtap="showEditNickname">
          <text class="settings-item-text">修改昵称</text>
        </view>
        <view class="settings-item" bindtap="onLogout">
          <text class="settings-item-text">退出登录</text>
        </view>
      </view>
    </view>
  </view>
</view>
