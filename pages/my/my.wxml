<!-- 我的页：按新版设计改为顶部信息区 + 快捷入口 + 简洁菜单 -->
<view class="container">
  <!-- 顶部灰底信息区 -->
  <view class="profile-hero">
    <!-- 头像和昵称区域：已登录展示信息，未登录展示设置控件 -->
    <view class="user-section">
      <view class="user-info">
        <block wx:if="{{isLoggedIn}}">
          <text class="user-nickname">{{userInfo.nickName || '觅食者'}}</text>
          <text class="user-desc">与你相遇的第 {{userInfo.days || 1}} 天</text>
        </block>
        <block wx:else>
          <!-- 未登录：昵称输入框（type="nickname" 可获取微信昵称） -->
          <input class="user-nickname-input" type="nickname" placeholder="点击获取微信昵称" value="{{loginNickname}}" bindinput="onInputNickname" bindblur="onNicknameBlur" />
          <text class="user-desc">设置头像和昵称，开始记录美食足迹</text>
        </block>
      </view>

      <!-- 头像区域 -->
      <block wx:if="{{isLoggedIn}}">
        <image class="user-avatar" src="{{avatarUrl}}" mode="aspectFill" bindtap="onTapUserProfile" />
      </block>
      <block wx:else>
        <!-- 未登录：头像选择按钮（open-type="chooseAvatar"） -->
        <button class="user-avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
          <image wx:if="{{loginAvatarUrl}}" class="user-avatar-img" src="{{loginAvatarUrl}}" mode="aspectFill" />
          <view wx:else class="user-avatar-placeholder">
            <i class="mgc_ghost_fill"></i>
            <text class="avatar-btn-text">点我</text>
          </view>
        </button>
      </block>
    </view>

    <!-- 统计一行：点击整行进入我的采集 -->
    <view class="stats-row" bindtap="onGoCollection">
      <view class="stat-item">
        <text class="stat-label">采集</text>
        <text class="stat-value">{{checkinStats.totalCount || 0}}</text>
      </view>
      <view class="stat-item">
        <text class="stat-label">城市</text>
        <text class="stat-value">{{checkinStats.cityCount || 0}}</text>
      </view>
      <view class="stat-item">
        <text class="stat-label">足迹</text>
        <text class="stat-value">{{stats.visitedCount || 0}}</text>
      </view>
    </view>

    <!-- 快捷入口：收藏保留，采集替换掉原来的我的发布 -->
    <view class="shortcut-section">
      <view class="shortcut-card" bindtap="onMenuTap" data-type="favorites">
        <i class="mgc_star_line shortcut-icon icon-gradient"></i>
        <text>收藏</text>
      </view>
      <view class="shortcut-card" bindtap="onGoCollection">
        <i class="mgc_flower_4_line shortcut-icon icon-gradient"></i>
        <text>采集</text>
      </view>
    </view>
  </view>

  <!-- 下方菜单：去掉我的想去和采集本，只保留这三项 -->
  <view class="list-section">
    <view class="list-item" bindtap="onMenuTap" data-type="guides">
      <text class="list-item-text">我的发布</text>
      <i class="mgc_right_line arrow-icon"></i>
    </view>
    <view class="list-item" bindtap="onMenuTap" data-type="settings">
      <text class="list-item-text">设置</text>
      <i class="mgc_right_line arrow-icon"></i>
    </view>
    <view class="list-item" bindtap="onMenuTap" data-type="share">
      <text class="list-item-text">分享我们</text>
      <i class="mgc_right_line arrow-icon"></i>
    </view>
  </view>

  <!-- 自定义 TabBar -->
  <custom-tabbar></custom-tabbar>
</view>
