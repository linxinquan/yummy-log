@import "../guide-detail/guide-detail.wxss";

.mode-switch[hidden] {
  display: none;
}

.place-swipe-cell {
  position: relative;
  overflow: hidden;
  min-height: 160rpx;
  margin-bottom: 48rpx;
}

.place-swipe-cell.drag-active-cell {
  overflow: visible;
  z-index: 30;
}

.place-swipe-cell.drag-active-cell .place-delete-btn {
  display: none;
}

.place-list {
  margin: 0 48rpx;
}

.day-anchor {
  position: relative;
  top: -132rpx;
  height: 0;
}

.place-delete-btn {
  position: absolute;
  top: 0;
  bottom: 0;
  right: 0;
  width: 120rpx;
  border-radius: 24rpx;
  background: #FF5A5F;
  display: flex;
  align-items: center;
  justify-content: center;
}

.place-delete-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
}

.place-delete-icon {
  font-size: 40rpx;
  line-height: 40rpx;
  color: #FFFFFF;
}

.place-delete-text {
  color: #FFFFFF;
  font-size: 24rpx;
  line-height: 24rpx;
  font-weight: 500;
}

.place-row {
  position: relative;
  margin: 0;
  transition: transform 0.18s ease;
  background: #FFFFFF;
  border-radius: 24rpx;
}

.place-handle i {
  color: #C7CAD1;
  font-size: 36rpx;
}

.place-row.dragging {
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.12);
  transition: none;
}

.add-place-entry {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  height: 88rpx;
  margin-bottom: 48rpx;
  border-radius: 24rpx;
  background: #F2F4F7;
  color: #242529;
  font-size: 28rpx;
}

.add-place-entry i {
  font-size: 32rpx;
  color: #242529;
}

.add-place-entry text {
  color: #242529;
}

.add-place-entry-empty {
  margin: 0;
}

.empty-day {
  margin: 0 48rpx 48rpx;
  padding: 0;
  background: transparent;
  border-radius: 0;
  display: block;
}

.bottom-btn i {
  font-size: 40rpx;
}

.route-bottom-bar {
  gap: 16rpx;
}

.route-icon-btn {
  width: 96rpx !important;
  flex: none !important;
  padding: 0;
}

.route-adjust-btn {
  width: 188rpx !important;
  flex: none !important;
  gap: 8rpx;
}

.route-nav-btn {
  flex: 1;
  min-width: 0;
  gap: 10rpx;
}

.place-picker-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0);
  z-index: 90;
  pointer-events: none;
  transition: background 0.3s;
}

.place-picker-mask.show {
  background: rgba(0, 0, 0, 0.4);
  pointer-events: auto;
}

.place-picker-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 72vh;
  background: #FFFFFF;
  border-radius: 48rpx 48rpx 0 0;
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.32, 0.72, 0, 1);
  overflow: hidden;
}

.place-picker-mask.show .place-picker-panel {
  transform: translateY(0);
}

.picker-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 40rpx 48rpx 24rpx;
}

.picker-title {
  color: #242529;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 32rpx;
}

.picker-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #242529;
  font-size: 48rpx;
}

.picker-tabs {
  display: flex;
  gap: 16rpx;
  padding: 0 48rpx 24rpx;
}

.picker-tab {
  min-width: 112rpx;
  height: 56rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: #F2F4F7;
  color: #6E727A;
  font-size: 24rpx;
  line-height: 56rpx;
  text-align: center;
  box-sizing: border-box;
}

.picker-tab.active {
  background: #47BFFE;
  color: #FFFFFF;
}

.place-picker-scroll {
  height: calc(72vh - 160rpx);
  padding: 0 48rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.picker-place-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #EEF0F3;
}

.picker-place-image {
  width: 112rpx;
  height: 112rpx;
  border-radius: 24rpx;
  background: #F2F4F7;
  flex-shrink: 0;
}

.picker-place-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.picker-place-tag {
  align-self: flex-start;
  padding: 6rpx 10rpx;
  border-radius: 8rpx;
  background: #FDF8E3;
  color: #ee8733;
  font-size: 20rpx;
  line-height: 20rpx;
}

.picker-place-name {
  color: #242529;
  font-size: 30rpx;
  line-height: 42rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.picker-place-meta {
  color: #6E727A;
  font-size: 24rpx;
  line-height: 24rpx;
}

.picker-place-add {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  background: #F2F4F7;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #47BFFE;
  flex-shrink: 0;
}

.picker-place-add i {
  font-size: 36rpx;
}

.picker-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 240rpx;
  color: #6E727A;
  font-size: 26rpx;
}

.map-panel {
  position: fixed;
  left: 48rpx;
  right: 48rpx;
  bottom: 48rpx;
  z-index: 20;
}

.map-card {
  border-radius: 32rpx;
  background: #FFFFFF;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.05);
}

.route-map-preview-card {
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  padding: 32rpx;
  min-height: 520rpx;
}

.preview-tabs-panel {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  width: 100%;
}

.preview-tab-scroll {
  width: 100%;
}

.preview-tab-row {
  display: inline-flex;
  align-items: center;
  gap: 32rpx;
  min-width: 100%;
  white-space: nowrap;
}

.preview-tab-item {
  flex-shrink: 0;
  color: #A0A4AE;
  font-size: 28rpx;
  line-height: 28rpx;
  font-weight: 500;
}

.preview-tab-item.active {
  color: #242529;
}

.preview-tab-divider {
  width: 100%;
  height: 2rpx;
  background: #F2F4F7;
}

.preview-card-stage {
  width: 100%;
}

.preview-detail-card {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  width: 100%;
}

.preview-side-inner {
  display: flex;
  flex-direction: column;
  gap: 40rpx;
  width: 100%;
}

.preview-card-head {
  display: flex;
  align-items: center;
  gap: 32rpx;
  width: 100%;
  min-width: 0;
}

.preview-cover-image {
  width: 128rpx;
  height: 128rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}

.preview-head-main {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 24rpx;
}

.preview-name {
  display: block;
  width: 100%;
  min-width: 0;
  max-width: 100%;
  color: #242529;
  font-size: 36rpx;
  line-height: 36rpx;
  font-weight: 400;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.preview-meta-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  width: 100%;
  min-width: 0;
  overflow: hidden;
}

.preview-chip {
  flex-shrink: 0;
  max-width: 160rpx;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  background: #F7F8FA;
  color: #A0A4AE;
  font-size: 22rpx;
  line-height: 22rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.preview-chip.score {
  background: #FDF8E3;
  color: #ee8733;
}

.preview-desc-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  width: 100%;
}

.preview-desc-left,
.preview-desc-right {
  min-width: 0;
  color: #6E727A;
  font-size: 24rpx;
  line-height: 24rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.preview-desc-left {
  flex: 1;
}

.preview-desc-right {
  flex-shrink: 0;
  max-width: 180rpx;
  text-align: right;
}

.preview-btn-row {
  display: flex;
  gap: 20rpx;
  width: 100%;
}

.preview-btn {
  flex: 1;
  min-width: 0;
  height: 76rpx;
  border-radius: 16rpx;
  background: #F7F8FA;
  display: flex;
  align-items: center;
  justify-content: center;
}

.preview-btn text {
  color: #242529;
  font-size: 28rpx;
  line-height: 28rpx;
}

.preview-btn.disabled {
  opacity: 0.35;
}

.preview-footer {
  display: grid;
  grid-template-columns: minmax(72rpx, auto) minmax(0, 1fr) minmax(72rpx, auto);
  align-items: center;
  column-gap: 16rpx;
  width: 100%;
  height: 32rpx;
  min-height: 32rpx;
}

.preview-footer-side {
  min-width: 72rpx;
  height: 32rpx;
  color: #6E727A;
  font-size: 24rpx;
  line-height: 24rpx;
  display: flex;
  align-items: center;
  justify-self: start;
  text-align: left;
}

.preview-footer travel-meta-line {
  height: 32rpx;
  display: flex;
  align-items: center;
  justify-self: center;
  min-width: 0;
  max-width: 100%;
}

.preview-footer-side.right {
  justify-content: flex-end;
  justify-self: end;
  text-align: right;
}
