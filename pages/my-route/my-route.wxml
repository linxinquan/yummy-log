<view class="page" wx:if="{{route}}">
  <view class="hero-wrap {{viewMode === 'map' ? 'hero-wrap-map' : ''}}">
    <map
      class="hero-map"
      latitude="{{mapCenter.lat}}"
      longitude="{{mapCenter.lng}}"
      scale="12"
      markers="{{mapMarkers}}"
      polyline="{{polyline}}"
      enable-zoom="{{viewMode === 'map'}}"
      enable-scroll="{{viewMode === 'map'}}"
      enable-rotate="{{false}}"
      enable-overlooking="{{false}}"
    ></map>
    <view class="hero-mask" wx:if="{{viewMode === 'list'}}"></view>
  </view>

  <view class="top-actions" style="top: {{menuTop}}px; height: {{menuHeight}}px;">
    <view class="top-icon" bindtap="onBack">
      <i class="mgc_left_line"></i>
    </view>
    <view class="top-icon" bindtap="onShareTap">
      <i class="mgc_share_forward_line"></i>
    </view>
  </view>

  <view class="mode-switch" style="top: {{modeSwitchTop}}px;" wx:if="{{route && !isEditing}}">
    <view class="mode-chip {{viewMode === 'list' ? 'active' : ''}}" bindtap="onSwitchMode" data-mode="list">
      <i class="mgc_list_check_line"></i>
      <text>列表</text>
    </view>
    <view class="mode-chip {{viewMode === 'map' ? 'active' : ''}}" bindtap="onSwitchMode" data-mode="map">
      <i class="mgc_world_2_line"></i>
      <text>地图</text>
    </view>
  </view>

  <block wx:if="{{viewMode === 'list'}}">
    <view class="detail-sheet" id="route-top-anchor">
      <view class="sheet-header">
        <text class="guide-title">{{route.title}}</text>
        <view class="guide-meta-row">
          <text class="guide-meta">{{summaryText}}</text>
          <text class="guide-city">{{cityText}}</text>
        </view>
      </view>

      <scroll-view class="tab-scroll" scroll-x enable-flex="{{true}}" show-scrollbar="{{false}}">
        <view class="tab-row">
          <view
            wx:for="{{tabs}}"
            wx:key="key"
            wx:for-item="tab"
            wx:for-index="tabIndex"
            class="tab-item {{currentTab === tabIndex ? 'active' : ''}}"
            bindtap="onTabTap"
            data-index="{{tabIndex}}"
          >
            <text>{{tab.label}}</text>
          </view>
          <view class="tab-item add-item" bindtap="onAddDay" wx:if="{{isEditing}}">
            <i class="mgc_add_line"></i>
            <text>新增</text>
          </view>
        </view>
      </scroll-view>

      <view class="section-divider"></view>

      <view class="sort-tip" wx:if="{{isEditing}}">
        <text>长按地点卡片并上下拖动，可调整当天顺序</text>
      </view>

      <view
        class="day-section"
        wx:for="{{daySections}}"
        wx:key="id"
        wx:for-item="day"
        wx:for-index="dayIndex"
        id="route-day-section-{{dayIndex}}"
      >
        <view class="day-header">
          <text class="day-title">{{day.title}}</text>
          <text class="day-count">{{day.countText}}</text>
        </view>

        <view class="place-list" wx:if="{{day.items.length}}">
          <view
            class="place-swipe-cell"
            wx:for="{{day.items}}"
            wx:key="id"
            wx:for-item="place"
            wx:for-index="placeIndex"
          >
            <view
              class="place-delete-btn"
              wx:if="{{isEditing}}"
              bindtap="onDeletePlace"
              data-day-index="{{dayIndex}}"
              data-index="{{placeIndex}}"
            >
              <i class="mgc_delete_2_line"></i>
            </view>
            <view
              class="place-row {{isEditing && dragging && dragDay === dayIndex && dragIndex === placeIndex ? 'dragging' : ''}}"
              style="transform: translateX({{isEditing ? (place.swipeOffset || 0) : 0}}px);"
              data-day-index="{{dayIndex}}"
              data-index="{{placeIndex}}"
              bindtouchstart="onSwipeStart"
              bindtouchmove="onSwipeMove"
              bindtouchend="onSwipeEnd"
            >
              <view class="place-cover-wrap">
                <view class="place-cover-shadow"></view>
                <image class="place-cover" src="{{place.image}}" mode="aspectFill"></image>
              </view>
              <view class="place-main">
                <view class="place-tag">{{place.tag}}</view>
                <text class="place-name">{{place.name}}</text>
                <text class="place-travel">{{place.travelText}}</text>
              </view>
              <view class="place-arrow" wx:if="{{!isEditing}}">
                <i class="mgc_right_small_fill"></i>
              </view>
              <view
                class="place-handle"
                wx:if="{{isEditing}}"
                data-day-index="{{dayIndex}}"
                data-index="{{placeIndex}}"
                catchtouchstart="onHandleTouchStart"
                bindlongpress="onDragStart"
                catchtouchmove="onDragMove"
                bindtouchend="onDragEnd"
                catchtap="noop"
              >
                <i class="mgc_dot_grid_line"></i>
              </view>
            </view>
          </view>
        </view>

        <view class="empty-day" wx:else>
          <text>这一天还没有地点，点击上方新增后可继续补充</text>
        </view>

        <view class="day-separator" wx:if="{{dayIndex < daySections.length - 1}}"></view>
      </view>
    </view>

    <view class="bottom-bar" wx:if="{{isEditing}}">
      <view class="bottom-btn secondary" bindtap="onCancelEdit">
        <text>取消</text>
      </view>
      <view class="bottom-btn primary" bindtap="onSave">
        <text>保存</text>
      </view>
    </view>
    <view class="bottom-bar" wx:else>
      <view class="bottom-btn secondary" bindtap="onEditMeta">
        <i class="mgc_edit_3_line"></i>
        <text>编辑</text>
      </view>
      <view class="bottom-btn primary" bindtap="onStartRouteEdit">
        <i class="mgc_route_line"></i>
        <text>修改路线</text>
      </view>
    </view>
  </block>

  <block wx:else>
    <view class="map-panel">
      <view class="map-card">
        <text class="map-title">{{route.title}}</text>
        <view class="map-meta-row">
          <text class="map-meta">{{summaryText}}</text>
          <text class="map-city">{{cityText}}</text>
        </view>
        <scroll-view class="map-chip-scroll" scroll-x enable-flex="{{true}}" show-scrollbar="{{false}}">
          <view class="map-chip-row">
            <view class="map-chip {{currentMapDay === -1 ? 'active' : ''}}" bindtap="onSelectMapDay" data-index="-1">全部路线</view>
            <view
              wx:for="{{daySections}}"
              wx:key="id"
              wx:for-item="day"
              wx:for-index="dayIndex"
              class="map-chip {{currentMapDay === dayIndex ? 'active' : ''}}"
              bindtap="onSelectMapDay"
              data-index="{{dayIndex}}"
            >
              {{day.title}}
            </view>
          </view>
        </scroll-view>
      </view>
    </view>
  </block>
</view>
