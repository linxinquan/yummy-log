<view class="page" wx:if="{{route}}">
  <view class="hero-wrap {{viewMode === 'map' ? 'hero-wrap-map' : ''}}">
    <map
      id="myRouteMap"
      class="hero-map"
      latitude="{{mapCenter.lat}}"
      longitude="{{mapCenter.lng}}"
      scale="{{mapScale}}"
      markers="{{mapMarkers}}"
      polyline="{{polyline}}"
      enable-zoom="{{viewMode === 'map'}}"
      enable-scroll="{{viewMode === 'map'}}"
      enable-rotate="{{false}}"
      enable-overlooking="{{false}}"
    ></map>
    <view class="hero-mask" wx:if="{{viewMode === 'list'}}"></view>
  </view>

  <view class="top-actions {{isEditing ? 'top-actions-editing' : ''}}" style="top: {{menuTop}}px; height: {{menuHeight}}px;">
    <view class="top-icon" bindtap="onBack" wx:if="{{!isEditing}}">
      <i class="mgc_left_line"></i>
    </view>
    <view class="edit-header-title" wx:if="{{isEditing}}">
      <text>编辑路线</text>
    </view>
  </view>

  <view class="mode-switch" style="top: {{modeSwitchTop}}px;" wx:if="{{route && !isEditing}}">
    <view class="mode-chip {{viewMode === 'list' ? 'active' : ''}}" bindtap="onSwitchMode" data-mode="list">
      <i class="mgc_list_check_line"></i>
      <text>列表</text>
    </view>
    <view class="mode-chip {{viewMode === 'map' ? 'active' : ''}}" bindtap="onSwitchMode" data-mode="map">
      <i class="mgc_world_2_line"></i>
      <text>地图</text>
    </view>
  </view>

  <block wx:if="{{viewMode === 'list'}}">
    <view class="detail-sheet">
      <scroll-view class="detail-scroll" scroll-y="{{!dragging}}" scroll-into-view="{{sheetScrollTarget}}" show-scrollbar="{{false}}">
        <view class="detail-scroll-inner">
          <view class="sheet-header" id="route-scroll-top">
            <text class="guide-title">{{route.title}}</text>
            <view class="guide-meta-row">
                <text class="guide-meta">{{summaryText}}</text>
              <text class="guide-city">{{cityText}}</text>
            </view>
          </view>

          <view class="tab-sticky-wrap">
            <scroll-view class="tab-scroll" scroll-x enable-flex="{{true}}" show-scrollbar="{{false}}">
              <view class="tab-row">
                <view
                  wx:for="{{tabs}}"
                  wx:key="key"
                  wx:for-item="tab"
                  wx:for-index="tabIndex"
                  wx:if="{{!(isEditing && tabIndex === 0)}}"
                  class="tab-item {{currentTab === tabIndex ? 'active' : ''}}"
                  bindtap="onTabTap"
                  data-index="{{tabIndex}}"
                >
                  <text>{{tab.label}}</text>
                </view>
                <view class="tab-item add-item" bindtap="onAddDay" wx:if="{{isEditing}}">
                  <i class="mgc_add_line"></i>
                </view>
              </view>
            </scroll-view>

            <view class="section-divider"></view>
          </view>

          <view class="sheet-content">
            <view class="overview-anchor" id="route-overview-anchor" wx:if="{{!isEditing}}"></view>
            <view class="overview-section" wx:if="{{!isEditing}}">
              <text class="overview-title">概览</text>
              <view class="overview-list" wx:if="{{hasRoutePlaces}}">
                <view
                  class="overview-card"
                  wx:for="{{daySections}}"
                  wx:key="id"
                  wx:for-item="day"
                  wx:for-index="dayIndex"
                >
                  <text class="overview-card-day">{{day.title}}</text>
                  <view
                    class="overview-place-row"
                    wx:for="{{day.items}}"
                    wx:key="id"
                    wx:for-item="place"
                    wx:for-index="placeIndex"
                  >
                    <view class="overview-place-main">
                      <text class="overview-place-index">{{placeIndex + 1}}.</text>
                      <text class="overview-place-name">{{place.name}}</text>
                    </view>
                    <view class="overview-place-tag">{{place.tag}}</view>
                  </view>
                </view>
              </view>
              <view class="overview-empty" wx:else>暂未添加行程地点</view>
            </view>
            <view class="day-separator overview-separator" wx:if="{{!isEditing}}"></view>

            <view
              class="day-section"
              wx:for="{{daySections}}"
              wx:key="id"
              wx:for-item="day"
              wx:for-index="dayIndex"
              id="route-day-section-{{dayIndex}}"
              data-day-index="{{dayIndex}}"
            >
              <view class="day-anchor" id="route-day-anchor-{{dayIndex}}"></view>
              <view class="day-header">
                <text class="day-title">{{day.title}}</text>
                <text class="day-count">{{day.countText}}</text>
              </view>

              <view class="place-list" wx:if="{{day.items.length}}">
                <view
                  class="place-swipe-cell {{isEditing && dragging && dragDay === dayIndex && dragIndex === placeIndex ? 'drag-active-cell' : ''}}"
                  wx:for="{{day.items}}"
                  wx:key="id"
                  wx:for-item="place"
                  wx:for-index="placeIndex"
                  data-day-index="{{dayIndex}}"
                  data-place-index="{{placeIndex}}"
                >
                  <view
                    class="place-delete-btn"
                    wx:if="{{isEditing && (place.swipeOffset || 0) < 0 && !(dragging && dragDay === dayIndex && dragIndex === placeIndex)}}"
                    bindtap="onDeletePlace"
                    data-day-index="{{dayIndex}}"
                    data-index="{{placeIndex}}"
                  >
                    <view class="place-delete-inner">
                      <i class="mgc_delete_2_line place-delete-icon"></i>
                      <text class="place-delete-text">删除</text>
                    </view>
                  </view>
                  <view
                    class="place-row {{isEditing && dragging && dragDay === dayIndex && dragIndex === placeIndex ? 'dragging' : ''}}"
                    style="transform: translateX({{isEditing ? (place.swipeOffset || 0) : 0}}px) translateY({{isEditing && dragging && dragDay === dayIndex && dragIndex === placeIndex ? dragOffsetY : 0}}px); z-index: {{isEditing && dragging && dragDay === dayIndex && dragIndex === placeIndex ? 20 : 1}};"
                    data-day-index="{{dayIndex}}"
                    data-index="{{placeIndex}}"
                    bindtouchstart="onSwipeStart"
                    bindtouchmove="onSwipeMove"
                    bindtouchend="onSwipeEnd"
                    bindlongpress="onDragStart"
                  >
                    <image class="place-cover" src="{{place.image}}" mode="aspectFill"></image>
                    <view class="place-info-row">
                      <view class="place-main">
                        <view class="place-head">
                          <view class="place-tag">
                            <text class="place-tag-text">{{place.tag}}</text>
                          </view>
                          <text class="place-name">{{place.name}}</text>
                        </view>
                        <travel-meta-line
                          class="place-meta-line"
                          travel-meta="{{place.travelMeta}}"
                          bindtapmeta="onOpenPlaceTransportSheet"
                          data-day-index="{{dayIndex}}"
                          data-index="{{placeIndex}}"
                        ></travel-meta-line>
                      </view>
                      <view class="place-arrow" wx:if="{{!isEditing}}">
                        <i class="mgc_right_line"></i>
                      </view>
                      <view
                        class="place-handle"
                        wx:if="{{isEditing}}"
                        data-day-index="{{dayIndex}}"
                        data-index="{{placeIndex}}"
                        catchtouchstart="onHandleTouchStart"
                        catchtap="noop"
                      >
                        <i class="mgc_dot_grid_line"></i>
                      </view>
                    </view>
                  </view>
                </view>
                <view class="add-place-entry" wx:if="{{isEditing}}" bindtap="onOpenPlacePicker" data-day-index="{{dayIndex}}">
                  <i class="mgc_location_2_line"></i>
                  <text>添加地点</text>
                </view>
              </view>

              <view class="empty-day" wx:else>
                <view class="add-place-entry add-place-entry-empty" wx:if="{{isEditing}}" bindtap="onOpenPlacePicker" data-day-index="{{dayIndex}}">
                  <i class="mgc_location_2_line"></i>
                  <text>添加地点</text>
                </view>
                <view class="route-empty-card" wx:else>
                  <view class="route-empty-icon">
                    <i class="mgc_route_line"></i>
                  </view>
                  <text class="route-empty-title">还没有添加地点</text>
                  <text class="route-empty-hint">点击下方“编辑”，进入编辑后添加地点</text>
                </view>
              </view>

              <view class="day-separator" wx:if="{{dayIndex < daySections.length - 1}}"></view>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>

    <view class="bottom-bar" wx:if="{{isEditing}}">
      <view class="bottom-btn secondary" bindtap="onCancelEdit">
        <text>取消</text>
      </view>
      <view class="bottom-btn primary" bindtap="onSave">
        <text>保存</text>
      </view>
    </view>
    <view class="bottom-bar route-bottom-bar" wx:else>
      <view class="bottom-btn secondary route-icon-btn" bindtap="onEditMeta">
        <i class="mgc_pencil_3_line"></i>
      </view>
      <view class="bottom-btn secondary route-adjust-btn" bindtap="onStartRouteEdit">
        <i class="mgc_ai_line"></i>
        <text>编辑</text>
      </view>
      <view class="bottom-btn primary route-nav-btn" bindtap="onViewRoute">
        <i class="mgc_route_line"></i>
        <text>查看路线</text>
      </view>
    </view>
  </block>

  <block wx:else>
    <view class="map-panel">
      <view class="map-panel-actions" wx:if="{{mapPreviewPlace}}">
        <view class="map-floating-icon" bindtap="onSwitchMode" data-mode="list">
          <i class="mgc_left_line"></i>
        </view>
        <view class="map-floating-icon" bindtap="onFitRoute">
          <i class="mgc_fullscreen_line"></i>
        </view>
      </view>
      <view class="map-card route-map-preview-card" wx:if="{{mapPreviewPlace}}">
        <view class="preview-tabs-panel">
          <scroll-view class="preview-tab-scroll" scroll-x enable-flex="{{true}}" show-scrollbar="{{false}}">
            <view class="preview-tab-row">
              <view
                wx:for="{{previewTabs}}"
                wx:key="index"
                class="preview-tab-item {{((currentMapDay < 0 && item.index === 0) || currentMapDay === item.index) ? 'active' : ''}}"
                bindtap="onSelectMapPreviewDay"
                data-index="{{item.index}}"
              >
                {{item.label}}
              </view>
            </view>
          </scroll-view>
          <view class="preview-tab-divider"></view>
        </view>

        <view class="preview-card-stage">
          <view class="preview-detail-card">
            <view class="preview-side-inner">
              <view class="preview-card-head">
                <image class="preview-cover-image" src="{{mapPreviewPlace.image || mapPreviewPlace.coverImage}}" mode="aspectFill"></image>
                <view class="preview-head-main">
                  <text class="preview-name">{{mapPreviewPlace.name}}</text>
                  <view class="preview-meta-row" wx:if="{{previewDisplayMeta.length > 0}}">
                    <view
                      wx:for="{{previewDisplayMeta}}"
                      wx:key="index"
                      wx:for-item="chip"
                      class="preview-chip {{chip.type === 'score' ? 'score' : ''}}"
                    >
                      {{chip.text}}
                    </view>
                  </view>
                </view>
              </view>

              <view class="preview-desc-row">
                <text class="preview-desc-left">{{previewDescriptionText}}</text>
                <text class="preview-desc-right">{{previewFeeText}}</text>
              </view>
            </view>

            <view class="preview-btn-row">
              <view
                class="preview-btn {{previewDisablePrev ? 'disabled' : ''}}"
                bindtap="onMapPreviewStep"
                data-index="{{previewPrevIndex}}"
              >
                <text>上一站</text>
              </view>
              <view
                class="preview-btn {{previewDisableNext ? 'disabled' : ''}}"
                bindtap="onMapPreviewStep"
                data-index="{{previewNextIndex}}"
              >
                <text>下一站</text>
              </view>
            </view>
          </view>
        </view>

        <view class="preview-footer">
          <view class="preview-footer-side">
            <text>{{previewStationText}}</text>
          </view>
          <travel-meta-line variant="compact" travel-meta="{{mapPreviewPlace.travelMeta}}" bindtapmeta="onOpenMapTransportSheet"></travel-meta-line>
          <view class="preview-footer-side right">
            <text>{{previewCountText}}</text>
          </view>
        </view>
      </view>
    </view>
  </block>

  <view class="place-picker-mask {{placePickerVisible ? 'show' : ''}}" bindtap="onClosePlacePicker">
    <view class="place-picker-panel" catchtap="preventBubble">
      <view class="picker-header">
        <text class="picker-title">添加地点</text>
        <i class="mgc_close_line picker-close" bindtap="onClosePlacePicker"></i>
      </view>
      <view class="picker-body">
        <view class="picker-toolbar">
          <view class="picker-tabs">
            <view class="picker-tab {{placePickerTab === 'all' ? 'active' : ''}}" bindtap="onSwitchPlacePickerTab" data-tab="all">全部</view>
            <view class="picker-tab {{placePickerTab === 'want' ? 'active' : ''}}" bindtap="onSwitchPlacePickerTab" data-tab="want">想去</view>
            <view class="picker-tab {{placePickerTab === 'collect' ? 'active' : ''}}" bindtap="onSwitchPlacePickerTab" data-tab="collect">收藏</view>
          </view>
          <view class="picker-map-btn" bindtap="onChoosePlaceFromMap">
            <i class="mgc_location_line"></i>
            <text>地图选点</text>
          </view>
        </view>
        <scroll-view class="place-picker-scroll" scroll-y show-scrollbar="{{false}}">
          <block wx:if="{{placePickerCurrentItems.length}}">
            <view
              class="picker-place-card"
              wx:for="{{placePickerCurrentItems}}"
              wx:key="sourceKey"
              bindtap="onAddPlaceToDay"
              data-item="{{item}}"
            >
              <view class="picker-place-image-wrap">
                <image class="picker-place-image" src="{{item.image}}" mode="aspectFill"></image>
                <view class="picker-place-tag">{{item.tag}}</view>
              </view>
              <view class="picker-place-info">
                <view class="picker-place-info-inner">
                  <text class="picker-place-name">{{item.name}}</text>
                  <view class="picker-place-rating">
                    <view class="picker-rating-star" wx:if="{{item.rating}}">
                      <text>{{item.rating}}</text>
                    </view>
                    <text class="picker-place-chip" wx:for="{{item.tags}}" wx:key="*this">{{item}}</text>
                  </view>
                </view>
                <view class="picker-place-footer">
                  <text class="picker-place-meta">{{item.sourceText}}</text>
                </view>
              </view>
              <view class="picker-place-add-btn">
                <i class="mgc_add_line"></i>
              </view>
            </view>
          </block>
          <view class="picker-empty" wx:else>
            <text>还没有可添加的地点</text>
          </view>
        </scroll-view>
      </view>
    </view>
  </view>

  <transport-info-sheet
    visible="{{transportSheetVisible}}"
    options="{{transportOptions}}"
    selected-mode="{{pendingTransportMode}}"
    bindclose="onCloseTransportSheet"
    bindselect="onSelectTransportMode"
    bindconfirm="onConfirmTransportMode"
  ></transport-info-sheet>
</view>
