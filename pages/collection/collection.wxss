page {
  background: #FFFFFF;
}

.container {
  min-height: 100vh;
  background: #FFFFFF;
  padding-bottom: env(safe-area-inset-bottom);
}

.header {
  padding: 48rpx;
  background: #FFFFFF;
}

.district-title {
  color: #242529;
  font-size: 48rpx;
  font-weight: 500;
  line-height: 48rpx;
}

.page-content {
  padding-left: 48rpx;
  padding-right: 48rpx;
}

.hero-card {
  padding: 40rpx 32rpx;
  border-radius: 32rpx;
  background: #FFFFFF;
  border: 2rpx solid #F0F1F3;
}

.hero-action-row {
  display: flex;
  justify-content: flex-end;
}

.hero-action-btn {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  height: 72rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: #242529;
  color: #FFFFFF;
  flex-shrink: 0;
}

.hero-action-btn i {
  font-size: 32rpx;
  line-height: 32rpx;
}

.hero-action-btn text {
  color: #FFFFFF;
  font-size: 28rpx;
  line-height: 28rpx;
}

.hero-stats {
  display: flex;
  align-items: center;
  margin-top: 32rpx;
  gap: 24rpx;
}

.hs-item {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.hs-num {
  color: #242529;
  font-size: 44rpx;
  font-weight: 600;
  line-height: 44rpx;
}

.hs-label,
.hs-sep {
  color: #6E727A;
  font-size: 24rpx;
  line-height: 24rpx;
}

.view-tabs {
  display: flex;
  gap: 16rpx;
  margin-top: 32rpx;
  padding: 8rpx;
  border-radius: 999rpx;
  background: #F7F8FA;
}

.vt-item {
  flex: 1;
  height: 72rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  color: #6E727A;
}

.vt-item.active {
  background: #FFFFFF;
  color: #242529;
  box-shadow: inset 0 0 0 2rpx #F0F1F3;
}

.vt-icon {
  color: inherit;
  font-size: 30rpx;
  line-height: 30rpx;
}

.vt-item text {
  color: inherit;
  font-size: 28rpx;
  line-height: 28rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: calc(100vh - 520rpx);
  padding: 0 24rpx;
}

.empty-illustration {
  width: 200rpx;
  height: 200rpx;
  border-radius: 999rpx;
  background: #F7F8FA;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
}

.empty-icon {
  font-size: 100rpx;
  color: #A0A4AE;
}

.empty-title {
  color: #242529;
  font-size: 36rpx;
  font-weight: 500;
  line-height: 36rpx;
}

.empty-hint {
  margin-top: 24rpx;
  color: #6E727A;
  font-size: 28rpx;
  line-height: 40rpx;
  text-align: center;
}

.empty-actions {
  width: 100%;
  margin-top: 40rpx;
}

.empty-btn {
  width: 100%;
  height: 88rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  border: none;
}

.empty-btn::after {
  border: none;
}

.empty-btn-primary {
  background: #242529;
  color: #FFFFFF;
}

.empty-btn-primary i,
.empty-btn-primary text {
  color: #FFFFFF;
  font-size: 28rpx;
  line-height: 28rpx;
}

/* 列表区：改成纵向信息卡，突出标题、标签、时间 */
.checkin-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding: 32rpx 0 0;
}

.checkin-card {
  display: flex;
  gap: 24rpx;
  padding: 24rpx;
  border-radius: 28rpx;
  background: #FFFFFF;
  border: 2rpx solid #F0F1F3;
  box-sizing: border-box;
}

.checkin-card-photo {
  width: 176rpx;
  height: 176rpx;
  border-radius: 24rpx;
  flex-shrink: 0;
  background: #F7F8FA;
}

.checkin-card-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.checkin-card-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.checkin-type-badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  height: 44rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}

.checkin-type-badge.food {
  color: #D59B1A;
  background: #FFF7E8;
}

.checkin-type-badge.spot {
  color: #2F92EE;
  background: #ECF6FF;
}

.checkin-type-badge i,
.checkin-type-badge text {
  color: inherit;
  font-size: 22rpx;
  line-height: 22rpx;
}

.checkin-card-date {
  color: #8F949C;
  font-size: 22rpx;
  line-height: 22rpx;
  flex-shrink: 0;
}

.checkin-card-title {
  color: #242529;
  font-size: 34rpx;
  font-weight: 500;
  line-height: 44rpx;
  word-break: break-all;
}

.checkin-card-address {
  color: #6E727A;
  font-size: 26rpx;
  line-height: 38rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.checkin-card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: auto;
  padding-top: 8rpx;
}

.checkin-card-time {
  color: #A0A4AE;
  font-size: 24rpx;
  line-height: 24rpx;
}

.checkin-card-arrow {
  width: 44rpx;
  height: 44rpx;
  border-radius: 999rpx;
  background: #F7F8FA;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8F949C;
}

.checkin-card-arrow i {
  color: inherit;
  font-size: 24rpx;
  line-height: 24rpx;
}

.map-wrap {
  width: 100%;
  height: 760rpx;
  margin-top: 32rpx;
  overflow: hidden;
  border-radius: 32rpx;
}

.collection-map {
  width: 100%;
  height: 100%;
}

.map-list {
  margin-top: 24rpx;
  white-space: nowrap;
}

.map-card {
  display: inline-flex;
  align-items: center;
  gap: 20rpx;
  width: 360rpx;
  margin-right: 24rpx;
  padding: 20rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  border: 2rpx solid #F0F1F3;
  box-sizing: border-box;
}

.mc-photo {
  width: 96rpx;
  height: 96rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
}

.mc-info {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.mc-top-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.mc-type-badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  height: 40rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}

.mc-type-badge.food {
  color: #D59B1A;
  background: #FFF7E8;
}

.mc-type-badge.spot {
  color: #2F92EE;
  background: #ECF6FF;
}

.mc-type-badge i,
.mc-type-badge text {
  color: inherit;
  font-size: 20rpx;
  line-height: 20rpx;
}

.mc-name {
  color: #242529;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 36rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.mc-date {
  color: #8F949C;
  font-size: 22rpx;
  line-height: 22rpx;
}

.mc-addr {
  color: #6E727A;
  font-size: 24rpx;
  line-height: 32rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
