page {
  background: #FFFFFF;
}

.container {
  min-height: 100vh;
  background-color: #F7F8FA;
  padding-bottom: env(safe-area-inset-bottom);
}

.header {
  padding: 48rpx;
  background: linear-gradient(#ffffff, #F7F8FA);
}

.header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.district-title {
  color: #242529;
  font-size: 48rpx;
  font-weight: 500;
  line-height: 48rpx;
}

.page-content {
  padding-left: 24px;
  padding-right: 24px;
}

.hero-action-btn {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  height: 64rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: #242529;
  color: #FFFFFF;
  flex-shrink: 0;
}

.hero-action-btn i {
  font-size: 32rpx;
  line-height: 32rpx;
}

.hero-action-btn text {
  color: #FFFFFF;
  font-size: 28rpx;
  line-height: 28rpx;
}

/* 顶部三张统计卡：对齐设计稿的独立小卡 */
.stats-row {
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
}

.stat-card {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 20rpx;
  width: 216rpx;
  height: 136rpx;
  padding-left: 24rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.stat-label {
  color: #A0A4AE;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 24rpx;
}

.stat-value {
  color: #242529;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 44rpx;
  font-family: 'DIN Alternate', 'PingFang SC', sans-serif;
}

.view-tabs {
  display: flex;
  align-items: center;
  gap: 32rpx;
  margin-top: 96rpx;
}

.vt-item {
  display: flex;
  align-items: center;
  color: #C1C1C1;
}

.vt-item.active {
  color: #242529;
}

.vt-item text {
  color: inherit;
  font-size: 40rpx;
  font-weight: 500;
  line-height: 40rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: calc(100vh - 520rpx);
  padding: 0 24rpx;
}

.empty-illustration {
  width: 200rpx;
  height: 200rpx;
  border-radius: 999rpx;
  background: #F7F8FA;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
}

.empty-icon {
  font-size: 100rpx;
  color: #A0A4AE;
}

.empty-title {
  color: #242529;
  font-size: 36rpx;
  font-weight: 500;
  line-height: 36rpx;
}

.empty-hint {
  margin-top: 24rpx;
  color: #6E727A;
  font-size: 28rpx;
  line-height: 40rpx;
  text-align: center;
}

.empty-actions {
  width: 100%;
  margin-top: 40rpx;
}

.empty-btn {
  width: 100%;
  height: 80rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.empty-btn::after {
  border: none;
}

.empty-btn-primary {
  background: #242529;
  color: #FFFFFF;
}

.empty-btn-primary text {
  color: #FFFFFF;
  font-size: 28rpx;
  line-height: 28rpx;
}

/* 邮票网格：2 列邮票排版 */
.stamp-grid {
  display: grid;
  grid-template-columns: 340rpx 340rpx;
  column-gap: 4rpx;
  row-gap: 48rpx;
  justify-content: start;
  padding: 32rpx 0 96rpx;
}

.stamp-item {
  width: 340rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 32rpx;
  position: relative;
  z-index: 1;
}

.stamp-ticket {
  position: relative;
  width: 340rpx;
  height: 442rpx;
  overflow: visible;
  z-index: 1;
}

.stamp-bottom-shadow {
  position: absolute;
  left: 35%;
  bottom: -16rpx;
  width: 96rpx;
  height: 96rpx;
  border-radius: 16rpx;
  background: rgba(0, 0, 0, 0.3);
  filter: blur(64rpx);
  opacity: 0.85;
  z-index: 0;
}

.stamp-shell {
  position: absolute;
  left: 0;
  top: 0;
  width: 340rpx;
  height: 442rpx;
  z-index: 1;
}

.stamp-photo {
  position: absolute;
  left: 32rpx;
  top: 32rpx;
  width: 276rpx;
  height: 368rpx;
  background: transparent;
  /* 图片使用 3:4 比例，叠在邮票上层显示 */
  z-index: 2;
}

.stamp-title {
  width: 276rpx;
  color: #000000;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 32rpx;
  text-align: center;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
  position: relative;
  z-index: 2;
}

.map-wrap {
  width: 100%;
  height: 760rpx;
  margin-top: 32rpx;
  overflow: hidden;
  border-radius: 32rpx;
}

.collection-map {
  width: 100%;
  height: 100%;
}

.map-marker-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  width: 170px;
  height: 264px;
  opacity: 0;
  pointer-events: none;
}

.map-list {
  margin-top: 24rpx;
  white-space: nowrap;
}

.map-card {
  display: inline-flex;
  align-items: center;
  gap: 20rpx;
  width: 360rpx;
  margin-right: 24rpx;
  padding: 20rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  border: 2rpx solid #F0F1F3;
  box-sizing: border-box;
}

.mc-photo {
  width: 96rpx;
  height: 96rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
}

.mc-info {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.mc-top-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.mc-type-badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  height: 40rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}

.mc-type-badge.food {
  color: #D59B1A;
  background: #FFF7E8;
}

.mc-type-badge.spot {
  color: #2F92EE;
  background: #ECF6FF;
}

.mc-type-badge i,
.mc-type-badge text {
  color: inherit;
  font-size: 20rpx;
  line-height: 20rpx;
}

.mc-name {
  color: #242529;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 36rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.mc-date {
  color: #8F949C;
  font-size: 22rpx;
  line-height: 22rpx;
}

.mc-addr {
  color: #6E727A;
  font-size: 24rpx;
  line-height: 32rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.route-action-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0);
  z-index: 1004;
  pointer-events: none;
  transition: background 0.3s;
}

.route-action-mask.show {
  background: rgba(0, 0, 0, 0.4);
  pointer-events: auto;
}

.route-action-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.32, 0.72, 0, 1);
}

.route-action-mask.show .route-action-sheet {
  transform: translateY(0);
}

.route-action-header {
  height: 128rpx;
  padding: 0 48rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
}

.route-action-title {
  color: #242529;
  font-size: 40rpx;
  line-height: 100%;
  font-weight: 500;
}

.route-action-close {
  color: #242529;
  font-size: 40rpx;
  line-height: 40rpx;
}

.route-action-body {
  padding: 0 48rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.route-action-grid {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.route-action-card {
  width: 100%;
  min-height: 104rpx;
  border-radius: 24rpx;
  border: 2rpx solid #E5E7EB;
  background: #FFFFFF;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 0 32rpx;
  box-sizing: border-box;
}

.route-action-card.active {
  border-color: #242529;
}

.route-action-card.danger .route-action-icon,
.route-action-card.danger .route-action-label {
  color: #FF5A5F;
}

.route-action-card.active.danger {
  border-color: #FF5A5F;
  background: #FFF7F7;
}

.route-action-icon {
  color: #242529;
  font-size: 40rpx;
  line-height: 40rpx;
  flex-shrink: 0;
}

.route-action-label {
  color: #242529;
  font-size: 32rpx;
  line-height: 32rpx;
  font-weight: 400;
  flex: 1;
  text-align: left;
}

.route-action-confirm {
  margin-top: 48rpx;
  width: 100%;
  height: 96rpx;
  border-radius: 999rpx;
  background: #242529;
  color: #FFFFFF;
  font-size: 32rpx;
  line-height: 32rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
}

.route-edit-name-sheet .route-action-body {
  padding-top: 0rpx;
}

.route-edit-name-input {
  width: 100%;
  height: 104rpx;
  padding: 0 32rpx;
  border-radius: 24rpx;
  border: 2rpx solid #E5E7EB;
  background: #FFFFFF;
  box-sizing: border-box;
  color: #242529;
  font-size: 28rpx;
  font-weight: 400;
}
