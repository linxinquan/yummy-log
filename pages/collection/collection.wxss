/* pages/collection/collection.wxss - 基于 Design System v1.0 */

.container {
  min-height: 100vh;
  background: var(--background);
  padding-bottom: calc(var(--space-xl) + env(safe-area-inset-bottom));
}

/* 顶部统计横幅 */
.hero-bar {
  background: var(--gradient-warm);
  padding: var(--space-xl) var(--space-md) var(--space-lg);
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
  border-bottom: 2rpx solid var(--border);
}

.hero-title {
  color: var(--primary-dark);
}

.hero-stats {
  display: flex;
  align-items: center;
  gap: var(--space-md);
}

.hs-item {
  display: flex;
  align-items: baseline;
  gap: var(--space-xs);
}

.hs-num {
  color: var(--primary);
}

.hs-label {
  color: var(--text-secondary);
}

.hs-sep {
  color: var(--text-disabled);
}

/* 视图切换 Tab */
.view-tabs {
  display: flex;
  background: var(--surface);
  border-bottom: 2rpx solid var(--border);
}

.vt-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-sm);
  padding: var(--space-md) 0;
  color: var(--text-secondary);
  transition: all 0.2s;
  border-bottom: 4rpx solid transparent;
}

.vt-item.active {
  color: var(--primary);
  border-bottom-color: var(--primary);
  
}

.vt-icon {
  color: inherit;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-height: calc(100vh - 320rpx);
  padding: 0 48rpx calc(120rpx + env(safe-area-inset-bottom));
}

.empty-illustration {
  width: 240rpx;
  height: 240rpx;
  border-radius: 999rpx;
  background: #F7F8FA;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 48rpx;
}

.empty-icon {
  font-size: 120rpx;
  color: #A0A4AE;
}

.empty-title {
  color: #242529;
  font-size: 40rpx;
  line-height: 40rpx;
  margin-bottom: 32rpx;
  font-weight: 500;
}

.empty-hint {
  font-size: 28rpx;
  color: #6E727A;
  line-height: 40rpx;
  text-align: center;
  margin-bottom: 48rpx;
}

.empty-actions {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.empty-btn {
  width: 100%;
  height: 80rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border: none;
}

.empty-btn::after {
  border: none;
}

.empty-btn-primary {
  background: #242529;
  color: #FFFFFF;
}

.empty-btn-secondary {
  background: #FFFFFF;
  color: #242529;
  box-shadow: inset 0 0 0 2rpx #E5E7EB;
}

/* 邮票网格 */
.stamps-grid {
  display: flex;
  flex-wrap: wrap;
  padding: var(--space-md);
  gap: var(--space-md);
}

.stamp-item {
  width: calc(50% - var(--space-sm));
}

.stamp-card {
  padding: 0; /* override card default padding */
  overflow: hidden;
  position: relative;
  box-shadow: var(--shadow-sm);
}

/* Stamp edge styling (perforations) */
.stamp-card::before {
  content: '';
  position: absolute;
  top: -8rpx;
  left: 0;
  right: 0;
  height: 16rpx;
  background: radial-gradient(circle at 50% 100%, var(--background) 8rpx, var(--surface) 8rpx) 0 0 / 20rpx 16rpx repeat-x;
  z-index: 1;
}

.stamp-card::after {
  content: '';
  position: absolute;
  bottom: -8rpx;
  left: 0;
  right: 0;
  height: 16rpx;
  background: radial-gradient(circle at 50% 0%, var(--background) 8rpx, var(--surface) 8rpx) 0 0 / 20rpx 16rpx repeat-x;
  z-index: 1;
}

.stamp-photo-wrap {
  position: relative;
  width: 100%;
  height: 240rpx; /* ~4:3 */
  overflow: hidden;
}

.stamp-photo {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.stamp-postmark {
  position: absolute;
  top: var(--space-sm);
  right: var(--space-sm);
  background: rgba(71, 191, 254, 0.85); /* primary with opacity */
  border-radius: var(--radius-full);
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(255,255,255,0.6);
  z-index: 2;
}

.pm-date {
  color: var(--surface);
  
  text-align: center;
  transform: rotate(-15deg); /* playful angle */
}

.stamp-info {
  padding: var(--space-md);
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
  background: var(--surface);
}

.stamp-name {
  color: var(--text-primary);
  
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.stamp-addr {
  color: var(--text-secondary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 类型标签 */
.stamp-type-tag {
  position: absolute;
  top: var(--space-sm);
  left: var(--space-sm);
  background: rgba(255,255,255,0.92);
  backdrop-filter: blur(8rpx);
  border-radius: var(--radius-sm);
  padding: var(--space-xs) var(--space-sm);
  
  color: var(--text-primary);
  z-index: 2;
  box-shadow: var(--shadow-xs);
}

/* 地图视图 */
.map-wrap {
  width: 100%;
  height: 65vh;
}

.collection-map {
  width: 100%;
  height: 100%;
}

.map-list {
  width: 100%;
  white-space: nowrap;
  padding: var(--space-md);
  background: var(--surface);
  box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.06);
  position: relative;
  z-index: 10;
}

.map-card {
  display: inline-flex;
  align-items: center;
  gap: var(--space-md);
  margin-right: var(--space-md);
  width: 360rpx;
  white-space: normal;
  margin-bottom: 0;
}

.mc-photo {
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--radius-sm);
  flex-shrink: 0;
  object-fit: cover;
}

.mc-info {
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
  overflow: hidden;
}

.mc-icon {
  color: var(--text-secondary);
}

.mc-name {
  color: var(--text-primary);
  
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.mc-date {
  color: var(--text-disabled);
}

/* 浮动采集按钮 (FAB) */
.fab {
  position: fixed;
  right: var(--space-lg);
  bottom: calc(160rpx + env(safe-area-inset-bottom));
  width: 112rpx; /* 56px */
  height: 112rpx; /* 56px */
  background: var(--primary);
  border-radius: var(--radius-full);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-lg);
  z-index: 100;
  transition: transform 0.2s;
}

.fab:active {
  transform: scale(0.95);
}

.fab-icon {
  color: var(--surface);
  line-height: 0.8;
  
}

.fab-text {
  color: var(--surface);
  
  margin-top: -4rpx;
}
