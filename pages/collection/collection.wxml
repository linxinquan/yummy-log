<!-- pages/collection/collection.wxml - 我的采集本 (基于 Design System v1.0) -->
<view class="container">

  <!-- 顶部统计横幅 -->
  <view class="hero-bar">
    <view class="hero-title display">我的采集本</view>
    <view class="hero-stats">
      <view class="hs-item">
        <text class="hs-num display">{{stats.totalCount}}</text>
        <text class="hs-label caption">采集</text>
      </view>
      <view class="hs-sep body">·</view>
      <view class="hs-item">
        <text class="hs-num display">{{stats.cityCount}}</text>
        <text class="hs-label caption">城市</text>
      </view>
      <view class="hs-sep body">·</view>
      <view class="hs-item">
        <text class="hs-num display">{{stats.spotCount}}</text>
        <text class="hs-label caption">景点</text>
      </view>
    </view>
  </view>

  <!-- 视图切换 Tab -->
  <view class="view-tabs">
    <view class="vt-item body-sm {{viewMode === 'list' ? 'active' : ''}}" bindtap="onSwitchView" data-view="list">
      <i class="mgc_list_check_line vt-icon heading-3"></i>
      <text>列表</text>
    </view>
    <view class="vt-item body-sm {{viewMode === 'map' ? 'active' : ''}}" bindtap="onSwitchView" data-view="map">
      <i class="mgc_map_line vt-icon heading-3"></i>
      <text>地图</text>
    </view>
  </view>

  <!-- 列表视图 -->
  <block wx:if="{{viewMode === 'list'}}">
    <view class="empty-state" wx:if="{{checkins.length === 0}}">
      <view class="empty-illustration">
        <i class="mgc_package_line empty-icon"></i>
      </view>
      <text class="empty-title">我的采集本</text>
      <text class="empty-hint">去记录你的第一张采集卡吧</text>
      <view class="empty-actions">
        <button class="empty-btn empty-btn-primary" bindtap="onGoCheckinFood"><i class="mgc_fork_spoon_line"></i>美食打卡</button>
        <button class="empty-btn empty-btn-secondary" bindtap="onGoCheckinSpot"><i class="mgc_scenery_line"></i>景点打卡</button>
      </view>
    </view>

    <view class="stamps-grid" wx:else>
      <view class="stamp-item" wx:for="{{checkins}}" wx:key="id" bindtap="onCheckinTap" data-id="{{item.id}}">
        <view class="stamp-card card">
          <!-- 类型标签 -->
          <view class="stamp-type-tag caption"><i class="{{item.typeIcon}}"></i> {{item.typeLabel}}</view>
          <view class="stamp-photo-wrap">
            <image class="stamp-photo" src="{{item.photoPath}}" mode="aspectFill" />
            <view class="stamp-postmark">
              <text class="pm-date caption">{{item.dateStr}}</text>
            </view>
          </view>
          <view class="stamp-info">
            <!-- 优先显示店名/景点名，再显示地址 -->
            <text class="stamp-name body">{{item.spotName || item.shortAddr || '未知地点'}}</text>
            <text class="stamp-addr caption">{{item.shortAddr}}</text>
          </view>
        </view>
      </view>
    </view>
  </block>

  <!-- 地图视图 -->
  <block wx:if="{{viewMode === 'map'}}">
    <view class="map-wrap">
      <map
        class="collection-map"
        latitude="{{mapCenter.lat}}"
        longitude="{{mapCenter.lng}}"
        scale="12"
        markers="{{mapMarkers}}"
        show-location
        enable-zoom
        enable-scroll
      />
    </view>
    <scroll-view class="map-list" scroll-x enable-flex>
      <view class="map-card card" wx:for="{{checkins}}" wx:key="id" bindtap="onCheckinTap" data-id="{{item.id}}">
        <image class="mc-photo" src="{{item.photoPath}}" mode="aspectFill" />
        <view class="mc-info">
          <view class="mc-icon body"><i class="{{item.typeIcon}}"></i></view>
          <text class="mc-name body-sm">{{item.spotName || item.address}}</text>
          <text class="mc-date caption">{{item.dateStr}}</text>
        </view>
      </view>
    </scroll-view>
  </block>

  <!-- 浮动采集按钮 (FAB) -->
  <view class="fab" bindtap="onGoCheckinFood">
    <text class="fab-icon display">＋</text>
    <text class="fab-text caption">采集</text>
  </view>

</view>
