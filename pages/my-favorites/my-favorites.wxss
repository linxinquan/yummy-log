/* pages/my-favorites/my-favorites.wxss */

.page {
  background: #FFFFFF;
}

.container {
  min-height: 100vh;
  background: #FFFFFF;
  padding-bottom: env(safe-area-inset-bottom);
  display: flex;
  flex-direction: column;
}

/* ── 大标题（与 district-guide 一致） ── */
.header {
  padding: 48rpx; 
  background: #FFFFFF;
}

.district-title {
  font-family: 'PingFang SC';
  font-style: normal;
  font-weight: 500;
  font-size: 48rpx;
  line-height: 100%;
  color: #242529;
}

/* ── 空状态 ── */
.empty-state {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 0 48rpx calc(120rpx + env(safe-area-inset-bottom));
}

.empty-illustration {
  width: 240rpx;
  height: 240rpx;
  border-radius: 999rpx;
  background: #F7F8FA;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 48rpx;
}

.empty-icon {
  font-size: 120rpx;
  color: #A0A4AE;
}

.empty-title {
  color: #242529;
  font-size: 40rpx;
  line-height: 40rpx;
  margin-bottom: 32rpx;
  font-weight: 500;
}

.empty-hint {
  font-size: 28rpx;
  color: #6E727A;
  text-align: center;
  line-height: 40rpx;
  white-space: pre-line;
  margin-bottom: 48rpx;
}

.empty-btn {
  min-width: 176rpx;
  height: 80rpx;
  padding: 0 32rpx;
  border-radius: 999rpx;
  background: #242529;
  font-size: 28rpx;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ── 列表容器 ── */
.list-container {
  flex: 1;

  background: #FFFFFF;
}

/* ── 卡片项（与探索页面弹窗列表一致） ── */
.card-item {
  display: flex;
  align-items: flex-start;
  gap: 32rpx; /* 16px 间距，图片与右侧信息 */
  background: transparent;
  border-radius: 0;
  padding: 0 48rpx; /* 24px */
  margin-bottom: 48rpx; /* 24px */
  position: relative;
  width: 100vw;
  height: 200rpx; /* 100px */
  box-sizing: border-box;
}

/* 封面图 */
.card-img-wrap {
  width: 200rpx;
  height: 200rpx;
  flex-shrink: 0;
  border-radius: 24rpx;
  overflow: hidden;
  position: relative;
  background: #F2F4F7;
}

.card-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* 左上角分类徽章 */
.card-cat-badge {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  background: rgba(0, 0, 0, 0.1);
  border-radius: 8rpx;
  padding: 6rpx 8rpx;
  font-family: 'PingFang SC';
  font-size: 20rpx;
  color: #FFFFFF;
  line-height: 20rpx;
  backdrop-filter: blur(4px);
}

/* 信息区 */
.card-info {
  display: flex;
  flex-direction: column;
  padding: 16rpx 0;
  justify-content: space-between;
  height: 200rpx;
  box-sizing: border-box;
  width: calc(100vw - 328rpx);
  min-width: 0;
}

.card-info-inner {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  min-width: 0;
  width: 100%;
}

.card-name {
  font-family: 'PingFang SC';
  font-weight: 500;
  font-size: 32rpx;
  color: #242529;
  line-height: 32rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  width: 100%;
  display: block;
  padding-right: 64rpx;
  box-sizing: border-box;
}

.card-rating {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-wrap: nowrap;
  overflow: hidden;
  width: 100%;
}

.rating-star {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: #FDF8E3;
  border-radius: 12rpx;
  padding: 8rpx 16rpx;
  font-family: 'PingFang SC';
  font-size: 24rpx;
  color: #EE8733;
  line-height: 24rpx;
  flex-shrink: 0;
}

.spot-tag {
  background: #F7F8FA;
  border-radius: 12rpx;
  padding: 8rpx 16rpx;
  font-family: 'PingFang SC';
  font-size: 24rpx;
  color: #A0A4AE;
  line-height: 24rpx;
  flex-shrink: 0;
  white-space: nowrap;
}

.card-footer {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  min-width: 0;
  width: 100%;
  box-sizing: border-box;
  padding-right: 64rpx;
}

.card-desc {
  font-family: 'PingFang SC';
  font-size: 28rpx;
  color: #A0A4AE;
  line-height: 28rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  width: 100%;
  display: block;
}

/* 右侧操作区 */
.shop-action-icons {
  display: flex;
  align-items: center;
}

.icon-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  background: #F7F8FA;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: all 0.3s;
}

.collect-icon {
  background: #F7F8FA;
}

.icon-btn.collected {
  background: #FFFFFF;
}

.icon-btn-text {
  font-size: 40rpx;
  color: #6E727A;
}

.icon-btn.collected .icon-btn-text {
  color: #EEB237;
}

/* ── 底部安全区 ── */
.safe-area-bottom {
  height: env(safe-area-inset-bottom);
}
