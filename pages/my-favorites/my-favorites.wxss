/* pages/my-favorites/my-favorites.wxss */

.page {
  background: #FFFFFF;
}

.container {
  min-height: 100vh;
  background: #FFFFFF;
  padding-bottom: env(safe-area-inset-bottom);
}

/* ── 大标题（与 district-guide 一致） ── */
.header {
  padding: 48rpx;
  background: #FFFFFF;
}

.district-title {
  font-family: 'PingFang SC';
  font-style: normal;
  font-weight: 500;
  font-size: 48rpx;
  line-height: 100%;
  color: #000000;
}

/* ── 空状态 ── */
.empty-state {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 64rpx;
}

.empty-icon {
  font-size: 120rpx;
  color: #D8D8D8;
  margin-bottom: 32rpx;
}

.empty-text {
  font-family: 'PingFang SC';
  font-size: 28rpx;
  color: #999999;
  text-align: center;
  line-height: 1.6;
  white-space: pre-line;
}

.empty-btn {
  margin-top: 48rpx;
  padding: 20rpx 64rpx;
  background: #3D403F;
  border-radius: 40rpx;
  font-family: 'PingFang SC';
  font-weight: 500;
  font-size: 28rpx;
  color: #FFFFFF;
}

/* ── 列表容器 ── */
.list-container {
  flex: 1;
  padding-top: 24rpx;
  background: #FFFFFF;
}

/* ── 卡片项（与探索页面弹窗列表一致） ── */
.card-item {
  display: flex;
  align-items: flex-start;
  gap: 32rpx;
  background: #FFFFFF;
  padding: 24rpx 48rpx;
  margin-bottom: 24rpx;
}

/* 封面图 */
.card-img-wrap {
  width: 200rpx;
  height: 200rpx;
  flex-shrink: 0;
  border-radius: 24rpx;
  overflow: hidden;
  position: relative;
  background: #f0f0f0;
}

.card-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* 左上角分类徽章 */
.card-cat-badge {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  background: rgba(0, 0, 0, 0.1);
  border-radius: 8rpx;
  padding: 6rpx 8rpx;
  font-family: 'PingFang SC';
  font-size: 20rpx;
  color: #ffffff;
  line-height: 20rpx;
  backdrop-filter: blur(4px);
}

/* 信息区 */
.card-info {
  display: flex;
  flex-direction: column;
  padding: 16rpx 0;
  justify-content: space-between;
  height: 200rpx;
  box-sizing: border-box;
  width: calc(100vw - 328rpx);
  min-width: 0;
}

.card-info-inner {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  min-width: 0;
  width: 100%;
}

.card-name {
  font-family: 'PingFang SC';
  font-weight: 500;
  font-size: 32rpx;
  color: #262626;
  line-height: 32rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  width: 100%;
  display: block;
  padding-right: 64rpx;
  box-sizing: border-box;
}

.card-rating {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-wrap: nowrap;
  overflow: hidden;
  width: 100%;
}

.rating-star {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: #FDF8E3;
  border-radius: 12rpx;
  padding: 8rpx 16rpx;
  font-family: 'PingFang SC';
  font-size: 24rpx;
  color: #EE8733;
  line-height: 24rpx;
  flex-shrink: 0;
}

.spot-tag {
  background: #F6F6F6;
  border-radius: 12rpx;
  padding: 8rpx 16rpx;
  font-family: 'PingFang SC';
  font-size: 24rpx;
  color: #BABABA;
  line-height: 24rpx;
  flex-shrink: 0;
  white-space: nowrap;
}

.card-footer {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  min-width: 0;
  width: 100%;
  box-sizing: border-box;
  padding-right: 64rpx;
}

.card-desc {
  font-family: 'PingFang SC';
  font-size: 28rpx;
  color: #C2C2C2;
  line-height: 28rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  width: 100%;
  display: block;
}

/* 右侧操作区 */
.shop-action-icons {
  display: flex;
  align-items: center;
}

.icon-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  background: #F6F6F6;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: all 0.3s;
}

.want-icon {
  background: #F6F6F6;
}

.icon-btn.liked {
  background: #E8F5E8;
}

.icon-btn-text {
  font-size: 32rpx;
  color: #999999;
}

.icon-btn.liked .icon-btn-text {
  color: #27AE60;
}

/* ── 底部安全区 ── */
.safe-area-bottom {
  height: env(safe-area-inset-bottom);
}