/* pages/my-favorites/my-favorites.wxss */

.page {
  background: #FFFFFF;
}

.container {
  min-height: 100vh;
  background: #FFFFFF;
  padding-bottom: env(safe-area-inset-bottom);
  display: flex;
  flex-direction: column;
}

/* ── 大标题（与 district-guide 一致） ── */
.header {
  padding: 48rpx; 
  background: #FFFFFF;
}

.district-title {
  font-family: 'PingFang SC';
  font-style: normal;
  font-weight: 500;
  font-size: 48rpx;
  line-height: 100%;
  color: #242529;
}

/* ── 空状态 ── */
.empty-state {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 0 48rpx calc(120rpx + env(safe-area-inset-bottom));
}

.empty-illustration {
  width: 240rpx;
  height: 240rpx;
  border-radius: 999rpx;
  background: #F7F8FA;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 48rpx;
}

.empty-icon {
  font-size: 120rpx;
  color: #A0A4AE;
}

.empty-title {
  color: #242529;
  font-size: 40rpx;
  line-height: 40rpx;
  margin-bottom: 32rpx;
  font-weight: 500;
}

.empty-hint {
  font-size: 28rpx;
  color: #6E727A;
  text-align: center;
  line-height: 40rpx;
  white-space: pre-line;
  margin-bottom: 48rpx;
}

.empty-btn {
  min-width: 176rpx;
  height: 80rpx;
  padding: 0 32rpx;
  border-radius: 999rpx;
  background: #242529;
  font-size: 28rpx;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ── 列表容器 ── */
.list-container {
  flex: 1;

  background: #FFFFFF;
}

/* ── 卡片项（与最新探索列表一致） ── */
.card-item {
  display: flex;
  align-items: center;
  gap: 24rpx; /* 12px：中间信息到右侧图标 */
  background: transparent;
  border-radius: 0;
  padding: 0 48rpx;
  margin-bottom: 48rpx;
  width: 100vw;
  min-height: 160rpx; /* 80px */
  box-sizing: border-box;
}

.card-main {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 32rpx; /* 16px：封面到中间信息 */
  min-width: 0;
}

/* 左侧封面容器：图片和封面角标都放在这里 */
.card-img-wrap {
  width: 160rpx;
  height: 160rpx;
  flex-shrink: 0;
  border-radius: 24rpx;
  overflow: hidden;
  position: relative;
  background: #F2F4F7;
}

.card-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* 封面角标：显示大类，不显示细分类 */
.card-cat-badge {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  background: rgba(0, 0, 0, 0.1);
  border-radius: 8rpx;
  padding: 6rpx 8rpx;
  font-family: 'PingFang SC';
  font-size: 20rpx;
  color: #FFFFFF;
  line-height: 20rpx;
  backdrop-filter: blur(4px);
}

/* 中间信息区：垂直摆放标题、标签、底部数据 */
.card-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-height: 160rpx;
  box-sizing: border-box;
  min-width: 0;
}

/* 标题：一行显示，超长用省略号 */
.card-name {
  font-family: 'PingFang SC';
  font-weight: 400;
  font-size: 32rpx;
  color: #242529;
  line-height: 32rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  width: 100%;
  display: block;
  box-sizing: border-box;
  margin-bottom: 16rpx;
}

/* 标签行：评分标签和普通标签 */
.card-rating {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-wrap: nowrap;
  overflow: hidden;
  width: 100%;
  margin-bottom: 32rpx;
}

.rating-star {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: #FDF8E3;
  border-radius: 12rpx;
  padding: 8rpx 16rpx;
  font-family: 'PingFang SC';
  font-size: 24rpx;
  color: #EE8733;
  line-height: 24rpx;
  flex-shrink: 0;
}

.spot-tag {
  background: #F7F8FA;
  border-radius: 12rpx;
  padding: 8rpx 16rpx;
  font-family: 'PingFang SC';
  font-size: 24rpx;
  color: #A0A4AE;
  line-height: 24rpx;
  flex-shrink: 0;
  white-space: nowrap;
}

/* 底部数据：想去人数 + 距离 */
.card-footer {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 8rpx;
  min-width: 0;
  width: 100%;
  box-sizing: border-box;
}

.card-desc {
  font-family: 'PingFang SC';
  font-size: 24rpx;
  color: #A0A4AE;
  line-height: 28rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  width: auto;
  display: block;
  flex-shrink: 0;
}

.card-separator {
  color: #A0A4AE;
  font-size: 24rpx;
  line-height: 28rpx;
  flex-shrink: 0;
}

/* 右侧操作区 */
/* 右侧图标占位：保证星星按钮居中 */
.shop-action-icons {
  flex: 0 0 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 取消收藏按钮：点击的是这个区域 */
.collect-icon {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.icon-btn-text {
  font-size: 40rpx;
  color: #EEB237;
}

/* ── 底部安全区 ── */
.safe-area-bottom {
  height: env(safe-area-inset-bottom);
}
