/* pages/my-favorites/my-favorites.wxss */

.container {
  min-height: 100vh;
  background: #F6F6F6;
  display: flex;
  flex-direction: column;
}

/* ── 自定义导航栏 ── */
.nav-bar {
  background: #FFFFFF;
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.nav-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 32rpx;
}

.back-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-btn i {
  font-size: 40rpx;
  color: #262626;
}

.nav-title {
  font-family: 'PingFang SC';
  font-weight: 600;
  font-size: 34rpx;
  color: #262626;
}

.nav-placeholder {
  width: 64rpx;
}

/* ── 空状态 ── */
.empty-state {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 64rpx;
}

.empty-icon {
  font-size: 120rpx;
  color: #D8D8D8;
  margin-bottom: 32rpx;
}

.empty-text {
  font-family: 'PingFang SC';
  font-size: 28rpx;
  color: #999999;
  text-align: center;
  line-height: 1.6;
  white-space: pre-line;
}

.empty-btn {
  margin-top: 48rpx;
  padding: 20rpx 64rpx;
  background: #3D403F;
  border-radius: 40rpx;
  font-family: 'PingFang SC';
  font-weight: 500;
  font-size: 28rpx;
  color: #FFFFFF;
}

/* ── 列表容器 ── */
.list-container {
  flex: 1;
  padding: 24rpx 32rpx;
}

/* ── 收藏项 ── */
.collect-item {
  display: flex;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.item-cover {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}

.item-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  margin-left: 24rpx;
  overflow: hidden;
}

.item-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.item-name {
  font-family: 'PingFang SC';
  font-weight: 600;
  font-size: 30rpx;
  color: #262626;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 300rpx;
}

.item-type-badge {
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  flex-shrink: 0;
}

.item-type-badge.food {
  background: #FFF3E6;
  color: #E67E22;
}

.item-type-badge.spot {
  background: #E8F5E8;
  color: #27AE60;
}

.item-category {
  font-family: 'PingFang SC';
  font-size: 24rpx;
  color: #7D7F85;
  margin-bottom: 12rpx;
}

.item-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.rating {
  font-family: 'PingFang SC';
  font-size: 24rpx;
  color: #FF9500;
}

.price {
  font-family: 'PingFang SC';
  font-size: 24rpx;
  color: #7D7F85;
}

.free-tag {
  font-family: 'PingFang SC';
  font-size: 22rpx;
  color: #27AE60;
  background: #E8F5E8;
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
}

/* ── 移除按钮 ── */
.remove-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
}

.remove-btn i {
  font-size: 40rpx;
  color: #DC6962;
}

/* ── 底部安全区 ── */
.safe-area-bottom {
  height: env(safe-area-inset-bottom);
}
