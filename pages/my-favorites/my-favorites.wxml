<view class="container">
  <!-- 大标题（与 district-guide 一致） -->
  <view class="header">
    <view class="district-title">我的收藏</view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{showEmpty}}">
    <i class="mgc_heart_line empty-icon"></i>
    <text class="empty-text">{{emptyText}}</text>
    <view class="empty-btn" bindtap="onBack">去探索</view>
  </view>

  <!-- 收藏列表 -->
  <scroll-view 
    class="list-container" 
    scroll-y 
    wx:if="{{!showEmpty}}"
  >
    <view 
      class="card-item" 
      wx:for="{{allList}}" 
      wx:key="id"
      bindtap="onItemTap"
      data-item="{{item}}"
    >
      <!-- 左侧：封面图 -->
      <view class="card-img-wrap">
        <image 
          class="card-img" 
          src="{{item.displayImage}}" 
          mode="aspectFill"
          binderror="onImageError"
          data-index="{{index}}"
        />
        <!-- 左上角分类徽章 -->
        <view class="card-cat-badge">{{item.displayCategory}}</view>
      </view>

      <!-- 中间：信息区 -->
      <view class="card-info">
        <view class="card-info-inner">
          <view class="card-name">{{item.name}}</view>
          <!-- 评分与标签 -->
          <view class="card-rating">
            <view class="rating-star">
              <text>{{item.rating || '4.0'}}</text>
            </view>
            <text class="spot-tag" wx:for="{{item.tags}}" wx:key="*this" wx:for-item="tag">{{tag}}</text>
          </view>
        </view>
        <!-- 底部：距离及统计 -->
        <view class="card-footer">
          <text class="card-desc">{{item.displayWantCount || '1024'}} 人想去</text>
        </view>
      </view>

      <!-- 右侧：取消想去按钮 -->
      <view class="shop-action-icons">
        <view
          class="icon-btn want-icon liked"
          catchtap="onRemoveCollect"
          data-item="{{item}}"
        >
          <i class="mgc_check_2_fill icon-btn-text"></i>
        </view>
      </view>
    </view>

    <!-- 底部安全区 -->
    <view class="safe-area-bottom"></view>
  </scroll-view>
</view>