<view class="container">
  <!-- 自定义导航栏（大标题样式） -->
  <view class="picker-header">
    <text class="picker-title">我的收藏</text>
    <i class="mgc_close_line picker-close" bindtap="onBack"></i>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{showEmpty}}">
    <i class="mgc_heart_line empty-icon"></i>
    <text class="empty-text">{{emptyText}}</text>
    <view class="empty-btn" bindtap="onBack">去探索</view>
  </view>

  <!-- 收藏列表 -->
  <scroll-view 
    class="list-container" 
    scroll-y 
    wx:if="{{!showEmpty}}"
  >
    <view 
      class="collect-item" 
      wx:for="{{allList}}" 
      wx:key="id"
      bindtap="onItemTap"
      data-item="{{item}}"
    >
      <image 
        class="item-cover" 
        src="{{item.displayImage}}" 
        mode="aspectFill"
        binderror="onImageError"
        data-index="{{index}}"
      />
      <view class="item-info">
        <view class="item-header">
          <text class="item-name">{{item.name}}</text>
          <view class="item-type-badge {{item.type}}">
            <text>{{item.type === 'spot' ? '景点' : '美食'}}</text>
          </view>
        </view>
        <text class="item-category">{{item.displayCategory}}</text>
        <view class="item-meta" wx:if="{{item.rating}}">
          <text class="rating">★ {{item.rating}}</text>
          <text class="price" wx:if="{{item.price}}">¥{{item.price}}/人</text>
          <text class="free-tag" wx:if="{{item.free === true || item.free === 'true'}}">免费</text>
        </view>
      </view>
      <view class="remove-btn" catchtap="onRemoveCollect" data-item="{{item}}">
        <i class="mgc_heart_fill"></i>
      </view>
    </view>

    <!-- 底部安全区 -->
    <view class="safe-area-bottom"></view>
  </scroll-view>
</view>