/* 觅食图 - 我的攻略页面样式 */

.page {
  background: #FFFFFF;
}

.container {
  width: 100%;
  min-height: 100vh;
  background: #FFFFFF;
  padding-bottom: env(safe-area-inset-bottom);
  display: flex;
  flex-direction: column;
}

/* ── 大标题（与 district-guide 一致） ── */
.header {
  padding: 48rpx;
  background: #FFFFFF;
}

.district-title {
  font-family: 'PingFang SC';
  font-style: normal;
  font-weight: 500;
  font-size: 48rpx;
  line-height: 100%;
  color: #242529;
}

.guide-list {
  flex: 1;
  background: #FFFFFF;
  padding: 0 48rpx calc(64rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.guide-swipe-item {
  position: relative;
  min-height: 368rpx;
  margin-bottom: 48rpx;
  border-radius: 32rpx;
  overflow: hidden;
}

.guide-delete-action {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 160rpx;
  background: #FF5A5F;
  border-radius:32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.guide-delete-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 32rpx;
}

.guide-delete-icon {
  color: #FFFFFF;
  font-size: 40rpx;
  line-height: 40rpx;
}

.guide-delete-text {
  color: #FFFFFF;
  font-size: 24rpx;
  line-height: 24rpx;
  font-weight: 500;
}

.guide-card {
  width: 100%;
  min-height: 368rpx;
  border-radius: 32rpx;
  padding: 32rpx;
  box-sizing: border-box;
  position: relative;
  z-index: 1;
  border: 2rpx solid #F6F7F7;
  background: linear-gradient(180deg, #F7F8FA 0%, #FFFFFF 100%);
}

.guide-cover-wrap {
  position: absolute;
  width: 192rpx;
  height: 192rpx;
  left: 32rpx;
  top: 32rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.guide-cover {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.guide-info {
  position: absolute;
  top: 32rpx;
  left: 256rpx;
  right: 32rpx;
  width: auto;
  height: 192rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  min-width: 0;
}

.guide-title {
  width: 100%;
  max-width: 100%;
  height: 96rpx;
  display: -webkit-box;
  overflow: hidden;
  font-family: 'PingFang SC';
  font-weight: 500;
  font-size: 32rpx;
  line-height: 48rpx;
  color: #242529;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  word-break: break-all;
}

.guide-city {
  margin-top: 24rpx;
  font-family: 'PingFang SC';
  font-weight: 400;
  font-size: 24rpx;
  color: #A0A4AE;
  line-height: 100%;
}

.guide-stats {
  font-family: 'PingFang SC';
  font-weight: 400;
  font-size: 24rpx;
  color: #A0A4AE;
  line-height: 100%;
  margin-top: 16rpx;
}

.guide-divider {
  position: absolute;
  width: calc(100% - 64rpx);
  left: 32rpx;
  top: 272rpx;
  height: 2rpx;
  background: linear-gradient(to right, #EEF0F3 50%, transparent 50%);
  background-size: 16rpx 2rpx;
}

.guide-footer {
  position: absolute;
  width: calc(100% - 64rpx);
  left: 32rpx;
  top: 304rpx;
}

.guide-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
}

.guide-author-wrap {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
}

.guide-time-icon {
  width: 32rpx;
  height: 32rpx;
  border-radius: 16rpx;
  color: #A0A4AE;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.guide-author {
  font-family: 'PingFang SC';
  font-weight: 400;
  font-size: 24rpx;
  line-height: 100%;
  color: #A0A4AE;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.guide-likes {
  font-family: 'PingFang SC';
  font-weight: 400;
  font-size: 24rpx;
  line-height: 100%;
  color: #A0A4AE;
  white-space: nowrap;
}

/* ── 空状态 ── */
.empty-state {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 0 48rpx calc(120rpx + env(safe-area-inset-bottom));
}

.empty-illustration {
  width: 240rpx;
  height: 240rpx;
  border-radius: 999rpx;
  background: #F7F8FA;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 48rpx;
}

.empty-icon {
  font-size: 120rpx;
  color: #A0A4AE;
}

.empty-title {
  color: #242529;
  font-size: 40rpx;
  line-height: 40rpx;
  margin-bottom: 32rpx;
  font-weight: 500;
}

.empty-hint {
  font-size: 28rpx;
  color: #6E727A;
  line-height: 40rpx;
  text-align: center;
  margin-bottom: 48rpx;
}

.empty-btn {
  min-width: 176rpx;
  height: 80rpx;
  padding: 0 32rpx;
  border-radius: 999rpx;
  background: #242529;
  color: #FFFFFF;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ── 底部安全区 ── */
.safe-area-bottom {
  height: env(safe-area-inset-bottom);
}
