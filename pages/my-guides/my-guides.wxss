/* 觅食图 - 我的攻略页面样式 */

/* ── 容器 ── */
.container {
  width: 100%;
  min-height: 100vh;
  background: #F6F6F6;
  display: flex;
  flex-direction: column;
}

/* ── 自定义导航栏 ── */
.nav-bar {
  background: #FFFFFF;
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.nav-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 32rpx;
}

.nav-left {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-left i {
  font-size: 40rpx;
  color: #262626;
}

.nav-title {
  font-family: 'PingFang SC';
  font-weight: 600;
  font-size: 34rpx;
  color: #262626;
}

.nav-right {
  width: 64rpx;
}

.manage-btn {
  font-family: 'PingFang SC';
  font-size: 28rpx;
  color: #555555;
}

/* ── 攻略列表 ── */
.guide-list {
  flex: 1;
  padding-top: 24rpx;
}

/* ── 攻略卡片 ── */
.guide-card {
  display: flex;
  align-items: flex-start;
  gap: 32rpx;
  background: transparent;
  padding: 0 48rpx;
  margin-bottom: 48rpx;
  position: relative;
}

/* 封面图片 */
.card-img-wrap {
  width: 200rpx;
  height: 200rpx;
  flex-shrink: 0;
  border-radius: 24rpx;
  overflow: hidden;
  position: relative;
  background: #f0f0f0;
}

.card-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.card-cat-badge {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  background: rgba(0, 0, 0, 0.4);
  border-radius: 8rpx;
  padding: 6rpx 12rpx;
  font-family: 'PingFang SC';
  font-size: 20rpx;
  color: #ffffff;
  line-height: 20rpx;
  backdrop-filter: blur(4px);
}

/* 信息区 */
.card-info {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  height: 200rpx;
  box-sizing: border-box;
  width: calc(100vw - 328rpx);
  min-width: 0;
}

.card-info-inner {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  min-width: 0;
  width: 100%;
}

.card-name {
  font-family: 'PingFang SC';
  font-weight: 500;
  font-size: 32rpx;
  color: #262626;
  line-height: 32rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  width: 100%;
  display: block;
  padding-right: 80rpx;
  box-sizing: border-box;
}

.card-rating {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-wrap: nowrap;
  overflow: hidden;
  width: 100%;
}

.rating-star {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: #FDF8E3;
  border-radius: 12rpx;
  padding: 8rpx 16rpx;
  font-family: 'PingFang SC';
  font-size: 24rpx;
  color: #EE8733;
  line-height: 24rpx;
  flex-shrink: 0;
}

.spot-tag {
  background: #F6F6F6;
  border-radius: 12rpx;
  padding: 8rpx 16rpx;
  font-family: 'PingFang SC';
  font-size: 24rpx;
  color: #BABABA;
  line-height: 24rpx;
  flex-shrink: 0;
  white-space: nowrap;
}

.card-footer {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  min-width: 0;
  width: 100%;
  box-sizing: border-box;
  padding-right: 80rpx;
}

.card-desc {
  font-family: 'PingFang SC';
  font-size: 28rpx;
  color: #C2C2C2;
  line-height: 28rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  width: 100%;
  display: block;
}

/* 右侧操作 */
.card-action {
  position: absolute;
  right: 48rpx;
  top: 0;
  display: flex;
  align-items: center;
}

.delete-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  background: #FFF0F0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.delete-icon {
  font-size: 32rpx;
  color: #DC6962;
}

/* ── 空状态 ── */
.empty-state {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 64rpx;
  gap: 16rpx;
}

.empty-icon {
  font-size: 100rpx;
  color: #DDDDDD;
}

.empty-title {
  font-family: 'PingFang SC';
  font-weight: 500;
  font-size: 32rpx;
  color: #666666;
}

.empty-desc {
  font-family: 'PingFang SC';
  font-size: 26rpx;
  color: #999999;
}

/* ── 底部安全区 ── */
.safe-area-bottom {
  height: env(safe-area-inset-bottom);
}
