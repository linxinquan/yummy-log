<!-- 觅食图 - 攻略页 -->
<view class="container" style="padding-top: {{contentTop}}px;">
  <!-- 自定义导航栏 -->
  <view class="nav-bar" style="padding-top: {{menuTop}}px; height: {{menuHeight}}px; padding-right: {{menuRightInset}}px;">
    <view class="nav-left">
      <text class="nav-title">攻略</text>
    </view>
    <view class="nav-right">
      <view class="nav-btn" bindtap="onOpenSearch">
        <text class="search-icon">search_line</text>
      </view>
    </view>
  </view>

  <!-- 分类标签 -->
  <view class="category-row">
    <view 
      wx:for="{{categories}}"
      wx:key="name"
      class="category-item {{currentCategory === item.name ? 'active' : ''}}"
      bindtap="onCategoryChange"
      data-category="{{item.name}}"
    >{{item.name}}</view>
  </view>

  <!-- 精选攻略卡片（横向滚动） -->
  <scroll-view class="featured-scroll" scroll-x enable-flex>
    <view class="featured-list">
      <view 
        wx:for="{{featuredGuides}}"
        wx:key="id"
        class="featured-card"
        bindtap="onGuideTap"
        data-guide="{{item}}"
      >
        <view class="featured-cover-wrap">
          <image class="featured-cover" src="{{item.coverImage}}" mode="aspectFill" />
          <view class="featured-overlay">
            <text class="featured-title">{{item.title}}</text>
          </view>
        </view>
        <view class="featured-info">
          <text class="featured-tag">精选攻略</text>
          <text class="featured-name">{{item.name}}</text>
        </view>
      </view>
    </view>
  </scroll-view>

  <!-- 攻略列表 -->
  <view class="guide-list">
    <view 
      wx:for="{{currentGuides}}"
      wx:key="id"
      class="guide-card"
      bindtap="onGuideTap"
      data-guide="{{item}}"
    >
      <view class="guide-cover-wrap">
        <image class="guide-cover" src="{{item.coverImage}}" mode="aspectFill" />
      </view>
      <view class="guide-info">
        <text class="guide-desc">{{item.desc}}</text>
        <text class="guide-stats">{{item.duration}} · {{item.shopCount}} 个地点</text>
      </view>
      <view class="guide-divider"></view>
      <view class="guide-footer">
        <text class="guide-title">{{item.title}}</text>
        <view class="guide-meta">
          <view class="guide-author-wrap">
            <image class="guide-author-avatar" src="{{item.coverImage}}" mode="aspectFill" />
            <text class="guide-author">{{item.author}}</text>
          </view>
          <text class="guide-likes">{{item.likes}} 人收藏</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 搜索弹窗 -->
  <view class="modal-mask {{showSearchModal ? 'show' : ''}}" bindtap="onCloseSearch">
    <view class="search-modal" catchtap="stopPropagation">
      <view class="search-header">
        <view class="search-input-wrap">
          <text class="search-icon-text">search_line</text>
          <input 
            class="search-input" 
            placeholder="搜索攻略" 
            value="{{searchText}}"
            bindinput="onSearchInput"
            bindconfirm="onSearch"
          />
          <text class="search-clear" wx:if="{{searchText}}" bindtap="onClearSearch">×</text>
        </view>
      </view>
      <view class="search-history" wx:if="{{searchHistory.length > 0}}">
        <text class="history-title">搜索历史</text>
        <view class="history-list">
          <text 
            wx:for="{{searchHistory}}" 
            wx:key="*this" 
            class="history-item"
            bindtap="onHistoryTap"
            data-text="{{item}}"
          >{{item}}</text>
        </view>
      </view>
      <view class="search-hot" wx:if="{{hotSearches.length > 0}}">
        <text class="hot-title">热门搜索</text>
        <view class="hot-list">
          <text 
            wx:for="{{hotSearches}}" 
            wx:key="*this" 
            class="hot-item"
            bindtap="onHotTap"
            data-text="{{item}}"
          >{{item}}</text>
        </view>
      </view>
    </view>
  </view>
</view>