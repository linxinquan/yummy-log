<!-- 觅食图 - 攻略页 -->
<view class="container" style="padding-top: {{contentTop}}px;">
  <!-- 自定义导航栏 -->
  <view class="nav-bar" style="padding-top: {{menuTop}}px; height: {{menuHeight}}px; padding-right: {{menuRightInset}}px;">
    <view class="nav-left">
      <text class="nav-title">攻略</text>
    </view>
  </view>

  <!-- 精选攻略卡片（横向滚动） -->
  <view class="featured-scroll">
    <view 
      wx:for="{{featuredGuides}}"
      wx:key="id"
      class="featured-card"
      bindtap="onGuideTap"
      data-guide="{{item}}"
    >
      <view class="featured-header">
        <text class="featured-tag">精选攻略</text>
        <text class="featured-name">{{item.name}}</text>
      </view>
      <view class="featured-cover-wrap">
        <image class="featured-cover" src="{{item.coverImage}}" mode="aspectFill" />
        <view class="featured-overlay">
          <text class="featured-title">{{item.title}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 区域标签 -->
  <view class="district-row">
    <view 
      wx:for="{{districts}}"
      wx:key="id"
      class="district-item"
      bindtap="onDistrictChange"
      data-district="{{item.id}}"
      data-name="{{item.name}}"
    >{{item.name}}</view>
  </view>

  <!-- 分类标签 -->
  <view class="category-row">
    <view 
      wx:for="{{categories}}"
      wx:key="id"
      class="category-item {{currentCategory === item.name ? 'active' : ''}}"
      bindtap="onCategoryChange"
      data-category="{{item.id}}"
      data-name="{{item.name}}"
    >{{item.name}}</view>
  </view>

  <!-- 攻略列表 -->
  <view class="guide-list">
    <view 
      wx:for="{{currentGuides}}"
      wx:key="id"
      class="guide-card"
      bindtap="onGuideTap"
      data-guide="{{item}}"
    >
      <view class="guide-cover-wrap">
        <image class="guide-cover" src="{{item.coverImage}}" mode="aspectFill" />
      </view>
      <view class="guide-info">
        <text class="guide-title">{{item.title}}</text>
        <text class="guide-city">{{item.cityText}}</text>
        <text class="guide-stats">{{item.duration}} · {{item.shopCount}} 个地点</text>
      </view>
      <view class="guide-divider"></view>
      <view class="guide-footer">
        <view class="guide-meta">
          <view class="guide-author-wrap">
            <image class="guide-author-avatar" src="{{item.authorAvatar || item.coverImage}}" mode="aspectFill" />
            <text class="guide-author">{{item.author}}</text>
          </view>
          <text class="guide-likes">{{item.useRouteCount}} 人使用路线</text>
        </view>
      </view>
    </view>
    
    <view class="no-more">
      <view class="no-more-line"></view>
      <text class="no-more-text">已经没有更多了</text>
      <view class="no-more-line"></view>
    </view>
  </view>

  <!-- 公用右下角悬浮入口：和想去页使用同一个按钮组件。 -->
  <entry-fab-button
    iconType="{{addEntryVisible || importEntryVisible ? 'close' : 'add'}}"
    overlay="{{addEntryVisible || importEntryVisible}}"
    bind:tapentry="onEntryFabTap"
  />

  <!-- 悬浮入口三卡片菜单：点击遮罩关闭。 -->
  <view
    class="entry-sheet-mask {{addEntryVisible ? 'show' : ''}}"
    bindtap="closeAddEntrySheet"
  ></view>
  <view
    class="entry-sheet {{addEntryVisible ? 'show' : ''}}"
    catchtap="preventBubble"
  >
    <view class="entry-sheet-body">
      <view class="entry-card-list">
        <view class="entry-action-card entry-action-card-bar entry-create-route-card" bindtap="onCreateRouteFromFab">
          <view class="entry-action-card-content">
            <view class="entry-action-card-text">
              <text class="entry-action-card-label">创建路线</text>
              <text class="entry-action-card-desc">从空白路线开始创建行程</text>
            </view>
            <i class="entry-action-card-icon entry-action-card-icon-gradient mgc_add_circle_line"></i>
          </view>
        </view>

        <view class="entry-action-card entry-action-card-bar entry-parse-card" bindtap="onOpenLinkImport">
          <view class="entry-action-card-content">
            <view class="entry-action-card-text">
              <text class="entry-action-card-label">解析路线</text>
              <text class="entry-action-card-desc">粘贴链接或正文生成路线</text>
            </view>
            <i class="entry-action-card-icon entry-action-card-icon-gradient mgc_ai_line"></i>
          </view>
        </view>

        <view class="entry-action-card entry-action-card-bar entry-checkin-card" bindtap="onOpenCheckinFromFab">
          <view class="entry-action-card-content">
            <view class="entry-action-card-text">
              <text class="entry-action-card-label">采集打卡</text>
              <text class="entry-action-card-desc">拍照记录地点和打卡内容</text>
            </view>
            <i class="entry-action-card-icon entry-action-card-icon-gradient mgc_camera_2_ai_line"></i>
          </view>
        </view>
      </view>

    </view>
  </view>

  <!-- 解析路线输入弹窗：从三卡片菜单继续下钻。 -->
  <view
    class="import-sheet-mask {{importEntryVisible ? 'show' : ''}}"
    bindtap="onCloseLinkImport"
  ></view>
  <view
    class="import-sheet {{importEntryVisible ? 'show' : ''}}"
    catchtap="preventBubble"
  >
    <view class="import-sheet-header">
      <text class="import-sheet-title">解析路线</text>
    </view>

    <view class="import-sheet-body">
      <view class="import-input-wrap">
        <textarea
          class="import-textarea"
          value="{{guideLink}}"
          placeholder="粘贴纯链接、攻略正文或分享文案"
          placeholder-class="import-placeholder"
          maxlength="-1"
          auto-height
          cursor-spacing="24"
          bindinput="onLinkInput"
        ></textarea>
      </view>

      <view class="import-hint-list">
        <text class="import-hint">支持识别微信公众号、小红书笔记的文本内容或者链接</text>
      </view>
    </view>

    <view class="import-sheet-footer">
      <view class="import-secondary-btn" bindtap="onPasteLink">粘贴内容</view>
      <view class="import-primary-btn" bindtap="onConfirmLink">确认</view>
    </view>
  </view>

</view>
