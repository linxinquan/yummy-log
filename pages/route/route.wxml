<view class="page">
  <!-- 顶部地图区域：普通模式显示头图效果，导览/地图模式全屏展示 -->
  <view class="hero-wrap {{isNavigating || viewMode === 'map' ? 'hero-wrap-map' : ''}}">
    <map
      id="routeMap"
      class="hero-map"
      latitude="{{mapCenter.lat}}"
      longitude="{{mapCenter.lng}}"
      scale="{{isNavigating ? 16 : mapScale}}"
      markers="{{markers}}"
      polyline="{{polyline}}"
      show-location
      enable-zoom="true"
      enable-scroll="true"
      enable-overlooking="true"
      bindregionchange="onMapRegionChange"
    ></map>
    <view class="hero-mask" wx:if="{{!isNavigating}}"></view>
  </view>

  <!-- 左上角返回按钮 -->
  <view class="top-actions" style="top: {{menuTop}}px; height: {{menuHeight}}px;">
    <view class="top-icon" bindtap="onBack">
      <i class="mgc_left_line"></i>
    </view>
  </view>

  <!-- 导览模式顶部进度条 -->
  <view class="nav-header" wx:if="{{isNavigating}}">
    <view class="nav-progress">
      <view
        wx:for="{{routeShops}}"
        wx:key="id"
        class="progress-dot {{index < currentNavIndex ? 'done' : ''}} {{index === currentNavIndex ? 'active' : ''}}"
      ></view>
      <text class="remaining-text">剩余 {{routeShops.length - currentNavIndex - 1}} 站</text>
    </view>
    <view class="nav-close-btn" bindtap="onExitNav">
      <i class="mgc_close_line"></i>
      <text>退出</text>
    </view>
  </view>

  <!-- 导览完成后的提示卡片 -->
  <view class="nav-complete" wx:if="{{isNavComplete}}">
    <i class="mgc_celebrate_fill complete-icon"></i>
    <text class="complete-title">路线已完成</text>
    <text class="complete-sub">本次共到达 {{visitedCount}} 站</text>
    <view class="complete-btn" bindtap="onExitNav">返回路线</view>
  </view>

  <!-- 正在导览时的下一站信息卡片 -->
  <view class="nav-card" wx:if="{{isNavigating && !isNavComplete}}">
    <view class="nav-card-header">
      <view>
        <text class="nav-card-title">下一站</text>
        <text class="nav-card-sub">{{currentNavIndex + 1}} / {{routeShops.length}}</text>
      </view>
      <text class="nav-card-remain">剩余 {{routeShops.length - currentNavIndex - 1}} 站</text>
    </view>
    <view class="nav-destination">
      <view class="nav-cover-wrap">
        <view class="nav-cover-shadow"></view>
        <image class="nav-cover" src="{{currentNavShop.coverImage}}" mode="aspectFill"></image>
      </view>
      <view class="nav-destination-main">
        <view class="nav-tag">{{currentNavShop.tagText}}</view>
        <text class="nav-destination-name">{{currentNavShop.name}}</text>
        <travel-meta-line travel-meta="{{currentNavShop.travelMeta}}" bindtapmeta="onOpenNavTransportSheet"></travel-meta-line>
      </view>
    </view>
    <view class="nav-btns-row">
      <view class="nav-btn secondary" bindtap="onNavToCurrent">
        <i class="mgc_navigation_line"></i>
        <text>开始导航</text>
      </view>
      <view class="nav-btn primary" bindtap="onVisitNav">
        <i class="mgc_check_line"></i>
        <text>已到达</text>
      </view>
    </view>
  </view>

  <!-- 非导览模式：支持列表 / 地图 两种查看方式 -->
  <block wx:if="{{!isNavigating}}">
    <!-- 列表 / 地图 模式切换 -->
    <view class="mode-switch" style="top: {{modeSwitchTop}}px;" wx:if="{{routeShops.length > 0 && !isEditing}}">
      <view class="mode-chip {{viewMode === 'list' ? 'active' : ''}}" bindtap="onSwitchMode" data-mode="list">
        <i class="mgc_list_check_line"></i>
        <text>列表</text>
      </view>
      <view class="mode-chip {{viewMode === 'map' ? 'active' : ''}}" bindtap="onSwitchMode" data-mode="map">
        <i class="mgc_world_2_line"></i>
        <text>地图</text>
      </view>
    </view>

    <!-- 列表模式：候选地点、概览、分天行程 -->
    <block wx:if="{{viewMode === 'list'}}">
      <view class="detail-sheet">
        <scroll-view class="detail-scroll" scroll-y scroll-into-view="{{sheetScrollTarget}}" show-scrollbar="{{false}}">
          <view class="detail-scroll-inner">
            <view class="sheet-header" id="route-scroll-top">
              <text class="guide-title">{{routeTitle}}</text>
              <view class="guide-meta-row">
                <text class="guide-meta">{{summaryText}}</text>
                <text class="guide-city">{{cityText}}</text>
              </view>
            </view>

            <view class="tab-sticky-wrap" wx:if="{{routeDaySections.length > 0}}">
              <scroll-view class="tab-scroll" scroll-x enable-flex="{{true}}" show-scrollbar="{{false}}">
                <view class="tab-row">
                  <view
                    wx:for="{{tabs}}"
                    wx:key="key"
                    wx:if="{{!(isEditing && index === 0)}}"
                    class="tab-item {{currentTab === index ? 'active' : ''}}"
                    bindtap="onTabTap"
                    data-index="{{index}}"
                  >
                    <text>{{item.label}}</text>
                  </view>
                </view>
              </scroll-view>
              <view class="section-divider"></view>
            </view>

            <view class="sheet-content">
              <!-- 自定义规划时，先选择哪些地点参与路线生成 -->
              <view class="section-card candidate-card" wx:if="{{selectMode === 'custom' && allLikedShops.length > 0}}">
                <view class="candidate-header">
                  <view>
                    <text class="section-title">参与规划的{{isMixedRoute ? '地点' : (routeType === 'spot' ? '景点' : '店铺')}}</text>
                    <text class="candidate-sub">已选择 {{selectedCount}} 个</text>
                  </view>
                  <view class="select-all-pill" bindtap="onToggleSelectAll">{{isAllSelected ? '取消全选' : '全选'}}</view>
                </view>
                <view
                  wx:for="{{allLikedShops}}"
                  wx:key="id"
                  class="candidate-item {{item.selected ? 'selected' : ''}}"
                  bindtap="onToggleCandidate"
                  data-shopid="{{item.id}}"
                >
                  <view class="candidate-check {{item.selected ? 'on' : ''}}">
                    <i wx:if="{{item.selected}}" class="mgc_check_line"></i>
                  </view>
                  <image class="candidate-cover" src="{{item.coverImage}}" mode="aspectFill"></image>
                  <view class="candidate-main">
                    <text class="candidate-name">{{item.name}}</text>
                    <text class="candidate-meta">{{item.metaText}}</text>
                  </view>
                  <view class="candidate-order {{item.selected ? 'show' : ''}}">{{item.orderNum}}</view>
                </view>
              </view>

              <block wx:if="{{routeDaySections.length > 0}}">
                <view class="overview-anchor" id="route-overview-anchor"></view>
                <!-- 概览区：按天快速浏览 -->
                <view class="overview-section" wx:if="{{!isEditing}}">
                  <text class="overview-title">概览</text>
                  <view class="overview-list">
                    <view
                      class="overview-card"
                      wx:for="{{routeDaySections}}"
                      wx:key="id"
                    >
                      <text class="overview-card-day">{{item.title}}</text>
                      <view
                        class="overview-place-row"
                        wx:for="{{item.items}}"
                        wx:key="id"
                      >
                        <view class="overview-place-main">
                          <text class="overview-place-index">{{index + 1}}.</text>
                          <text class="overview-place-name">{{item.name}}</text>
                        </view>
                        <view class="overview-place-tag">{{item.tagText}}</view>
                      </view>
                    </view>
                  </view>
                </view>
                <view class="day-separator overview-separator" wx:if="{{!isEditing}}"></view>

                <view
                  class="day-section"
                  wx:for="{{routeDaySections}}"
                  wx:key="id"
                  id="route-day-section-{{index}}"
                >
                  <view class="day-anchor" id="route-day-anchor-{{index}}"></view>
                  <view class="day-header">
                    <text class="day-title">{{item.title}}</text>
                    <text class="day-count">{{item.countText}}</text>
                  </view>

                  <view class="place-list" wx:if="{{item.items.length}}">
                    <view
                      class="place-row"
                      wx:for="{{item.items}}"
                      wx:key="id"
                      wx:for-item="place"
                      wx:for-index="placeIndex"
                      bindtap="onOpenPlaceIntro"
                      data-day-index="{{index}}"
                      data-index="{{placeIndex}}"
                    >
                      <!-- 地点卡片主体：左侧封面，中间标题与标签，底部交通信息 -->
                      <view class="route-place-main">
                        <view class="route-place-cover-wrap">
                          <image class="place-cover" src="{{place.image || place.coverImage}}" mode="aspectFill"></image>
                          <view class="card-cat-badge" wx:if="{{place.displayCategory}}">{{place.displayCategory}}</view>
                        </view>
                        <view class="place-info-row">
                          <view class="place-main route-place-content">
                            <view class="route-place-top">
                              <text class="place-name route-place-name">{{place.name}}</text>
                              <view class="route-place-tags">
                                <view class="rating-star" wx:if="{{place.rating}}">
                                  <text>{{place.rating}}</text>
                                </view>
                                <text class="spot-tag" wx:for="{{place.tags}}" wx:key="*this" wx:for-item="tag">{{tag}}</text>
                              </view>
                            </view>
                            <view
                              class="route-place-travel-row"
                              catchtap="onOpenPlaceTransportSheet"
                              data-day-index="{{index}}"
                              data-index="{{placeIndex}}"
                            >
                              <view class="route-place-travel-mode">
                                <i class="{{place.travelModeIcon}}"></i>
                                <text>{{place.travelModeLabel}}</text>
                              </view>
                              <view class="route-place-travel-summary">
                                <text>{{place.travelSummaryText}}</text>
                                <i class="mgc_right_line"></i>
                              </view>
                            </view>
                          </view>
                        </view>
                      </view>
                      <view
                        class="place-arrow"
                        wx:if="{{!isEditing}}"
                        catchtap="onOpenPlaceNavigation"
                        data-day-index="{{index}}"
                        data-index="{{placeIndex}}"
                      >
                        <i class="mgc_navigation_line"></i>
                      </view>
                      <view class="route-sort-actions" wx:if="{{isEditing}}">
                        <view class="sort-action {{placeIndex === 0 ? 'off' : ''}}" catchtap="onMoveUp" data-index="{{placeIndex}}">
                          <i class="mgc_arrow_up_line"></i>
                        </view>
                        <view class="sort-action {{placeIndex === routeShops.length - 1 ? 'off' : ''}}" catchtap="onMoveDown" data-index="{{placeIndex}}">
                          <i class="mgc_arrow_down_line"></i>
                        </view>
                      </view>
                    </view>
                  </view>

                  <view class="empty-day" wx:else>
                    <text>当前没有可展示的地点</text>
                  </view>
                </view>
              </block>

              <view class="empty-card" wx:if="{{routeShops.length === 0 && allLikedShops.length === 0}}">
                <i class="mgc_map_line"></i>
                <text class="empty-title">{{isMixedRoute ? '还没有可规划的地点' : (routeType === 'spot' ? '还没有想去的景点' : '还没有想去的店铺')}}</text>
                <text class="empty-sub">{{isMixedRoute ? '先去探索页添加想去地点，再回来规划路线' : (routeType === 'spot' ? '先去景点详情添加想去' : '先去探索页挑一些想去的店铺')}}</text>
                <view class="empty-action" bindtap="onBackToHome">去探索看看</view>
              </view>

              <view class="empty-card" wx:if="{{routeShops.length === 0 && allLikedShops.length > 0 && selectMode === 'custom'}}">
                <i class="mgc_cursor_line"></i>
                <text class="empty-title">先选择参与规划的{{isMixedRoute ? '地点' : (routeType === 'spot' ? '景点' : '店铺')}}</text>
                <text class="empty-sub">至少选择 1 个，才能生成路线</text>
              </view>
            </view>
          </view>
        </scroll-view>
      </view>

      <!-- 普通态底部按钮：基础信息 / 编辑 / 查看路线 / 保存 -->
      <view class="bottom-bar route-preview-bar" wx:if="{{routeShops.length > 0 && !isEditing}}">
        <view class="bottom-btn secondary route-edit-meta-btn" bindtap="onEditBasicInfo">
          <i class="mgc_settings_3_line"></i>
        </view>
        <view class="bottom-btn secondary reorder-btn" bindtap="onOpenReorderSheet">
          <i class="mgc_ai_line"></i>
          <text>编辑</text>
        </view>
        <view class="bottom-btn secondary route-view-btn" bindtap="onViewRoute">
          <i class="mgc_route_line"></i>
          <text>路线</text>
        </view>
        <view class="bottom-btn primary route-save-btn" bindtap="onSaveToMyRoute">
          <i class="mgc_finger_love_line"></i>
          <text>保存</text>
        </view>
      </view>
      <view class="bottom-bar edit-bottom-bar" wx:if="{{routeShops.length > 0 && isEditing}}">
        <view class="bottom-btn secondary" bindtap="onCancelEdit">
          <text>取消</text>
        </view>
        <view class="bottom-btn primary" bindtap="onConfirmEdit">
          <text>保存</text>
        </view>
      </view>
    </block>

    <block wx:else>
      <view class="map-panel">
      <view class="map-panel-actions" wx:if="{{mapPreviewShop}}">
        <view class="map-floating-icon" bindtap="onSwitchMode" data-mode="list">
          <i class="mgc_left_line"></i>
        </view>
        <view class="map-floating-icon" bindtap="onFitRoute">
          <i class="mgc_fullscreen_line"></i>
        </view>
      </view>
        <view class="map-card route-map-preview-card" wx:if="{{mapPreviewShop}}">
          <view class="preview-tabs-panel">
            <scroll-view class="preview-tab-scroll" scroll-x enable-flex="{{true}}" show-scrollbar="{{false}}">
              <view class="preview-tab-row">
                <view
                  wx:for="{{previewTabs}}"
                  wx:key="index"
                  class="preview-tab-item {{((currentMapDay < 0 && item.index === 0) || currentMapDay === item.index) ? 'active' : ''}}"
                  bindtap="onSelectMapPreviewDay"
                  data-index="{{item.index}}"
                >
                  {{item.label}}
                </view>
              </view>
            </scroll-view>
            <view class="preview-tab-divider"></view>
          </view>

          <view class="preview-card-stage">
            <view class="preview-detail-card">
              <view class="preview-side-inner">
                <view class="preview-card-head">
                  <image class="preview-cover-image" src="{{mapPreviewShop.image || mapPreviewShop.coverImage}}" mode="aspectFill"></image>
                  <view class="preview-head-main">
                    <text class="preview-name">{{mapPreviewShop.name}}</text>
                    <view class="preview-meta-row" wx:if="{{previewDisplayMeta.length > 0}}">
                      <view
                        wx:for="{{previewDisplayMeta}}"
                        wx:key="index"
                        wx:for-item="chip"
                        class="preview-chip {{chip.type === 'score' ? 'score' : ''}}"
                      >
                        {{chip.text}}
                      </view>
                    </view>
                  </view>
                </view>

                <view class="preview-desc-row">
                  <text class="preview-desc-left">{{previewDescriptionText}}</text>
                  <text class="preview-desc-right">{{previewFeeText}}</text>
                </view>
              </view>

              <view class="preview-btn-row">
                <view
                  class="preview-btn {{previewDisablePrev ? 'disabled' : ''}}"
                  bindtap="onMapPreviewStep"
                  data-index="{{previewPrevIndex}}"
                >
                  <text>上一站</text>
                </view>
                <view
                  class="preview-btn {{previewDisableNext ? 'disabled' : ''}}"
                  bindtap="onMapPreviewStep"
                  data-index="{{previewNextIndex}}"
                >
                  <text>下一站</text>
                </view>
              </view>
            </view>
          </view>

          <view class="preview-footer">
            <view class="preview-footer-side">
              <text>{{previewStationText}}</text>
            </view>
            <travel-meta-line variant="compact" travel-meta="{{mapPreviewShop.travelMeta}}" bindtapmeta="onOpenMapTransportSheet"></travel-meta-line>
            <view class="preview-footer-side right">
              <text>{{previewCountText}}</text>
            </view>
          </view>
        </view>
      </view>
    </block>

    <view class="reorder-sheet-mask" wx:if="{{reorderSheetVisible}}" bindtap="onCloseReorderSheet"></view>
    <view class="reorder-sheet" wx:if="{{reorderSheetVisible}}">
      <view class="reorder-sheet-header">
        <text class="reorder-sheet-title">编辑路线规划</text>
        <view class="reorder-sheet-close" bindtap="onCloseReorderSheet">
          <i class="mgc_close_line"></i>
        </view>
      </view>
      <view class="reorder-sheet-option-list">
        <view
          class="reorder-sheet-option {{pendingReorderMode === 'smart' ? 'active' : ''}}"
          bindtap="onSelectReorderMode"
          data-mode="smart"
        >
          <i class="reorder-option-icon mgc_ai_line"></i>
          <view class="reorder-option-main">
            <text class="reorder-option-title">智能规划</text>
            <text class="reorder-option-desc">AI 智能分析路线，自动重新排序最佳路线</text>
          </view>
        </view>
        <view
          class="reorder-sheet-option {{pendingReorderMode === 'manual' ? 'active' : ''}}"
          bindtap="onSelectReorderMode"
          data-mode="manual"
        >
          <i class="reorder-option-icon mgc_pencil_3_line"></i>
          <view class="reorder-option-main">
            <text class="reorder-option-title">手动编辑</text>
            <text class="reorder-option-desc">进入编辑状态，按需求手动调整路线顺序</text>
          </view>
        </view>
      </view>
      <view class="reorder-sheet-footer">
        <view class="reorder-confirm-btn" bindtap="onConfirmReorderMode">
          <text>确认</text>
        </view>
      </view>
    </view>
  </block>

  <transport-info-sheet
    visible="{{transportSheetVisible}}"
    options="{{transportOptions}}"
    selected-mode="{{pendingTransportMode}}"
    bindclose="onCloseTransportSheet"
    bindselect="onSelectTransportMode"
    bindconfirm="onConfirmTransportMode"
  ></transport-info-sheet>

  <!-- 请选择导航地图：这里提供腾讯地图、高德地图和复制地址 -->
  <view class="sheet-mask {{navMapSheetVisible ? 'show' : ''}}" bindtap="onCloseNavMapSheet">
    <view class="sheet-panel route-action-sheet" catchtap="preventBubble">
      <view class="sheet-modal-header">
        <text class="sheet-modal-title">请选择导航地图</text>
        <i class="mgc_close_line sheet-modal-close" bindtap="onCloseNavMapSheet"></i>
      </view>
      <view class="route-sheet-option-list">
        <view class="route-sheet-option" bindtap="onSelectNavMapOption" data-type="tencent">
          <view class="route-sheet-option-main">
            <i class="mgc_navigation_fill"></i>
            <text>腾讯地图（推荐）</text>
          </view>
          <i class="mgc_right_small_line route-sheet-option-arrow"></i>
        </view>
        <view class="route-sheet-option" bindtap="onSelectNavMapOption" data-type="gaode">
          <view class="route-sheet-option-main">
            <i class="mgc_navigation_fill"></i>
            <text>高德地图</text>
          </view>
          <i class="mgc_right_small_line route-sheet-option-arrow"></i>
        </view>
        <view class="route-sheet-option" bindtap="onSelectNavMapOption" data-type="copy">
          <view class="route-sheet-option-main">
            <i class="mgc_copy_2_line"></i>
            <text>复制地址</text>
          </view>
          <i class="mgc_right_small_line route-sheet-option-arrow"></i>
        </view>
      </view>
    </view>
  </view>

  <!-- 地点简介底部弹窗：内容沿用我的路线详情版本 -->
  <view class="sheet-mask {{placeIntroVisible ? 'show' : ''}}" bindtap="onClosePlaceIntro">
    <view class="sheet-panel place-intro-sheet" catchtap="preventBubble">
      <view class="sheet-modal-header">
        <text class="sheet-modal-title">地点简介</text>
        <i class="mgc_close_line sheet-modal-close" bindtap="onClosePlaceIntro"></i>
      </view>
      <scroll-view class="place-intro-scroll" scroll-y show-scrollbar="{{false}}" wx:if="{{placeIntroData}}">
        <view class="place-intro-body">
          <image class="place-intro-cover" src="{{placeIntroData.image}}" mode="aspectFill"></image>
          <view class="place-intro-tags">
            <view class="rating-star" wx:if="{{placeIntroData.rating}}">
              <text>{{placeIntroData.rating}}</text>
            </view>
            <view class="tag-badge" wx:for="{{placeIntroData.tags}}" wx:key="*this" wx:for-item="tag">
              <text>{{tag}}</text>
            </view>
          </view>
          <text class="place-intro-title">{{placeIntroData.name}}</text>
          <text class="place-intro-open-time">{{placeIntroData.openTimeText}}</text>
          <view class="place-intro-address-box">
            <view class="place-intro-address-content">
              <text class="place-intro-address-label">地址</text>
              <text class="place-intro-address-text">{{placeIntroData.address}}</text>
            </view>
            <i class="mgc_right_line place-intro-address-icon"></i>
          </view>
          <text class="place-intro-desc">{{placeIntroData.desc}}</text>
        </view>
      </scroll-view>
    </view>
  </view>
</view>
