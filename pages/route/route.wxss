/* pages/route/route.wxss - 路线规划页 (基于 Design System v1.0) */

.container {
  min-height: 100vh;
  background: var(--background);
  padding-bottom: calc(var(--space-xl) * 2 + env(safe-area-inset-bottom));
}

/* ═══════════════════════════════════════════════
   地图区
   ═══════════════════════════════════════════════ */
.map-wrap {
  position: relative;
  height: 40vh;
  min-height: 380rpx;
  background: var(--primary-light);
  transition: height 0.3s;
}

.map-wrap.nav-mode {
  height: 60vh;
  min-height: 560rpx;
}

.map {
  width: 100%;
  height: 100%;
}

/* 返回按钮 */
.map-back-btn {
  position: absolute;
  top: calc(var(--space-md) + env(safe-area-inset-top));
  left: var(--space-md);
  width: 88rpx; /* 44px hit area */
  height: 88rpx;
  background: var(--surface);
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid var(--border);
  z-index: 10;
}

.map-back-icon {
  font-size: 64rpx;
  
  color: var(--text-primary);
  line-height: 1;
  margin-top: -4rpx;
}

/* 适配全部标记按钮 */
.map-fit-btn {
  position: absolute;
  top: calc(var(--space-md) + env(safe-area-inset-top));
  right: var(--space-md);
  width: 88rpx;
  height: 88rpx;
  background: var(--surface);
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid var(--border);
  z-index: 10;
}

.map-fit-icon {
  font-size: 40rpx;
  color: var(--primary-dark);
}

/* 地图信息浮层（底部） */
.map-info-bar {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-around;
  background: rgba(255,255,255,0.92);
  backdrop-filter: blur(8px);
  padding: var(--space-md);
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  border-top: 1rpx solid var(--border);
}

.map-info-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-xs);
}

.map-info-val {
  color: var(--primary-dark);
}

.map-info-lbl {
  color: var(--text-secondary);
}

.map-info-divider {
  width: 2rpx;
  height: 36rpx;
  background: var(--divider);
}

/* 导览进度条 */
.nav-header {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--space-md);
  padding-top: calc(var(--space-md) + env(safe-area-inset-top));
  background: linear-gradient(to bottom, rgba(0,0,0,0.55) 0%, transparent 100%);
  z-index: 20;
}

.nav-progress {
  display: flex;
  gap: var(--space-sm);
  align-items: center;
}

.progress-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: var(--radius-full);
  background: rgba(255,255,255,0.35);
  transition: all 0.3s;
}

.progress-dot.done  { background: var(--success); }
.progress-dot.active {
  background: #FFFFFF;
  transform: scale(1.4);
  box-shadow: 0 0 8rpx rgba(255,255,255,0.9);
}

.remaining-text {
  color: rgba(255,255,255,0.9);
  
  margin-left: var(--space-xs);
}

.nav-close-btn {
  padding: var(--space-xs) var(--space-md);
  background: rgba(0,0,0,0.4);
  border-radius: var(--radius-full);
  color: #FFFFFF;
}

/* ═══════════════════════════════════════════════
   导览完成
   ═══════════════════════════════════════════════ */
.nav-complete {
  position: fixed;
  inset: 0;
  background: var(--primary); /* design system prohibits custom gradients */
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 300;
}

.complete-icon  { font-size: 160rpx; margin-bottom: var(--space-lg); }
.complete-title { color: var(--surface); margin-bottom: var(--space-md); }
.complete-sub   { color: rgba(255,255,255,0.8); margin-bottom: var(--space-2xl); }

.complete-btn {
  width: 400rpx;
}

/* ═══════════════════════════════════════════════
   导览模式卡片（底部 fixed）
   ═══════════════════════════════════════════════ */
.nav-card {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: var(--surface);
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  padding: var(--space-md) var(--space-md) calc(var(--space-md) + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--border);
  z-index: 100;
}

.nav-card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--space-md);
}

.nav-header-left {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
}

.nav-label {
  color: var(--primary);
  
}

.nav-badge {
  padding: 4rpx 16rpx;
  background: var(--primary);
  color: #FFF;
  border-radius: var(--radius-full);
  
}

.nav-remain {
  color: var(--text-secondary);
}

.nav-shop-row {
  display: flex;
  align-items: center;
  gap: var(--space-md);
  background: var(--background);
  border-radius: var(--radius-md);
  padding: var(--space-md);
  margin-bottom: var(--space-md);
}

.nav-shop-num {
  width: 56rpx;
  height: 56rpx;
  background: var(--primary);
  color: #FFF;
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
  
  flex-shrink: 0;
}

.nav-shop-thumb {
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--radius-sm);
  flex-shrink: 0;
}

.nav-shop-info { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: var(--space-xs); }

.nav-shop-name {
  color: var(--text-primary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.nav-shop-meta {
  color: var(--text-secondary);
}

.nav-shop-addr {
  color: var(--text-disabled);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.nav-stats-row {
  display: flex;
  justify-content: space-around;
  padding: var(--space-sm) 0;
  background: var(--background);
  border-radius: var(--radius-md);
  margin-bottom: var(--space-md);
}

.nav-stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-xs);
}

.ns-val { color: var(--text-primary);  }
.ns-lbl { color: var(--text-secondary); }

.nav-btns-row {
  display: flex;
  gap: var(--space-md);
}

.nav-btns-row .btn {
  flex: 1;
}

/* ═══════════════════════════════════════════════
   常规路线规划内容区
   ═══════════════════════════════════════════════ */
.route-body {
  padding: var(--space-md);
}

/* ─── 起点行 ─── */
.start-row {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  background: var(--surface);
  border-radius: var(--radius-md);
  padding: var(--space-md);
  margin-bottom: var(--space-sm);
  border: 1rpx solid var(--border);
}

.start-dot {
  font-size: 24rpx;
  color: var(--success);
  flex-shrink: 0;
}

/* 出发/终点标签 */
.start-tag {
  color: var(--success);
  
  flex-shrink: 0;
  padding: 4rpx 12rpx;
  background: rgba(58, 155, 111, 0.1);
  border-radius: var(--radius-sm);
}

.end-tag {
  color: var(--danger);
  background: rgba(224, 82, 82, 0.1);
}

/* 终点行 */
.end-row {
  /* 移除原本突兀的粗红色左边框，保持干净统一的卡片风格 */
}

.end-dot {
  color: var(--danger);
}

.start-name {
  flex: 1;
  color: var(--text-primary);
  
}

.start-chevron {
  color: var(--text-disabled);
}

.start-expand {
  margin-bottom: var(--space-sm);
}

.start-chips {
  display: flex;
  gap: var(--space-sm);
  padding: var(--space-xs) 0 var(--space-md);
}

.start-chip {
  padding: 12rpx 32rpx;
  background: var(--surface);
  border-radius: var(--radius-full);
  color: var(--text-secondary);
  white-space: nowrap;
  border: 2rpx solid var(--border);
  flex-shrink: 0;
  transition: all 0.2s;
}

.start-chip.active {
  background: var(--primary-light);
  color: var(--primary-dark);
  border-color: transparent;
}

.start-chip.map-chip {
  background: rgba(230, 168, 23, 0.1); /* warning light */
  border-color: var(--warning);
  color: #E65100;
}

/* ─── 出行方式行 ─── */
.mode-row {
  display: flex;
  gap: var(--space-sm);
  margin-bottom: var(--space-lg);
}

.mode-chip {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--space-md) var(--space-sm);
  background: var(--surface);
  border-radius: var(--radius-md);
  
  color: var(--text-secondary);
  border: 2rpx solid var(--border);
  transition: all 0.2s;
}

.mode-chip.active {
  background: var(--primary-light);
  color: var(--primary-dark);
  border-color: transparent;
}

.mode-chip.optimize {
  flex: 0.7;
  background: rgba(230, 168, 23, 0.1);
  border-color: var(--warning);
  color: #E65100;
}

/* ═══════════════════════════════════════════════
   ★ 双模式切换卡片
   ═══════════════════════════════════════════════ */
.mode-switch-bar {
  display: flex;
  background: var(--surface);
  border-radius: var(--radius-lg);
  padding: var(--space-sm);
  margin-bottom: var(--space-md);
  border: 1rpx solid var(--border);
}

.mode-switch-item {
  flex: 1;
  display: flex;
  align-items: center;
  gap: var(--space-md);
  padding: var(--space-md);
  border-radius: var(--radius-md);
  transition: all 0.2s;
  position: relative;
  border: 2rpx solid transparent;
}

.mode-switch-item.active {
  background: var(--primary-light);
  border-color: transparent;
}

.ms-icon {
  font-size: 40rpx;
  flex-shrink: 0;
}

.ms-text-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
}

.ms-title {
  color: var(--text-primary);
  
}

.mode-switch-item.active .ms-title {
  color: var(--primary-dark);
}

.ms-sub {
  color: var(--text-secondary);
}

.ms-check {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--primary);
  font-size: 40rpx;
  flex-shrink: 0;
}

.mode-switch-sep {
  width: 2rpx;
  background: var(--divider);
  margin: var(--space-sm) 0;
}

/* ═══════════════════════════════════════════════
   ★ 候选勾选面板
   ═══════════════════════════════════════════════ */
.candidate-panel {
  background: var(--surface);
  border-radius: var(--radius-lg);
  margin-bottom: var(--space-md);
  overflow: hidden;
  border: 1rpx solid var(--border);
}

.candidate-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-md);
  border-bottom: 1rpx solid var(--divider);
}

.candidate-title {
  color: var(--text-primary);
  
}

.select-all-pill {
  padding: 8rpx 24rpx;
  background: var(--primary-light);
  border-radius: var(--radius-full);
  color: var(--primary-dark);
  
}

.cand-item {
  display: flex;
  align-items: center;
  gap: var(--space-md);
  padding: var(--space-md);
  border-bottom: 1rpx solid var(--divider);
  transition: background 0.15s;
}

.cand-item:last-child { border-bottom: none; }
.cand-item.selected  { background: var(--background); }

.cand-check {
  width: 48rpx;
  height: 48rpx;
  border-radius: var(--radius-full);
  border: 4rpx solid var(--border);
  display: flex;
  align-items: center;
  justify-content: center;
  color: transparent;
  flex-shrink: 0;
  transition: all 0.2s;
}

.cand-check.on {
  background: var(--primary);
  border-color: var(--primary);
  color: var(--surface);
}

.cand-logo {
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--radius-sm);
  flex-shrink: 0;
}

.cand-info { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: var(--space-xs); }

.cand-name {
  color: var(--text-primary);
  
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.cand-meta {
  color: var(--text-secondary);
}

.cand-badge {
  width: 48rpx;
  height: 48rpx;
  border-radius: var(--radius-full);
  background: var(--border);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-disabled);
  
  flex-shrink: 0;
  opacity: 0;
  transition: all 0.2s;
}

.cand-badge.show {
  opacity: 1;
  background: var(--primary);
  color: var(--surface);
}

/* ═══════════════════════════════════════════════
   ★ 路线 Timeline
   ═══════════════════════════════════════════════ */
.timeline-card {
  background: var(--surface);
  border-radius: var(--radius-lg);
  padding: var(--space-md);
  border: 1rpx solid var(--border);
}

.timeline-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--space-md);
}

.timeline-title {
  color: var(--text-primary);
  
}

.edit-pill {
  padding: 8rpx 24rpx;
  background: var(--primary-light);
  border-radius: var(--radius-full);
  color: var(--primary-dark);
  
}

/* timeline 行 */
.tl-item {
  display: flex;
  gap: 0;
  min-height: 88rpx;
}

.tl-item.editing .tl-shop-row {
  background: rgba(230, 168, 23, 0.1);
  border: 2rpx dashed var(--warning);
  border-radius: var(--radius-md);
}

/* 节点轨道 */
.tl-node-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 64rpx;
  flex-shrink: 0;
  padding-top: 8rpx;
}

/* 数字节点 */
.tl-num {
  width: 48rpx;
  height: 48rpx;
  background: var(--primary);
  color: var(--surface);
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
  
  flex-shrink: 0;
  box-shadow: var(--shadow-xs);
  z-index: 1;
}

.tl-num.first {
  background: var(--warning);
}

/* 起终点圆点 */
.tl-dot {
  width: 32rpx;
  height: 32rpx;
  border-radius: var(--radius-full);
  flex-shrink: 0;
  margin: 12rpx 0 0 16rpx;
}

.start-dot-node {
  background: var(--success);
  box-shadow: 0 0 0 8rpx rgba(58, 155, 111, 0.2);
}

.end-dot-node {
  background: var(--danger);
  box-shadow: 0 0 0 8rpx rgba(224, 82, 82, 0.2);
}

/* 竖线 */
.tl-line {
  flex: 1;
  width: 4rpx;
  background: var(--border);
  border-radius: var(--radius-full);
  margin: 8rpx 0;
  min-height: 40rpx;
}

/* 内容区 */
.tl-content {
  flex: 1;
  padding: 0 0 var(--space-md) var(--space-md);
  min-width: 0;
}

.tl-item.tl-start .tl-content,
.tl-item.tl-end .tl-content {
  padding-bottom: var(--space-md);
}

.tl-tag-start,
.tl-tag-end {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: var(--radius-sm);
  
  margin-bottom: var(--space-xs);
}

.tl-tag-start {
  background: rgba(58, 155, 111, 0.1);
  color: var(--success);
}

.tl-tag-end {
  background: rgba(224, 82, 82, 0.1);
  color: var(--danger);
}

.tl-name {
  display: block;
  color: var(--text-primary);
  
}

/* 店铺行 */
.tl-shop-row {
  display: flex;
  align-items: center;
  gap: var(--space-md);
  padding: var(--space-md);
  background: var(--background);
  border-radius: var(--radius-md);
  transition: background 0.15s;
}

.tl-thumb {
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--radius-sm);
  flex-shrink: 0;
}

.tl-shop-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
}

.tl-name {
  color: var(--text-primary);
  
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.tl-meta {
  color: var(--text-secondary);
}

.tl-dist {
  color: var(--primary-dark);
  
}

/* 操作按钮 */
.tl-actions {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
  flex-shrink: 0;
}

.tl-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  transition: all 0.15s;
}

.tl-btn.nav { background: var(--primary-light); color: var(--primary-dark); }
.tl-btn.del { background: rgba(224, 82, 82, 0.1); color: var(--danger); }

/* 排序箭头 */
.tl-sort {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
  flex-shrink: 0;
}

.sort-arrow {
  width: 56rpx;
  height: 56rpx;
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  
  transition: all 0.15s;
  background: var(--background);
  color: var(--text-primary);
  border: 2rpx solid var(--border);
}

.sort-arrow.off {
  opacity: 0.3;
  pointer-events: none;
}

/* ═══════════════════════════════════════════════
   空状态
   ═══════════════════════════════════════════════ */
.empty-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--space-3xl) 0 var(--space-xl);
  text-align: center;
  gap: var(--space-sm);
}

.empty-icon  { color: var(--text-disabled); margin-bottom: var(--space-md); }
.empty-text  { color: var(--text-primary);  }
.empty-hint  { color: var(--text-secondary); margin-bottom: var(--space-lg); }

.empty-btn {
  width: auto;
  padding: 0 var(--space-2xl);
  background: var(--primary);
  color: var(--surface);
  border-radius: var(--radius-full);
  height: 80rpx;
  display: flex;
  align-items: center;
  
  border: none;
}

/* ═══════════════════════════════════════════════
   底部操作栏
   ═══════════════════════════════════════════════ */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: var(--space-md);
  padding: var(--space-md);
  padding-bottom: calc(var(--space-md) + env(safe-area-inset-bottom));
  background: var(--surface);
  border-top: 1rpx solid var(--border);
  z-index: 100;
}

.bb-clear {
  width: 160rpx;
  flex-shrink: 0;
}

.bb-start {
  flex: 1;
}