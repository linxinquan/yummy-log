@import "../guide-detail/guide-detail.wxss";

page {
  background: #ffffff;
}

.page {
  position: relative;
  height: 100vh;
  background: #ffffff;
  overflow: hidden;
}

.hero-wrap {
  position: relative;
  width: 100%;
  height: 780rpx;
  overflow: hidden;
}

.hero-wrap-map {
  height: 100vh;
}

.hero-map {
  width: 100%;
  height: 100%;
}

.hero-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 220rpx;
  background: linear-gradient(180deg, rgba(255,255,255,0) 0%, rgba(255,255,255,0.9) 62%, #ffffff 100%);
  pointer-events: none;
}

.top-actions {
  position: fixed;
  z-index: 30;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.top-actions {
  left: 48rpx;
}

.top-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
}

.top-icon i {
  font-size: 40rpx;
  color: #ffffff;
}

.detail-sheet {
  position: fixed;
  left: 0;
  right: 0;
  top: 248rpx;
  bottom: 0;
  z-index: 15;
  border-radius: 48rpx 48rpx 0 0;
  background: #ffffff;
  overflow: hidden;
}

.detail-scroll {
  height: 100%;
}

.sheet-header,
.section-card,
.empty-card {
  margin: 0 48rpx 24rpx;
}

.plain-section {
  margin: 0 48rpx 32rpx;
}

.section-card,
.empty-card,
.nav-card {
  background: #ffffff;
  border: 1rpx solid #e8e8e8;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.05);
}

.section-card {
  padding: 28rpx;
}

.empty-day {
  margin: 0 48rpx;
  padding-bottom: 48rpx;
  color: #c2c2c2;
  font-size: 24rpx;
  line-height: 24rpx;
}

.section-head {
  margin-bottom: 24rpx;
}

.section-title {
  display: block;
  color: #000000;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 32rpx;
}

.section-sub,
.candidate-sub {
  display: block;
  margin-top: 12rpx;
  color: #868686;
  font-size: 22rpx;
  line-height: 22rpx;
}

.candidate-card {
  padding-bottom: 8rpx;
}

.edit-bottom-bar {
  gap: 24rpx;
}

.candidate-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.select-all-pill {
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: #eaf7ff;
  color: #47bffe;
  font-size: 22rpx;
  line-height: 22rpx;
}

.candidate-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 0;
}

.candidate-item + .candidate-item {
  border-top: 1rpx solid #f3f3f3;
}

.candidate-item.selected {
  background: transparent;
}

.candidate-check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid #d9d9d9;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  color: transparent;
}

.candidate-check.on {
  background: #47bffe;
  border-color: #47bffe;
  color: #ffffff;
}

.candidate-check i {
  font-size: 24rpx;
}

.candidate-cover {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}

.candidate-main {
  flex: 1;
  min-width: 0;
}

.candidate-name {
  display: block;
  color: #000000;
  font-size: 28rpx;
  line-height: 28rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.candidate-meta {
  display: block;
  margin-top: 10rpx;
  color: #868686;
  font-size: 22rpx;
  line-height: 22rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.candidate-order {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #f0f0f0;
  color: #b7b7b7;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  flex-shrink: 0;
  opacity: 0;
}

.candidate-order.show {
  opacity: 1;
  background: #47bffe;
  color: #ffffff;
}

.route-list-header {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  margin-bottom: 24rpx;
}

.edit-pill {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: #eaf7ff;
  color: #47bffe;
  font-size: 22rpx;
  line-height: 22rpx;
}

.edit-pill i {
  font-size: 24rpx;
}

.route-place-row {
  display: block;
}

.route-place-row.editing .route-place-card {
  opacity: 0.96;
}

.route-place-card {
  display: flex;
  align-items: center;
  gap: 32rpx;
  padding-bottom: 64rpx;
  border-bottom: 1rpx solid #f3f3f3;
}

.route-cover-wrap {
  position: relative;
  width: 128rpx;
  height: 128rpx;
  flex-shrink: 0;
}

.route-cover-shadow {
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  width: 112rpx;
  height: 112rpx;
  border-radius: 20rpx;
  background: rgba(0, 0, 0, 0.04);
  transform: rotate(-8deg);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
}

.route-cover {
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  width: 112rpx;
  height: 112rpx;
  border-radius: 20rpx;
  border: 2rpx solid #ffffff;
  transform: rotate(-8deg);
}

.route-place-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.route-place-tag,
.nav-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  align-self: flex-start;
  min-width: 56rpx;
  height: 32rpx;
  padding: 0 8rpx;
  border-radius: 8rpx;
  background: #fdf8e3;
  color: #ee8733;
  font-size: 20rpx;
  line-height: 20rpx;
}

.route-place-name,
.nav-destination-name {
  color: #000000;
  font-size: 32rpx;
  line-height: 32rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.route-place-travel,
.nav-destination-meta {
  color: #868686;
  font-size: 24rpx;
  line-height: 24rpx;
}

.route-place-actions,
.route-sort-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  flex-shrink: 0;
}

.route-action-btn,
.sort-action {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.route-action-btn i,
.sort-action i {
  font-size: 28rpx;
}

.route-action-btn.nav {
  background: #eaf7ff;
  color: #47bffe;
}

.route-action-btn.del {
  background: #fff1f0;
  color: #ff4d4f;
}

.sort-action {
  background: #f7f7f7;
  color: #666666;
}

.sort-action.off {
  opacity: 0.3;
  pointer-events: none;
}

.reorder-sheet-mask {
  position: fixed;
  inset: 0;
  z-index: 70;
  background: rgba(0, 0, 0, 0.26);
}

.reorder-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 71;
  border-radius: 32rpx 32rpx 0 0;
  background: #ffffff;
  padding: 16rpx 48rpx calc(24rpx + env(safe-area-inset-bottom));
}

.reorder-sheet-handle {
  width: 72rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #d9d9d9;
  margin: 0 auto 20rpx;
}

.reorder-sheet-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.reorder-sheet-title {
  color: #000000;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 32rpx;
}

.reorder-sheet-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #f6f6f6;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #868686;
}

.reorder-sheet-close i {
  font-size: 28rpx;
}

.reorder-sheet-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f2f2f2;
}

.reorder-option-main {
  flex: 1;
  min-width: 0;
}

.reorder-option-title {
  display: block;
  color: #000000;
  font-size: 28rpx;
  line-height: 28rpx;
}

.reorder-option-desc {
  display: block;
  margin-top: 12rpx;
  color: #868686;
  font-size: 22rpx;
  line-height: 22rpx;
}

.reorder-sheet-option i {
  color: #47bffe;
  font-size: 32rpx;
  flex-shrink: 0;
}

.empty-card {
  padding: 56rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.empty-card i {
  color: #c2c2c2;
  font-size: 72rpx;
}

.empty-title {
  margin-top: 20rpx;
  color: #000000;
  font-size: 30rpx;
  line-height: 42rpx;
}

.empty-sub {
  margin-top: 12rpx;
  color: #868686;
  font-size: 24rpx;
  line-height: 36rpx;
}

.empty-action {
  margin-top: 28rpx;
  min-width: 200rpx;
  height: 80rpx;
  padding: 0 32rpx;
  border-radius: 999rpx;
  background: #47bffe;
  color: #ffffff;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  z-index: 40;
  gap: 16rpx;
  padding: 16rpx 48rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  box-sizing: border-box;
}

.bottom-btn {
  min-width: 0;
  height: 96rpx;
  border-radius: 24rpx;
  display: flex;
  flex-wrap: nowrap;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.bottom-btn.secondary {
  width: 176rpx;
  flex-shrink: 0;
  border: 2rpx solid #e7e7e7;
  background: #ffffff;
  color: #060606;
}

.bottom-btn.primary {
  flex: 1;
  min-width: 0;
  background: #47bffe;
  color: #ffffff;
}

.save-btn {
  width: 176rpx;
}

.view-btn {
  min-width: 0;
}

.bottom-btn i {
  font-size: 40rpx;
  flex-shrink: 0;
}

.bottom-btn text {
  font-size: 32rpx;
  font-weight: 500;
  white-space: nowrap;
  flex-shrink: 0;
}

.nav-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 40;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: calc(16rpx + env(safe-area-inset-top)) 48rpx 0;
}

.nav-progress {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.progress-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.35);
}

.progress-dot.done {
  background: #47bffe;
}

.progress-dot.active {
  background: #ffffff;
  transform: scale(1.5);
}

.remaining-text {
  margin-left: 12rpx;
  color: #ffffff;
  font-size: 24rpx;
}

.nav-close-btn {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.3);
  color: #ffffff;
  font-size: 24rpx;
}

.nav-complete {
  position: fixed;
  inset: 0;
  z-index: 80;
  background: #ffffff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.complete-icon {
  font-size: 140rpx;
  color: #47bffe;
}

.complete-title {
  margin-top: 24rpx;
  color: #000000;
  font-size: 40rpx;
  font-weight: 500;
}

.complete-sub {
  margin-top: 16rpx;
  color: #868686;
  font-size: 26rpx;
}

.complete-btn {
  margin-top: 40rpx;
  min-width: 240rpx;
  height: 88rpx;
  padding: 0 32rpx;
  border-radius: 999rpx;
  background: #f5fbff;
  color: #47bffe;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  border: 2rpx solid rgba(71, 191, 254, 0.18);
}

.nav-card {
  position: fixed;
  left: 48rpx;
  right: 48rpx;
  bottom: calc(32rpx + env(safe-area-inset-bottom));
  z-index: 60;
  padding: 28rpx;
}

.nav-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.nav-card-title {
  display: block;
  color: #000000;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 32rpx;
}

.nav-card-sub,
.nav-card-remain {
  color: #868686;
  font-size: 22rpx;
  line-height: 22rpx;
}

.nav-card-sub {
  display: block;
  margin-top: 10rpx;
}

.nav-destination {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.nav-cover-wrap {
  position: relative;
  width: 128rpx;
  height: 128rpx;
  flex-shrink: 0;
}

.nav-cover-shadow {
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  width: 112rpx;
  height: 112rpx;
  border-radius: 20rpx;
  background: rgba(0, 0, 0, 0.04);
  transform: rotate(-8deg);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
}

.nav-cover {
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  width: 112rpx;
  height: 112rpx;
  border-radius: 20rpx;
  border: 2rpx solid #ffffff;
  transform: rotate(-8deg);
}

.nav-destination-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.nav-btns-row {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.nav-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  font-size: 28rpx;
}

.nav-btn.secondary {
  background: #f7f7f7;
  color: #000000;
}

.nav-btn.primary {
  background: #47bffe;
  color: #ffffff;
}

.nav-btn i {
  font-size: 32rpx;
}

.map-panel {
  position: fixed;
  left: 48rpx;
  right: 48rpx;
  bottom: 48rpx;
  z-index: 20;
}

.map-card {
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.05);
}

.route-map-preview-card {
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  padding: 32rpx;
  min-height: 520rpx;
}

.preview-tabs-panel {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  width: 100%;
}

.preview-tab-row {
  display: flex;
  align-items: center;
  gap: 32rpx;
  width: 100%;
  min-width: 0;
}

.preview-tab-item {
  flex-shrink: 0;
  color: #c2c2c2;
  font-size: 28rpx;
  line-height: 28rpx;
  font-weight: 500;
}

.preview-tab-item.active {
  color: #000000;
}

.preview-tab-divider {
  width: 100%;
  height: 2rpx;
  background: #e8e8e8;
}

.preview-card-stage {
  width: 100%;
}

.preview-detail-card {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  width: 100%;
}

.preview-side-inner {
  display: flex;
  flex-direction: column;
  gap: 40rpx;
  width: 100%;
}

.preview-card-head {
  display: flex;
  align-items: center;
  gap: 32rpx;
  width: 100%;
  min-width: 0;
}

.preview-cover-image {
  width: 128rpx;
  height: 128rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}

.preview-head-main {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 24rpx;
}

.preview-name {
  display: block;
  width: 100%;
  min-width: 0;
  max-width: 100%;
  color: #000000;
  font-size: 36rpx;
  line-height: 36rpx;
  font-weight: 400;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.preview-meta-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  width: 100%;
  min-width: 0;
  overflow: hidden;
}

.preview-chip {
  flex-shrink: 0;
  max-width: 160rpx;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  background: #f6f6f6;
  color: #bababa;
  font-size: 22rpx;
  line-height: 22rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.preview-chip.score {
  background: #fdf8e3;
  color: #ee8733;
}

.preview-desc-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  width: 100%;
}

.preview-desc-left,
.preview-desc-right {
  min-width: 0;
  color: #999999;
  font-size: 24rpx;
  line-height: 24rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.preview-desc-left {
  flex: 1;
}

.preview-desc-right {
  flex-shrink: 0;
  max-width: 180rpx;
  text-align: right;
}

.preview-btn-row {
  display: flex;
  gap: 20rpx;
  width: 100%;
}

.preview-btn {
  flex: 1;
  min-width: 0;
  height: 76rpx;
  border-radius: 16rpx;
  background: #f7f7f7;
  display: flex;
  align-items: center;
  justify-content: center;
}

.preview-btn text {
  color: #000000;
  font-size: 28rpx;
  line-height: 28rpx;
}

.preview-btn.disabled {
  opacity: 0.35;
}

.preview-footer {
  display: grid;
  grid-template-columns: minmax(72rpx, auto) minmax(0, 1fr) minmax(72rpx, auto);
  align-items: center;
  column-gap: 16rpx;
  width: 100%;
  height: 32rpx;
  min-height: 32rpx;
}

.preview-footer-side {
  min-width: 72rpx;
  height: 32rpx;
  color: #999999;
  font-size: 24rpx;
  line-height: 24rpx;
  display: flex;
  align-items: center;
  justify-self: start;
  text-align: left;
}

.preview-footer travel-meta-line {
  height: 32rpx;
  display: flex;
  align-items: center;
  justify-self: center;
  min-width: 0;
  max-width: 100%;
}

.preview-footer-side.right {
  justify-content: flex-end;
  justify-self: end;
  text-align: right;
}
