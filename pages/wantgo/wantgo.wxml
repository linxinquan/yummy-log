<view class="container">
  <view class="tab-bar" style="padding-top: {{menuTop}}px; height: {{menuHeight}}px; padding-right: {{menuRightInset}}px;">
    <view class="tab-left">
      <view class="tab-item {{tab === 'want' ? 'active' : ''}}" bindtap="onTabChange" data-tab="want">
        <text>想去</text>
      </view>
      <view class="tab-item {{tab === 'plan' ? 'active' : ''}}" bindtap="onTabChange" data-tab="plan">
        <text>路线</text>
      </view>
      <view class="tab-item {{tab === 'visited' ? 'active' : ''}}" bindtap="onTabChange" data-tab="visited">
        <text>足迹</text>
      </view>
    </view>
    <view class="tab-right"></view>
  </view>

  <view wx:if="{{empty}}" class="empty-wrap" style="padding-top: {{listTop}}px;">
    <view class="empty-illustration">
      <i class="empty-icon {{tab === 'want' ? 'mgc_heart_line' : (tab === 'plan' ? 'mgc_map_line' : 'mgc_location_line')}}"></i>
    </view>
    <text class="empty-title">{{titles[tab]}}</text>
    <text class="empty-hint">{{tab === 'want' ? '去探索页收藏心仪的美食和景点吧' : (tab === 'plan' ? '去攻略详情页复制路线到这里吧' : '还没标记任何到访记录')}}</text>
    <view class="empty-btn" bindtap="onGoHome" wx:if="{{tab !== 'visited'}}">去探索</view>
  </view>

  <block wx:else>
    <view wx:if="{{tab === 'plan'}}" class="route-card-list" style="padding-top: {{listTop}}px;">
      <block wx:for="{{items}}" wx:key="id">
        <view class="route-card route-card-theme-{{index % 4}}" bindtap="onRouteCardTap" data-route="{{item}}">
          <text class="route-title">{{item.title}}</text>
          <image class="route-image" src="{{item.image}}" mode="aspectFill" />
          <view class="route-footer">
            <text class="route-subtitle">{{item.subtitle}}</text>
            <i class="mgc_right_small_line route-arrow"></i>
          </view>
        </view>
      </block>
    </view>

    <view wx:else class="want-list {{tab === 'want' ? 'has-plan-button' : ''}}" style="padding-top: {{listTop}}px;">
      <block wx:for="{{items}}" wx:key="id">
        <view class="place-swipe-item">
          <view wx:if="{{tab === 'want'}}" class="place-delete-action" catchtap="onRemove" data-id="{{item.id}}">
            <view class="place-delete-inner">
              <i class="mgc_delete_2_line place-delete-icon"></i>
              <text class="place-delete-text">删除</text>
            </view>
          </view>
          <view
            class="place-row"
            bindtap="onItemTap"
            bindtouchstart="onCardTouchStart"
            bindtouchmove="onCardTouchMove"
            bindtouchend="onCardTouchEnd"
            bindtouchcancel="onCardTouchEnd"
            data-item="{{item}}"
            data-index="{{index}}"
            style="transform: translateX({{item.swipeOffset || 0}}px);"
          >
            <image class="place-cover" src="{{item.coverImage}}" mode="aspectFill"></image>
            <view class="place-info-row">
              <view class="place-main">
                <view class="place-head">
                  <view class="place-tag">
                    <text class="place-tag-text">{{item.tagText}}</text>
                  </view>
                  <text class="place-name">{{item.name}}</text>
                </view>
                <travel-meta-line
                  class="place-meta-line"
                  travel-meta="{{item.travelMeta}}"
                  variant="compact"
                  bindtapmeta="onOpenTransportSheet"
                  data-index="{{index}}"
                ></travel-meta-line>
              </view>
              <view class="place-arrow">
                <i class="mgc_right_line"></i>
              </view>
            </view>
          </view>
        </view>
      </block>
    </view>
  </block>

  <view wx:if="{{tab === 'want' && !empty}}" class="plan-route-fixed">
    <view class="plan-route-btn" bindtap="onPlanRoute">
      <view class="plan-route-inner">
        <i class="mgc_ai_fill"></i>
        <text>智能规划路线</text>
      </view>
    </view>
  </view>

  <custom-tabbar></custom-tabbar>

  <transport-info-sheet
    visible="{{transportSheetVisible}}"
    options="{{transportOptions}}"
    selected-mode="{{pendingTransportMode}}"
    bindclose="onCloseTransportSheet"
    bindselect="onSelectTransportMode"
    bindconfirm="onConfirmTransportMode"
  ></transport-info-sheet>

  <view class="plan-day-mask {{planDaySheetVisible ? 'show' : ''}}" bindtap="onClosePlanDaySheet">
    <view class="plan-day-sheet" catchtap="preventBubble">
      <view class="plan-day-header">
        <text class="plan-day-title">旅行天数</text>
        <i class="mgc_close_line plan-day-close" bindtap="onClosePlanDaySheet"></i>
      </view>
      <view class="plan-day-body">
        <picker-view class="plan-day-picker-view" indicator-style="height: 88rpx;" value="{{[selectedPlanDayIndex]}}" bindchange="onSelectPlanDay">
          <picker-view-column>
            <view wx:for="{{dayOptions}}" wx:key="*this" class="plan-day-picker-item">
              {{item}} 天
            </view>
          </picker-view-column>
        </picker-view>
        <view class="plan-day-save" bindtap="onConfirmPlanRoute">保存</view>
      </view>
    </view>
  </view>
</view>
