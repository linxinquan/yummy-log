<view class="container">
  <view class="tab-bar" style="padding-top: {{menuTop}}px; height: {{menuHeight}}px; padding-right: {{menuRightInset}}px;">
    <view class="tab-left">
      <view class="tab-item {{tab === 'want' ? 'active' : ''}}" bindtap="onTabChange" data-tab="want">
        <text>想去</text>
      </view>
      <view class="tab-item {{tab === 'plan' ? 'active' : ''}}" bindtap="onTabChange" data-tab="plan">
        <text>路线</text>
      </view>
      <view class="tab-item {{tab === 'visited' ? 'active' : ''}}" bindtap="onTabChange" data-tab="visited">
        <text>足迹</text>
      </view>
    </view>
    <view class="tab-right"></view>
  </view>

  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="loading-wrap">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <view wx:elif="{{empty}}" class="empty-wrap">
    <view class="empty-illustration">
      <i class="empty-icon {{emptyIcon}}"></i>
    </view>
    <text class="empty-title">{{titles[tab]}}</text>
    <text class="empty-hint">{{emptyHint}}</text>
    <view class="empty-btn" bindtap="onGoLogin" wx:if="{{!isLoggedIn}}">去登录</view>
    <view class="empty-btn" bindtap="onGoHome" wx:elif="{{tab !== 'visited'}}">去探索</view>
  </view>

  <block wx:else>
    <view wx:if="{{tab === 'plan'}}" class="route-card-list" style="padding-top: {{listTop}}px;">
      <block wx:for="{{items}}" wx:key="id">
        <view class="route-card-frame">
          <view class="route-card-backdrop"></view>
          <view class="route-card route-card-theme-{{index % 4}}" bindtap="onRouteCardTap" bindlongpress="onRouteCardLongPress" data-route="{{item}}">
            <view class="route-card-stroke"></view>
            <view class="route-card-top">
              <image class="route-image" src="{{item.coverImage}}" mode="aspectFill" />
              <view class="route-main">
                <text class="route-title">{{item.title}}</text>
                <text class="route-subtitle">{{item.subtitle}}</text>
              </view>
            </view>
            <view class="route-cutout-wrap route-cutout-wrap-left">
              <view class="route-cutout route-cutout-left"></view>
            </view>
            <view class="route-cutout-wrap route-cutout-wrap-right">
              <view class="route-cutout route-cutout-right"></view>
            </view>
            <view class="route-divider"></view>
            <view class="route-footer">
              <view class="route-author-wrap">
                <image class="route-author-avatar" src="{{item.authorAvatar}}" mode="aspectFill" />
                <text class="route-author">{{item.author}}</text>
              </view>
              <text class="route-city">{{item.city}}</text>
            </view>
          </view>
        </view>
      </block>
    </view>

    <view wx:else class="want-list" style="padding-top: {{listTop}}px;">
    <view wx:if="{{tab === 'want'}}" class="want-toolbar">
      <view class="want-toolbar-left" bindtap="onCityFilterTap">
        <text class="want-toolbar-title">{{cityFilterLabel}}</text>
        <i class="mgc_down_line want-toolbar-arrow"></i>
      </view>
      <view class="want-plan-entry" bindtap="onPlanRoute">
        <i class="mgc_signature_2_ai_line"></i>
        <text>路线规划</text>
      </view>
    </view>
    <!-- 城市筛选改成底部弹窗，不再使用顶部下拉框。 -->
    <view class="route-action-mask {{cityFilterVisible ? 'show' : ''}}" bindtap="onCloseCityFilter">
      <view class="route-action-sheet city-filter-sheet" catchtap="preventBubble">
        <view class="route-action-header">
          <text class="route-action-title">选择地点范围</text>
          <i class="mgc_close_line route-action-close" bindtap="onCloseCityFilter"></i>
        </view>
        <view class="route-action-body">
          <view class="route-action-grid">
            <view class="route-action-card {{!cityFilter ? 'active' : ''}}" bindtap="onSelectCityFilter" data-city="">
              <text class="route-action-label">全部</text>
            </view>
            <view
              wx:for="{{cityOptions}}"
              wx:key="*this"
              class="route-action-card {{cityFilter === item ? 'active' : ''}}"
              bindtap="onSelectCityFilter"
              data-city="{{item}}"
            >
              <text class="route-action-label">{{item}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
      <block wx:for="{{items}}" wx:key="id">
        <view class="place-swipe-item">
          <view wx:if="{{tab === 'want'}}" class="place-delete-action {{(item.swipeOffset || 0) < 0 ? 'show' : ''}}" catchtap="onRemove" data-id="{{item.id}}">
            <view class="place-delete-inner">
              <i class="mgc_delete_2_line place-delete-icon"></i>
              <text class="place-delete-text">删除</text>
            </view>
          </view>
          <!-- 实际可滑动的卡片本体：左边封面，中间信息，右边箭头 -->
          <view
            class="place-row"
            bindtap="onItemTap"
            bindtouchstart="onCardTouchStart"
            bindtouchmove="onCardTouchMove"
            bindtouchend="onCardTouchEnd"
            bindtouchcancel="onCardTouchEnd"
            data-item="{{item}}"
            data-index="{{index}}"
            style="transform: translateX({{item.swipeOffset || 0}}px);"
          >
            <view class="place-card-main">
              <!-- 左侧封面：图片 + 封面角标 -->
              <view class="place-cover-wrap">
                <image class="place-cover" src="{{item.coverImage}}" mode="aspectFill"></image>
                <view class="card-cat-badge" wx:if="{{item.displayCategory}}">{{item.displayCategory}}</view>
              </view>
              <!-- 中间信息和右侧箭头 -->
              <view class="place-info-row">
                <view class="place-main">
                  <text class="place-name">{{item.name}}</text>
                  <view class="place-tags">
                    <view class="place-rating" wx:if="{{item.rating}}">
                      <text>{{item.rating}}</text>
                    </view>
                    <text class="place-tag-chip" wx:for="{{item.tags}}" wx:key="*this" wx:for-item="tag">{{tag}}</text>
                  </view>
                  <view class="place-footer">
                    <text class="place-footer-text">{{item.displayWantCount}} 人想去</text>
                    <text class="place-footer-separator">·</text>
                    <text class="place-footer-text">{{item.distanceText}}</text>
                  </view>
                </view>
                <view class="place-arrow">
                  <i class="mgc_right_line"></i>
                </view>
              </view>
            </view>
          </view>
        </view>
      </block>
    </view>
  </block>

  <!-- 公用右下角悬浮入口：后续改样式时，想去页和攻略页会自动同步。 -->
  <entry-fab-button
    iconType="{{addEntryVisible || importEntryVisible ? 'close' : 'add'}}"
    overlay="{{addEntryVisible || importEntryVisible}}"
    bind:tapentry="onEntryFabTap"
  />

  <!-- 悬浮入口三卡片菜单：点击遮罩关闭。 -->
  <view
    class="entry-sheet-mask {{addEntryVisible ? 'show' : ''}}"
    bindtap="closeAddEntrySheet"
  ></view>
  <view
    class="entry-sheet {{addEntryVisible ? 'show' : ''}}"
    catchtap="preventBubble"
  >
    <view class="entry-sheet-body">
      <view class="entry-card-list">
        <view class="entry-action-card entry-action-card-bar entry-create-route-card" bindtap="onCreateRouteFromFab">
          <view class="entry-action-card-content">
            <view class="entry-action-card-text">
              <text class="entry-action-card-label">创建路线</text>
              <text class="entry-action-card-desc">从空白路线开始创建行程</text>
            </view>
            <i class="entry-action-card-icon entry-action-card-icon-gradient mgc_add_circle_line"></i>
          </view>
        </view>

        <view class="entry-action-card entry-action-card-bar entry-parse-card" bindtap="onOpenLinkImport">
          <view class="entry-action-card-content">
            <view class="entry-action-card-text">
              <text class="entry-action-card-label">解析路线</text>
              <text class="entry-action-card-desc">粘贴链接或正文生成路线</text>
            </view>
            <i class="entry-action-card-icon entry-action-card-icon-gradient mgc_ai_line"></i>
          </view>
        </view>

        <view class="entry-action-card entry-action-card-bar entry-checkin-card" bindtap="onOpenCheckinFromFab">
          <view class="entry-action-card-content">
            <view class="entry-action-card-text">
              <text class="entry-action-card-label">采集打卡</text>
              <text class="entry-action-card-desc">拍照记录地点和打卡内容</text>
            </view>
            <i class="entry-action-card-icon entry-action-card-icon-gradient mgc_camera_2_ai_line"></i>
          </view>
        </view>
      </view>

    </view>
  </view>

  <!-- 解析路线输入弹窗：从三卡片菜单继续下钻。 -->
  <view
    class="import-sheet-mask {{importEntryVisible ? 'show' : ''}}"
    bindtap="onCloseLinkImport"
  ></view>
  <view
    class="import-sheet {{importEntryVisible ? 'show' : ''}}"
    catchtap="preventBubble"
  >
    <view class="import-sheet-header">
      <text class="import-sheet-title">解析路线</text>
    </view>

    <view class="import-sheet-body">
      <view class="import-input-wrap">
        <textarea
          class="import-textarea"
          value="{{guideLink}}"
          placeholder="粘贴纯链接、攻略正文或分享文案"
          placeholder-class="import-placeholder"
          maxlength="-1"
          auto-height
          cursor-spacing="24"
          bindinput="onLinkInput"
        ></textarea>
      </view>

      <view class="import-hint-list">
        <text class="import-hint">支持识别微信公众号、小红书笔记的文本内容或者链接</text>
      </view>
    </view>

    <view class="import-sheet-footer">
      <view class="import-secondary-btn" bindtap="onPasteLink">粘贴内容</view>
      <view class="import-primary-btn" bindtap="onConfirmLink">确认</view>
    </view>
  </view>

  <view class="plan-day-mask {{planDaySheetVisible ? 'show' : ''}}" bindtap="onClosePlanDaySheet">
    <view class="plan-day-sheet" catchtap="preventBubble">
      <view class="plan-day-header">
        <text class="plan-day-title">旅行天数</text>
        <i class="mgc_close_line plan-day-close" bindtap="onClosePlanDaySheet"></i>
      </view>
      <view class="plan-day-body">
        <picker-view class="plan-day-picker-view" indicator-style="height: 88rpx; background: transparent; border-top: 1px solid #FFFFFF; border-bottom: 1px solid #FFFFFF;" value="{{[selectedPlanDayCount - 1]}}" bindchange="onSelectPlanDay">
          <picker-view-column>
            <view wx:for="{{dayOptions}}" wx:key="*this" class="plan-day-picker-item">
              {{item}} 天
            </view>
          </picker-view-column>
        </picker-view>
        <view class="plan-day-save" bindtap="onConfirmPlanRoute">确定</view>
      </view>
    </view>
  </view>

  <view class="route-action-mask {{routeActionSheetVisible ? 'show' : ''}}" bindtap="onCloseRouteActionSheet">
    <view class="route-action-sheet" catchtap="preventBubble">
      <view class="route-action-header">
        <text class="route-action-title">路线编辑</text>
        <i class="mgc_close_line route-action-close" bindtap="onCloseRouteActionSheet"></i>
      </view>
      <view class="route-action-body">
        <view class="route-action-grid">
          <view
            wx:for="{{routeActionOptions}}"
            wx:key="key"
            class="route-action-card {{item.danger ? 'danger' : ''}}"
            bindtap="onSelectRouteAction"
            data-action="{{item.key}}"
          >
            <i class="route-action-icon {{item.icon}}"></i>
            <text class="route-action-label">{{item.label}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 删除路线确认：统一改成自定义底部确认层。 -->
  <view class="route-action-mask {{deleteRouteConfirmVisible ? 'show' : ''}}" bindtap="onCloseDeleteRouteConfirm">
    <view class="route-action-sheet route-delete-confirm-sheet" catchtap="preventBubble">
      <view class="route-action-header">
        <text class="route-action-title">删除路线</text>
        <i class="mgc_close_line route-action-close" bindtap="onCloseDeleteRouteConfirm"></i>
      </view>
      <view class="route-action-body">
        <text class="route-delete-confirm-desc">删除后无法恢复，确认删除这条路线吗？</text>
        <view class="route-delete-confirm-actions">
          <view class="route-delete-confirm-btn cancel" bindtap="onCloseDeleteRouteConfirm">取消</view>
          <view class="route-delete-confirm-btn danger" bindtap="onConfirmDeleteRoute">确认删除</view>
        </view>
      </view>
    </view>
  </view>
</view>
