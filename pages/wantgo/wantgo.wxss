/* 觅食图 V1 - 想去清单页样式 */
.container {
  position: relative;
  min-height: 100vh;
  background: #ffffff;
}

.tab-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-left: 48rpx;
  background: #ffffff;
  box-sizing: content-box;
}

.tab-left {
  display: flex;
  align-items: center;
  gap: 32rpx;
}

.tab-item text {
  color: #c1c1c1;
  font-size: 48rpx;
  line-height: 48rpx;
  font-weight: 500;
}

.tab-item.active text {
  color: #000000;
}

.tab-right {
  width: 48rpx;
  height: 48rpx;
}

.empty-wrap {
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-right: 48rpx;
  padding-left: 48rpx;
}

.empty-illustration {
  width: 160rpx;
  height: 160rpx;
  border-radius: 999rpx;
  background: #ecf8ff;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.empty-icon {
  font-size: 80rpx;
  color: #47bffe;
}

.empty-title {
  color: #000000;
  font-size: 40rpx;
  line-height: 40rpx;
  margin-bottom: 16rpx;
}

.empty-hint {
  color: #868686;
  font-size: 28rpx;
  line-height: 44rpx;
  text-align: center;
  margin-bottom: 40rpx;
}

.empty-btn {
  min-width: 176rpx;
  height: 80rpx;
  padding: 0 32rpx;
  border-radius: 999rpx;
  background: #47bffe;
  color: #ffffff;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.route-card-list,
.want-list {
  box-sizing: border-box;
  padding-right: 48rpx;
  padding-left: 48rpx;
}

.route-card-list {
  padding-bottom: calc(132rpx + env(safe-area-inset-bottom));
}

.want-list {
  padding-bottom: calc(132rpx + env(safe-area-inset-bottom));
}

.want-list.has-plan-button {
  padding-bottom: calc(340rpx + env(safe-area-inset-bottom));
}

.route-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid #f5f5f5;
}

.route-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding-right: 24rpx;
}

.route-title {
  font-size: 36rpx;
  line-height: 50rpx;
  font-weight: 600;
  color: #000000;
}

.route-subtitle {
  font-size: 28rpx;
  line-height: 40rpx;
  color: #999999;
}

.route-image {
  width: 180rpx;
  height: 180rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}

.place-row {
  display: flex;
  align-items: center;
  gap: 32rpx;
  padding-bottom: 48rpx;
}

.place-cover-wrap {
  position: relative;
  width: 128rpx;
  height: 128rpx;
  flex-shrink: 0;
  overflow: visible;
}

.place-cover-shadow {
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  width: 112rpx;
  height: 112rpx;
  border-radius: 20rpx;
  background: rgba(0, 0, 0, 0.04);
  transform: rotate(-8deg);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
}

.place-cover {
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  width: 112rpx;
  height: 112rpx;
  border: 2rpx solid #ffffff;
  border-radius: 20rpx;
  transform: rotate(-8deg);
}

.place-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.place-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  align-self: flex-start;
  min-width: 56rpx;
  height: 32rpx;
  padding: 0 8rpx;
  border-radius: 8rpx;
  background: #fdf8e3;
  color: #ee8733;
  font-size: 20rpx;
  line-height: 20rpx;
}

.place-name {
  color: #000000;
  font-size: 32rpx;
  line-height: 32rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.place-travel {
  color: #868686;
  font-size: 24rpx;
  line-height: 24rpx;
}

.place-arrow {
  width: 48rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.place-arrow i {
  color: #7cc5df;
  font-size: 32rpx;
}

.plan-route-fixed {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(100rpx + env(safe-area-inset-bottom));
  z-index: 25;
  height: 128rpx;
  padding: 16rpx 48rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.plan-route-btn {
  width: 100%;
  height: 96rpx;
  border-radius: 24rpx;
  background: #47bffe;
  display: flex;
  align-items: center;
  justify-content: center;
}

.plan-route-inner {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  width: 248rpx;
  height: 40rpx;
}

.plan-route-inner i {
  color: #ffffff;
  font-size: 40rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.plan-route-inner text {
  color: #ffffff;
  font-size: 32rpx;
  line-height: 32rpx;
  font-weight: 500;
  white-space: nowrap;
}
