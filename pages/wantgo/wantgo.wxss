/* 觅食图 V1 - 想去清单页样式 */
.container {
  position: relative;
  min-height: 100vh;
  background: #FFFFFF;
}

.tab-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-left: 48rpx;
  background: #FFFFFF;
  box-sizing: content-box;
}

.tab-left {
  display: flex;
  align-items: center;
  gap: 32rpx;
}

.tab-item text {
  color: #A0A4AE;
  font-size: 48rpx;
  line-height: 48rpx;
  font-weight: 500;
}

.tab-item.active text {
  color: #242529;
}

.tab-right {
  width: 48rpx;
  height: 48rpx;
}

.empty-wrap {
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-right: 48rpx;
  padding-left: 48rpx;
}

.empty-illustration {
  width: 160rpx;
  height: 160rpx;
  border-radius: 999rpx;
  background: #ecf8ff;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.empty-icon {
  font-size: 80rpx;
  color: #47BFFE;
}

.empty-title {
  color: #242529;
  font-size: 40rpx;
  line-height: 40rpx;
  margin-bottom: 16rpx;
}

.empty-hint {
  color: #6E727A;
  font-size: 28rpx;
  line-height: 44rpx;
  text-align: center;
  margin-bottom: 40rpx;
}

.empty-btn {
  min-width: 176rpx;
  height: 80rpx;
  padding: 0 32rpx;
  border-radius: 999rpx;
  background: #47BFFE;
  color: #FFFFFF;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.route-card-list,
.want-list {
  box-sizing: border-box;
  padding-right: 48rpx;
  padding-left: 48rpx;
}

.route-card-list {
  padding-bottom: calc(42rpx + env(safe-area-inset-bottom));
}

.want-list {
  padding-bottom: calc(132rpx + env(safe-area-inset-bottom));
}

.want-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  height: 56rpx;
  margin-bottom: 48rpx;
}

.want-toolbar-title {
  color: #242529;
  font-size: 32rpx;
  line-height: 32rpx;
  font-weight: 500;
}

.want-plan-entry {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  height: auto;
  padding: 16rpx 16rpx;
  border-radius: 999rpx;
  background: #242529;
  box-sizing: border-box;
}

.want-plan-entry i {
  color: #FFFFFF;
  font-size: 32rpx;
  line-height: 32rpx;
}

.want-plan-entry text {
  color: #FFFFFF;
  font-size: 24rpx;
  line-height: 24rpx;
  font-weight: 400;
}

.place-swipe-item {
  position: relative;
  margin-bottom: 48rpx;
  overflow: hidden;
}

.place-delete-action {
  position: absolute;
  top: 0;
  right: 0;
  width: 120rpx;
  height: 160rpx;
  border-radius: 24rpx;
  background: #FF5A5F;
  display: flex;
  align-items: center;
  justify-content: center;
}

.place-delete-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
}

.place-delete-icon {
  color: #FFFFFF;
  font-size: 40rpx;
  line-height: 40rpx;
}

.place-delete-text {
  color: #FFFFFF;
  font-size: 24rpx;
  line-height: 24rpx;
  font-weight: 500;
}

.route-card {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 40rpx;
  padding: 32rpx;
  height: 416rpx;
  margin-bottom: 48rpx;
  border-radius: 32rpx;
  box-sizing: border-box;
}

.route-card-theme-0 {
  background-image: linear-gradient(180deg, #f2f6fa 0%, #F7F8FA 100%);
}

.route-card-theme-1 {
  background-image: linear-gradient(180deg, #faf2f4 0%, #F7F8FA 100%);
}

.route-card-theme-2 {
  background-image: linear-gradient(180deg, #faf2fa 0%, #F7F8FA 100%);
}

.route-card-theme-3 {
  background-image: linear-gradient(180deg, #f2faf3 0%, #F7F8FA 100%);
}

.route-title {
  width: 100%;
  height: 112rpx;
  font-size: 40rpx;
  line-height: 56rpx;
  font-weight: 400;
  color: #242529;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.route-image {
  width: 128rpx;
  height: 128rpx;
  border-radius: 24rpx;
  flex-shrink: 0;
}

.route-footer {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  min-height: 32rpx;
}

.route-subtitle {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  line-height: 24rpx;
  font-weight: 400;
  color: #6E727A;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.route-arrow {
  flex-shrink: 0;
  font-size: 32rpx;
  color: #6E727A;
}

.place-row {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 32rpx;
  height: 160rpx;
  background: #FFFFFF;
  transition: transform 0.2s ease;
  box-sizing: border-box;
}

.place-cover {
  width: 160rpx;
  height: 160rpx;
  border-radius: 24rpx;
  flex-shrink: 0;
  display: block;
}

.place-main {
  height: 144rpx;
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  justify-content: center;
}

.place-info-row {
  flex: 1;
  min-width: 0;
  height: 144rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.place-head {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 16rpx;
}

.place-tag {
  min-width: 48rpx;
  max-width: 100%;
  height: 32rpx;
  padding: 6rpx 8rpx;
  border-radius: 8rpx;
  background: #FDF8E3;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.place-tag-text {
  color: #ee8733;
  font-size: 20rpx;
  line-height: 20rpx;
  font-weight: 400;
  text-align: center;
  white-space: nowrap;
}

.place-name {
  width: 100%;
  color: #242529;
  font-size: 32rpx;
  line-height: 32rpx;
  font-weight: 400;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.place-meta-line {
  display: inline-flex;
  max-width: 100%;
}

.place-arrow {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.place-arrow i {
  color: #C7CAD1;
  font-size: 40rpx;
  line-height: 40rpx;
}

.plan-day-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0);
  z-index: 1002;
  pointer-events: none;
  transition: background 0.3s;
}

.plan-day-mask.show {
  background: rgba(0, 0, 0, 0.4);
  pointer-events: auto;
}

.plan-day-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.32, 0.72, 0, 1);
}

.plan-day-mask.show .plan-day-sheet {
  transform: translateY(0);
}

.plan-day-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 128rpx;
  padding: 0 48rpx;
  box-sizing: border-box;
}

.plan-day-title {
  color: #242529;
  font-size: 40rpx;
  line-height: 40rpx;
  font-weight: 500;
}

.plan-day-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #242529;
  font-size: 48rpx;
}

.plan-day-body {
  padding: 0 48rpx calc(48rpx + env(safe-area-inset-bottom));
}

.plan-day-picker-view {
  width: 100%;
  height: 360rpx;
}

.plan-day-picker-item {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #6E727A;
  font-size: 32rpx;
  line-height: 32rpx;
}

.plan-day-save {
  height: 96rpx;
  border-radius: 999rpx;
  margin-top: 32rpx;
  background: #242529;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 32rpx;
  line-height: 32rpx;
  font-weight: 500;
}
