/* 觅食图 V1 - 想去清单页样式 */
.loading-wrap {
  position: fixed;
  inset: 0;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #FFFFFF;
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 6rpx solid #F0F0F0;
  border-top-color: #1A2739;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 32rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  color: #9DA4AD;
  font-size: 28rpx;
  line-height: 28rpx;
}

.container {
  position: relative;
  min-height: 100vh;
  background: #FFFFFF;
}

.tab-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-left: 48rpx;
  background: #FFFFFF;
  box-sizing: content-box;
}

.tab-left {
  display: flex;
  align-items: center;
  gap: 32rpx;
}

.tab-item text {
  color: #9DA4AD;
  font-size: 48rpx;
  line-height: 48rpx;
  font-weight: 500;
}

.tab-item.active text {
  color: #1A2739;
}

.tab-right {
  width: 48rpx;
  height: 48rpx;
}

.empty-wrap {
  position: fixed;
  inset: 0;
  z-index: 1;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-right: 48rpx;
  padding-left: 48rpx;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

.empty-illustration {
  width: 240rpx;
  height: 240rpx;
  border-radius: 999rpx;
  background: #F6F8FA;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 48rpx;
}

.empty-icon {
  font-size: 120rpx;
  color: #9DA4AD;
}

.empty-title {
  color: #1A2739;
  font-size: 40rpx;
  line-height: 40rpx;
  margin-bottom: 32rpx;
  font-weight: 500;
}

.empty-hint {
  color: #808B9A;
  font-size: 28rpx;
  line-height: 28rpx;
  text-align: center;
  margin-bottom: 48rpx;
}

.empty-btn {
  min-width: 176rpx;
  height: 80rpx;
  padding: 0 32rpx;
  border-radius: 999rpx;
  background: #25BBE7;
  color: #FFFFFF;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.route-card-list,
.want-list {
  box-sizing: border-box;
  padding-right: 48rpx;
  padding-left: 48rpx;
}

.route-card-list {
  padding-bottom: calc(42rpx + env(safe-area-inset-bottom));
}

.want-list {
  padding-bottom: calc(132rpx + env(safe-area-inset-bottom));
}

.visited-layout {
  box-sizing: border-box;
  padding-right: 48rpx;
  padding-bottom: calc(132rpx + env(safe-area-inset-bottom));
  padding-left: 48rpx;
}

/* 足迹顶部地图卡片：只保留一层轻背景，避免页面显得太重。 */
.visited-map-card {
  position: relative;
  overflow: hidden;
  border-radius: 32rpx;
  background: #F6F8FA;
}

.visited-map {
  width: 100%;
  height: 654rpx;
}

/* 足迹地图上的两个悬浮按钮直接复用探索页的白底小浮块风格。 */
.visited-map-action {
  position: absolute;
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
}

.visited-map-action i {
  color: #1A2739;
  font-size: 48rpx;
  line-height: 48rpx;
}

.visited-map-action-top {
  top: 24rpx;
  right: 24rpx;
}

.visited-map-action-bottom {
  right: 24rpx;
  bottom: 24rpx;
}

/* “添加足迹”是文字按钮，不再和右上角定位按钮共用正方形尺寸。 */
.visited-map-action-text {
  width: auto;
  min-width: 168rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.visited-map-action-label {
  color: #1A2739;
  font-size: 28rpx;
  line-height: 28rpx;
  font-weight: 500;
}

/* 统计卡片现在固定 4 张，直接两列排布，版面会更整齐。 */
.visited-stats-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 24rpx;
  margin-top: 32rpx;
}

.visited-stat-card {
  position: relative;
  min-height: 168rpx;
  padding: 32rpx;
  border-radius: 32rpx;
  background: #F6F8FA;
  box-sizing: border-box;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  overflow: hidden;
}

/* 左侧只放数字和文案，保证信息层级清楚。 */
.visited-stat-main {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.visited-stat-value {
  color: #1A2739;
  font-size: 48rpx;
  line-height: 48rpx;
  font-weight: 600;
}

.visited-stat-label {
  margin-top: 16rpx;
  color: #1A2739;
  font-size: 24rpx;
  line-height: 24rpx;
  font-weight: 400;
}

.visited-stat-icon-wrap {
  position: absolute;
  right: 20rpx;
  bottom: 16rpx;
  z-index: 0;
}

.visited-stat-icon {
  color: rgba(26, 39, 57, 0.08);
  font-size: 80rpx;
  line-height: 80rpx;
}

.want-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  width: 100%;
  height: 56rpx;
  margin-bottom: 48rpx;
}

.want-toolbar-title {
  color: #1A2739;
  font-size: 32rpx;
  line-height: 32rpx;
  font-weight: 500;
}

.want-plan-entry {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  height: auto;
  padding: 16rpx 24rpx;
  border-radius: 999rpx;
  background: #25BBE7;
  box-sizing: border-box;
}

.want-plan-entry i {
  color: #FFFFFF;
  font-size: 32rpx;
  line-height: 32rpx;
}

.want-plan-entry text {
  color: #FFFFFF;
  font-size: 28rpx;
  line-height: 28rpx;
  font-weight: 400;
}

.place-swipe-item {
  position: relative;
  margin-bottom: 48rpx;
  overflow: hidden;
}

.place-delete-action {
  position: absolute;
  top: 0;
  right: 0;
  width: 120rpx;
  height: 160rpx;
  border-radius: 24rpx;
  background: #FF5A5F;
  display: flex;
  align-items: center;
  justify-content: center;
  /* 默认完全隐藏，只有开始左滑后再显示，避免未滑开时透出来。 */
  opacity: 0;
  transition: opacity 0.2s ease;
}

.place-delete-action.show {
  opacity: 1;
}

.place-delete-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
}

.place-delete-icon {
  color: #FFFFFF;
  font-size: 40rpx;
  line-height: 40rpx;
}

.place-delete-text {
  color: #FFFFFF;
  font-size: 24rpx;
  line-height: 24rpx;
  font-weight: 500;
}

.route-card-frame {
  position: relative;
  height: 318rpx;
  margin-bottom: 48rpx;
}

.route-card-backdrop {
  position: absolute;
  top: 0;
  left: 32rpx;
  right: 32rpx;
  height: 320rpx;
  border-radius: 24rpx;
  background: #F6F8FA;
  z-index: 0;
}

.route-card {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 304rpx;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  justify-content: space-between;
  padding: 32rpx;
  border-radius: 32rpx;
  background-color: #FFFFFF;
  box-sizing: border-box;
  overflow: visible;
  z-index: 1;
}

.route-card-stroke {
  position: absolute;
  inset: 0;
  border: 2rpx solid #F6F7F7;
  border-radius: 32rpx;
  box-sizing: border-box;
  pointer-events: none;
  z-index: 1;
}

.route-card-theme-0 {
  background-image: linear-gradient(180deg, #F2F6FA 0%, #FFFFFF 101.32%);
}

.route-card-theme-1 {
  background-image: linear-gradient(180deg, #FAF2F4 0%, #FFFFFF 101.32%);
}

.route-card-theme-2 {
  background-image: linear-gradient(180deg, #FAF2FA 0%, #FFFFFF 101.32%);
}

.route-card-theme-3 {
  background-image: linear-gradient(180deg, #F2FAF3 0%, #FFFFFF 101.32%);
}

.route-card-top {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: flex-start;
  gap: 32rpx;
  min-width: 0;
}

.route-main {
  flex: 1;
  min-width: 0;
  height: 136rpx;
  padding-top: 2rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.route-title {
  display: -webkit-box;
  width: 100%;
  min-height: 48rpx;
  font-size: 32rpx;
  line-height: 48rpx;
  font-weight: 500;
  color: #1A2739;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.route-image {
  width: 144rpx;
  height: 144rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}

.route-subtitle {
  width: 100%;
  min-width: 0;
  font-size: 24rpx;
  line-height: 24rpx;
  font-weight: 400;
  color: #9DA4AD;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.route-divider {
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  top: 208rpx;
  height: 2rpx;
  background: linear-gradient(to right, #F6F8FA 50%, transparent 50%);
  background-size: 16rpx 2rpx;
  z-index: 2;
}

.route-cutout-wrap {
  position: absolute;
  top: 208rpx;
  width: 16rpx;
  height: 32rpx;
  transform: translateY(-50%);
  overflow: hidden;
  z-index: 3;
}

.route-cutout-wrap-left {
  left: 0;
}

.route-cutout-wrap-right {
  right: 0;
}

.route-cutout {
  position: absolute;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: #FFFFFF;
  box-shadow: 0 0 0 2rpx #F6F7F7;
}

.route-cutout-left {
  left: -16rpx;
}

.route-cutout-right {
  left: 0;
}

.route-footer {
  position: relative;
  z-index: 2;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  min-height: 32rpx;
  margin-top: auto;
  padding-top: 44rpx;
}

.route-author-wrap {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
}

.route-author-avatar {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.route-author,
.route-city {
  color: #9DA4AD;
  font-size: 24rpx;
  line-height: 24rpx;
  font-weight: 400;
}

.route-author {
  max-width: 160rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.route-city {
  flex-shrink: 0;
  text-align: right;
}

.place-row {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 24rpx;
  min-height: 160rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  transition: transform 0.2s ease;
  box-sizing: border-box;
}

/* 卡片主体：左边封面，右边信息 */
.place-card-main {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 32rpx;
  min-width: 0;
}

/* 左侧封面：图片和角标都放在这里 */
.place-cover-wrap {
  width: 160rpx;
  height: 160rpx;
  border-radius: 24rpx;
  flex-shrink: 0;
  overflow: hidden;
  position: relative;
  background: #F2F4F7;
}

.place-cover {
  width: 100%;
  height: 100%;
  display: block;
}

/* 封面角标：和探索页保持同一种样式 */
.card-cat-badge {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  background: rgba(0, 0, 0, 0.1);
  border-radius: 8rpx;
  padding: 6rpx 8rpx;
  font-family: 'PingFang SC';
  font-size: 20rpx;
  color: #FFFFFF;
  line-height: 20rpx;
  backdrop-filter: blur(4px);
}

/* 中间主要信息区：标题、标签、底部数据 */
.place-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-height: 160rpx;
  box-sizing: border-box;
}

/* 中间信息和右侧箭头的横向布局 */
.place-info-row {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

/* 标题：超长省略 */
.place-name {
  width: 100%;
  gap: 16rpx;
  color: #1A2739;
  font-size: 32rpx;
  line-height: 32rpx;
  font-weight: 400;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  margin-bottom: 16rpx;
}

/* 标签行：评分和业务标签 */
.place-tags {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-wrap: nowrap;
  overflow: hidden;
  width: 100%;
  margin-bottom: 32rpx;
}

/* 评分标签 */
.place-rating {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FFF7E8;
  border-radius: 12rpx;
  padding: 8rpx 16rpx;
  color: #FF7D00;
  font-size: 24rpx;
  line-height: 24rpx;
  flex-shrink: 0;
}

/* 普通标签 */
.place-tag-chip {
  background: #F6F8FA;
  border-radius: 12rpx;
  padding: 8rpx 16rpx;
  color: #9DA4AD;
  font-size: 24rpx;
  line-height: 24rpx;
  white-space: nowrap;
  flex-shrink: 0;
}

/* 底部数据：想去人数和距离 */
.place-footer {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
}

.place-footer-text,
.place-footer-separator {
  color: #9DA4AD;
  font-size: 24rpx;
  line-height: 28rpx;
  flex-shrink: 0;
}

/* 右侧加号：单独点击后弹出路线列表，把地点加到路线里。 */
.place-arrow {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.place-arrow i {
  color: #BAC4CC;
  font-size: 40rpx;
  line-height: 40rpx;
}

.route-picker-sheet {
  max-height: 80vh;
}

.route-picker-scroll {
  max-height: 58vh;
}

.route-picker-empty {
  padding: 48rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.route-picker-empty-text {
  color: #808B9A;
  font-size: 28rpx;
  line-height: 40rpx;
}

.plan-day-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0);
  z-index: 1002;
  pointer-events: none;
  transition: background 0.3s;
}

.plan-day-mask.show {
  background: rgba(0, 0, 0, 0.4);
  pointer-events: auto;
}

.plan-day-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.32, 0.72, 0, 1);
}

.plan-day-mask.show .plan-day-sheet {
  transform: translateY(0);
}

.route-action-grid {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.route-action-card {
  width: 100%;
  min-height: 104rpx;
  border-radius: 24rpx;
  border: 2rpx solid #F6F8FA;
  background: #FFFFFF;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 0 32rpx;
  box-sizing: border-box;
}

.route-action-card.active {
  border-color: #1A2739;
}

.route-action-card.danger .route-action-icon,
.route-action-card.danger .route-action-label {
  color: #FF5A5F;
}

.route-action-card.active.danger {
  border-color: #FF5A5F;
  background: #FFF7F7;
}

.route-action-icon {
  color: #1A2739;
  font-size: 40rpx;
  line-height: 40rpx;
  flex-shrink: 0;
}

.route-action-label {
  color: #1A2739;
  font-size: 32rpx;
  line-height: 32rpx;
  font-weight: 400;
  flex: 1;
  text-align: left;
}

.route-action-confirm {
  margin-top: 48rpx;
  width: 100%;
  height: 96rpx;
  border-radius: 999rpx;
  background: #25BBE7;
  color: #FFFFFF;
  font-size: 32rpx;
  line-height: 32rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
}

.route-delete-confirm-body {
  padding-top: 0;
}

.route-delete-confirm-desc {
  display: block;
  color: #808B9A;
  font-size: 28rpx;
  line-height: 44rpx;
}

.route-delete-confirm-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 48rpx;
}

.route-delete-confirm-btn {
  height: 96rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 32rpx;
}

.route-delete-confirm-btn.cancel {
  width: 160rpx;
  background: #F2F4F7;
  color: #1A2739;
  flex-shrink: 0;
}

.route-delete-confirm-btn.danger {
  flex: 1;
  background: #FF5A5F;
  color: #FFFFFF;
}

.plan-day-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 128rpx;
  padding: 0 48rpx;
  box-sizing: border-box;
}

.plan-day-title {
  color: #1A2739;
  font-size: 40rpx;
  line-height: 40rpx;
  font-weight: 500;
}

.plan-day-close {
  width: 48rpx;
  height: rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #1A2739;
  font-size: 48rpx;
}

.plan-day-body {
  padding: 0 48rpx 48rpx;
}

.plan-day-picker-view {
  width: 100%;
  height: 360rpx;
}

.plan-day-picker-item {
  height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #1A2739;
  font-size: 48rpx;
  line-height: 48rpx;
}

.plan-day-save {
  height: 96rpx;
  border-radius: 999rpx;
  margin-top: 32rpx;
  background: #25BBE7;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 32rpx;
  line-height: 32rpx;
  font-weight: 500;
}

/* ─── 城市筛选 ───────────────────────────── */
.want-toolbar-left {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 16rpx 8rpx 0;
  flex-shrink: 0;
}

.want-toolbar-arrow {
  color: #1A2739;
  font-size: 40rpx;
  line-height: 40rpx;
}

/* 城市选择沿用现有底部弹窗结构，但选中后不做颜色变化。 */
.city-filter-card.active,
.city-filter-card.active .route-action-label {
  border-color: #F6F8FA;
  color: #1A2739;
}

/* 三卡片菜单遮罩：沿用之前添加弹窗的交互方式。 */
.entry-sheet-mask {
  position: fixed;
  inset: 0;
  z-index: 220;
  background: rgba(0, 0, 0, 0);
  pointer-events: none;
  transition: background 0.28s ease;
}

.entry-sheet-mask.show {
  background: rgba(0, 0, 0, 0.4);
  pointer-events: auto;
}

.entry-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 221;
  padding: 0 48rpx 208rpx; /* 关闭按钮顶边是 140rpx，这里再加 48rpx，确保视觉间距固定为 48rpx。 */
  background: transparent;
  opacity: 0;
  transform: translateY(16rpx) scale(0.99); /* 收一点起始位移和缩放，让整体出现更轻。 */
  transform-origin: right bottom;
  pointer-events: none;
  transition: opacity 0.24s ease, transform 0.3s cubic-bezier(0.2, 0.9, 0.22, 1); /* 换成更柔和的缓动曲线。 */
}

.entry-sheet.show {
  opacity: 1;
  transform: translateY(0) scale(1);
  pointer-events: auto;
}

.entry-sheet-body {
  padding: 0;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: flex-end; /* 三卡片菜单整体改成右对齐。 */
  transform-origin: right bottom;
}

.entry-card-list {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 24rpx;
}

.entry-action-card {
  position: relative;
  width: 480rpx;
  height: 164rpx;
  border-radius: 48rpx;
  background: linear-gradient(180deg, #FFF 0%, #FFFFFF 100%);
  overflow: hidden;
  opacity: 0;
  transform: translateY(12rpx) scale(0.985); /* 卡片起始动作再轻一点，避免生硬。 */
  transform-origin: right bottom;
  transition: opacity 0.22s ease, transform 0.32s cubic-bezier(0.18, 0.9, 0.24, 1);
  transition-delay: 0s; /* 默认不延迟，避免关闭时也跟着拖慢。 */
}

.entry-sheet.show .entry-action-card {
  opacity: 1;
  transform: translateY(0) scale(1);
}

.entry-sheet.show .entry-action-card:nth-child(1) {
  transition-delay: 0.03s;
}

.entry-sheet.show .entry-action-card:nth-child(2) {
  transition-delay: 0.08s;
}

.entry-sheet.show .entry-action-card:nth-child(3) {
  transition-delay: 0.13s;
}

.entry-action-card-bar {
  display: flex;
  align-items: center;
  height: 100%;
  padding: 40rpx;
  box-sizing: border-box;
}

.entry-action-card-content {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: flex-start;
  justify-content: flex-start;
  width: 100%;
  height: 100%;
}

.entry-action-card-icon {
  position: absolute;
  /* 图标贴近卡片右上角，并向外溢出 24rpx。 */
  right: -16rpx;
  top: -16rpx;
  font-size: 64rpx;
  line-height: 64rpx;
  flex: 0 0 auto;
}

.entry-action-card-icon-gradient {
  background: linear-gradient(180deg, #C5D3E3 0%, #D8E1EC 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.entry-action-card-text {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 24rpx;
  flex: 1;
  min-width: 0;
  /* 图标放大并移到右上角后，给文字区多预留一点空间。 */
  max-width: calc(100% - 136rpx);
}

.entry-action-card-label {
  color: #1A2739;
  font-size: 36rpx;
  font-weight: 400;
  line-height: 36rpx;
  text-align: left;
}

.entry-action-card-desc {
  color: #7B808A;
  font-size: 28rpx;
  line-height: 28rpx;
  text-align: left;
  white-space: nowrap;
}

/* 解析路线输入弹窗：沿用原来添加入口里的底部输入方式。 */
.import-sheet-mask {
  position: fixed;
  inset: 0;
  z-index: 230;
  background: rgba(0, 0, 0, 0);
  pointer-events: none;
  transition: background 0.28s ease;
}

.import-sheet-mask.show {
  background: rgba(0, 0, 0, 0.4);
  pointer-events: auto;
}

.import-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 231;
  padding: 0 0 calc(188rpx + env(safe-area-inset-bottom)); /* 让右下角关闭按钮和底部内容互不遮挡。 */
  border-radius: 32rpx 32rpx 0 0;
  background: #FFFFFF;
  transform: translateY(100%);
  transition: transform 0.28s cubic-bezier(0.32, 0.72, 0, 1);
}

.import-sheet.show {
  transform: translateY(0);
}

.import-sheet-header {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  height: 128rpx;
  padding: 0 48rpx;
  box-sizing: border-box;
}

.import-sheet-title {
  color: #1A2739;
  font-size: 40rpx;
  font-weight: 500;
  line-height: 100%;
}

.import-sheet-body {
  padding: 0 48rpx;
  box-sizing: border-box;
}

.import-input-wrap {
  box-sizing: border-box;
  min-height: 320rpx;
  padding: 32rpx;
  background: #F6F8FA;
  border: 2rpx solid #F6F8FA;
  border-radius: 24rpx;
}

.import-textarea {
  width: 100%;
  min-height: 240rpx;
  color: #1A2739;
  font-size: 32rpx;
  line-height: 48rpx;
}

.import-placeholder {
  color: #9DA4AD;
  font-size: 32rpx;
  line-height: 48rpx;
}

.import-hint-list {
  margin-top: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.import-hint {
  color: #808B9A;
  font-size: 24rpx;
  line-height: 24rpx;
}

.import-sheet-footer {
  display: flex;
  gap: 24rpx;
  padding: 48rpx 48rpx 0;
}

.import-secondary-btn,
.import-primary-btn {
  height: 96rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  line-height: 32rpx;
  font-weight: 500;
}

.import-secondary-btn {
  width: 220rpx;
  flex: 0 0 220rpx;
  background: #F2F4F7;
  color: #1A2739;
}

.import-primary-btn {
  flex: 1;
  background: #25BBE7;
  color: #FFFFFF;
}
