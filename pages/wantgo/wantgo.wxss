/* 觅食图 V1 - 想去清单页样式 (Refactored to Design System) */
.container {
  height: 100vh;
  background: #FFFFFF; /* 改为纯白色 */
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
}

/* 路线卡片列表 */
.route-card-list {
  flex: 1;
  width: 100%;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  padding: 32rpx;
  box-sizing: border-box;
}

/* 路线卡片 */
.route-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid #F5F5F5;
}

.route-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding-right: 24rpx;
}

.route-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #000000;
  line-height: 1.4;
}

.route-subtitle {
  font-size: 28rpx;
  color: #999999;
}

.route-image {
  width: 180rpx;
  height: 180rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  object-fit: cover;
}

/* ── Tab切换 (新设计) ── */
.tab-bar {
  display: flex;
  align-items: center; /* 居中对齐 */
  justify-content: space-between;
  padding: 0 48rpx; /* left: 24px, right: 24px */
  background: #FFFFFF; /* 与页面背景色一致 */
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 19;
  box-sizing: content-box; /* padding-top 不包含在 height 中 */
  padding-bottom: 24rpx; /* 底部稍微加点留白避免贴边 */
}

.tab-left {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 32rpx; /* 16px */
}

.tab-item {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  position: relative;
  z-index: 20; /* 提升层级确保可点击 */
  padding: 8rpx 0; /* 调整内边距，使其不影响整体行高 */
}

.tab-item text {
  font-family: 'PingFang SC', sans-serif;
  font-weight: 500;
  font-size: 48rpx; /* 24px */
  line-height: 48rpx; /* 24px */
  color: #C1C1C1;
}

.tab-item.active text {
  color: #000000;
}

.tab-right {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx; /* 32px */
  height: 64rpx; /* 32px */
}

.search-icon {
  font-size: 48rpx; /* 24px */
  color: #262626;
}

/* ── 空状态 ── */
.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--space-3xl) var(--space-2xl) var(--space-xl);
}

.empty-illustration {
  width: 160rpx;
  height: 160rpx;
  background: var(--primary-light);
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: var(--space-lg);
}

.empty-icon {
  font-size: 80rpx;
}

.empty-title {
  font-size: 40rpx;
  
  color: var(--text-primary);
  margin-bottom: var(--space-xs);
}

.empty-hint {
  font-size: 28rpx;
  color: var(--text-secondary);
  text-align: center;
  line-height: 1.6;
  margin-bottom: var(--space-2xl);
}

.empty-btn {
  padding: 0 var(--space-xl);
  height: 80rpx; /* md: 40px */
  background: var(--primary);
  color: #FFF;
  border-radius: var(--radius-full);
  font-size: 28rpx;
  
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 176rpx; /* 88px */
}

.empty-btn:active {
  background: var(--primary-dark);
}

/* ── 规划路线横幅 ── */
.route-banner {
  margin: var(--space-md) var(--space-md) 0;
  background: var(--primary);
  border-radius: var(--radius-lg);
  padding: var(--space-md);
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: var(--shadow-sm);
  position: relative;
  overflow: hidden;
}

.route-banner::before {
  content: '';
  position: absolute;
  top: -30rpx;
  right: -30rpx;
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--radius-full);
  background: rgba(255,255,255,0.1);
}

.banner-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  background: rgba(255,255,255,0.2);
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  z-index: 1;
}

.banner-icon {
  font-size: 40rpx;
  color: #FFFFFF;
}

.banner-info {
  flex: 1;
  padding-left: var(--space-sm);
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
  z-index: 1;
}

.banner-title {
  font-size: 32rpx;
  
  color: #FFFFFF;
}

.banner-sub {
  font-size: 24rpx;
  color: rgba(255,255,255,0.85);
}

.banner-arrow-wrap {
  width: 56rpx;
  height: 56rpx;
  background: rgba(255,255,255,0.2);
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  z-index: 1;
}

.banner-arrow {
  font-size: 44rpx;
  color: #FFFFFF;
  
  line-height: 1;
}

/* ── 拖拽提示 ── */
.sort-tip {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-xs);
  padding: var(--space-sm) 0;
  font-size: 24rpx;
  color: var(--text-disabled);
}

.tip-icon {
  font-size: 24rpx;
}

.tip-text {
  font-size: 24rpx;
}

/* ── 可拖拽列表 ── */
.item-list {
  flex: 1;
  width: 100%;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  padding: var(--space-sm) var(--space-md) var(--space-xl);
  box-sizing: border-box;
}

/* 卡片样式 */
.item-card {
  display: flex;
  align-items: center;
  gap: var(--space-md);
  width: 100%;
  background: var(--surface);
  border-radius: var(--radius-md);
  padding: var(--space-md);
  box-shadow: var(--shadow-sm);
  box-sizing: border-box;
  margin-bottom: var(--space-sm);
  transition: transform 0.15s, box-shadow 0.15s, opacity 0.15s;
}

.item-card.dragging {
  box-shadow: var(--shadow-lg);
  opacity: 0.9;
  background: var(--surface);
  transform: scale(1.02);
}

/* 拖拽手柄 */
.drag-handle {
  width: 44rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-disabled);
  font-size: 32rpx;
  flex-shrink: 0;
}

/* 序号 */
.item-num {
  width: 48rpx;
  height: 48rpx;
  background: var(--primary-light);
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.item-num text {
  font-size: 24rpx;
  
  color: var(--primary-dark);
}

/* 图片 */
.item-img {
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--radius-sm);
  flex-shrink: 0;
  background: var(--background);
  object-fit: cover;
}

.item-img.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}

/* 信息区 */
.item-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: var(--space-xs);
  overflow: hidden;
}

.item-name {
  display: block;
  font-size: 34rpx;
  
  color: var(--text-primary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  line-height: 1.4;
}

.item-meta {
  font-size: 24rpx;
  color: var(--text-secondary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  line-height: 1.5;
}

.item-address {
  font-size: 24rpx;
  color: var(--text-secondary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  line-height: 1.5;
}

/* 右侧操作 */
.item-actions {
  display: flex;
  flex-direction: column;
  gap: var(--space-sm);
  flex-shrink: 0;
  width: 64rpx;
}

.navi-btn,
.remove-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

.navi-btn {
  background: var(--primary-light);
  color: var(--primary-dark);
}

.remove-btn {
  background: rgba(224, 82, 82, 0.1);
  color: var(--danger);
  font-size: 24rpx;
  
}
