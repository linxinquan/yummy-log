<!-- 觅食图 · 探索页 (合并景点与美食) -->
<view class="container">

  <!-- ── Map ── -->
  <map
    id="mainMap"
    class="map-full"
    latitude="{{mapCenter.lat}}"
    longitude="{{mapCenter.lng}}"
    scale="{{mapScale}}"
    markers="{{allMarkers}}"
    bindmarkertap="onMarkerTap"
    enable-rotate
    enable-overlooking
    show-location="{{false}}"
  ></map>

  <!-- ── Top Floating Area ── -->
  <view class="top-panel">
    <!-- 头部信息 (适配胶囊按钮高度与宽度避让) -->
    <view class="header-row" style="padding-top: {{menuTop}}px; height: {{menuHeight}}px; padding-right: {{menuRightInset}}px;">
      <!-- 左侧：地址 -->
      <view class="address-box" bindtap="onOpenLocationPicker">
        <text class="city-name">{{currentCity}}</text>
        <i class="mgc_down_small_fill arrow"></i>
      </view>
      
      <!-- 右侧：地图按钮与搜索按钮 -->
      <view class="header-right">
        <!-- 地图图标：列表只要处于展开状态（半屏或全屏）就显示 -->
        <view class="header-map-btn" bindtap="onToggleMap" wx:if="{{isSheetExpanded}}">
          <i class="mgc_map_2_line"></i>
        </view>
      </view>
    </view>

    <!-- 天气单独一行 -->
    <view class="weather-row">
      <view class="weather-box">
        <text class="weather-text">多云 23~28°C</text>
      </view>
    </view>

    <!-- 分类标签 (胶囊样式) -->
    <view class="category-scroll">
      <view
        wx:for="{{exploreCategories}}"
        wx:key="name"
        id="cat-{{item.name}}"
        class="cat-pill {{currentCategory === item.name ? 'active' : ''}}"
        bindtap="onCategoryChange"
        data-category="{{item.name}}"
      >
        <!-- 分类图标统一改用 marker PNG，和地图点位保持同一套资源 -->
        <image
          class="cat-icon-image {{currentCategory === item.name ? 'active' : ''}}"
          src="{{item.iconPath}}"
          mode="aspectFit"
        />
        <text class="cat-name {{currentCategory === item.name ? 'active' : ''}}">{{item.name}}</text>
      </view>
    </view>
  </view>

  <!-- 悬浮按钮组 (全屏时隐藏) -->
  <view class="float-btns-group" style="bottom: {{sheetHeight + 16 + sheetBottom}}px" wx:if="{{!isDragging && sheetHeight < sysMaxHeight - 10}}">
    <!-- 左侧：列表展开按钮 -->
    <view class="float-btn explore-float-btn" bindtap="onListBtnTap">
      <i class="mgc_list_check_3_line"></i>
    </view>
    
    <!-- 右侧：放大缩小按钮组 + 定位按钮 -->
    <view class="zoom-location-group">
      <!-- 放大缩小板块 -->
      <view class="zoom-controls">
        <view class="zoom-btn zoom-in" bindtap="onMapZoomIn">
          <i class="mgc_add_line zoom-icon"></i>
        </view>
        <view class="zoom-btn zoom-out" bindtap="onMapZoomOut">
          <i class="mgc_minimize_line zoom-icon"></i>
        </view>
      </view>
      
      <!-- 定位按钮 -->
      <view class="float-btn location-btn" bindtap="onMyLocation">
        <i class="mgc_aiming_2_line"></i>
      </view>
    </view>
  </view>

  <!-- ── Bottom Sheet ── -->
  <view 
    class="bottom-sheet {{isDragging ? 'dragging' : ''}}" 
    style="height: {{sheetHeight}}px; bottom: {{sheetBottom}}px;"
  >
    <!-- 拖拽手柄区域 -->
    <view 
      class="sheet-handle-area-inner" 
      bindtouchstart="onSheetTouchStart" 
      bindtouchmove="onSheetTouchMove" 
      bindtouchend="onSheetTouchEnd"
    >
      <view class="sheet-handle"></view>
    </view>

    <!-- 列表内容 -->
    <scroll-view class="sheet-content" scroll-y enable-back-to-top bindscrolltolower="onLoadMore">
      
      <!-- 列表头 -->
      <view class="list-header">
        <text class="list-title">{{currentCategory === '全部' ? '全部' : currentCategory}}</text>
        <view class="sort-btns">
          <view
            class="sort-btn {{sortType === 'distance' ? 'active-distance' : ''}}"
            bindtap="onSortChange"
            data-sort="distance"
          ><i class="mgc_location_line"></i> 距离</view>
          <view
            class="sort-btn {{sortType === 'rating' ? 'active-rating' : ''}}"
            bindtap="onSortChange"
            data-sort="rating"
          ><i class="mgc_star_line"></i> 好评</view>
        </view>
      </view>

      <view class="empty-state" wx:if="{{filteredItems.length === 0}}">
        <view class="empty-illustration">
          <i class="mgc_leaf_line empty-icon"></i>
        </view>
        <text class="empty-text body-sm">附近暂无{{currentCategory === '全部' ? '内容' : currentCategory}}，换个分类看看</text>
      </view>

      <!-- 卡片列表 (合并美食与景点的统一排版) -->
      <view wx:if="{{sheetHeight > sysMinHeight + 50}}">
        <view 
          wx:for="{{filteredItems}}" 
          wx:key="id" 
        >
          <!-- 统一卡片布局：左边封面，中间信息，右边想去按钮 -->
          <view class="shop-card" bindtap="onItemTap" data-item="{{item}}">
            <view class="card-main">
              <!-- 左侧封面区：图片、兜底占位、封面角标都放这里 -->
              <view class="card-img-wrap">
                <image
                  wx:if="{{item.displayImage}}"
                  class="card-img"
                  src="{{item.displayImage}}"
                  mode="aspectFill"
                  binderror="onImageError"
                  data-index="{{index}}"
                />
                <view wx:if="{{!item.displayImage}}" class="shop-emoji-placeholder">
                  <i class="mgc_sparkles_line shop-emoji"></i>
                </view>
                <view class="card-cat-badge" wx:if="{{item.displayCategory}}">{{item.displayCategory}}</view>
              </view>

              <!-- 中间信息区：标题、评分标签、底部数据 -->
              <view class="card-info">
                <view class="card-name">{{item.name}}</view>
                <view class="card-tags">
                  <view class="rating-star" wx:if="{{item.rating}}">
                    <text>{{item.rating}}</text>
                  </view>
                  <text class="spot-tag" wx:for="{{item.tags}}" wx:key="*this" wx:for-item="tag">{{tag}}</text>
                </view>
                <view class="card-footer">
                  <text class="card-desc">{{item.displayWantCount}} 人想去</text>
                  <text class="card-separator">·</text>
                  <text class="card-desc">{{item.distance}}</text>
                </view>
              </view>
            </view>

            <!-- 右侧操作区：这里只保留想去图标 -->
            <view class="shop-action-icons">
              <view
                class="want-icon {{item.isLiked ? 'liked' : ''}}"
                catchtap="onToggleLike"
                data-shopid="{{item.id}}"
                data-type="{{item.type}}"
              >
                <i class="{{item.isLiked ? 'mgc_heart_fill' : 'mgc_heart_line'}} icon-btn-text"></i>
              </view>
            </view>
          </view>
        </view>
        
        <view class="no-more" wx:if="{{filteredItems.length > 0}}">
          <view class="no-more-line"></view>
          <text class="no-more-text">已经没有更多了</text>
          <view class="no-more-line"></view>
        </view>
        
        <view class="bottom-spacer"></view>
      </view>
    </scroll-view>
  </view>

  <!-- 位置选择器弹窗 -->
  <view class="location-picker-mask {{showLocationPicker ? 'show' : ''}}" bindtap="onCloseLocationPicker">
    <view class="location-picker-panel" catchtap="preventBubble">
      <view class="picker-header">
        <text class="picker-title">精选城市</text>
        <i class="mgc_close_line picker-close" bindtap="onCloseLocationPicker"></i>
      </view>
      <scroll-view class="picker-content" scroll-y>
        <view class="city-grid">
          <view
            wx:for="{{cityOptions}}"
            wx:key="id"
            class="city-card {{currentCity === item.fullName ? 'active' : ''}}"
            bindtap="onSelectCity"
            data-item="{{item}}"
          >
            <view class="city-cover-wrap">
              <image class="city-cover" src="{{item.coverImage}}" mode="aspectFill" />
            </view>
            <!-- 城市卡片改成横向结构：左图 + 右侧标题与人数 -->
            <view class="city-card-content">
              <text class="city-card-name">{{item.name}}</text>
              <text class="city-card-meta">{{item.wantCount}} 人想去</text>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 自定义TabBar -->
  <custom-tabbar></custom-tabbar>
</view>
