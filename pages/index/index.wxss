/* ================================================
  觅食图 · 探索页 (合并版)
  基于 Design System v1.0 规范重构
  ================================================ */

.container {
  width: 100%;
  height: 100vh;
  position: relative;
  overflow: hidden;
}

/* ─── Map ─────────────────────────────────────── */
.map-full {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100vh;
  z-index: 1;
}

/* ─── Top Floating Area ──────────────────────── */
.top-panel {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 100;
  pointer-events: none; /* 让事件穿透到地图 */
  padding-bottom: 24rpx;
}

.top-panel-gradient {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  pointer-events: none;
  /* 把顶部白色渐变固定成独立层，避免二级卡片出现时一起被拉长。 */
  background: linear-gradient(180deg, #FFFFFF 50%, rgba(255, 255, 255, 0) 100%);
  z-index: 0;
}

.top-panel-content {
  position: relative;
  z-index: 1;
  pointer-events: auto; /* 恢复真正内容层的交互 */
}

/* ── 头部信息 (地址与天气) ── */
.header-row {
  display: flex;
  justify-content: space-between;
  align-items: center; /* 左右元素水平居中对齐 */
  padding: 0 48rpx; /* left: 24px, right: 24px */
  box-sizing: content-box;
}

.address-box {
  display: flex;
  align-items: center;
  gap: 4rpx; /* 2px */
  height: 100%;
}

.city-name {
  font-family: 'PingFang SC', sans-serif;
  font-weight: 500;
  font-size: 48rpx; /* 24px */
  color: #1A2739;
  line-height: 48rpx; /* 24px */
}

.arrow {
  font-size: 48rpx; /* 24px */
  color: #1A2739;
}

.weather-row {
  padding: 8rpx 48rpx 0; /* top: 4px, 左右: 24px */
}

.weather-box {
  display: flex;
  align-items: center;
}

.weather-text {
  font-family: 'PingFang SC', sans-serif;
  font-size: 24rpx; /* 12px */
  color: #808B9A;
  line-height: 24rpx; /* 12px */
}

.header-right {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  height: 100%;

}

.header-map-btn {
  width: 64rpx; /* 32px */
  height: 64rpx; /* 32px */
  background: transparent;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.header-map-btn i {
  font-size: 48rpx; /* 24px */
  color: #1A2739;
}

.search-btn {
  width: 64rpx; /* 32px */
  height: 64rpx; /* 32px */
  display: flex;
  align-items: center;
  justify-content: center;
}

.search-btn i {
  font-size: 48rpx; /* 24px */
  color: #1A2739;
}

.search-btn i {
  font-size: 48rpx; /* 24px */
  color: #1A2739;
}

/* ─── Category Pills ─────────────────────────── */
.category-scroll {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  padding: 0 48rpx;
  margin-top: 24rpx;
  overflow-x: auto;
  white-space: nowrap;
}

.category-scroll::-webkit-scrollbar {
  display: none;
}

.cat-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 16rpx 24rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  flex-shrink: 0;
  transition: all 0.3s;
  margin-right: 16rpx;
}

.cat-icon-image {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
  opacity: 0.5;
  transition: opacity 0.3s;
}

.cat-icon-image.active {
  opacity: 1;
}

.cat-name {
  font-family: 'PingFang SC';
  font-size: 28rpx; /* 14px */
  font-weight: 500;
  color: #808B9A;
  line-height: 40rpx; /* 20px */
  transition: color 0.3s;
}

/* 选中状态改成黑色胶囊背景 + 白色文字 */
.cat-name.active {
  color: #FFFFFF;
}

.cat-pill.active {
  background: #25bbe7;
}

.cat-pill.active .cat-icon-image {
  opacity: 1;
}

/* 二级美食 Tab：
   外层是一整张大卡片，里面的 8 个美食项可以横向滑动。 */
.secondary-category-wrap {
  padding: 0 48rpx;
  margin-top: 16rpx;
}

.secondary-category-panel {
  width: 100%;
  padding: 24rpx 0 24rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.96);
  box-sizing: border-box;
}

.secondary-category-scroll {
  width: 100%;
  white-space: nowrap;
}

.secondary-category-scroll::-webkit-scrollbar {
  display: none;
}

.secondary-category-list {
  display: inline-flex;
  flex-direction: row;
  align-items: flex-start;
  box-sizing: border-box;
}

.secondary-cat-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  /* 二级项改回固定宽度，横向滚动时整体节奏会更整齐。 */
  width: 144rpx;
  min-height: auto;
  padding: 0rpx 0rpx 0rpx;
  background: transparent;
  flex-shrink: 0;
  /* 每个二级项之间统一保留 24rpx 间距。 */
  margin-right: 24rpx;
  box-sizing: border-box;
}

.secondary-cat-item:last-child {
  margin-right: 0rpx;
}

.secondary-cat-item.active {
  /* 选中态不再加底色，只保留图标和彩色文字变化。 */
  background: transparent;
}

.secondary-cat-image {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  /* 使用透明 PNG 时不要再铺灰底，避免把透明背景“垫成方块”。 */
  background: transparent;
  /* 默认态图标先压成灰色，避免和选中态抢视觉。 */
  filter: grayscale(1);
  opacity: 0.55;
}

.secondary-cat-image.active {
  /* 选中后恢复彩色图片。 */
  filter: grayscale(0);
  opacity: 1;
}

.secondary-cat-name {
  font-family: 'PingFang SC';
  font-size: 24rpx;
  line-height: 32rpx;
  font-weight: 500;
  /* 默认态标题改成浅色。 */
  color: #9DA4AD;
  text-align: center;
  white-space: normal;
}

.secondary-cat-name.active {
  /* 选中后标题恢复深色。 */
  color: #1A2739;
}

/* ─── Float Buttons (Right Bottom) ────────────────────────── */
.float-btns-group {
  position: absolute;
  right: 32rpx; /* 16px */
  left: 32rpx; /* 16px */
  display: flex;
  flex-direction: row; /* 横向排列 */
  justify-content: space-between; /* 左右分布 */
  align-items: flex-end; /* 底部对齐 */
  z-index: 60;
  transition: bottom 0.3s cubic-bezier(0.32, 0.72, 0, 1);
  pointer-events: none; /* 让中间空隙可以透传点击事件到底部地图 */
}

.zoom-location-group {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 24rpx; /* 12px */
  pointer-events: auto;
}

.zoom-controls {
  width: 80rpx; /* 40px */
  height: 160rpx; /* 80px */
  background: #FFFFFF;
  border-radius: 24rpx; /* 12px */
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx; /* 8px */
  pointer-events: auto;
}

.zoom-btn {
  width: 48rpx; /* 24px */
  height: 48rpx; /* 24px */
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: auto;
}

.zoom-icon {
  font-size: 48rpx; /* 24px */
  color: #1A2739;
}

.float-btn {
  width: 80rpx; /* 40px */
  height: 80rpx; /* 40px */
  background: #FFFFFF;
  border-radius: 24rpx; /* 12px */
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx; /* 24px */
  color: #1A2739;
  pointer-events: auto; /* 按钮自身可以点击 */
}

/* ─── Bottom Sheet ───────────────────────────── */
.bottom-sheet {
  position: fixed;
  left: 0;
  right: 0;
  background: transparent; /* 弹窗容器透明 */
  border-radius: 0;
  z-index: 120;
  display: flex;
  flex-direction: column;
  transition: height 0.5s cubic-bezier(0.32, 0.72, 0, 1), transform 0.5s cubic-bezier(0.32, 0.72, 0, 1);
}

.bottom-sheet.dragging {
  transition: none;
}

.sheet-handle-area-inner {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0; /* 10px 0 */
  box-sizing: border-box;
  background: transparent; /* 透明背景，让内容可以透过显示 */
  border-radius: 48rpx 48rpx 0 0;
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 10;
}

.sheet-handle {
  width: 144rpx; /* 72px */
  height: 8rpx; /* 4px */
  background: #F2F4F7;
  border-radius: 4rpx; /* 2px */
  margin-bottom: 0;
}

/* （在最新 UI 中已去掉搜索框区域，隐藏） */
.sheet-search-row {
  display: none;
}

.sheet-content {
  flex: 1;
  height: calc(100% + 100rpx); /* 增加高度确保覆盖底部 */
  width: 100%;
  opacity: 1;
  transform: translateY(0);
  transition: opacity 0.5s cubic-bezier(0.32, 0.72, 0, 1), transform 0.5s cubic-bezier(0.32, 0.72, 0, 1);
  box-sizing: border-box;
  padding-top: 0; /* 内容从顶部开始，可穿过拖拽区域 */
  padding-bottom: 120rpx; /* 底部内边距，防止漏出地图 */
  background: #FFFFFF; /* 内容区域有白色背景 */
  border-radius: 48rpx 48rpx 0 0; /* 24px */
}

.sheet-content.hidden {
  opacity: 0;
  transform: translateY(20rpx);
  pointer-events: none;
}

.list-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 48rpx; /* 24px */
  margin-top: 64rpx; /* 32px - 避开拖拽区域，让标题不被遮挡 */
  margin-bottom: 48rpx; /* 24px */
}

.list-title {
  font-family: 'PingFang SC';
  font-weight: 500;
  font-size: 32rpx; /* 16px */
  color: #1A2739;
  line-height: 32rpx; /* 16px */
}

.sort-btns {
  display: flex;
  gap: 32rpx; /* 16px */
}

.sort-btn {
  display: flex;
  align-items: center;
  gap: 8rpx; /* 4px */
  font-family: 'PingFang SC';
  font-weight: 500;
  font-size: 28rpx; /* 14px */
  color: #9DA4AD;
  transition: color 0.2s;
}

.sort-btn i {
  font-size: 32rpx; /* 16px */
  color: #9DA4AD;
}

.sort-btn.active-distance {
  color: #25bbe7; /* 距离选中改成主题色 */
}

.sort-btn.active-distance i {
  color: #25bbe7;
}

.sort-btn.active-rating {
  color: #25bbe7; /* 好评选中改成主题色 */
}

.sort-btn.active-rating i {
  color: #25bbe7;
}

/* ─── Empty State ────────────────────────────── */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 96rpx 48rpx 64rpx;
}

.empty-illustration {
  width: 160rpx;
  height: 160rpx;
  border-radius: 999rpx;
  background: #F6F8FA;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.empty-icon {
  font-size: 80rpx;
  color: #9DA4AD;
}

.empty-text {
  color: #808B9A;
  text-align: center;
}

/* ── 列表卡片 (统一重构样式) ── */
.shop-card, .spot-card {
  display: flex;
  align-items: center;
  gap: 24rpx; /* 12px：中间信息到右侧图标 */
  background: transparent;
  border-radius: 0;
  padding: 0 48rpx; /* 24px */
  margin-bottom: 48rpx; /* 24px */
  width: 100vw;
  min-height: 160rpx; /* 80px */
  box-sizing: border-box;
}

/* 卡片主体：负责把封面和中间信息横向排开 */
.card-main {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 32rpx; /* 16px：封面到中间信息 */
  min-width: 0;
}

/* 左侧封面容器：图片和封面角标都绝对定位在这里面 */
.card-img-wrap, .shop-thumb-wrapper {
  width: 160rpx; /* 80px */
  height: 160rpx; /* 80px */
  flex-shrink: 0;
  border-radius: 24rpx; /* 12px */
  overflow: hidden;
  position: relative;
  background: #F2F4F7;
}

.card-img, .shop-thumb {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.shop-emoji-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  background: #F6F8FA;
}

/* 封面角标：统一显示大类，比如美食、景点、购物 */
.card-cat-badge, .distance-badge, .shop-category-badge {
  position: absolute;
  top: 12rpx; /* 6px */
  left: 12rpx; /* 6px */
  background: rgba(0, 0, 0, 0.1);
  border-radius: 8rpx; /* 4px */
  padding: 6rpx 8rpx; /* 3px 4px */
  font-family: 'PingFang SC';
  font-size: 20rpx; /* 10px */
  color: #FFFFFF;
  line-height: 20rpx; /* 10px */
  backdrop-filter: blur(4px);
}

/* 中间信息区：让标题、标签、底部数据垂直排列 */
.shop-info, .card-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-height: 160rpx;
  box-sizing: border-box;
  min-width: 0;
}

/* 标题：单行显示，超长时省略 */
.shop-name, .card-name {
  font-family: 'PingFang SC';
  font-weight: 400;
  font-size: 32rpx;
  color: #1A2739;
  line-height: 32rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  width: 100%;
  display: block;
  box-sizing: border-box;
  margin-bottom: 16rpx;
}

/* 标签行：评分和业务标签在这里横向排列 */
.card-tags,
.shop-meta, .card-rating {
  display: flex;
  align-items: center;
  gap: 16rpx; /* 8px */
  flex-wrap: nowrap;
  overflow: hidden;
  width: 100%;
  margin-bottom: 32rpx;
}

/* 评分标签：浅黄色底，用来突出评分数字 */
.shop-rating, .rating-star {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: #FFF7E8;
  border-radius: 12rpx; /* 6px */
  padding: 8rpx 16rpx; /* 4px 8px */
  font-family: 'PingFang SC';
  font-size: 24rpx; /* 12px */
  color: #FF7D00;
  line-height: 24rpx;
  flex-shrink: 0; /* 评分不压缩 */
}

/* 普通标签：比如“粤菜”“面馆”这种业务标签 */
.shop-category, .spot-tag, .card-free-badge {
  background: #F6F8FA;
  border-radius: 12rpx; /* 6px */
  padding: 8rpx 16rpx; /* 4px 8px */
  font-family: 'PingFang SC';
  font-size: 24rpx; /* 12px */
  color: #9DA4AD;
  line-height: 24rpx;
  flex-shrink: 0; /* 标签不压缩 */
  white-space: nowrap; /* 标签文字不换行 */
}

/* 底部数据：显示“多少人想去”和距离 */
.shop-bottom-row, .card-footer {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 8rpx;
  min-width: 0;
  width: 100%;
  box-sizing: border-box;
}

.stat-item, .footer-hours, .card-desc {
  font-family: 'PingFang SC';
  font-size: 24rpx; /* 12px */
  color: #9DA4AD;
  line-height: 28rpx; /* 14px */
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  width: auto;
  display: block;
  flex-shrink: 0;
}

/* 右侧想去按钮区域：这里只控制按钮整体占位 */
.shop-action-icons, .want-btn {
  flex: 0 0 40rpx;
  width: 40rpx; /* 20px */
  height: 40rpx; /* 20px */
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 中间的小圆点分隔符 */
.card-separator {
  color: #9DA4AD;
  font-size: 24rpx;
  line-height: 28rpx;
  flex-shrink: 0;
}

/* 真正可点击的想去图标区域 */
.want-icon {
  width: 40rpx; /* 20px 点击区域 */
  height: 40rpx; /* 20px 点击区域 */
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 图标本身：未选中是灰色，选中后下面会变红 */
.icon-btn-text, .want-btn i {
  font-size: 40rpx; /* 20px */
  color: #BAC4CC;
}

.want-icon.liked .icon-btn-text,
.want-btn.wanted i {
  color: #FF5A5F;
}

/* ─── Location Picker (Copied from before) ───── */
.location-picker-mask {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0);
  z-index: 1000;
  pointer-events: none;
  transition: background 0.3s;
}

.location-picker-mask.show {
  background: rgba(0,0,0,0.4);
  pointer-events: auto;
}

.location-picker-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FFFFFF;
  border-radius: 48rpx 48rpx 0 0;
  max-height: 78vh;
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.32, 0.72, 0, 1);
  z-index: 1001;
  overflow: hidden;
}

.location-picker-mask.show .location-picker-panel {
  transform: translateY(0);
}

.picker-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 128rpx;
  padding: 0 48rpx;
  box-sizing: border-box;
}

.picker-title {
  color: #1A2739;
  font-size: 40rpx;
  font-weight: 500;
  line-height: 100%;
}

.picker-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #1A2739;
  font-size: 48rpx;
}

.picker-content {
  padding: 0 48rpx calc(48rpx + env(safe-area-inset-bottom));
  height: 960rpx;
  box-sizing: border-box;
}

.city-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 24rpx;
}

.city-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 24rpx;
  width: 100%;
  min-width: 0;
  min-height: 160rpx;
  padding: 32rpx;
  border-radius: 32rpx;
  background: #F6F8FA;
  box-sizing: border-box;
}

.city-cover-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  overflow: hidden;
  flex-shrink: 0;
}

.city-cover {
  width: 100%;
  height: 100%;
  display: block;
}

.city-card-content {
  /* 右侧文案区域允许自适应收缩，避免不同城市名把卡片撑坏 */
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: flex-start;
  gap: 24rpx;
}

.city-card-name {
  color: #1A2739;
  font-size: 32rpx;
  font-weight: 400;
  line-height: 32rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.city-card-meta {
  color: #808B9A;
  font-size: 24rpx;
  line-height: 24rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.no-more {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  padding: 32rpx 32rpx 64rpx;
  gap: 16rpx;
  margin-top: 48rpx;
}

.no-more-line {
  width: 160rpx;
  height: 1rpx;
  background: #E7E7E7;
}

.no-more-text {
  font-family: 'PingFang SC';
  font-weight: 400;
  font-size: 24rpx;
  line-height: 100%;
  color: #9DA4AD;
}
