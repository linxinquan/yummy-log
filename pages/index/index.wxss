/* ================================================
  觅食图 · 探索页 (合并版)
  基于 Design System v1.0 规范重构
  ================================================ */

.container {
  width: 100%;
  height: 100vh;
  position: relative;
  overflow: hidden;
}

/* ─── Map ─────────────────────────────────────── */
.map-full {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100vh;
  z-index: 1;
}

/* ─── Top Floating Area ──────────────────────── */
.top-panel {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 100;
  pointer-events: none; /* 让事件穿透到地图 */
  /* 添加与Figma一致的顶部白色渐变蒙层 */
  background: linear-gradient(180deg, #ffffff 50%, rgba(255, 255, 255, 0) 100%);
  padding-bottom: 24rpx;
}

.top-panel > view,
.top-panel > scroll-view {
  pointer-events: auto; /* 恢复子元素的交互 */
}

/* ── 头部信息 (地址与天气) ── */
.header-row {
  display: flex;
  justify-content: space-between;
  align-items: center; /* 左右元素水平居中对齐 */
  padding: 0 48rpx; /* left: 24px, right: 24px */
  box-sizing: content-box;
}

.address-box {
  display: flex;
  align-items: center;
  gap: 4rpx; /* 2px */
  height: 100%;
}

.city-name {
  font-family: 'PingFang SC', sans-serif;
  font-weight: 500;
  font-size: 48rpx; /* 24px */
  color: #000000;
  line-height: 48rpx; /* 24px */
}

.arrow {
  font-size: 48rpx; /* 24px */
  color: #09244B;
}

.weather-row {
  padding: 8rpx 48rpx 0; /* top: 4px, 左右: 24px */
}

.weather-box {
  display: flex;
  align-items: center;
}

.weather-text {
  font-family: 'PingFang SC', sans-serif;
  font-size: 24rpx; /* 12px */
  color: #7D7F85;
  line-height: 24rpx; /* 12px */
}

.header-right {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  height: 100%;

}

.header-map-btn {
  width: 64rpx; /* 32px */
  height: 64rpx; /* 32px */
  background: transparent;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.header-map-btn i {
  font-size: 48rpx; /* 24px */
  color: #262626;
}

.search-btn {
  width: 64rpx; /* 32px */
  height: 64rpx; /* 32px */
  display: flex;
  align-items: center;
  justify-content: center;
}

.search-btn i {
  font-size: 48rpx; /* 24px */
  color: #262626;
}

.search-btn i {
  font-size: 48rpx; /* 24px */
  color: #262626;
}

/* ─── Category Pills ─────────────────────────── */
.category-scroll {
  width: 100%;
  margin-top: 24rpx; /* 12px */
  padding-left: var(--space-md);
  box-sizing: border-box;
}

.category-list {
  display: flex;
  gap: 16rpx; /* 8px */
  padding-right: var(--space-md);
}

.cat-pill {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx; /* 4px */
  padding: 12rpx 24rpx; /* 6px 12px */
  border-radius: 999rpx;
  background: #ffffff;
  flex-shrink: 0;
  transition: all 0.3s;
}

.cat-pill.active {
  background: #47bffe;
}

.cat-icon {
  font-size: 32rpx; /* 16px */
  color: #7D7F85;
}

.cat-pill.active .cat-icon {
  color: #ffffff;
}

.cat-name {
  font-family: 'PingFang SC';
  font-size: 28rpx; /* 14px */
  font-weight: 500;
  color: #7D7F85;
  line-height: 40rpx; /* 20px */
}

.cat-pill.active .cat-name {
  color: #ffffff;
}

/* ─── Float Buttons (Right Bottom) ────────────────────────── */
.float-btns-group {
  position: absolute;
  right: 32rpx; /* 16px */
  left: 32rpx; /* 16px */
  display: flex;
  flex-direction: row; /* 横向排列 */
  justify-content: space-between; /* 左右分布 */
  align-items: flex-end; /* 底部对齐 */
  z-index: 60;
  transition: bottom 0.3s cubic-bezier(0.32, 0.72, 0, 1);
  pointer-events: none; /* 让中间空隙可以透传点击事件到底部地图 */
}

.zoom-location-group {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 24rpx; /* 12px */
  pointer-events: auto;
}

.zoom-controls {
  width: 80rpx; /* 40px */
  height: 160rpx; /* 80px */
  background: #FFF;
  border-radius: 24rpx; /* 12px */
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx; /* 8px */
  pointer-events: auto;
}

.zoom-btn {
  width: 48rpx; /* 24px */
  height: 48rpx; /* 24px */
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: auto;
}

.zoom-icon {
  font-size: 48rpx; /* 24px */
  color: #09244B;
}

.float-btn {
  width: 80rpx; /* 40px */
  height: 80rpx; /* 40px */
  background: #ffffff;
  border-radius: 24rpx; /* 12px */
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx; /* 24px */
  color: #262626;
  pointer-events: auto; /* 按钮自身可以点击 */
}

/* ─── Bottom Sheet ───────────────────────────── */
.bottom-sheet {
  position: fixed;
  left: 0;
  right: 0;
  background: transparent; /* 弹窗容器透明 */
  border-radius: 0;
  z-index: 120;
  display: flex;
  flex-direction: column;
  transition: height 0.3s cubic-bezier(0.32, 0.72, 0, 1);
}

.bottom-sheet.dragging {
  transition: none;
}

.sheet-handle-area-inner {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0; /* 10px 0 */
  box-sizing: border-box;
  background: transparent; /* 透明背景，让内容可以透过显示 */
  border-radius: 48rpx 48rpx 0 0;
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 10;
}

.sheet-handle {
  width: 144rpx; /* 72px */
  height: 8rpx; /* 4px */
  background: #f0f0f0;
  border-radius: 4rpx; /* 2px */
  margin-bottom: 0;
}

/* （在最新 UI 中已去掉搜索框区域，隐藏） */
.sheet-search-row {
  display: none;
}

.sheet-content {
  flex: 1;
  height: calc(100% + 100rpx); /* 增加高度确保覆盖底部 */
  width: 100%;
  opacity: 1;
  transition: opacity 0.2s;
  box-sizing: border-box;
  padding-top: 0; /* 内容从顶部开始，可穿过拖拽区域 */
  padding-bottom: 80rpx; /* 底部内边距，防止漏出地图 */
  background: #ffffff; /* 内容区域有白色背景 */
  border-radius: 48rpx 48rpx 0 0; /* 24px */
}

.sheet-content.hidden {
  opacity: 0;
  pointer-events: none;
}

.list-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 48rpx; /* 24px */
  margin-top: 64rpx; /* 32px - 避开拖拽区域，让标题不被遮挡 */
  margin-bottom: 48rpx; /* 24px */
}

.list-title {
  font-family: 'PingFang SC';
  font-weight: 500;
  font-size: 32rpx; /* 16px */
  color: #000000;
  line-height: 32rpx; /* 16px */
}

.sort-btns {
  display: flex;
  gap: 32rpx; /* 16px */
}

.sort-btn {
  display: flex;
  align-items: center;
  gap: 8rpx; /* 4px */
  font-family: 'PingFang SC';
  font-weight: 500;
  font-size: 28rpx; /* 14px */
  color: #C2C2C2;
  transition: color 0.2s;
}

.sort-btn i {
  font-size: 32rpx; /* 16px */
  color: #C2C2C2;
}

.sort-btn.active {
  color: #E5675F; /* 选中变成珊瑚红 */
}

.sort-btn.active i {
  color: #E5675F;
}

/* ─── Empty State ────────────────────────────── */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--space-3xl) 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: var(--space-md);
  opacity: 0.5;
}

.empty-text {
  color: var(--text-secondary);
}

/* ── 列表卡片 (统一重构样式) ── */
.shop-card, .spot-card {
  display: flex;
  align-items: flex-start;
  gap: 32rpx; /* 16px 间距，图片与右侧信息 */
  background: transparent;
  border-radius: 0;
  padding: 0 48rpx; /* 24px */
  margin-bottom: 48rpx; /* 24px */
  position: relative;
  width: 100vw;
  height: 200rpx; /* 100px */
  box-sizing: border-box;
}

.card-img-wrap, .shop-thumb-wrapper {
  width: 200rpx; /* 100px */
  height: 200rpx; /* 100px */
  flex-shrink: 0;
  border-radius: 24rpx; /* 12px */
  overflow: hidden;
  position: relative;
  background: #f0f0f0;
}

.card-img, .shop-thumb {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.shop-emoji-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  background: #fdf8e3;
}

.card-cat-badge, .distance-badge, .shop-category-badge {
  position: absolute;
  top: 12rpx; /* 6px */
  left: 12rpx; /* 6px */
  background: rgba(0, 0, 0, 0.1);
  border-radius: 8rpx; /* 4px */
  padding: 6rpx 8rpx; /* 3px 4px */
  font-family: 'PingFang SC';
  font-size: 20rpx; /* 10px */
  color: #ffffff;
  line-height: 20rpx; /* 10px */
  backdrop-filter: blur(4px);
}

.shop-info, .card-info {
  display: flex;
  flex-direction: column;
  padding: 16rpx 0; /* 上下: 8px, 左右: 0 */
  justify-content: space-between;
  height: 200rpx; /* 100px */
  box-sizing: border-box;
  width: calc(100vw - 328rpx); /* 精确计算剩余宽度: 100vw - padding(48*2) - img(200) - gap(32) */
  min-width: 0;
}

.card-info-inner {
  display: flex;
  flex-direction: column;
  gap: 24rpx; /* 12px */
  min-width: 0; /* 继续向内传递 min-width 约束 */
  width: 100%;
}

.shop-name, .card-name {
  font-family: 'PingFang SC';
  font-weight: 500;
  font-size: 32rpx;
  color: #262626;
  line-height: 32rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  width: 100%;
  display: block; /* 确保 text-overflow 能够生效 */
  padding-right: 64rpx; /* 给右上角的想去按钮预留空间，防止重叠 */
  box-sizing: border-box;
}

.shop-meta, .card-rating {
  display: flex;
  align-items: center;
  gap: 16rpx; /* 8px */
  flex-wrap: nowrap; /* 强制不换行 */
  overflow: hidden; /* 超出隐藏 */
  width: 100%;
}

.shop-rating, .rating-star {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: #FDF8E3;
  border-radius: 12rpx; /* 6px */
  padding: 8rpx 16rpx; /* 4px 8px */
  font-family: 'PingFang SC';
  font-size: 24rpx; /* 12px */
  color: #EE8733;
  line-height: 24rpx;
  flex-shrink: 0; /* 评分不压缩 */
}

.shop-category, .spot-tag, .card-free-badge {
  background: #F6F6F6;
  border-radius: 12rpx; /* 6px */
  padding: 8rpx 16rpx; /* 4px 8px */
  font-family: 'PingFang SC';
  font-size: 24rpx; /* 12px */
  color: #BABABA;
  line-height: 24rpx;
  flex-shrink: 0; /* 标签不压缩 */
  white-space: nowrap; /* 标签文字不换行 */
}

.shop-bottom-row, .card-footer {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  min-width: 0; /* 防止撑爆 */
  width: 100%;
  box-sizing: border-box;
  padding-right: 64rpx;
}

.stat-item, .footer-hours, .card-desc {
  font-family: 'PingFang SC';
  font-size: 28rpx; /* 14px */
  color: #C2C2C2;
  line-height: 28rpx; /* 14px */
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  width: 100%;
  display: block;
}

/* ── 右侧想去按钮 (矩形背景 + 加号) ── */
.shop-action-icons, .want-btn {
  position: absolute;
  right: 48rpx; /* 24px */
  top: 0; /* Align with top of card */
  width: 56rpx; /* 28px */
  height: 56rpx; /* 28px */
  border-radius: 16rpx; /* 8px */
  background: linear-gradient(180deg, rgba(197, 211, 227, 0.1) 0%, rgba(216, 225, 236, 0.1) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.want-icon {
  width: 32rpx; /* 16px */
  height: 32rpx; /* 16px */
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-btn-text, .want-btn i {
  font-size: 32rpx; /* 16px */
  color: transparent;
  background: linear-gradient(180deg, #C5D3E3 0%, #D8E1EC 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent; /* 确保文字填充为透明，以便显示渐变背景 */
}

/* 已想去状态 */
.icon-btn.liked, .want-btn.wanted {
  background: linear-gradient(180deg, rgba(197, 211, 227, 0.1) 0%, rgba(216, 225, 236, 0.1) 100%);
}
.icon-btn.liked i, .want-btn.wanted i {
  color: #47BFFE;
  background: none;
  -webkit-background-clip: unset;
  -webkit-text-fill-color: initial;
}

/* ─── Location Picker (Copied from before) ───── */
.location-picker-mask {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0);
  z-index: 1000;
  pointer-events: none;
  transition: background 0.3s;
}

.location-picker-mask.show {
  background: rgba(0,0,0,0.4);
  pointer-events: auto;
}

.location-picker-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FFFFFF;
  border-radius: 48rpx 48rpx 0 0;
  max-height: 78vh;
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.32, 0.72, 0, 1);
  z-index: 1001;
  overflow: hidden;
}

.location-picker-mask.show .location-picker-panel {
  transform: translateY(0);
}

.picker-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 40rpx 48rpx 40rpx;
}

.picker-title {
  color: #000000;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 32rpx;
}

.picker-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #09244B;
  font-size: 48rpx;
}

.picker-content {
  padding: 0 48rpx 0;
  height:960rpx;
  box-sizing: border-box;
}

.city-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 28rpx;
}

.city-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  border-radius: 24rpx;
  padding: 64rpx 36rpx;
  min-height: 344rpx;
  box-sizing: border-box;
}

.city-cover-wrap {
  width: 80px;
  height: 80px;
  border-radius: 50%;
  background: #FFFFFF;
  overflow: hidden;
  flex-shrink: 0;
}

.city-cover {
  width: 100%;
  height: 100%;
}

.city-card-name {
  margin-top: 48rpx;
  color: #060606;
  text-align: center;
  font-size: 32rpx;
  font-weight: 400;
  line-height: 32rpx;
}

.city-card-meta {
  margin-top: 24rpx;
  color: #868686;
  text-align: center;
  font-size: 24rpx;
  line-height: 24rpx;
}

.no-more {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  padding: 32rpx 32rpx 64rpx;
  gap: 16rpx;
  margin-top: 48rpx;
}

.no-more-line {
  width: 160rpx;
  height: 1rpx;
  background: #E7E7E7;
}

.no-more-text {
  font-family: 'PingFang SC';
  font-weight: 400;
  font-size: 24rpx;
  line-height: 100%;
  color: #BABABA;
}
