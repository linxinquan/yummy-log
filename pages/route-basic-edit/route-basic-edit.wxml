<view class="page" wx:if="{{route}}">
  <view class="header">
    <view class="district-title">基础信息</view>
  </view>

  <view class="settings-panel">
    <view class="setting-block">
      <text class="setting-label">封面</text>
      <view class="cover-row">
        <image class="cover-preview" src="{{coverImage}}" mode="aspectFill"></image>
        <view class="cover-upload" bindtap="onChooseCover">
          <i class="mgc_add_line"></i>
        </view>
      </view>
    </view>

    <view class="setting-block">
      <text class="setting-label">旅行城市</text>
      <view class="setting-field picker-field" bindtap="onOpenCityPicker">
        <text class="setting-value {{city ? '' : 'placeholder'}}">{{city || '请选择城市'}}</text>
        <i class="mgc_right_small_line"></i>
      </view>
    </view>

    <view class="setting-block">
      <view class="field-head">
        <text class="setting-label">路线名称</text>
        <text class="field-count">{{title.length}} / {{maxTitleLength}}</text>
      </view>
      <input
        class="setting-field input-field"
        placeholder="请输入路线名称"
        maxlength="{{maxTitleLength}}"
        value="{{title}}"
        bindinput="onTitleInput"
      />
    </view>

    <view class="setting-block">
      <text class="setting-label">旅行天数</text>
      <view class="setting-field picker-field" bindtap="onOpenDayPicker">
        <text class="setting-value">{{dayCount}}</text>
        <i class="mgc_right_small_line"></i>
      </view>
    </view>

    <view class="setting-block">
      <text class="setting-label">交通偏好（全局）</text>
      <view class="setting-field picker-field" bindtap="onOpenTransportPicker">
        <text class="setting-value {{transportPreferenceText ? '' : 'placeholder'}}">{{transportPreferenceText || '请选择交通偏好'}}</text>
        <i class="mgc_right_small_line"></i>
      </view>
    </view>
  </view>

  <view class="bottom-bar">
    <view class="icon-btn delete-btn" wx:if="{{!isNewRoute}}" bindtap="onDeleteRoute">
      <i class="mgc_delete_2_line"></i>
    </view>
    <view class="bottom-btn secondary" bindtap="onCancel">取消</view>
    <view class="bottom-btn primary" bindtap="onSave">保存</view>
  </view>

  <view class="location-picker-mask {{showCityPicker ? 'show' : ''}}" bindtap="onCloseCityPicker">
    <view class="location-picker-panel" catchtap="preventBubble">
      <view class="picker-header">
        <text class="picker-title">精选城市</text>
        <i class="mgc_close_line picker-close" bindtap="onCloseCityPicker"></i>
      </view>
      <scroll-view class="picker-content" scroll-y>
        <view class="city-grid">
          <view
            wx:for="{{cityOptions}}"
            wx:key="id"
            class="city-card {{city === item.fullName ? 'active' : ''}}"
            bindtap="onSelectCity"
            data-item="{{item}}"
            style="background: {{item.bgColor}};"
          >
            <view class="city-cover-wrap">
              <image class="city-cover" src="{{item.coverImage}}" mode="aspectFill"></image>
            </view>
            <text class="city-card-name">{{item.name}}</text>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>

  <view class="sheet-mask {{showDayPicker ? 'show' : ''}}" bindtap="onCloseDayPicker">
    <view class="sheet-panel" catchtap="preventBubble">
      <view class="sheet-header">
        <text class="sheet-title">旅行天数</text>
        <i class="mgc_close_line sheet-close" bindtap="onCloseDayPicker"></i>
      </view>
      <view class="sheet-body">
        <picker-view class="day-picker-view" indicator-style="height: 88rpx;" value="{{[dayPickerIndex]}}" bindchange="onDayPickerChange">
          <picker-view-column>
            <view wx:for="{{dayOptions}}" wx:key="*this" class="day-picker-item">
              {{item}} 天
            </view>
          </picker-view-column>
        </picker-view>
        <view class="sheet-confirm" bindtap="onConfirmDayPicker">确定</view>
      </view>
    </view>
  </view>

  <view class="sheet-mask {{showTransportPicker ? 'show' : ''}}" bindtap="onCloseTransportPicker">
    <view class="sheet-panel transport-sheet" catchtap="preventBubble">
      <view class="sheet-header">
        <text class="sheet-title">交通偏好（全局）</text>
        <i class="mgc_close_line sheet-close" bindtap="onCloseTransportPicker"></i>
      </view>
      <view class="sheet-body">
        <view class="transport-group">
          <text class="transport-group-title">小于 1 公里</text>
          <view class="transport-option-grid">
            <view
              wx:for="{{transportOptions}}"
              wx:key="key"
              class="transport-option-card {{draftTransportPreferences.shortDistanceMode === item.key ? 'active' : ''}}"
              bindtap="onSelectTransportMode"
              data-type="shortDistanceMode"
              data-mode="{{item.key}}"
            >
              <i class="transport-option-icon {{item.icon}}"></i>
              <text class="transport-option-label">{{item.label}}</text>
            </view>
          </view>
        </view>
        <view class="transport-group">
          <text class="transport-group-title">大于等于 1 公里</text>
          <view class="transport-option-grid">
            <view
              wx:for="{{transportOptions}}"
              wx:key="key"
              class="transport-option-card {{draftTransportPreferences.longDistanceMode === item.key ? 'active' : ''}}"
              bindtap="onSelectTransportMode"
              data-type="longDistanceMode"
              data-mode="{{item.key}}"
            >
              <i class="transport-option-icon {{item.icon}}"></i>
              <text class="transport-option-label">{{item.label}}</text>
            </view>
          </view>
        </view>
        <view class="sheet-confirm" bindtap="onConfirmTransportPicker">确定</view>
      </view>
    </view>
  </view>
</view>
