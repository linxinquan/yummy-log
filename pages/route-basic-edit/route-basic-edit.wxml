<view class="page" wx:if="{{route}}">
  <view class="header" style="padding-top: {{statusBarHeight + 24}}px;">
    <view class="page-title">基础信息</view>
  </view>

  <view class="form-card">
    <view class="field-block">
      <view class="field-head">
        <text class="field-label">路线名称</text>
        <text class="field-count">{{title.length}} / {{maxTitleLength}}</text>
      </view>
      <input
        class="field-input"
        placeholder="请输入路线名称"
        maxlength="{{maxTitleLength}}"
        value="{{title}}"
        bindinput="onTitleInput"
      />
    </view>

    <view class="field-block">
      <text class="field-label">天数</text>
      <view class="stepper">
        <view class="step-btn {{dayCount <= 1 ? 'disabled' : ''}}" bindtap="onMinusDay">-</view>
        <text class="step-value">{{dayCount}} 天</text>
        <view class="step-btn {{dayCount >= 15 ? 'disabled' : ''}}" bindtap="onPlusDay">+</view>
      </view>
    </view>

    <view class="field-block">
      <text class="field-label">城市</text>
      <view class="field-picker" bindtap="onOpenCityPicker">
        <text class="field-picker-text {{city ? '' : 'placeholder'}}">{{city || '请选择城市'}}</text>
        <i class="mgc_right_small_line"></i>
      </view>
    </view>
  </view>

  <view class="bottom-bar">
    <view class="bottom-btn secondary" bindtap="onCancel">取消</view>
    <view class="bottom-btn primary" bindtap="onSave">保存</view>
  </view>

  <view class="location-picker-mask {{showCityPicker ? 'show' : ''}}" bindtap="onCloseCityPicker">
    <view class="location-picker-panel" catchtap="preventBubble">
      <view class="picker-header">
        <text class="picker-title">精选城市</text>
        <i class="mgc_close_line picker-close" bindtap="onCloseCityPicker"></i>
      </view>
      <scroll-view class="picker-content" scroll-y>
        <view class="city-grid">
          <view
            wx:for="{{cityOptions}}"
            wx:key="id"
            class="city-card {{city === item.fullName ? 'active' : ''}}"
            bindtap="onSelectCity"
            data-item="{{item}}"
            style="background: {{item.bgColor}};"
          >
            <view class="city-cover-wrap">
              <image class="city-cover" src="{{item.coverImage}}" mode="aspectFill"></image>
            </view>
            <text class="city-card-name">{{item.name}}</text>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>
</view>
