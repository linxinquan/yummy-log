.page {
  min-height: 100vh;
  background: #ffffff;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.header {
  padding: 48rpx;
  background: #ffffff;
}

.district-title {
  font-family: 'PingFang SC';
  font-style: normal;
  font-weight: 500;
  font-size: 48rpx;
  line-height: 100%;
  color: #000000;
}

.settings-panel {
  display: flex;
  flex-direction: column;
  gap: 64rpx;
  padding: 0 48rpx;
}

.setting-block {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.field-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.setting-label {
  color: #999999;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 28rpx;
}

.field-count {
  color: #999999;
  font-size: 24rpx;
  line-height: 24rpx;
}

.setting-field {
  height: 96rpx;
  border-radius: 24rpx;
  background: #f7f7f7;
  padding: 0 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
}

.input-field {
  display: block;
  width: 100%;
}

.setting-value,
.input-field {
  color: #000000;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 32rpx;
}

.setting-value.placeholder {
  color: #b7b7b7;
}

.picker-field i {
  font-size: 32rpx;
  color: #999999;
}

.cover-row {
  display: flex;
  align-items: center;
  gap: 32rpx;
}

.cover-preview,
.cover-upload {
  width: 128rpx;
  height: 128rpx;
  border-radius: 16rpx;
}

.cover-preview {
  background: #f2f2f2;
}

.cover-upload {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f7f7f7;
}

.cover-upload i {
  font-size: 48rpx;
  color: #999999;
}

.bottom-bar {
  position: fixed;
  left: 48rpx;
  right: 48rpx;
  bottom: 0;
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 16rpx 0 calc(24rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-sizing: border-box;
}

.icon-btn,
.bottom-btn {
  height: 96rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 500;
}

.icon-btn {
  width: 96rpx;
  flex-shrink: 0;
}

.delete-btn {
  background: rgba(255, 77, 79, 0.08);
  color: #ff4d4f;
}

.delete-btn i {
  font-size: 40rpx;
}

.bottom-btn.secondary {
  flex: 1;
  border: 2rpx solid #e7e7e7;
  background: #ffffff;
  color: #060606;
}

.bottom-btn.primary {
  flex: 1;
  background: #47bffe;
  color: #ffffff;
}

.location-picker-mask,
.sheet-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0);
  pointer-events: none;
  transition: background 0.3s;
}

.location-picker-mask {
  z-index: 1000;
}

.sheet-mask {
  z-index: 1001;
}

.location-picker-mask.show,
.sheet-mask.show {
  background: rgba(0, 0, 0, 0.4);
  pointer-events: auto;
}

.location-picker-panel,
.sheet-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  border-radius: 48rpx 48rpx 0 0;
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.32, 0.72, 0, 1);
  overflow: hidden;
}

.location-picker-panel {
  max-height: 78vh;
}

.sheet-panel {
  z-index: 1002;
}

.location-picker-mask.show .location-picker-panel,
.sheet-mask.show .sheet-panel {
  transform: translateY(0);
}

.picker-header,
.sheet-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 40rpx 48rpx;
}

.picker-title,
.sheet-title {
  color: #000000;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 32rpx;
}

.picker-close,
.sheet-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #09244b;
  font-size: 48rpx;
}

.picker-content {
  padding: 0 48rpx;
  height: 960rpx;
  box-sizing: border-box;
}

.city-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 28rpx;
}

.city-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  border-radius: 24rpx;
  padding: 64rpx 36rpx;
  min-height: 300rpx;
  box-sizing: border-box;
}

.city-cover-wrap {
  width: 80px;
  height: 80px;
  border-radius: 50%;
  background: #ffffff;
  overflow: hidden;
  flex-shrink: 0;
}

.city-cover {
  width: 100%;
  height: 100%;
}

.city-card-name {
  margin-top: 48rpx;
  color: #060606;
  text-align: center;
  font-size: 32rpx;
  font-weight: 400;
  line-height: 32rpx;
}

.sheet-body {
  padding: 0 48rpx calc(48rpx + env(safe-area-inset-bottom));
}

.day-picker-view {
  width: 100%;
  height: 360rpx;
}

.day-picker-item,
.transport-option {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #666666;
  font-size: 32rpx;
  line-height: 32rpx;
}

.sheet-confirm {
  height: 96rpx;
  border-radius: 24rpx;
  margin-top: 32rpx;
  background: #47bffe;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 500;
}

.transport-group {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.transport-group + .transport-group {
  margin-top: 32rpx;
}

.transport-group-title {
  color: #999999;
  font-size: 26rpx;
  line-height: 26rpx;
}

.transport-option-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx;
}

.transport-hint {
  margin-top: 32rpx;
  color: #999999;
  font-size: 24rpx;
  line-height: 36rpx;
}
