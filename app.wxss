@import "./styles/mingcute.wxss";

/* ================================================
  觅食图 · 全局设计系统
  基于最新的 Design System (tokens.md, components.md)
  ================================================ */

page {
  /* ── Colors · 颜色系统 ── */
  /* 主色调 (Primary)：决定了整个小程序的品牌主色，比如按钮、图标选中的颜色 */
  --primary: #25BBE7; /* 品牌主色：统一回退到原来的主题色 */
  --primary-light: #E9F8FD; /* 主色浅底：用于选中态弱背景和浅色强调 */
  --primary-dark: #1AA6CF; /* 主色按下态：用于按钮点击反馈 */

  /* 中性色 (Neutral)：主要用于文字、背景、卡片底色等 */
  --text-primary: #1A2739; /* 主要文字颜色：用于标题、正文等最重要的信息 */
  --text-body: #495664; /* 一级正文：用于正文内容和中高优先级说明 */
  --text-secondary: #808B9A; /* 次要文字颜色：用于副标题、描述、时间等 */
  --text-tertiary: #9DA4AD; /* 弱提示文字：用于轻提示、辅助信息 */
  --text-disabled: #BAC4CC; /* 禁用文字颜色：用于不可点击的按钮或占位符提示 */
  --background: #FFFFFF; /* 全局页面背景色：纯白色 */
  --surface: #FFFFFF; /* 表面/卡片颜色：所有卡片、模块的默认纯白底色 */
  --surface-subtle: #F6F8FA; /* 浅层背景：用于弱区块、空状态和浅灰容器 */
  --surface-muted: #F2F4F7; /* 次级浅底：用于更明显的分层背景 */
  --surface-active: #F6F8FA; /* 表面按下时的颜色：卡片被点击时的反馈底色 */
  --border: #F6F8FA; /* 边框颜色：用于按钮边框、浅色卡片描边 */
  --divider: #F6F8FA; /* 分割线颜色：用于列表、模块之间的细线条 */

  /* 功能色 (Semantic)：用于表示状态的辅助颜色 */
  --success: #3A9B6F; /* 成功色：如操作成功、安全状态 */
  --warning: #E6A817; /* 警告色：如必吃榜标签、提示信息 */
  --danger: #FF5A5F; /* 危险色：如删除按钮、报错信息 */
  --info: #4A7FC1; /* 信息色：普通的通知或引导 */
  --dark-button: #25BBE7; /* 深色主按钮、深色胶囊按钮统一回退到原来的产品主题色 */
  --tag-bg-warning: #F6F8FA; /* 警告标签底色：统一改成更轻的浅灰底 */
  --tag-text-warning: #9DA4AD; /* 警告标签文字：统一改成更柔和的浅灰文字 */

  /* 渐变 (Gradient)：用于一些特殊的背景 */
  --gradient-warm: linear-gradient(135deg, #E6F7FF 0%, #FFFFFF 100%); /* 浅蓝到纯白的渐变，如“今日推荐”卡片底色 */

  /* ── Spacing · 间距系统 (注意：小程序里 1px = 2rpx) ── */
  --space-xs: 8rpx;     /* 4px - 极小间距：如小图标和文字之间 */
  --space-sm: 16rpx;    /* 8px - 小间距：如卡片内部元素的上下间距 */
  --space-smp: 20rpx;   /* 10px - 特殊小间距：用于特定场景微调 */
  --space-md: 48rpx;    /* 24px - 中等间距 (全局标准)：页面左右边距、卡片内边距 (Padding) */
  --space-lg: 48rpx;    /* 24px - 大间距：大的模块、区块之间的间距 */
  --space-xl: 64rpx;    /* 32px - 超大间距：页面头部、底部留白 */
  --space-2xl: 96rpx;   /* 48px - 极大间距：空状态插画的上下留白 */
  --space-3xl: 128rpx;  /* 64px - 最大间距：特殊排版留白 */

  /* ── Border Radius · 圆角系统 ── */
  --radius-none: 0rpx;  /* 直角 */
  --radius-sm: 12rpx;   /* 6px - 小圆角：如小标签、小按钮 */
  --radius-md: 24rpx;   /* 12px - 中等圆角 (全局标准)：所有的内容卡片、弹窗的圆角 */
  --radius-lg: 32rpx;   /* 16px - 大圆角：大型焦点图、大横幅卡片 */
  --radius-xl: 48rpx;   /* 24px - 超大圆角：特殊造型面板 */
  --radius-full: 9999rpx; /* 全圆角：用于圆形头像、胶囊形按钮 (Pill button) */

  /* ── Shadows · 阴影系统 ── */
  /* 全部去掉阴影以符合扁平化清新设计 */
  --shadow-xs: none;
  --shadow-sm: none;
  --shadow-md: none;
  --shadow-lg: none;

  /* ── Typography · 字体系统 ── */
  font-family: -apple-system, "PingFang SC", "Noto Sans SC", sans-serif;
  color: var(--text-primary);
  background: var(--background);
  font-weight: 400 !important;
  font-size: 28rpx;
  line-height: 1.6;
}

/* ── 基础通用类 (Utility Classes) ── */
/* 这些是可以直接加在 class 里快速排版的快捷类名 */
.flex { display: flex; } /* 基础横向弹性布局 */
.flex-col { display: flex; flex-direction: column; } /* 纵向弹性布局 */
.flex-center { display: flex; align-items: center; justify-content: center; } /* 完全居中对齐 */
.flex-between { display: flex; align-items: center; justify-content: space-between; } /* 两端对齐，中间留白 */
.flex-wrap { flex-wrap: wrap; } /* 允许子元素自动换行 */
.flex-1 { flex: 1; } /* 占据剩余的所有空间 */

/* ── 文本颜色类 (Text Color Classes) ── */
/* 快捷设置文字颜色的类名 */
.text-primary { color: var(--text-primary); } /* 主要文字 (深色) */
.text-secondary { color: var(--text-secondary); } /* 次要文字 (灰色) */
.text-disabled { color: var(--text-disabled); } /* 禁用文字 (浅灰色) */

/* ── 字号层级 (Typography Scale) ── */
/* 统一全站字体大小的规范类名，直接加在文本标签上即可 (注意：小程序 1px = 2rpx) */
.display { font-size: 64rpx; font-weight: 400; line-height: 1.2; }      /* 32px - 超大标题：用于展示型数字、巨大文案 */
.heading-1 { font-size: 48rpx; font-weight: 400; line-height: 1.3; }    /* 24px - 一级标题：用于页面主标题、大模块名字 */
.heading-2 { font-size: 40rpx; font-weight: 400; line-height: 1.35; }   /* 20px - 二级标题：用于卡片标题、区块小标题 */
.heading-3 { font-size: 34rpx; font-weight: 400; line-height: 1.4; }    /* 17px - 三级标题：用于列表标题、重点强调的文字 */
.body { font-size: 32rpx; font-weight: 400; line-height: 1.6; }         /* 16px - 正文：常规的描述段落、常规列表文字 */
.body-sm { font-size: 28rpx; font-weight: 400; line-height: 1.6; }      /* 14px - 小正文：辅助说明的段落、次要信息的列表文字 */
.caption { font-size: 24rpx; font-weight: 400; line-height: 1.5; }      /* 12px - 辅助文字：时间、标签、距离、提示信息等 */

/* ── 卡片组件基础 (Card Component Base) ── */
/* 给一个 view 加上 class="card" 就会立刻获得标准的卡片外观 */
.card {
  background: var(--surface); /* 纯白底色 */
  border-radius: var(--radius-md); /* 标准 12px 圆角 */
  padding: var(--space-md); /* 标准 12px 内边距 */
  box-shadow: var(--shadow-sm); /* （当前被设置为无阴影） */
  transition: box-shadow 0.2s; /* 阴影变化的过渡动画 */
}
.card:active {
  box-shadow: var(--shadow-xs); /* 点击时阴影变小（产生按压感） */
}

/* ── 按钮组件基础 (Button Component Base) ── */
/* 给 button 加上 class="btn btn-primary" 可以覆盖微信默认丑陋的按钮样式 */
button.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: var(--radius-full);
  border: none;
  padding: 0 var(--space-lg);
  font-size: 32rpx;
  font-weight: 400;
  margin: 0;
  box-sizing: border-box;
}
button.btn::after {
  display: none; /* 移除微信默认的按钮边框 */
}
button.btn-primary {
  background: var(--dark-button);
  color: var(--surface);
}
button.btn-primary:active {
  background: #1AA6CF;
}
button.btn-secondary {
  background: var(--surface-muted);
  color: var(--text-primary);
  border: none;
}
button.btn[disabled] {
  background: var(--surface-muted);
  color: var(--text-disabled);
}

/* ── 分割线 (Divider) ── */
/* 给一个 view 加上 class="divider" 可以生成一条极细的浅色横线 */
.divider {
  height: 1rpx; /* 极细线，比 1px 更细 */
  background: var(--divider); /* 浅灰色线条 */
  margin: 0;
}
