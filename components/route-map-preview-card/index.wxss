.map-card {
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.96);
  backdrop-filter: blur(20rpx);
  box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.06);
}

.route-map-preview-card {
  padding: 28rpx;
}

.nav-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 0;
}

.nav-card-sub,
.nav-card-remain {
  color: #868686;
  font-size: 22rpx;
  line-height: 22rpx;
}

.nav-card-sub {
  display: block;
}

.tab-scroll {
  margin-top: 24rpx;
  white-space: nowrap;
}

.tab-row {
  display: inline-flex;
  align-items: center;
  gap: 40rpx;
  padding: 0 4rpx;
}

.tab-item {
  position: relative;
  color: #c2c2c2;
  font-size: 32rpx;
  font-weight: 400;
  line-height: 44rpx;
  padding-bottom: 20rpx;
  flex-shrink: 0;
}

.tab-item.active {
  color: #000000;
  font-weight: 500;
}

.nav-destination {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.nav-cover-wrap {
  position: relative;
  width: 128rpx;
  height: 128rpx;
  flex-shrink: 0;
}

.nav-cover-shadow {
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  width: 112rpx;
  height: 112rpx;
  border-radius: 20rpx;
  background: rgba(0, 0, 0, 0.04);
  transform: rotate(-8deg);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
}

.nav-cover {
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  width: 112rpx;
  height: 112rpx;
  border-radius: 20rpx;
  border: 2rpx solid #ffffff;
  transform: rotate(-8deg);
}

.nav-destination-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.nav-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  align-self: flex-start;
  min-width: 56rpx;
  height: 32rpx;
  padding: 0 8rpx;
  border-radius: 8rpx;
  background: #fdf8e3;
  color: #ee8733;
  font-size: 20rpx;
  line-height: 20rpx;
}

.nav-destination-name {
  color: #000000;
  font-size: 32rpx;
  line-height: 32rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.nav-destination-meta {
  color: #868686;
  font-size: 24rpx;
  line-height: 24rpx;
}

.nav-btns-row {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.nav-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

.nav-btn.secondary {
  background: #f7f7f7;
  color: #000000;
}

.nav-btn.primary {
  background: #47bffe;
  color: #ffffff;
}

.nav-btn.disabled {
  opacity: 0.35;
}
