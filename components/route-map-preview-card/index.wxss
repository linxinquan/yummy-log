/* 公共地图预览卡片：统一三页“查看路线”地图卡片的整体容器 */
.route-map-preview-card {
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  padding: 32rpx;
  min-height: 520rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
}

/* 顶部天数 Tab 区域 */
.preview-tabs-panel {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  width: 100%;
}

.preview-tab-scroll {
  width: 100%;
}

.preview-tab-row {
  display: inline-flex;
  align-items: center;
  gap: 16rpx;
  min-width: 100%;
  white-space: nowrap;
}

.preview-tab-item {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 64rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  border: 2rpx solid #E6EBF0;
  background: #FFFFFF;
  box-sizing: border-box;
  color: #808B9A;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 28rpx;
  flex-shrink: 0;
}

.preview-tab-item.active {
  color: #25BBE7;
  border-color: #25BBE7;
}

.preview-tab-divider {
  width: 100%;
  height: 2rpx;
  background: #F2F4F7;
}

/* 中间卡片主体 */
.preview-card-stage {
  width: 100%;
}

.preview-detail-card {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  width: 100%;
}

.preview-side-inner {
  display: flex;
  flex-direction: column;
  gap: 40rpx;
  width: 100%;
}

.preview-card-head {
  display: flex;
  align-items: center;
  gap: 32rpx;
  width: 100%;
  min-width: 0;
}

.preview-cover-image {
  width: 128rpx;
  height: 128rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}

.preview-head-main {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 24rpx;
}

.preview-name {
  display: block;
  width: 100%;
  min-width: 0;
  max-width: 100%;
  color: #1A2739;
  font-size: 36rpx;
  line-height: 36rpx;
  font-weight: 400;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.preview-meta-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  width: 100%;
  min-width: 0;
  overflow: hidden;
}

.preview-chip {
  flex-shrink: 0;
  max-width: 160rpx;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  background: #F6F8FA;
  color: #9DA4AD;
  font-size: 22rpx;
  line-height: 22rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.preview-chip.score {
  background: #FFF7E8;
  color: #FF7D00;
  font-size: 24rpx;
  line-height: 24rpx;
}

.preview-desc-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  width: 100%;
}

.preview-desc-left,
.preview-desc-right {
  min-width: 0;
  color: #808B9A;
  font-size: 24rpx;
  line-height: 24rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.preview-desc-left {
  flex: 1;
}

.preview-desc-right {
  flex-shrink: 0;
  max-width: 180rpx;
  text-align: right;
}

/* 上一站 / 下一站切换按钮 */
.preview-btn-row {
  display: flex;
  gap: 20rpx;
  width: 100%;
}

.preview-btn {
  flex: 1;
  min-width: 0;
  height: 88rpx;
  border-radius: 999rpx;
  background: #F6F8FA;
  display: flex;
  align-items: center;
  justify-content: center;
}

.preview-btn text {
  color: #1A2739;
  font-size: 28rpx;
  line-height: 28rpx;
}

.preview-btn.disabled {
  background: #F6F8FA;
}

.preview-btn.disabled text {
  color: #BAC4CC;
}

/* 底部交通信息行 */
.preview-footer {
  display: grid;
  grid-template-columns: minmax(72rpx, auto) minmax(0, 1fr) minmax(72rpx, auto);
  align-items: center;
  column-gap: 16rpx;
  width: 100%;
  height: 32rpx;
  min-height: 32rpx;
}

.preview-footer-side {
  min-width: 72rpx;
  height: 32rpx;
  color: #808B9A;
  font-size: 24rpx;
  line-height: 24rpx;
  display: flex;
  align-items: center;
  justify-self: start;
  text-align: left;
}

.preview-footer travel-meta-line {
  height: 32rpx;
  display: flex;
  align-items: center;
  justify-self: center;
  min-width: 0;
  max-width: 100%;
}

.preview-footer-side.right {
  justify-content: flex-end;
  justify-self: end;
  text-align: right;
}
