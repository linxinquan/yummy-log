.bottom-action-sheet-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0);
  z-index: 1004;
  pointer-events: none;
  transition: background 0.3s;
}

.bottom-action-sheet-mask.show {
  background: rgba(0, 0, 0, 0.4);
  pointer-events: auto;
}

.bottom-action-sheet-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.32, 0.72, 0, 1);
  z-index: 1005;
}

.bottom-action-sheet-panel.show {
  transform: translateY(0);
}

.bottom-action-sheet-header {
  height: 128rpx;
  padding: 0 48rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
}

.bottom-action-sheet-title {
  color: #1A2739;
  font-size: 40rpx;
  line-height: 100%;
  font-weight: 500;
}

.bottom-action-sheet-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #1A2739;
  font-size: 48rpx;
  line-height: 48rpx;
}

.bottom-action-sheet-body {
  padding: 0 48rpx 48rpx;
  box-sizing: border-box;
}
