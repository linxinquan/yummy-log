<view class="bottom-action-sheet-mask {{visible ? 'show' : ''}} custom-mask-class" bindtap="onMaskTap"></view>

<view class="bottom-action-sheet-panel {{visible ? 'show' : ''}} custom-panel-class" catchtap="preventBubble">
  <view class="bottom-action-sheet-header">
    <text class="bottom-action-sheet-title">{{title}}</text>
    <!-- 关闭按钮改成组件内自带的“×”，不再依赖全局 iconfont。 -->
    <text wx:if="{{showClose}}" class="bottom-action-sheet-close" bindtap="onClose">×</text>
  </view>

  <view class="bottom-action-sheet-body custom-body-class">
    <slot></slot>
  </view>
</view>
