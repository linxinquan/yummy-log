/* ── 悬浮入口遮罩 ── */
.entry-sheet-mask {
  position: fixed;
  inset: 0;
  z-index: 220;
  background: rgba(0, 0, 0, 0);
  pointer-events: none;
  transition: background 0.28s ease;
}

.entry-sheet-mask.show {
  background: rgba(0, 0, 0, 0.4);
  pointer-events: auto;
}

/* ── 三卡片菜单 ── */
.entry-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 221;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  padding: 0 48rpx calc(208rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  pointer-events: none;
  opacity: 0;
  transform: translateY(16rpx) scale(0.99);
  transform-origin: right bottom;
  transition: opacity 0.24s ease, transform 0.3s cubic-bezier(0.2, 0.9, 0.22, 1);
}

.entry-sheet.show {
  opacity: 1;
  transform: translateY(0) scale(1);
  pointer-events: auto;
}

.entry-sheet-body {
  padding: 0;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  transform-origin: right bottom;
}

.entry-card-list {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 24rpx;
}

.entry-action-card {
  position: relative;
  width: 480rpx;
  height: 164rpx;
  border-radius: 40rpx;
  background: linear-gradient(180deg, #FFF 0%, #FFFFFF 100%);
  overflow: hidden;
  opacity: 0;
  transform: translateY(12rpx) scale(0.985);
  transform-origin: right bottom;
  transition: opacity 0.22s ease, transform 0.32s cubic-bezier(0.18, 0.9, 0.24, 1);
  transition-delay: 0s;
}

.entry-sheet.show .entry-action-card {
  opacity: 1;
  transform: translateY(0) scale(1);
}

.entry-sheet.show .entry-action-card:nth-child(1) {
  transition-delay: 0.03s;
}

.entry-sheet.show .entry-action-card:nth-child(2) {
  transition-delay: 0.08s;
}

.entry-sheet.show .entry-action-card:nth-child(3) {
  transition-delay: 0.13s;
}

.entry-action-card-bar {
  display: flex;
  align-items: center;
  height: 100%;
  padding: 40rpx;
  box-sizing: border-box;
}

.entry-action-card-content {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: flex-start;
  justify-content: flex-start;
  width: 100%;
  height: 100%;
}

.entry-action-card-icon {
  position: absolute;
  right: 0rpx;
  top: -16rpx;
  width: 56rpx;
  height: 56rpx;
  flex: 0 0 auto;
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
}

