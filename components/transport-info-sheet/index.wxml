<view class="transport-sheet-mask {{visible ? 'show' : ''}}" bindtap="onMaskTap"></view>
<view class="transport-sheet {{visible ? 'show' : ''}}" catchtap="preventBubble">
  <view class="transport-sheet-header">
    <text class="transport-sheet-title">交通信息</text>
    <view class="transport-sheet-close" bindtap="onClose">
      <i class="transport-sheet-close-icon mgc_close_line"></i>
    </view>
  </view>

  <view class="transport-option-list">
    <view
      wx:for="{{options}}"
      wx:key="mode"
      class="transport-option {{selectedMode === item.mode ? 'active' : ''}}"
      bindtap="onOptionTap"
      data-mode="{{item.mode}}"
    >
      <view class="transport-option-main">
        <i class="transport-option-icon {{item.icon}}"></i>
        <text class="transport-option-label">{{item.label}}</text>
      </view>
      <view class="transport-option-side">
        <!-- 右侧信息拆开写，方便分别控制距离、分隔点、时间颜色 -->
        <text class="transport-option-distance">{{item.distanceText}}</text>
        <text class="transport-option-dot">·</text>
        <text class="transport-option-time">{{item.timeText}}</text>
      </view>
    </view>
  </view>

  <view class="transport-sheet-footer">
    <view class="transport-confirm-btn" bindtap="onConfirm">
      <text class="transport-confirm-btn-text">确认</text>
    </view>
  </view>
</view>
