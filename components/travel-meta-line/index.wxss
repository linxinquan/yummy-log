.travel-meta-line {
  display: inline-flex;
  align-items: center;
  min-width: 0;
  gap: 8rpx;
}

.travel-meta-line.compact {
  gap: 8rpx;
  height: 32rpx;
  min-height: 32rpx;
  display: flex;
  align-items: center;
  justify-self: center;
  max-width: 100%;
}

.travel-meta-icon {
  flex-shrink: 0;
  color: #808B9A;
  font-size: 32rpx;
  line-height: 32rpx;
}

.travel-meta-arrow {
  flex-shrink: 0;
  font-size: 32rpx;
  line-height: 32rpx;
  color: #BAC4CC;
}

.travel-meta-text {
  min-width: 0;
  color: #808B9A;
  font-size: 24rpx;
  line-height: 24rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.travel-meta-line.compact .travel-meta-icon,
.travel-meta-line.compact .travel-meta-arrow {
  font-size: 32rpx; /* 16px */
  line-height: 32rpx;
}

.travel-meta-line.compact .travel-meta-text {
  font-size: 24rpx;
  line-height: 24rpx;
}
